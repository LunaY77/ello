{
  "name": "ello-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript workspace for ello",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm build && node packages/ello-tui/dist/cli/main.js",
    "bench:list": "node packages/ello-bench/dist/cli.js list",
    "bench:agents": "node packages/ello-bench/dist/cli.js agents",
    "bench:plan": "node packages/ello-bench/dist/cli.js plan",
    "bench:doctor": "node packages/ello-bench/dist/cli.js doctor",
    "bench:run": "node packages/ello-bench/dist/cli.js run",
    "bench:report": "node packages/ello-bench/dist/cli.js report",
    "bench:validate": "node packages/ello-bench/dist/cli.js validate && pnpm run verify-public-context",
    "format": "prettier --write .",
    "lint": "eslint . && pnpm run verify-public-context",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify-public-context": "node scripts/verify-public-context.mjs"
  },
  "devDependencies": {
    "@ello/tui": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "eslint": "^10.5.0",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.8.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.0.15"
  }
}
